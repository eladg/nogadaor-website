---
// עמוד עבודה זמני: 3 אפשרויות לתמונת הפתיח בעמוד הבית (נוגה שלחה 3 תמונות, 2026-11-07).
// לא בתפריט. **למחוק לפני עלייה לאוויר**, אחרי שנוגה תבחר.
// כל אפשרות היא פתיח מלא באותו טקסט, עם תמונה אחרת ופריסה שמתאימה לה:
//   1. "במה": נוגה בבלייזר לבן על הבמה. התמונה בצד שמאל, נעלמת בהדרגה לכיוון הטקסט (כמו היום).
//   2. "אולם מלא": נוגה מגבה מול אולם מלא. תמונה על כל הרוחב, הטקסט מעל הקהל, על הצללה.
//   3. "בין הקהל": נוגה מדברת בין המשתתפים. חיתוך אלכסוני עם קו זהב, הטקסט על כחול נקי.
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { contact } from '../data/contact';
import stageBlazer from '../assets/hero/stage-blazer.jpg';
import stageAudience from '../assets/hero/stage-audience.jpg';
import amongAudience from '../assets/hero/among-audience.jpg';

const advances = ['פרויקטים', 'משימות', 'תהליכי עבודה', 'יעדים', 'צוותים', 'מהלכי צמיחה'];
---

<BaseLayout title="אפשרויות לפתיח" description="עמוד עבודה זמני">
  <div class="opt-label"><span>אפשרות 1</span> במה: התמונה בצד, נעלמת לכיוון הטקסט</div>
  <section class="hx hx--1">
    <div class="hx__media">
      <Image src={stageBlazer} alt="נוגה דיין אור מרצה על הבמה בכנס עסקים במקסימום" widths={[640, 1024, 1600, 2000]} sizes="(min-width: 52rem) 62vw, 100vw" loading="eager" />
    </div>
    <div class="container hx__inner">
      <div class="hx__text">
        <p class="hx__kicker">נוגה דיין אור · ייעוץ עסקי וארגוני</p>
        <h1 class="hx__title">העולם משתנה בקצב מסחרר{' '}<span class="hl">וזה הזמן של העסק שלך לגדול</span></h1>
        <p class="hx__lead">להגדיל הכנסות ולשפר רווחיות באמצעות אסטרטגיה, שיווק ושיפור תהליכי עבודה עם בינה מלאכותית.</p>
        <p class="hx__adv-label">מקדמים יחד:</p>
        <ul class="hx__adv">{advances.map((a) => <li>{a}</li>)}</ul>
        <div class="hx__actions">
          <a class="btn" href={contact.booking} target="_blank" rel="noopener">קביעת שיחת היכרות</a>
          <a class="btn btn--ghost" href="/services/">לשירותים</a>
        </div>
      </div>
    </div>
  </section>

  <div class="opt-label"><span>אפשרות 2</span> אולם מלא: תמונה על כל הרוחב, הטקסט מעל הקהל</div>
  <section class="hx hx--2">
    <div class="hx__media">
      <Image src={stageAudience} alt="נוגה דיין אור על הבמה מול אולם מלא" widths={[640, 1024, 1600, 2000]} sizes="100vw" loading="eager" />
    </div>
    <div class="container hx__inner">
      <div class="hx__text">
        <p class="hx__kicker">נוגה דיין אור · ייעוץ עסקי וארגוני</p>
        <h2 class="hx__title">העולם משתנה בקצב מסחרר{' '}<span class="hl">וזה הזמן של העסק שלך לגדול</span></h2>
        <p class="hx__lead">להגדיל הכנסות ולשפר רווחיות באמצעות אסטרטגיה, שיווק ושיפור תהליכי עבודה עם בינה מלאכותית.</p>
        <p class="hx__adv-label">מקדמים יחד:</p>
        <ul class="hx__adv">{advances.map((a) => <li>{a}</li>)}</ul>
        <div class="hx__actions">
          <a class="btn" href={contact.booking} target="_blank" rel="noopener">קביעת שיחת היכרות</a>
          <a class="btn btn--ghost" href="/services/">לשירותים</a>
        </div>
      </div>
    </div>
  </section>

  <div class="opt-label"><span>אפשרות 3</span> בין הקהל: חיתוך אלכסוני עם קו זהב</div>
  <section class="hx hx--3">
    <div class="hx__edge" aria-hidden="true"></div>
    <div class="hx__media">
      <Image src={amongAudience} alt="נוגה דיין אור מדברת בין המשתתפים בכנס" widths={[640, 1024, 1600, 2000]} sizes="(min-width: 52rem) 58vw, 100vw" loading="eager" />
    </div>
    <div class="container hx__inner">
      <div class="hx__text">
        <p class="hx__kicker">נוגה דיין אור · ייעוץ עסקי וארגוני</p>
        <h2 class="hx__title">העולם משתנה בקצב מסחרר{' '}<span class="hl">וזה הזמן של העסק שלך לגדול</span></h2>
        <p class="hx__lead">להגדיל הכנסות ולשפר רווחיות באמצעות אסטרטגיה, שיווק ושיפור תהליכי עבודה עם בינה מלאכותית.</p>
        <p class="hx__adv-label">מקדמים יחד:</p>
        <ul class="hx__adv">{advances.map((a) => <li>{a}</li>)}</ul>
        <div class="hx__actions">
          <a class="btn" href={contact.booking} target="_blank" rel="noopener">קביעת שיחת היכרות</a>
          <a class="btn btn--ghost" href="/services/">לשירותים</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .opt-label {
    padding: 1rem;
    background: var(--gold-gradient);
    color: var(--navy);
    font-weight: 800;
    text-align: center;
  }
  .opt-label span {
    display: inline-block;
    margin-inline-end: 0.5rem;
    padding: 0.1rem 0.7rem;
    border-radius: 999px;
    background: var(--navy);
    color: var(--gold-light);
  }

  /* ---------- משותף ---------- */
  .hx {
    position: relative;
    overflow: hidden;
    background: var(--navy-deep);
    color: var(--on-dark);
  }
  .hx__media {
    position: relative;
    height: min(66vw, 22rem);
  }
  .hx__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hx__inner {
    position: relative;
    padding-block: 0.5rem 2.5rem;
  }
  .hx__kicker {
    margin: 0 0 0.75rem;
    font-weight: 800;
    color: var(--gold-light);
  }
  .hx__title {
    margin: 0 0 1rem;
    color: var(--white);
    font-size: clamp(2rem, 5.2vw, 3.3rem);
    font-weight: 900;
    line-height: 1.15;
  }
  .hx__title .hl {
    display: block;
    text-shadow: none;
  }
  .hx__lead {
    max-width: 36rem;
    font-size: clamp(1.1rem, 2.2vw, 1.3rem);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }
  .hx__adv-label {
    margin: 0 0 0.5rem;
    font-weight: 800;
    color: var(--white);
  }
  .hx__adv {
    list-style: none;
    margin: 0 0 1.75rem;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .hx__adv li {
    margin: 0;
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
    border: 1px solid rgb(252 220 109 / 0.45);
    background: rgb(7 17 31 / 0.35);
    color: var(--gold-light);
    font-weight: 700;
    font-size: 0.95rem;
    text-shadow: none;
  }
  .hx__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .hx__edge {
    display: none;
  }
  .hx__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(7 17 31 / 0.1) 50%, var(--navy-deep) 100%);
  }

  /* ---------- 1. במה: נוגה בבלייזר. בטלפון החיתוך על הפנים ---------- */
  .hx--1 .hx__media :global(img) {
    object-position: 62% 28%;
  }

  /* ---------- 2. אולם מלא: בטלפון החיתוך על נוגה והקהל ---------- */
  .hx--2 .hx__media :global(img) {
    object-position: 35% 55%;
  }

  /* ---------- 3. בין הקהל ---------- */
  .hx--3 .hx__media :global(img) {
    object-position: 52% 58%;
  }

  @media (min-width: 52rem) {
    .hx {
      display: flex;
      align-items: center;
      min-height: clamp(32rem, 76vh, 42rem);
    }
    .hx__media {
      position: absolute;
      height: auto;
    }
    .hx__inner {
      padding-block: 3.5rem;
    }
    .hx__text {
      max-width: min(38rem, 52vw);
      text-shadow: 0 2px 18px rgb(7 17 31 / 0.65);
    }

    /* 1. התמונה בשמאל (62%), נעלמת לכיוון הטקסט. השקף מאחור מוחשך. */
    .hx--1 .hx__media {
      inset: 0 auto 0 0;
      width: 62%;
    }
    .hx--1 .hx__media :global(img) {
      object-position: 70% 30%;
    }
    .hx--1 .hx__media::after {
      background:
        linear-gradient(to left, var(--navy-deep) 0%, rgb(7 17 31 / 0.75) 14%, rgb(7 17 31 / 0) 40%),
        linear-gradient(to bottom, rgb(7 17 31 / 0.55) 0%, rgb(7 17 31 / 0) 35%),
        linear-gradient(0deg, rgb(7 17 31 / 0.6) 0%, rgb(7 17 31 / 0) 25%),
        linear-gradient(to right, rgb(7 17 31 / 0.45) 0%, rgb(7 17 31 / 0) 25%);
    }

    /* 2. על כל הרוחב. נוגה והבמה בשמאל, הטקסט בימין מעל הקהל, על הצללה כחולה. */
    .hx--2 .hx__media {
      inset: 0;
      width: 100%;
    }
    .hx--2 .hx__media :global(img) {
      object-position: center 55%;
    }
    .hx--2 .hx__media::after {
      background:
        linear-gradient(to left, rgb(7 17 31 / 0.92) 0%, rgb(7 17 31 / 0.78) 38%, rgb(7 17 31 / 0.15) 70%),
        linear-gradient(0deg, rgb(7 17 31 / 0.55) 0%, rgb(7 17 31 / 0) 30%);
    }

    /* 3. חיתוך אלכסוני: התמונה בשמאל (58%), עם קו זהב לאורך החיתוך. הטקסט על כחול נקי. */
    .hx--3 {
      background:
        radial-gradient(36rem 24rem at 100% 0, rgb(25 154 181 / 0.22), transparent 70%),
        var(--navy-deep);
    }
    .hx--3 .hx__media {
      inset: 0 auto 0 0;
      width: 58%;
      clip-path: polygon(0 0, calc(100% - 6px) 0, calc(82% - 6px) 100%, 0 100%);
    }
    .hx--3 .hx__media::after {
      background: linear-gradient(0deg, rgb(7 17 31 / 0.35) 0%, rgb(7 17 31 / 0) 30%);
    }
    /* קו הזהב לאורך החיתוך האלכסוני */
    .hx--3 .hx__edge {
      display: block;
      position: absolute;
      inset: 0 auto 0 0;
      width: 58%;
      background: var(--gold-gradient);
      clip-path: polygon(calc(100% - 6px) 0, 100% 0, 82% 100%, calc(82% - 6px) 100%);
    }
    .hx--3 .hx__text {
      text-shadow: none;
    }
  }
</style>
