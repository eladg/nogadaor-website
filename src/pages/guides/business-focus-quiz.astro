---
// שאלון מיקוד פיתוח עסקי, גרסה 7 (2026-11-12): כלי שיווקי של נוגה, שמסתכל על העסק מלמעלה ומחפש אפשרויות
// להגדלת הכנסות בלי להוציא עוד כסף על לידים. שאלה אחת בכל מסך, באפקט הקלדה, בלי תגית תחום, עם משפטי עידוד בדרך.
// 5 תשובות לכל שאלה (4 עד 0). הקוד עדיין תומך בשאלה עם כמה תשובות (multi), שלא בשימוש.
// התוצאה מבוססת על התשובות עצמן (נוגה, 2026-11-12): ציון ורמה, "העצות שכדאי להתחיל מהן" (3 התשובות החלשות,
// כל אחת עם מה שענו, מה זה אומר, עצה להתחלה, מה אפשר לעשות עם נוגה וקישורים למדריכים, הדרכות והרצאות),
// פס לכל תחום, עוד עצות לכל תחום חלש, ו"מה כבר עובד" (התחומים החזקים והתשובות החזקות).
// התשובות נשמרות רק בדפדפן של המבקר (localStorage) ולא נשלחות לשום מקום.
// השאלות והטקסטים ב-src/data/quiz.ts (טיוטה לאישור נוגה).
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Star from '../../components/Star.astro';
import { quizAreas, quizQuestions, quizLevels, quizYear, quizCheers, quizStrongFrom, quizPoints, quizServices, quizResources, quizProfile, quizSessionLink } from '../../data/quiz';
import type { QuizLink } from '../../data/quiz';
import { contact } from '../../data/contact';
import ContentCover from '../../components/ContentCover.astro';
import type { CoverMotif } from '../../components/ContentCover.astro';

import { getCollection } from 'astro:content';
// מדריכים: מדריך פתוח מקבל קישור. מדריך "בקרוב" מוצג כקובייה בלי קישור, עם התג "בקרוב" (נוגה, 2026-11-13).
// מדריך שלא קיים בכלל באתר לא מוצג. קישורים אחרים (הדרכות, הרצאות, שירותים) תמיד מוצגים
const allGuides = await getCollection('guides');
const openGuides = new Set(allGuides.filter((g) => !g.data.comingSoon).map((g) => `/guides/${g.id}/`));
const soonGuides = new Set(allGuides.filter((g) => g.data.comingSoon).map((g) => `/guides/${g.id}/`));
const isGuidePage = (href: string) => /^\/guides\/[^#/]+\/$/.test(href);
const liveLink = (link?: { href: string; label: string }) => !!link && (!isGuidePage(link.href) || openGuides.has(link.href));
// הכריכה המקורית של כל מדריך, מאמר, הרצאה והדרכה (public/images/covers), לקוביות הצבעוניות בסוף התוצאה
// (נוגה, 2026-11-13). לשירותים אין כריכה, והם מקבלים אריח צבעוני עם אייקון
import fs from 'node:fs';
import path from 'node:path';
const coverFile = (name: string) =>
  fs.existsSync(path.join(process.cwd(), 'public/images/covers', `${name}.jpg`)) ? `/images/covers/${name}.jpg` : null;
const coverFor = (href: string) => {
  const lec = href.match(/^\/guides\/#lecture-(.+)$/);
  if (lec) return coverFile(`lecture-${lec[1]}`);
  const guide = href.match(/^\/guides\/([^#/]+)\/$/);
  if (guide) return coverFile(`guide-${guide[1]}`) ?? coverFile(`article-${guide[1]}`);
  const tr = href.match(/^\/trainings\/([^/]+)\/$/);
  if (tr) return coverFile(`training-${tr[1]}`);
  return null;
};
const asCube = (l: QuizLink) => ({ ...l, soon: soonGuides.has(l.href), img: coverFor(l.href) });
// לכל קובייה תמונה (נוגה, 2026-11-13: "צריך שלהכל יהיה תמונות"). למי שאין קובץ כריכה (שירותים, ומדריך חדש שעוד לא יוצא)
// מציירים את הכריכה באותו סגנון של כל הכריכות באתר. מדריך: הכותרת והחפץ מה-frontmatter שלו. שירות: הכותרת והחפץ כאן.
const serviceCovers: Record<string, { title: string; motif: CoverMotif }> = {
  '/services/business-consulting/': { title: 'אסטרטגיה|*ושיווק*', motif: 'target' },
  '/services/financial/': { title: 'ליווי|*פיננסי*', motif: 'growth' },
  '/services/ai-automation/': { title: 'ייעול תהליכים|*עם AI*', motif: 'ai' },
  '/services/organizational-consulting/': { title: 'ייעוץ|*ארגוני*', motif: 'compass' },
  '/services/consulting-session/': { title: 'פגישת|*ייעוץ*', motif: 'chat' },
  '/services/consulting-session/#digital': { title: 'נוכחות שיווקית|*בדיגיטל*', motif: 'screen' },
};
const drawnCovers = new Map<string, { title: string; motif: CoverMotif; star?: 'start' | 'end' | false }>();
for (const [href, c] of Object.entries(serviceCovers)) drawnCovers.set(href, c);
for (const g of allGuides) {
  const href = `/guides/${g.id}/`;
  if (!coverFor(href) && g.data.coverMotif) drawnCovers.set(href, { title: g.data.coverTitle ?? g.data.title, motif: g.data.coverMotif as CoverMotif, star: g.data.coverStar });
}
// המסך הראשון הוא שאלת הפתיחה ("מי עובד בעסק?"): נספרת במספור, לא בציון.
// בשאלה שיש לה נוסח לעסק עם עובדים (team.text או team.options) מוצגים שני נוסחים, ו-JavaScript מציג את המתאים
const screens = [
  { profile: true, multi: false, options: quizProfile.options, variants: [{ v: null, text: quizProfile.text, options: quizProfile.options }] },
  ...quizQuestions.map((q) => ({
    profile: false,
    multi: !!q.multi,
    options: q.options,
    variants:
      q.team && (q.team.text || q.team.options)
        ? [
            { v: 'solo', text: q.text, options: q.options },
            { v: 'team', text: q.team.text ?? q.text, options: q.team.options ?? q.options },
          ]
        : [{ v: null, text: q.text, options: q.options }],
  })),
];
const total = screens.length;
const resLinks = (keys?: (keyof typeof quizResources)[]) =>
  (keys ?? []).map((k) => quizResources[k] as QuizLink).filter((l) => liveLink(l) || soonGuides.has(l.href)).map(asCube);
// חלק מנתוני שאלה (team / byAnswer): השירות והקישורים הופכים לקישורים מלאים
const resolveParts = (part: { service?: keyof typeof quizServices; res?: (keyof typeof quizResources)[] } & Record<string, unknown>) => ({
  ...part,
  ...(part.service ? { service: asCube(quizServices[part.service]) } : {}),
  ...(part.res ? { res: resLinks(part.res) } : {}),
});
const cheers = quizCheers(total);
const MAX = 4; // הניקוד המרבי לשאלה
const config = {
  areas: quizAreas.map((a) => ({ id: a.id, title: a.title, count: quizQuestions.filter((q) => q.area === a.id).length })),
  max: MAX,
  points: quizPoints,
  strongFrom: quizStrongFrom,
  teamFrom: quizProfile.teamFrom,
  // הקוביות בסוף התוצאה כשלא עלו נושאים לשיפור
  generalRes: [...resLinks(['vidGrow', 'vidStrategy', 'guideAi']), asCube(quizServices.strategy)],
  // מקום 0 הוא שאלת הפתיחה. בשאלה עם נוסח לעסק עם עובדים, team מחזיק רק את מה שמשתנה
  questions: [
    { profile: true, options: quizProfile.options },
    ...quizQuestions.map((q) => ({
      area: q.area,
      multi: !!q.multi,
      options: q.options,
      topic: q.topic,
      insight: q.insight,
      impact: q.impact,
      service: asCube(quizServices[q.service]),
      res: resLinks(q.res),
      team: q.team ? resolveParts(q.team) : null,
      // עצה אחרת לתשובה מסוימת. המפתח: מקום התשובה ברשימה (0 = הראשונה)
      byAnswer: q.byAnswer
        ? Object.fromEntries(Object.entries(q.byAnswer).map(([k, part]) => [k, resolveParts(part)]))
        : null,
    })),
  ],
  levels: quizLevels,
  icons: Object.fromEntries(quizAreas.map((a) => [a.id, a.icon])),
  whatsapp: contact.whatsapp,
};
// תמונת אווירה בפתיח (2026-11-07, קו רציף בכל האתר)
import { atmoStyle } from '../../utils/atmo';
import darkLinesQz from '../../assets/atmosphere/dark-lines.webp';
const linesStyle = await atmoStyle(darkLinesQz, 0.5);
---

<BaseLayout
  title={`שאלון מיקוד פיתוח עסקי לשנת ${quizYear}`}
  description="איפה מסתתר הכסף הבא של העסק? שאלון אבחון שמסתכל על העסק מלמעלה ונותן תמונת מצב, עצות להתחלה לפי התשובות, ומה כבר עובד ושווה לחזק."
>
  <header class="qz-hero atmo" style={linesStyle}>
    <div class="container qz-hero__inner">
      <p class="qz-crumbs"><a href="/">בית</a> <span aria-hidden="true">/</span> שאלון</p>
      <h1>שאלון מיקוד פיתוח עסקי לשנת <span class="hl">{quizYear}</span></h1>
      {/* טיוטה לאישור נוגה. נוגה (2026-11-12): יותר התלהבות, בלי מספר השאלות, מה יוצא מזה ולמה כדאי */}
      <p class="qz-hero__lead">
        הכסף הבא של העסק לא תמיד מחכה בעוד לידים. הרבה פעמים הוא כבר כאן, בלקוחות שקנו פעם, בפניות שלא נסגרו ובשעות שהולכות על עבודה ידנית. השאלון מסתכל על העסק מלמעלה, ומראה בדיוק איפה זה מסתתר אצלך.
      </p>
      <p class="qz-get__title">מה מקבלים בסוף</p>
      <ul class="qz-get">
        <li><Icon name="chart" size={18} /> תמונת מצב של העסק בארבעה תחומים</li>
        <li><Icon name="bulb" size={18} /> העצות שכדאי להתחיל מהן, לפי התשובות שלך</li>
        <li><Icon name="rocket" size={18} /> מה כבר עובד אצלך, ושווה לחזק</li>
      </ul>
      <ul class="qz-meta">
        <li><Icon name="clock" size={16} /> כ-7 דקות</li>
        <li><Icon name="heart" size={16} /> התוצאה נפתחת מיד בסוף</li>
      </ul>
    </div>
  </header>

  {/* הרקע של השאלון, "גאות" (2026-11-13): לבן פנינה עם ברק שעובר עליו, ומים בתכלת שעולים מלמטה ככל שעונים.
      --prog (0 עד 1) נקבע ב-JavaScript לפי מספר התשובות. בתוצאה הרקע כולו תכלת */}
  <section class="section qz-body" data-stage>
    <div class="qz-tide" aria-hidden="true">
      <span class="qz-tide__glow"></span>
      <span class="qz-tide__water">
        <span class="qz-tide__wave qz-tide__wave--back"></span>
        <span class="qz-tide__wave qz-tide__wave--front"></span>
      </span>
      <span class="qz-tide__sheen"></span>
      <span class="qz-tide__bubbles"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>
    </div>
    <div class="container qz-wrap">
      <form id="quiz" class="qz" novalidate>
        <!-- פס התקדמות (מוצג רק עם JavaScript) -->
        <div class="qz-progress" data-progress hidden>
          <div class="qz-progress__track"><span class="qz-progress__fill" data-fill></span></div>
        </div>

        <ol class="qz-list">
          {
            screens.map((q, i) => {
              const cheer = cheers[i];
              return (
                <li class={`qz-q qz-q--c${i % 3}`} data-q={i}>
                  <fieldset>
                    {/* מספר השאלה: תג קטן וצבעוני שקופץ בכל החלפת מסך (נוגה, 2026-11-11) */}
                    <span class="qz-num" dir="ltr" aria-hidden="true">
                      <b>{String(i + 1).padStart(2, '0')}</b>
                      <small>/{total}</small>
                    </span>
                    {/* בלי תגית תחום מעל השאלה, כדי לא לגלות את התחום (נוגה, 2026-11-12). במקומה, בכמה נקודות בדרך, משפט עידוד */}
                    {cheer && (
                      <p class="qz-cheer">
                        <Icon name="star" size={16} /> {cheer}
                      </p>
                    )}
                    <legend>
                      <span class="sr-only">שאלה {i + 1} מתוך {total}.</span>
                      {/* השאלה מופיעה באפקט הקלדה. העותק השקוף שומר את הגובה, כדי שהתשובות לא יקפצו.
                          בשאלה עם נוסח לעסק עם עובדים יש שני נוסחים, ומוצג רק המתאים לשאלת הפתיחה */}
                      {q.variants.map((vr) => (
                        <span class="qz-q__text" data-variant={vr.v ?? undefined} hidden={vr.v === 'team'}>
                          <span class="qz-ghost" aria-hidden="true">{vr.text}</span>
                          <span class="qz-type" aria-hidden="true" data-text={vr.text}>{vr.text}</span>
                          <span class="sr-only">{vr.text}</span>
                        </span>
                      ))}
                    </legend>
                    {q.multi && <p class="qz-hint">אפשר לסמן כמה תשובות</p>}
                    <div class="qz-opts">
                      {q.profile && q.options.map((opt, k) => (
                        <label class="qz-opt" style={`--k:${k}`}>
                          <input type="radio" name={`q${i}`} value={k} />
                          <span class="qz-opt__mark" aria-hidden="true" />
                          <span class="qz-opt__text">{opt}</span>
                        </label>
                      ))}
                      {!q.profile && !q.multi && q.variants.map((vr) => vr.options.map((opt, k) => (
                        <label class="qz-opt" style={`--k:${k}`} data-variant={vr.v ?? undefined} hidden={vr.v === 'team'}>
                          <input type="radio" name={`q${i}`} value={vr.options.length - 1 - k} />
                          <span class="qz-opt__mark" aria-hidden="true" />
                          <span class="qz-opt__text">{opt}</span>
                        </label>
                      )))}
                      {!q.profile && q.multi && q.options.map((opt, k) =>
                        q.multi ? (
                          <label class="qz-opt qz-opt--multi" style={`--k:${k}`}>
                            <input
                              type="checkbox"
                              name={`q${i}`}
                              value={k}
                              data-none={k === q.options.length - 1 ? '' : undefined}
                            />
                            <span class="qz-opt__mark" aria-hidden="true" />
                            <span class="qz-opt__text">{opt}</span>
                          </label>
                        ) : (
                          <label class="qz-opt" style={`--k:${k}`}>
                            <input type="radio" name={`q${i}`} value={q.options.length - 1 - k} />
                            <span class="qz-opt__mark" aria-hidden="true" />
                            <span class="qz-opt__text">{opt}</span>
                          </label>
                        )
                      )}
                    </div>
                  </fieldset>
                </li>
              );
            })
          }
        </ol>

        <div class="qz-nav" data-nav hidden>
          <button type="button" class="qz-nav__back" data-back>
            <span aria-hidden="true">→</span> הקודמת
          </button>
          <button type="button" class="qz-nav__next" data-next>
            הבאה <span aria-hidden="true">←</span>
          </button>
        </div>
        <noscript><p class="qz-note">כדי לראות את התוצאה צריך לאפשר JavaScript בדפדפן.</p></noscript>
      </form>

      <!-- התוצאה -->
      {/* שער התוצאה (נוגה, 2026-11-13): כדי לפתוח את התוצאה משאירים שם ומייל. הטלפון לא חובה.
          התשובות נשמרות בגיליון של נוגה כבר כשמסיימים את השאלות (בלי פרטים), והפרטים נוספים לאותה שורה.
          אם השמירה נכשלת, התוצאה נפתחת בכל זאת, כדי לא להעניש את מי שמילא */}
      <div class="qz-gate" data-gate hidden tabindex="-1">
        <span class="qz-gate__icon" aria-hidden="true"><Icon name="chart" size={30} /></span>
        <h2 class="qz-gate__title">התוצאה שלך <span class="hl">מוכנה</span></h2>
        <p class="qz-gate__text">כדי לפתוח אותה, נשאר רק להשאיר שם ומייל.</p>
        <form class="qz-gate__form" data-gate-form novalidate>
          <label>
            <span class="qz-gate__label">שם</span>
            <input type="text" name="name" autocomplete="name" maxlength="100" required />
          </label>
          <label>
            <span class="qz-gate__label">אימייל</span>
            <input type="email" name="email" autocomplete="email" maxlength="200" dir="ltr" required />
          </label>
          <label>
            <span class="qz-gate__label">טלפון <small>(לא חובה)</small></span>
            <input type="tel" name="phone" autocomplete="tel" maxlength="30" dir="ltr" />
          </label>
          {/* TODO: נוסח ההסכמה לדיוור ונוסח היידוע לבדוק עם איש מקצוע, ולכתוב את מדיניות הפרטיות לפני פרסום */}
          <label class="qz-gate__check">
            <input type="checkbox" name="marketing" />
            <span>אני מאשר/ת לקבל תכנים ועדכונים במייל</span>
          </label>
          <div class="qz-hp" aria-hidden="true">
            <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
          </div>
          <p class="qz-gate__legal">
            הפרטים נשמרים אצל נוגה דיין אור, לחזרה בנושא השאלון. <a href="/privacy/">למדיניות הפרטיות</a>
          </p>
          <p class="qz-gate__error" data-gate-error role="alert" hidden></p>
          <button class="btn qz-gate__btn" type="submit" data-gate-btn>לפתיחת התוצאה</button>
        </form>
      </div>
      {/* התוצאה, עיצוב 2026-11-13 (נוגה): קודם הגרף, אחריו "מה שווה לשמור" (בולטים עם הכוכב, בלי מה שענו),
          אחריו "מה לשפר" לפי תחומים עם 2 עצות בכל תחום, ובסוף קוביות צבעוניות עם הכריכות של המדריכים וההרצאות */}
      <div class="qz-result" data-result hidden tabindex="-1">
        {/* 1. הגרף: הציון הכללי, פס לכל תחום, וסקלה עם משמעות */}
        <section class="qz-chart" aria-labelledby="qz-chart-title">
          <div class="qz-chart__head">
            <div class="qz-chart__score" dir="ltr"><span data-percent>0</span><small>%</small></div>
            <div>
              <h2 class="qz-chart__title no-grad" id="qz-chart-title" data-level-title></h2>
              <p class="qz-chart__text" data-level-text></p>
            </div>
          </div>
          {/* המקרא מעל הפסים, וצבע כל פס הוא הצבע שלו במקרא (נוגה, 2026-11-13) */}
          <ul class="qz-scale" aria-label="משמעות הסקלה">
            {[...quizLevels].reverse().map((l, k) => (
              <li class={`qz-scale__z qz-scale__z--${k}`}>
                <b dir="ltr">{k === 0 ? '0-40' : k === 1 ? '40-70' : '70-100'}</b> {l.title}
              </li>
            ))}
          </ul>
          <ul class="qz-bars" data-bars>
            {
              quizAreas.map((a, i) => (
                <li class="qz-bar" data-bar={a.id} style={`--i:${i}`}>
                  <span class="qz-bar__label">
                    <Icon name={a.icon as 'target'} size={17} /> {a.title}
                  </span>
                  <span class="qz-bar__track">
                    <span class="qz-bar__fill" />
                  </span>
                  <span class="qz-bar__pct" dir="ltr" />
                  <span class="qz-bar__level" />
                </li>
              ))
            }
          </ul>
        </section>

        {/* 2. מה שווה לשמור: פסקה אחת שמחברת את כל הנקודות החזקות, מחמיאה ומעודדת (נוגה, 2026-11-13) */}
        <section class="qz-keep" data-keep-block>
          <h3 class="qz-h3 no-grad"><Star size={22} /> מה שווה לשמור</h3>
          <p class="qz-keep__text" data-wins></p>
        </section>

        {/* 3. מה לשפר: לכל תחום מתחת ל-70, מהחלש לחזק, שתי עצות מתוך השאלות */}
        <section class="qz-improve" data-grow-block>
          <h3 class="qz-h3 no-grad">מה כדאי לשפר</h3>
          <div class="qz-areas" data-groups></div>
        </section>

        {/* 4. שיחת היכרות ללא עלות, לפני כל החומרים מהאתר (נוגה, 2026-11-13) */}
        <section class="qz-talk" aria-labelledby="qz-talk-title">
          <div>
            <h3 class="qz-talk__title no-grad" id="qz-talk-title">בואו נדבר</h3>
            <p class="qz-talk__text">מגיעה לך שיחת היכרות ללא עלות, כדי לעבור יחד על התוצאות ולבחור מאיפה מתחילים.</p>
          </div>
          <a class="btn qz-talk__btn" data-wa href={contact.whatsapp} target="_blank" rel="noopener">
            <Icon name="whatsapp" size={20} /> לשיחת היכרות<span class="sr-only"> (נפתח בלשונית חדשה)</span>
          </a>
        </section>

        {/* 5. להעמקה: כריכות המדריכים, ההרצאות וההדרכות לפי הנושאים שעלו, והשירות המתאים */}
        <div data-res-block hidden>
          <ul class="qz-cubes" data-res></ul>
        </div>

        <div class="qz-actions">
          {/* שיתוף המשוב (נוגה, 2026-11-13): בטלפון תפריט השיתוף של המכשיר, ובמחשב וואטסאפ, או העתקה כשאין וואטסאפ */}
          <button type="button" class="btn qz-actions__share" data-share>
            <Icon name="share" size={18} /> לשיתוף התוצאה
          </button>
          <span class="qz-actions__copied" data-copied role="status" hidden>הקישור הועתק</span>
          <a class="qz-actions__session" href={quizSessionLink.href}>{quizSessionLink.label} <Icon name="arrow" size={16} /></a>
          <button type="button" class="qz-actions__again" data-again>למילוי מחדש</button>
        </div>

        {/* תבניות שה-JavaScript משכפל: הכוכב, ואייקון לכל תחום ולאריח שירות */}
        <template data-tpl-star><Star size={24} /></template>
        {quizAreas.map((a) => <template data-tpl-icon={a.id}><Icon name={a.icon as 'target'} size={20} /></template>)}
        <template data-tpl-icon="service"><Icon name="rocket" size={30} /></template>
        <template data-tpl-icon="guide"><Icon name="list" size={30} /></template>
        {[...drawnCovers].map(([href, c]) => (
          <template data-cover={href}><ContentCover title={c.title} motif={c.motif} star={c.star} kind="guide" fit /></template>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline define:vars={{ config }}>
  (function () {
    var KEY = 'focus-quiz-2027-v10'; // שאלת פתיחה + 32 שאלות (שינוי בשאלות = מפתח חדש)
    var form = document.getElementById('quiz');
    var qs = Array.prototype.slice.call(form.querySelectorAll('.qz-q'));
    var progress = document.querySelector('[data-progress]');
    var fill = document.querySelector('[data-fill]');
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var typing = null; // { el, timer } של ההקלדה שרצה עכשיו
    var nav = document.querySelector('[data-nav]');
    var back = document.querySelector('[data-back]');
    var next = document.querySelector('[data-next]');
    var result = document.querySelector('[data-result]');
    var stage = document.querySelector('[data-stage]');
    // הפתיח של השאלון מיותר כשכבר בתוצאה (נוגה, 2026-11-13). הוא מוסתר בשער ובתוצאה, וחוזר במילוי מחדש
    var hero = document.querySelector('.qz-hero');
    var titles = {};
    config.areas.forEach(function (a) { titles[a.id] = a.title; });
    var idx = 0;
    // שאלת הפתיחה (מסך 0): מהתשובה config.teamFrom והלאה העסק מקבל את הנוסח לעסק עם עובדים
    function isTeam() {
      var c = qs[0].querySelector('input:checked');
      return !!c && Number(c.value) >= config.teamFrom;
    }
    // נתוני השאלה לפי הנוסח המתאים (team מחזיק רק את מה שמשתנה)
    function Q(i) {
      var q = config.questions[i];
      return q.team && isTeam() ? Object.assign({}, q, q.team) : q;
    }
    // נתוני העצה לתשובה שנבחרה: לתשובה עם עצה משלה (byAnswer) מחליפים רק את מה שמוגדר בה
    function QA(i, val) {
      var q = Q(i);
      var part = q.byAnswer && q.byAnswer[q.options.length - 1 - val];
      return part ? Object.assign({}, q, part) : q;
    }
    function variantHidden(n) {
      var box = n.closest('[data-variant]');
      return !!box && box.hidden;
    }
    // מציג בכל שאלה רק את הנוסח המתאים. תשובה שסומנה בנוסח שהוסתר עוברת לאותה תשובה בנוסח המוצג
    function applyVariant() {
      var want = isTeam() ? 'team' : 'solo';
      form.querySelectorAll('[data-variant]').forEach(function (n) { n.hidden = n.getAttribute('data-variant') !== want; });
      qs.forEach(function (q) {
        var c = q.querySelector('input:checked');
        if (!c || !variantHidden(c)) return;
        q.querySelectorAll('input[value="' + c.value + '"]').forEach(function (x) { if (!variantHidden(x)) x.checked = true; });
      });
    }

    // הניקוד של כל שאלה (null אם עוד לא נענתה).
    // שאלה עם כמה תשובות: מספר הדרכים שסומנו, עד הניקוד המרבי. "אף אחת" לבד = 0.
    function values() {
      return qs.map(function (q, i) {
        var checked = q.querySelectorAll('input:checked');
        if (!checked.length) return null;
        if (!config.questions[i].multi) return Number(checked[0].value);
        var n = 0;
        checked.forEach(function (c) { if (!c.hasAttribute('data-none')) n += 1; });
        return Math.min(n, config.max);
      });
    }
    // לשמירה: בשאלה רגילה הניקוד, ובשאלה עם כמה תשובות רשימת התשובות שסומנו
    function save() {
      var data = qs.map(function (q, i) {
        if (!config.questions[i].multi) {
          var c = q.querySelector('input:checked');
          return c ? Number(c.value) : null;
        }
        var list = [];
        q.querySelectorAll('input:checked').forEach(function (c) { list.push(Number(c.value)); });
        return list.length ? list : null;
      });
      try { localStorage.setItem(KEY, JSON.stringify(data)); } catch (e) {}
    }
    // אפקט הקלדה לשאלה. משך כולל של כשנייה, בלי קשר לאורך השאלה
    function stopTyping() {
      if (!typing) return;
      clearInterval(typing.timer);
      typing.el.textContent = typing.el.dataset.text;
      typing.el.classList.remove('is-typing');
      typing = null;
    }
    function typeIn(li) {
      stopTyping();
      var el = Array.prototype.filter.call(li.querySelectorAll('.qz-type'), function (n) { return !variantHidden(n); })[0];
      var full = el.dataset.text;
      if (reduce) { el.textContent = full; return 0; }
      var step = Math.max(10, Math.min(28, 1000 / full.length));
      var n = 0;
      el.textContent = '';
      el.classList.add('is-typing');
      typing = { el: el, timer: setInterval(function () {
        n += 1;
        el.textContent = full.slice(0, n);
        if (n >= full.length) stopTyping();
      }, step) };
      return full.length * step;
    }
    // כניסה של מסך חדש: הכרטיס נכנס מהצד, המספר קופץ, השאלה מוקלדת והתשובות עולות אחריה
    function enter(li, forward) {
      li.classList.remove('is-in', 'is-fwd', 'is-back');
      void li.offsetWidth; // מאפס את האנימציה
      var dur = typeIn(li);
      li.style.setProperty('--base', Math.round(dur * 0.55) + 'ms');
      li.classList.add('is-in', forward ? 'is-fwd' : 'is-back');
    }
    function show(i) {
      var prev = idx;
      idx = Math.max(0, Math.min(qs.length - 1, i));
      qs.forEach(function (q, k) { q.hidden = k !== idx; });
      if (prev !== idx || !qs[idx].classList.contains('is-in')) enter(qs[idx], idx >= prev);
      var v = values();
      var answered = v.filter(function (x) { return x !== null; }).length;
      fill.style.width = (answered / qs.length) * 100 + '%';
      // הרקע מתמלא בתכלת ככל שעונים
      stage.style.setProperty('--prog', (answered / qs.length).toFixed(3));
      back.disabled = idx === 0;
      next.disabled = v[idx] === null;
      next.innerHTML = idx === qs.length - 1 ? 'לתוצאה <span aria-hidden="true">←</span>' : 'הבאה <span aria-hidden="true">←</span>';
    }
    // שם תחום במירכאות, כי בשמות יש ו' החיבור ("נראות ואמון")
    function quoted(t) { return '"' + t + '"'; }
    function list(names) {
      if (names.length < 2) return names.join('');
      return names.slice(0, -1).join(', ') + ' ו' + names[names.length - 1];
    }
    // בונה אלמנט עם טקסט (בלי HTML, כדי שהטקסטים יוצגו כמו שהם)
    function el(tag, cls, text) {
      var n = document.createElement(tag);
      if (cls) n.className = cls;
      if (text) n.textContent = text;
      return n;
    }
    function linkEl(l, cls) {
      var a = el('a', cls, l.label + ' ');
      a.href = l.href;
      a.appendChild(el('span', null, '←')).setAttribute('aria-hidden', 'true');
      return a;
    }
    // מה שנבחר בשאלה (הניקוד 4 הוא התשובה הראשונה)
    function said(i, val) {
      var q = Q(i);
      return q.options[q.options.length - 1 - val];
    }
    // משכפל תבנית (הכוכב, אייקון של תחום)
    function tpl(sel) {
      var t = document.querySelector(sel);
      return t ? t.content.firstElementChild.cloneNode(true) : document.createTextNode('');
    }
    // הרמה לפי האחוז (הסקלה של נוגה: עד 40, 40-70, מעל 70)
    function levelOf(p) {
      return config.levels.find(function (l) { return p >= l.min; });
    }
    function levelIdx(p) { return p >= 70 ? 2 : p >= 40 ? 1 : 0; }
    // קובייה: הכריכה המקורית (או אריח צבעוני לשירות), סוג התוכן ושם. מדריך "בקרוב" בלי קישור
    function cube(r) {
      var hasCover = r.img || document.querySelector('template[data-cover="' + r.href + '"]');
      var li = el('li', 'qz-cube' + (r.soon ? ' qz-cube--soon' : '') + (hasCover ? '' : ' qz-cube--tile'));
      var box = el(r.soon ? 'div' : 'a', 'qz-cube__in');
      if (!r.soon) box.href = r.href;
      var media = el('span', 'qz-cube__media');
      var drawn = !r.img && document.querySelector('template[data-cover="' + r.href + '"]');
      if (drawn) {
        media.appendChild(drawn.content.firstElementChild.cloneNode(true));
      } else if (r.img) {
        var img = document.createElement('img');
        img.src = r.img;
        img.alt = '';
        img.loading = 'lazy';
        media.appendChild(img);
      } else {
        // מדריך בלי קובץ כריכה (עוד לא יוצא) מקבל אייקון רשימה, ושירות אייקון רקטה
        media.appendChild(tpl('[data-tpl-icon="' + (r.type === 'מדריך' || r.type === 'מאמר' ? 'guide' : 'service') + '"]'));
      }
      if (r.soon) media.appendChild(el('span', 'qz-cube__soon', 'בקרוב'));
      box.appendChild(media);
      var body = el('span', 'qz-cube__body');
      body.appendChild(el('span', 'qz-cube__type', r.type || ''));
      body.appendChild(el('span', 'qz-cube__title', r.label));
      box.appendChild(body);
      li.appendChild(box);
      return li;
    }
    // תחילת הטקסט, לעצות הקצרות: שני משפטים, או משפט אחד אם הוא כבר ארוך (המשפט הראשון לבד לא תמיד ברור)
    function firstSentence(t) {
      var parts = t.match(/[^.?!]+[.?!]+(\s|$)/g) || [t];
      var out = parts[0].trim();
      if (out.length < 75 && parts[1] && out.length + parts[1].length <= 160) out += ' ' + parts[1].trim();
      return out;
    }
    var targets = []; // הפסים והמספרים שמונפשים כשהתוצאה נפתחת
    var shareText = '';
    // שיתוף: תפריט השיתוף של המכשיר, ואם אין, וואטסאפ. אם גם זה נחסם, מעתיקים את הטקסט והקישור
    document.querySelector('[data-share]').addEventListener('click', function () {
      var url = location.origin + location.pathname;
      if (navigator.share) {
        navigator.share({ title: document.title, text: shareText, url: url }).catch(function () {});
        return;
      }
      var w = window.open('https://wa.me/?text=' + encodeURIComponent(shareText + ' ' + url), '_blank', 'noopener');
      if (!w && navigator.clipboard) {
        navigator.clipboard.writeText(shareText + ' ' + url).then(function () {
          var c = document.querySelector('[data-copied]');
          c.hidden = false;
          setTimeout(function () { c.hidden = true; }, 2500);
        });
      }
    });
    function finish() {
      var v = values();
      var sums = {};
      config.areas.forEach(function (a) { sums[a.id] = 0; });
      // כל תשובה שווה אחוז (config.points), ואחוז התחום הוא הממוצע
      // שאלת הפתיחה (config.questions[0].profile) לא נספרת בציון, ולכן מדלגים עליה בכל החישובים
      v.forEach(function (val, i) { if (!config.questions[i].profile) sums[config.questions[i].area] += config.points[val || 0]; });
      var pct = {};
      config.areas.forEach(function (a) { pct[a.id] = Math.round(sums[a.id] / a.count); });
      // הציון הכללי: ממוצע של אחוזי התחומים, כך שכל תחום שוקל אותו דבר, בלי קשר למספר השאלות בו
      var overall = Math.round(config.areas.reduce(function (s, a) { return s + pct[a.id]; }, 0) / config.areas.length);

      var level = levelOf(overall);
      document.querySelector('[data-level-title]').textContent = level.title;
      document.querySelector('[data-level-text]').textContent = level.text;
      targets = [{ num: document.querySelector('[data-percent]'), to: overall }];

      // הגרף: כל הפסים באותו צבע, ומתחת לכל פס המשמעות שלו בסקלה
      config.areas.forEach(function (a) {
        var bar = document.querySelector('[data-bar="' + a.id + '"]');
        bar.querySelector('.qz-bar__level').textContent = levelOf(pct[a.id]).title;
        bar.setAttribute('data-z', levelIdx(pct[a.id]));
        targets.push({ fill: bar.querySelector('.qz-bar__fill'), num: bar.querySelector('.qz-bar__pct'), to: pct[a.id], pct: true });
      });

      // התשובות החלשות (2 ומטה), מהחלשה לחזקה, ובתיקו לפי הקרבה לכסף (impact)
      var finds = [];
      v.forEach(function (val, i) {
        if (!config.questions[i].profile && val !== null && val <= 2) finds.push({ i: i, v: val, area: config.questions[i].area, impact: config.questions[i].impact });
      });
      finds.sort(function (a, b) { return a.v - b.v || b.impact - a.impact || a.i - b.i; });

      // מה שווה לשמור: הנושאים שהתשובה בהם חזקה (שתי הדרגות העליונות), עד 6, עם הכוכב. בלי מה שענו (נוגה)
      var wins = [];
      v.forEach(function (val, i) { if (!config.questions[i].profile && val !== null && val >= 3) wins.push({ i: i, v: val, impact: config.questions[i].impact }); });
      wins.sort(function (a, b) { return b.v - a.v || b.impact - a.impact || a.i - b.i; });
      // פסקה אחת שמחברת את הנקודות החזקות, מחמיאה ומעודדת (נוגה, 2026-11-13). טיוטה לאישור
      var winsBox = document.querySelector('[data-wins]');
      var winNames = wins.slice(0, 6).map(function (w) { return Q(w.i).topic; });
      winsBox.textContent = !winNames.length ? '' :
        'כל הכבוד על ' + list(winNames) + '. ' +
        (winNames.length > 1 ? 'אלה דברים שכבר עובדים אצלך' : 'זה כבר עובד אצלך') +
        ', וזה ממש לא מובן מאליו. זה מראה על עסק שנבנה בהתמדה, בהחלטות נכונות ובעבודה עקבית. ' +
        'כדאי לשמור על מה שכבר עובד ולהמשיך לחזק אותו, כי משם הכי קל לצמוח.';
      document.querySelector('[data-keep-block]').hidden = !winNames.length;

      // מה לשפר: כל תחום מתחת ל-70, מהחלש לחזק, ובו 2 העצות החלשות מהשאלות של התחום (נושא + משפט אחד)
      var order = config.areas.map(function (a, i) { return { id: a.id, p: pct[a.id], i: i }; })
        .sort(function (a, b) { return a.p - b.p || a.i - b.i; });
      var groupsBox = document.querySelector('[data-groups]');
      groupsBox.textContent = '';
      var picked = [];
      order.forEach(function (o) {
        if (o.p >= config.strongFrom) return;
        var mine = finds.filter(function (f) { return f.area === o.id; }).slice(0, 2);
        if (!mine.length) return;
        var art = el('article', 'qz-area');
        art.setAttribute('data-z', levelIdx(o.p));
        // שם התחום מחוץ לריבוע, והעצות לרוחב (נוגה, 2026-11-13)
        var head = el('header', 'qz-area__head');
        var ic = el('span', 'qz-area__icon');
        ic.appendChild(tpl('[data-tpl-icon="' + o.id + '"]'));
        head.appendChild(ic);
        head.appendChild(el('h4', 'qz-area__title', titles[o.id]));
        head.appendChild(el('span', 'qz-area__pct', o.p + '%'));
        art.appendChild(head);
        var ul = el('ul', 'qz-area__tips');
        mine.forEach(function (f) {
          var q = QA(f.i, f.v);
          var item = el('li');
          item.appendChild(el('strong', null, q.topic));
          item.appendChild(el('span', null, firstSentence(q.insight)));
          ul.appendChild(item);
          picked.push(f);
        });
        art.appendChild(ul);
        groupsBox.appendChild(art);
      });
      document.querySelector('[data-grow-block]').hidden = !groupsBox.children.length;

      // הקוביות בסוף: לפי הנושאים שעלו (מהחלש לחזק). עד 6 תכנים (מדריכים, מאמרים, הרצאות, הדרכות) ועד 2 שירותים,
      // בלי כפילויות. אם לא עלו נושאים לשיפור, רשימה כללית
      var seen = {};
      var content = [];
      var services = [];
      finds.forEach(function (f) {
        var q = QA(f.i, f.v);
        (q.res || []).forEach(function (r) {
          if (!seen[r.href] && content.length < 6) { seen[r.href] = true; content.push(r); }
        });
        if (q.service && !seen[q.service.href] && services.length < 2) { seen[q.service.href] = true; services.push(q.service); }
      });
      var cubes = content.concat(services);
      if (!cubes.length) cubes = config.generalRes;
      var resBox = document.querySelector('[data-res]');
      resBox.textContent = '';
      cubes.forEach(function (r) { resBox.appendChild(cube(r)); });
      document.querySelector('[data-res-block]').hidden = !cubes.length;

      var top = picked.slice(0, 3);
      var topNames = top.map(function (f) { return QA(f.i, f.v).topic; });
      var who = v[0] !== null ? ' (מי עובד בעסק: ' + config.questions[0].options[v[0]] + ')' : '';
      var text = 'היי נוגה, מילאתי את שאלון המיקוד העסקי' + who + '. ' +
        (topNames.length ? 'מה שיצא לי לשפר: ' + list(topNames) + '. ' : '') + 'אשמח לשיחה';
      document.querySelectorAll('[data-wa]').forEach(function (a) { a.href = config.whatsapp + '?text=' + encodeURIComponent(text); });
      shareText = 'מילאתי את שאלון המיקוד העסקי של נוגה דיין אור, ויצא לי ' + overall + '% (' + level.title + '). ' +
        'שווה לבדוק גם את העסק שלך';

      // השורה לגיליון של נוגה: מי עובד בעסק, הציונים, והתשובה (בטקסט) לכל שאלה לפי שם הנושא
      var row = { 'מי עובד בעסק': v[0] !== null ? config.questions[0].options[v[0]] : '', 'ציון כללי': overall };
      config.areas.forEach(function (a) { row['ציון ' + a.title] = pct[a.id]; });
      v.forEach(function (val, i) { if (!config.questions[i].profile) row[Q(i).topic] = said(i, val); });
      lastRow = row;
      var id = runId();
      if (sentId() !== id) {
        completeSent = send({ type: 'complete', id: id, answers: row });
        try { localStorage.setItem(KEY + '-sent', id); } catch (e) {}
      }
      if (isOpen()) reveal();
      else showGate();
    }

    // ---------- שמירה בגיליון ושער התוצאה ----------
    var gate = document.querySelector('[data-gate]');
    var gateForm = document.querySelector('[data-gate-form]');
    var gateBtn = document.querySelector('[data-gate-btn]');
    var gateErr = document.querySelector('[data-gate-error]');
    var lastRow = {};
    var completeSent = Promise.resolve();
    function store(k, val) { try { if (val === null) localStorage.removeItem(KEY + k); else localStorage.setItem(KEY + k, val); } catch (e) {} }
    function read(k) { try { return localStorage.getItem(KEY + k); } catch (e) { return null; } }
    // מזהה למילוי הזה, כדי שהפרטים ייכתבו באותה שורה בגיליון
    function runId() {
      var id = read('-id');
      if (!id) {
        id = 'q' + Date.now().toString(36) + Math.random().toString(36).slice(2, 10);
        store('-id', id);
      }
      return id;
    }
    function sentId() { return read('-sent'); }
    function isOpen() { return read('-open') === '1'; } // כבר השאירו פרטים במכשיר הזה
    // שליחה לפונקציה בשרת (/api/quiz). כל כישלון נבלע: התשובות לא נשמרות, אבל השאלון ממשיך לעבוד
    function send(body) {
      return fetch('/api/quiz', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
        keepalive: true,
      }).then(function (r) { return r.ok; }, function () { return false; });
    }
    function showGate() {
      if (hero) hero.hidden = true;
      form.hidden = true;
      result.hidden = true;
      gate.hidden = false;
      gateErr.hidden = true;
      gateBtn.disabled = false;
      gateBtn.textContent = 'לפתיחת התוצאה';
      gate.focus({ preventScroll: true });
      gate.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    function reveal() {
      if (hero) hero.hidden = true;
      form.hidden = true;
      gate.hidden = true;
      result.hidden = false;
      stage.style.setProperty('--prog', 1);
      stage.classList.add('is-done');
      result.focus({ preventScroll: true });
      result.scrollIntoView({ behavior: 'smooth', block: 'start' });
      animateChart();
    }
    // הפסים נמתחים בזה אחר זה והמספרים רצים איתם
    function animateChart() {
      targets.forEach(function (t) {
        if (t.fill) t.fill.style.width = '0%';
        if (t.num) t.num.textContent = t.pct ? '0%' : '0';
      });
      var start = null;
      var dur = reduce ? 1 : 1400;
      requestAnimationFrame(function () {
        targets.forEach(function (t) { if (t.fill) t.fill.style.width = t.to + '%'; });
        requestAnimationFrame(function tick(now) {
          if (start === null) start = now;
          var k = Math.min(1, (now - start) / dur);
          var e = 1 - Math.pow(1 - k, 3);
          targets.forEach(function (t) {
            if (t.num) t.num.textContent = Math.round(t.to * e) + (t.pct ? '%' : '');
          });
          if (k < 1) requestAnimationFrame(tick);
        });
      });
    }
    function gateError(msg, field) {
      gateErr.textContent = msg;
      gateErr.hidden = false;
      if (field) field.focus();
    }
    gateForm.addEventListener('submit', function (e) {
      e.preventDefault();
      var f = function (n) { return gateForm.querySelector('[name="' + n + '"]'); };
      var name = f('name').value.trim();
      var email = f('email').value.trim();
      if (!name) return gateError('נשאר למלא שם', f('name'));
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return gateError('כתובת המייל לא נראית תקינה', f('email'));
      gateErr.hidden = true;
      gateBtn.disabled = true;
      gateBtn.textContent = 'פותחים את התוצאה...';
      var done = false;
      var open = function () {
        if (done) return;
        done = true;
        store('-open', '1');
        reveal();
      };
      // קודם מחכים שהשורה "הושלם" תישמר, כדי שהפרטים ייכתבו באותה שורה
      completeSent.then(function () {
        return send({
          type: 'lead',
          id: runId(),
          name: name,
          email: email,
          phone: f('phone').value.trim(),
          marketing: f('marketing').checked,
          website: f('website').value,
          answers: lastRow,
        });
      }).then(open, open);
      setTimeout(open, 8000); // לא משאירים אף אחד מחכה
    });

    // מצב "שאלה אחת בכל מסך" (רק עם JavaScript)
    form.classList.add('is-wizard');
    progress.hidden = false;
    nav.hidden = false;

    // שחזור תשובות קודמות
    try {
      var saved = JSON.parse(localStorage.getItem(KEY) || 'null');
      if (Array.isArray(saved)) {
        saved.forEach(function (val, i) {
          if (val === null || !qs[i]) return;
          (Array.isArray(val) ? val : [val]).forEach(function (x) {
            var inp = qs[i].querySelector('input[value="' + x + '"]');
            if (inp) inp.checked = true;
          });
        });
      }
    } catch (e) {}
    applyVariant();
    var firstOpen = values().indexOf(null);
    show(firstOpen === -1 ? qs.length - 1 : firstOpen);

    form.addEventListener('change', function (e) {
      var t = e.target;
      if (t.type === 'checkbox') {
        // "אף אחת" מבטלת את השאר, וסימון של דרך כלשהי מבטל את "אף אחת"
        var q = t.closest('.qz-q');
        if (t.checked && t.hasAttribute('data-none')) {
          q.querySelectorAll('input:not([data-none])').forEach(function (c) { c.checked = false; });
        } else if (t.checked) {
          var none = q.querySelector('[data-none]');
          if (none) none.checked = false;
        }
        save();
        show(idx);
        return; // בשאלה עם כמה תשובות ממשיכים בכפתור "הבאה"
      }
      if (t.name === 'q0') applyVariant(); // שאלת הפתיחה קובעת את הנוסח של השאר
      save();
      show(idx);
      // מעבר אוטומטי לשאלה הבאה אחרי בחירה
      setTimeout(function () {
        if (idx < qs.length - 1) {
          show(idx + 1);
          var first = qs[idx].querySelector('input:checked') || qs[idx].querySelector('input');
          if (first) first.focus({ preventScroll: true });
        }
      }, 320);
    });
    back.addEventListener('click', function () { show(idx - 1); });
    next.addEventListener('click', function () {
      var open = values().indexOf(null);
      if (idx === qs.length - 1) {
        if (open === -1) finish();
        else show(open);
      } else show(idx + 1);
    });
    document.querySelector('[data-again]').addEventListener('click', function () {
      form.reset();
      applyVariant();
      try { localStorage.removeItem(KEY); } catch (e) {}
      store('-id', null); // מילוי חדש = שורה חדשה בגיליון. מי שכבר השאיר פרטים לא נשאל שוב
      store('-sent', null);
      result.hidden = true;
      gate.hidden = true;
      form.hidden = false;
      if (hero) hero.hidden = false;
      stage.classList.remove('is-done');
      show(0);
      form.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  })();
</script>

