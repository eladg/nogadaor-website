  }
  /* הברק: פס אור שעובר באלכסון על כל הרקע */
  .qz-tide__sheen {
    position: absolute;
    inset: -20% -60%;
    background: linear-gradient(115deg, transparent 42%, rgb(255 255 255 / 0.75) 50%, transparent 58%);
    mix-blend-mode: soft-light;
    animation: qz-sheen 7s ease-in-out infinite;
  }
  @keyframes qz-sheen {
