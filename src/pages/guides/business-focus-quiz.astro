    border: 1px solid rgb(255 255 255 / 0.6);
    opacity: calc(0.25 + var(--prog) * 0.6);
    animation: qz-bubble var(--d, 11s) ease-in infinite;
    animation-delay: var(--w, 0s);
  }
  .qz-tide__bubbles i:nth-child(1) { left: 8%; --s: 0.5rem; --d: 10s; }
  .qz-tide__bubbles i:nth-child(2) { left: 22%; --s: 0.9rem; --d: 13s; --w: -4s; }
