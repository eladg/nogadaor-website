---
// שאלון מיקוד פיתוח עסקי, גרסה 5 (2026-11-12): כלי שיווקי של נוגה, שמסתכל על העסק מלמעלה ומחפש אפשרויות
// להגדלת הכנסות בלי להוציא עוד כסף על לידים. שאלה אחת בכל מסך, באפקט הקלדה.
// בשאלה רגילה 5 תשובות (4 עד 0 נקודות). בשאלה עם כמה תשובות (multi) הניקוד הוא מספר הדרכים שסומנו, עד 4.
// התוצאה: ציון ורמה, פס לכל תחום, "אפשרויות להגדלת הכנסות" (טקסט grow לכל תשובה חלשה, לפי תחומים, מהחלש לחזק)
// ו"מה כבר עובד ושווה לשמור" (טקסט keep לכל תשובה חזקה), כל אחד עם משפט מסכם לפי התשובות.
// התשובות נשמרות רק בדפדפן של המבקר (localStorage) ולא נשלחות לשום מקום.
// השאלות והטקסטים ב-src/data/quiz.ts (טיוטה לאישור נוגה).
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { quizAreas, quizQuestions, quizLevels, quizYear } from '../../data/quiz';
import { contact } from '../../data/contact';

const total = quizQuestions.length;
const areaById = Object.fromEntries(quizAreas.map((a) => [a.id, a]));
const MAX = 4; // הניקוד המרבי לשאלה
const config = {
  areas: quizAreas.map((a) => ({ id: a.id, title: a.title, count: quizQuestions.filter((q) => q.area === a.id).length })),
  max: MAX,
  questions: quizQuestions.map((q) => ({ area: q.area, multi: !!q.multi })),
  levels: quizLevels,
  whatsapp: contact.whatsapp,
};
// תמונת אווירה בפתיח (2026-11-07, קו רציף בכל האתר)
import { atmoStyle } from '../../utils/atmo';
import darkLinesQz from '../../assets/atmosphere/dark-lines.webp';
const linesStyle = await atmoStyle(darkLinesQz, 0.5);
---

<BaseLayout
  title={`שאלון מיקוד פיתוח עסקי לשנת ${quizYear}`}
  description={`שאלון אבחון עסקי של ${total} שאלות שמסתכלות על העסק מלמעלה, באסטרטגיה, בהצעות ובמחירים, בנראות, בשיווק, במכירות, בניהול ובכספים. בסוף מקבלים תמונת מצב ואפשרויות להגדלת הכנסות מתוך מה שכבר קיים בעסק.`}
>
  <header class="qz-hero atmo" style={linesStyle}>
    <div class="container qz-hero__inner">
      <p class="qz-crumbs"><a href="/">בית</a> <span aria-hidden="true">/</span> שאלון</p>
      <h1>שאלון מיקוד פיתוח עסקי לשנת <span class="hl">{quizYear}</span></h1>
      {/* טיוטה לאישור נוגה */}
      <p class="qz-hero__lead">
        {total} שאלות קצרות שמסתכלות על העסק מלמעלה. בכל שאלה בוחרים את התשובה שהכי מתארת את המצב היום. בסוף מקבלים תמונת מצב של העסק ואפשרויות להגדלת הכנסות מתוך מה שכבר קיים בו, בלי להוציא עוד כסף על לידים.
      </p>
      <ul class="qz-meta">
        <li><Icon name="clock" size={16} /> כ-7 דקות</li>
        <li><Icon name="layers" size={16} /> {quizAreas.length} תחומים</li>
        <li><Icon name="heart" size={16} /> התשובות נשמרות רק במכשיר שלך</li>
      </ul>
    </div>
  </header>

  <section class="section qz-body">
    <div class="container qz-wrap">
      <form id="quiz" class="qz" novalidate>
        <!-- פס התקדמות (מוצג רק עם JavaScript) -->
        <div class="qz-progress" data-progress hidden>
          <div class="qz-progress__track"><span class="qz-progress__fill" data-fill></span></div>
        </div>

        <ol class="qz-list">
          {
            quizQuestions.map((q, i) => {
              const area = areaById[q.area];
              return (
                <li class={`qz-q qz-q--c${i % 3}`} data-q={i}>
                  <fieldset>
                    {/* מספר השאלה: תג קטן וצבעוני שקופץ בכל החלפת מסך (נוגה, 2026-11-11) */}
                    <span class="qz-num" dir="ltr" aria-hidden="true">
                      <b>{String(i + 1).padStart(2, '0')}</b>
                      <small>/{total}</small>
                    </span>
                    <legend>
                      <span class="sr-only">שאלה {i + 1} מתוך {total}.</span>
                      <span class="qz-q__area">
                        <Icon name={area.icon as 'target'} size={16} /> {area.title}
                      </span>
                      {/* השאלה מופיעה באפקט הקלדה. העותק השקוף שומר את הגובה, כדי שהתשובות לא יקפצו */}
                      <span class="qz-q__text">
                        <span class="qz-ghost" aria-hidden="true">{q.text}</span>
                        <span class="qz-type" aria-hidden="true" data-text={q.text}>{q.text}</span>
                        <span class="sr-only">{q.text}</span>
                      </span>
                    </legend>
                    {q.multi && <p class="qz-hint">אפשר לסמן כמה תשובות</p>}
                    <div class="qz-opts">
                      {q.options.map((opt, k) =>
                        q.multi ? (
                          <label class="qz-opt qz-opt--multi" style={`--k:${k}`}>
                            <input
                              type="checkbox"
                              name={`q${i}`}
                              value={k}
                              data-none={k === q.options.length - 1 ? '' : undefined}
                            />
                            <span class="qz-opt__mark" aria-hidden="true" />
                            <span class="qz-opt__text">{opt}</span>
                          </label>
                        ) : (
                          <label class="qz-opt" style={`--k:${k}`}>
                            <input type="radio" name={`q${i}`} value={q.options.length - 1 - k} />
                            <span class="qz-opt__mark" aria-hidden="true" />
                            <span class="qz-opt__text">{opt}</span>
                          </label>
                        )
                      )}
                    </div>
                  </fieldset>
                </li>
              );
            })
          }
        </ol>

        <div class="qz-nav" data-nav hidden>
          <button type="button" class="qz-nav__back" data-back>
            <span aria-hidden="true">→</span> הקודמת
          </button>
          <button type="button" class="qz-nav__next" data-next>
            הבאה <span aria-hidden="true">←</span>
          </button>
        </div>
        <noscript><p class="qz-note">כדי לראות את התוצאה צריך לאפשר JavaScript בדפדפן.</p></noscript>
      </form>

      <!-- התוצאה -->
      <div class="qz-result" data-result hidden tabindex="-1">
        <div class="qz-score">
          <div class="qz-score__ring" data-ring>
            <span class="qz-score__num" dir="ltr"><span data-percent>0</span>%</span>
          </div>
          <div>
            <h2 class="qz-score__title" data-level-title></h2>
            <p class="qz-score__text" data-level-text></p>
          </div>
        </div>

        <h3 class="qz-h3">איך נראה העסק בכל תחום</h3>
        <ul class="qz-bars" data-bars>
          {
            quizAreas.map((a) => (
              <li class="qz-bar" data-bar={a.id}>
                <span class="qz-bar__label">
                  <Icon name={a.icon as 'target'} size={18} /> {a.title}
                </span>
                <span class="qz-bar__track">
                  <span class="qz-bar__fill" />
                </span>
                <span class="qz-bar__pct" />
              </li>
            ))
          }
        </ul>

        {/* אפשרויות להגדלת הכנסות: לכל תשובה חלשה טקסט grow, לפי תחומים מהחלש לחזק (נוגה, 2026-11-11) */}
        <h3 class="qz-h3">אפשרויות להגדלת הכנסות בעסק שלך</h3>
        <p class="qz-sum" data-grow-sum></p>
        <div class="qz-groups" data-groups>
          {
            quizAreas.map((a) => (
              <article class="qz-group" data-group={a.id} hidden>
                <h4 class="qz-group__title">
                  <span class="qz-group__icon">
                    <Icon name={a.icon as 'target'} size={20} />
                  </span>
                  {a.title} <span class="qz-group__pct" />
                </h4>
                <ul class="qz-group__list">
                  {quizQuestions.map((q, i) =>
                    q.area === a.id ? (
                      <li data-grow={i} hidden>
                        {q.grow}
                        {q.link && (
                          <a class="qz-group__qlink" href={q.link.href}>
                            {q.link.label} <Icon name="arrow" size={14} />
                          </a>
                        )}
                      </li>
                    ) : null
                  )}
                </ul>
                {a.link && (
                  <a class="qz-group__link" href={a.link.href}>
                    {a.link.label} <Icon name="arrow" size={16} />
                  </a>
                )}
              </article>
            ))
          }
        </div>
        <button type="button" class="qz-more" data-more hidden></button>

        {/* מה כבר עובד: לכל תשובה חזקה טקסט keep */}
        <h3 class="qz-h3">מה כבר עובד ושווה לשמור</h3>
        <p class="qz-sum" data-keep-sum></p>
        <ul class="qz-keep" data-keep>
          {quizQuestions.map((q, i) => (
            <li data-keep-item={i} hidden>
              <Icon name="check" size={18} />
              <span>{q.keep}</span>
            </li>
          ))}
        </ul>

        <div class="qz-actions">
          <a class="btn qz-actions__wa" data-wa href={contact.whatsapp} target="_blank" rel="noopener">
            <Icon name="whatsapp" size={20} /> לשיחה על האפשרויות שיצאו לי<span class="sr-only"> (נפתח בלשונית חדשה)</span>
          </a>
          <button type="button" class="qz-actions__again" data-again>למילוי מחדש</button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline define:vars={{ config }}>
  (function () {
    var KEY = 'focus-quiz-2027-v5'; // גרסה 5: שאלות חדשות, ושאלה עם כמה תשובות
    var form = document.getElementById('quiz');
    var qs = Array.prototype.slice.call(form.querySelectorAll('.qz-q'));
    var progress = document.querySelector('[data-progress]');
    var fill = document.querySelector('[data-fill]');
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var typing = null; // { el, timer } של ההקלדה שרצה עכשיו
    var nav = document.querySelector('[data-nav]');
    var back = document.querySelector('[data-back]');
    var next = document.querySelector('[data-next]');
    var result = document.querySelector('[data-result]');
    var titles = {};
    config.areas.forEach(function (a) { titles[a.id] = a.title; });
    var idx = 0;

    // הניקוד של כל שאלה (null אם עוד לא נענתה).
    // שאלה עם כמה תשובות: מספר הדרכים שסומנו, עד הניקוד המרבי. "אף אחת" לבד = 0.
    function values() {
      return qs.map(function (q, i) {
        var checked = q.querySelectorAll('input:checked');
        if (!checked.length) return null;
        if (!config.questions[i].multi) return Number(checked[0].value);
        var n = 0;
        checked.forEach(function (c) { if (!c.hasAttribute('data-none')) n += 1; });
        return Math.min(n, config.max);
      });
    }
    // לשמירה: בשאלה רגילה הניקוד, ובשאלה עם כמה תשובות רשימת התשובות שסומנו
    function save() {
      var data = qs.map(function (q, i) {
        if (!config.questions[i].multi) {
          var c = q.querySelector('input:checked');
          return c ? Number(c.value) : null;
        }
        var list = [];
        q.querySelectorAll('input:checked').forEach(function (c) { list.push(Number(c.value)); });
        return list.length ? list : null;
      });
      try { localStorage.setItem(KEY, JSON.stringify(data)); } catch (e) {}
    }
    // אפקט הקלדה לשאלה. משך כולל של כשנייה, בלי קשר לאורך השאלה
    function stopTyping() {
      if (!typing) return;
      clearInterval(typing.timer);
      typing.el.textContent = typing.el.dataset.text;
      typing.el.classList.remove('is-typing');
      typing = null;
    }
    function typeIn(li) {
      stopTyping();
      var el = li.querySelector('.qz-type');
      var full = el.dataset.text;
      if (reduce) { el.textContent = full; return 0; }
      var step = Math.max(10, Math.min(28, 1000 / full.length));
      var n = 0;
      el.textContent = '';
      el.classList.add('is-typing');
      typing = { el: el, timer: setInterval(function () {
        n += 1;
        el.textContent = full.slice(0, n);
        if (n >= full.length) stopTyping();
      }, step) };
      return full.length * step;
    }
    // כניסה של מסך חדש: הכרטיס נכנס מהצד, המספר קופץ, השאלה מוקלדת והתשובות עולות אחריה
    function enter(li, forward) {
      li.classList.remove('is-in', 'is-fwd', 'is-back');
      void li.offsetWidth; // מאפס את האנימציה
      var dur = typeIn(li);
      li.style.setProperty('--base', Math.round(dur * 0.55) + 'ms');
      li.classList.add('is-in', forward ? 'is-fwd' : 'is-back');
    }
    function show(i) {
      var prev = idx;
      idx = Math.max(0, Math.min(qs.length - 1, i));
      qs.forEach(function (q, k) { q.hidden = k !== idx; });
      if (prev !== idx || !qs[idx].classList.contains('is-in')) enter(qs[idx], idx >= prev);
      var v = values();
      var answered = v.filter(function (x) { return x !== null; }).length;
      fill.style.width = (answered / qs.length) * 100 + '%';
      back.disabled = idx === 0;
      next.disabled = v[idx] === null;
      next.innerHTML = idx === qs.length - 1 ? 'לתוצאה <span aria-hidden="true">←</span>' : 'הבאה <span aria-hidden="true">←</span>';
    }
    // שם תחום במירכאות, כי בשמות יש ו' החיבור ("נראות ואמון")
    function quoted(t) { return '"' + t + '"'; }
    function list(names) {
      if (names.length < 2) return names.join('');
      return names.slice(0, -1).join(', ') + ' ו' + names[names.length - 1];
    }
    function finish() {
      var v = values();
      var sums = {}, max = {};
      config.areas.forEach(function (a) { sums[a.id] = 0; max[a.id] = a.count * config.max; });
      v.forEach(function (val, i) { sums[config.questions[i].area] += val || 0; });
      var pct = {};
      config.areas.forEach(function (a) { pct[a.id] = Math.round((sums[a.id] / max[a.id]) * 100); });
      // הציון הכללי: ממוצע של אחוזי התחומים, כך שכל תחום שוקל אותו דבר, בלי קשר למספר השאלות בו
      var overall = Math.round(config.areas.reduce(function (s, a) { return s + pct[a.id]; }, 0) / config.areas.length);

      document.querySelector('[data-percent]').textContent = overall;
      document.querySelector('[data-ring]').style.setProperty('--p', overall);
      var level = config.levels.find(function (l) { return overall >= l.min; });
      document.querySelector('[data-level-title]').textContent = level.title;
      document.querySelector('[data-level-text]').textContent = level.text;

      // התחומים מהחלש לחזק (בתיקו: לפי סדר התחומים)
      var order = config.areas.map(function (a, i) { return { id: a.id, p: pct[a.id], i: i }; })
        .sort(function (a, b) { return a.p - b.p || a.i - b.i; });

      // אפשרויות להגדלת הכנסות: תשובה של 2 נקודות ומטה
      var groupsBox = document.querySelector('[data-groups]');
      var growAreas = [];
      var growCount = 0;
      order.forEach(function (o) {
        var group = groupsBox.querySelector('[data-group="' + o.id + '"]');
        var items = [];
        group.querySelectorAll('[data-grow]').forEach(function (li) {
          var val = v[Number(li.dataset.grow)];
          li.hidden = val > 2;
          if (!li.hidden) items.push({ li: li, val: val });
        });
        // בתוך התחום: מהתשובה החלשה לחזקה
        items.sort(function (a, b) { return a.val - b.val; }).forEach(function (it) { it.li.parentNode.appendChild(it.li); });
        group.hidden = !items.length;
        group.classList.remove('is-extra');
        group.querySelector('.qz-group__pct').textContent = '(' + o.p + '%)';
        groupsBox.appendChild(group);
        if (items.length) { growAreas.push(o.id); growCount += items.length; }
      });
      // שלושת התחומים הראשונים גלויים, והשאר מאחורי כפתור
      var more = document.querySelector('[data-more]');
      var extra = growAreas.slice(3);
      extra.forEach(function (id) { groupsBox.querySelector('[data-group="' + id + '"]').classList.add('is-extra'); });
      groupsBox.classList.toggle('is-collapsed', extra.length > 0);
      more.hidden = !extra.length;
      if (extra.length) more.textContent = 'לעוד אפשרויות ב-' + extra.length + (extra.length === 1 ? ' תחום נוסף' : ' תחומים נוספים');

      config.areas.forEach(function (a) {
        var bar = document.querySelector('[data-bar="' + a.id + '"]');
        bar.querySelector('.qz-bar__fill').style.width = pct[a.id] + '%';
        bar.querySelector('.qz-bar__pct').textContent = pct[a.id] + '%';
        bar.classList.toggle('is-focus', growAreas.slice(0, 3).indexOf(a.id) !== -1);
      });

      var top = growAreas.slice(0, 2).map(function (id) { return quoted(titles[id]); });
      document.querySelector('[data-grow-sum]').textContent = growCount
        ? 'נמצאו ' + (growCount === 1 ? 'אפשרות אחת' : growCount + ' אפשרויות') +
          ' להגדלת הכנסות, כולן מתוך מה שכבר קיים בעסק ובלי להוציא עוד כסף על לידים. הכי הרבה פוטנציאל נמצא ב' +
          (top.length === 2 ? 'תחומים ' + top[0] + ' ו' + top[1] : 'תחום ' + top[0]) + '.'
        : 'לא נמצאו פערים משמעותיים. העסק עובד טוב בכל התחומים שנבדקו, וההמשך הוא לדייק ולהאיץ.';

      // מה כבר עובד: תשובה של 3-4 נקודות, מהחזקה לחלשה, עד 6
      var keepBox = document.querySelector('[data-keep]');
      var keeps = [];
      keepBox.querySelectorAll('[data-keep-item]').forEach(function (li) {
        var val = v[Number(li.dataset.keepItem)];
        li.hidden = true;
        if (val >= 3) keeps.push({ li: li, val: val });
      });
      keeps.sort(function (a, b) { return b.val - a.val; });
      keeps.slice(0, 6).forEach(function (k) { k.li.hidden = false; keepBox.appendChild(k.li); });
      var strongest = order[order.length - 1];
      document.querySelector('[data-keep-sum]').textContent = keeps.length
        ? (keeps.length === 1 ? 'דבר אחד כבר עובד טוב בעסק' : keeps.length + ' דברים כבר עובדים טוב בעסק') +
          ', והתחום החזק ביותר הוא ' + quoted(titles[strongest.id]) + '. כדאי להישען עליהם, כי את מה שכבר עובד חזק אפשר להגביר.' +
          (keeps.length > 6 ? ' אלה החזקים שבהם.' : '')
        : 'עוד לא נמצאו תחומים חזקים במיוחד. זה בדיוק המקום להתחיל בו, צעד אחרי צעד.';

      var focusNames = growAreas.slice(0, 3).map(function (id) { return quoted(titles[id]); });
      var text = 'היי נוגה, מילאתי את שאלון המיקוד העסקי. ' +
        (focusNames.length ? 'הכי הרבה פוטנציאל יצא לי ב' + list(focusNames) + '. ' : '') + 'אשמח לשיחה';
      document.querySelector('[data-wa]').href = config.whatsapp + '?text=' + encodeURIComponent(text);

      form.hidden = true;
      result.hidden = false;
      result.focus({ preventScroll: true });
      result.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    // מצב "שאלה אחת בכל מסך" (רק עם JavaScript)
    form.classList.add('is-wizard');
    progress.hidden = false;
    nav.hidden = false;

    // שחזור תשובות קודמות
    try {
      var saved = JSON.parse(localStorage.getItem(KEY) || 'null');
      if (Array.isArray(saved)) {
        saved.forEach(function (val, i) {
          if (val === null || !qs[i]) return;
          (Array.isArray(val) ? val : [val]).forEach(function (x) {
            var inp = qs[i].querySelector('input[value="' + x + '"]');
            if (inp) inp.checked = true;
          });
        });
      }
    } catch (e) {}
    var firstOpen = values().indexOf(null);
    show(firstOpen === -1 ? qs.length - 1 : firstOpen);

    form.addEventListener('change', function (e) {
      var t = e.target;
      if (t.type === 'checkbox') {
        // "אף אחת" מבטלת את השאר, וסימון של דרך כלשהי מבטל את "אף אחת"
        var q = t.closest('.qz-q');
        if (t.checked && t.hasAttribute('data-none')) {
          q.querySelectorAll('input:not([data-none])').forEach(function (c) { c.checked = false; });
        } else if (t.checked) {
          var none = q.querySelector('[data-none]');
          if (none) none.checked = false;
        }
        save();
        show(idx);
        return; // בשאלה עם כמה תשובות ממשיכים בכפתור "הבאה"
      }
      save();
      show(idx);
      // מעבר אוטומטי לשאלה הבאה אחרי בחירה
      setTimeout(function () {
        if (idx < qs.length - 1) {
          show(idx + 1);
          var first = qs[idx].querySelector('input:checked') || qs[idx].querySelector('input');
          if (first) first.focus({ preventScroll: true });
        }
      }, 320);
    });
    back.addEventListener('click', function () { show(idx - 1); });
    next.addEventListener('click', function () {
      var open = values().indexOf(null);
      if (idx === qs.length - 1) {
        if (open === -1) finish();
        else show(open);
      } else show(idx + 1);
    });
    document.querySelector('[data-more]').addEventListener('click', function () {
      document.querySelector('[data-groups]').classList.remove('is-collapsed');
      this.hidden = true;
    });
    document.querySelector('[data-again]').addEventListener('click', function () {
      form.reset();
      try { localStorage.removeItem(KEY); } catch (e) {}
      result.hidden = true;
      form.hidden = false;
      show(0);
      form.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  })();
</script>

