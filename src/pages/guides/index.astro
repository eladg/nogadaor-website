---
// עמוד מרכז "מדריכים והרצאות": חלק 1 מדריכים ומאמרים יחד, חלק 2 הדרכות מהיוטיוב (נוגה, 2026-11-07).
// כרגע הכל פתוח לצפייה (בלי הורדה ובלי איסוף אימייל).
// עיצוב (נוגה, 2026-11-06): כריכות בסגנון "חפץ זכוכית זוהר" (src/components/ContentCover.astro), בלי לוגו ובלי מספור.
// לכל סוג תוכן פריסה משלו באותה שפה: מדריכים בפריסה מדורגת (האמצעי נמוך יותר, מושך לגלול), שאלון בכרטיס רחב,
// הרצאות בפס כהה, ומאמרים ברשימה עם כריכה בצד. מתחת לכל כריכה: סוג התוכן וזמן הקריאה. הכרטיסים מופיעים בהדרגה בגלילה.
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import CtaBand from '../../components/CtaBand.astro';
import YouTubeEmbed from '../../components/YouTubeEmbed.astro';
import ContentCover from '../../components/ContentCover.astro';
import Icon from '../../components/Icon.astro';
import ShareBar from '../../components/ShareBar.astro';
import { readingMinutes } from '../../utils/readingTime';

const all = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
// קודם המדריכים ואחריהם המאמרים, כל קבוצה לפי order
const items = [...all.filter((g) => g.data.type === 'guide'), ...all.filter((g) => g.data.type === 'article')];
---

<BaseLayout
  title="מדריכים והרצאות"
  description="מדריכים, מאמרים והדרכות לצפייה בחינם לבעלי עסקים, מאת נוגה דיין אור."
>
  <PageHeader title="מדריכים והרצאות">
    <!-- TODO: משפט פתיחה קצר לעמוד – נוגה תספק -->
    <p class="placeholder">תוכן חסר: משפט פתיחה קצר.</p>
  </PageHeader>

  <!-- חלק 1: מדריכים ומאמרים יחד (נוגה, 2026-11-07: "שהמאמר לא יהיה לבד"). קודם המדריכים, אחריהם המאמרים.
       לכל כרטיס סוג משלו מתחת לכריכה (מדריך = רשימה, מאמר = ספר פתוח). -->
  <section class="section">
    <div class="container">
      <h2>מדריכים ומאמרים</h2>
      <p class="intro">הכול פתוח לקריאה כאן באתר.</p>
      <!-- הוחלט (2026-11-05): בשלב ראשון הכל פתוח, בלי איסוף אימיילים. לא לבנות שער אימייל עד שנוגה תבקש. -->
      <!-- TODO (נוגה, 2026-11-07): מדריכים חדשים שנוגה רוצה, עוד אין להם תוכן: הקמת עסק, תודעה עסקית מנצחת, מציאת בידול. -->
      <ul class="shelf">
        {
          items.map((g, i) => {
            const isArticle = g.data.type === 'article';
            return (
              <li class="item reveal" style={`transition-delay: ${(i % 3) * 0.12}s`}>
                <a class="item__cover" href={`/guides/${g.id}/`} tabindex="-1" aria-hidden="true">
                  <ContentCover title={g.data.coverTitle ?? g.data.title} motif={g.data.coverMotif} star={g.data.coverStar} kind={g.data.type} />
                </a>
                <p class="meta">
                  <Icon name={isArticle ? 'book-open' : 'list'} size={16} /> <span>{isArticle ? 'מאמר' : 'מדריך'}</span> · {readingMinutes(g.body)} דק' קריאה
                </p>
                <h3 class="item__title">
                  <a href={`/guides/${g.id}/`}>{g.data.title}</a>
                </h3>
                {g.data.tagline && <p class="item__sub">{g.data.tagline}</p>}
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <!-- חלק 2: הדרכות מהיוטיוב, לצפייה בחינם. פס כהה. הכריכה שלנו מוצגת במקום התמונה של יוטיוב, והסרטון נטען רק בלחיצה.
       השאלון עבר לעמוד הבית (נוגה, 2026-11-07). -->
  <section class="section section--dark lectures">
    <div class="container">
      <h2>הדרכות לצפייה <span class="hl">בחינם</span></h2>
      <!-- TODO: נוגה תביא עוד הדרכות מהערוץ (2026-11-07). כרגע הדרכה אחת. -->
      <div class="lecture reveal">
        <YouTubeEmbed id="QANXfOW_s-Q" title="נוגה דיין אור הדרכה חינמית - עסק מקצועי הוא עסק מעוצב">
          <ContentCover title="עסק מקצועי|הוא *עסק מעוצב*" motif="screen" kind="lecture" duration="53:37" ratio="16/9" />
        </YouTubeEmbed>
        <p class="meta meta--dark"><Icon name="mic" size={16} /> <span>הרצאה</span> · 54 דק' צפייה</p>
        <h3 class="lecture__title">הדרכה חינמית: עסק מקצועי הוא עסק מעוצב</h3>
        <ShareBar title="הדרכה חינמית של נוגה דיין אור: עסק מקצועי הוא עסק מעוצב" url="https://youtu.be/QANXfOW_s-Q" print={false} tone="dark" />
      </div>
      <p class="trainings-link">
        מחפשים הרצאה או סדנה לקבוצה או לארגון? <a href="/trainings/">לקטלוג ההדרכות</a>
      </p>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .intro {
    margin-bottom: 1.75rem;
  }

  /* שורת סוג וזמן קריאה, מתחת לכל כריכה */
  .meta {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0.85rem 0 0.2rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: #4a5b73;
  }
  .meta span {
    color: var(--teal-dark);
    font-weight: 800;
  }
  .meta :global(svg) {
    color: var(--teal-dark);
  }
  .meta--dark,
  .meta--dark :global(svg) {
    color: var(--on-dark-soft);
  }
  .meta--dark span {
    color: var(--gold-light);
  }

  /* מדריכים: 3 בשורה במחשב, 2 בטאבלט, 1 בנייד. העמודה האמצעית נמוכה יותר (פריסה מדורגת). */
  .shelf {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem 1.5rem;
    align-items: start;
  }
  .shelf > li:nth-child(3n + 2) {
    margin-top: 3rem;
  }
  @media (max-width: 62rem) {
    .shelf {
      grid-template-columns: repeat(2, 1fr);
    }
    .shelf > li:nth-child(3n + 2) {
      margin-top: 0;
    }
    .shelf > li:nth-child(2n) {
      margin-top: 2.5rem;
    }
  }
  @media (max-width: 36rem) {
    .shelf {
      grid-template-columns: 1fr;
    }
    .shelf > li:nth-child(2n) {
      margin-top: 0;
    }
  }
  .item {
    position: relative;
    margin: 0;
  }
  .item__cover {
    display: block;
    transition: transform 0.3s ease;
  }
  .item:hover .item__cover {
    transform: translateY(-4px);
  }
  .item__title {
    margin: 0 0 0.25rem;
    font-size: 1.15rem;
    line-height: 1.35;
  }
  .item__title a {
    color: var(--navy);
    text-decoration: none;
  }
  /* כל הכרטיס לחיץ, דרך הקישור שבכותרת */
  .item__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .item__title a:hover {
    color: var(--teal-dark);
  }
  .item__sub {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.5;
    color: #33445c;
  }

  /* הרצאות: פס כהה */
  .lecture {
    max-width: 44rem;
  }
  .lecture__title {
    margin: 0 0 0.75rem;
    font-size: 1.2rem;
    color: var(--white);
  }
  .trainings-link {
    margin: 2rem 0 0;
  }
  .lectures .trainings-link a {
    color: var(--gold-light);
  }

  @media (prefers-reduced-motion: reduce) {
    .item__cover {
      transition: none;
    }
  }
</style>
