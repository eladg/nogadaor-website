---
// עמוד מרכז "מדריכים והרצאות": חלק 1 מדריכים ומאמרים יחד, חלק 2 הדרכות מהיוטיוב (נוגה, 2026-11-07).
// כרגע הכל פתוח לצפייה (בלי הורדה ובלי איסוף אימייל).
// עיצוב (נוגה, 2026-11-06): כריכות בסגנון "חפץ זכוכית זוהר" (src/components/ContentCover.astro), בלי לוגו ובלי מספור.
// לכל סוג תוכן פריסה משלו באותה שפה: מדריכים בפריסה מדורגת (האמצעי נמוך יותר, מושך לגלול), שאלון בכרטיס רחב,
// הרצאות בפס כהה, ומאמרים ברשימה עם כריכה בצד. מתחת לכל כריכה: סוג התוכן וזמן הקריאה. הכרטיסים מופיעים בהדרגה בגלילה.
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import CtaBand from '../../components/CtaBand.astro';
import YouTubeEmbed from '../../components/YouTubeEmbed.astro';
import ContentCover from '../../components/ContentCover.astro';
import Icon from '../../components/Icon.astro';
import { readingMinutes } from '../../utils/readingTime';
import { lectures, minutesOf } from '../../data/lectures';
import { atmoStyle } from '../../utils/atmo';
import stairs from '../../assets/atmosphere/dark-stairs.webp';
import darkLines from '../../assets/atmosphere/dark-lines.webp';
const linesStyle = await atmoStyle(darkLines, 0.4);

const all = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
// קודם המדריכים ואחריהם המאמרים, כל קבוצה לפי order
const items = [...all.filter((g) => g.data.type === 'guide'), ...all.filter((g) => g.data.type === 'article')];
---

<BaseLayout
  title="מדריכים והרצאות"
  description="מדריכים, מאמרים והדרכות לצפייה בחינם לבעלי עסקים, מאת נוגה דיין אור."
>
  <!-- בלי משפט פתיחה (נוגה, 2026-11-07: "לא צריך משפט פתיחה") -->
  <PageHeader title="מדריכים והרצאות" kicker="תוכן חינמי לבעלי עסקים" image={stairs} />

  <!-- חלק 1: מדריכים ומאמרים יחד (נוגה, 2026-11-07: "שהמאמר לא יהיה לבד"). קודם המדריכים, אחריהם המאמרים.
       לכל כרטיס סוג משלו מתחת לכריכה (מדריך = רשימה, מאמר = ספר פתוח). -->
  <section class="section">
    <div class="container">
      <h2>מדריכים ומאמרים</h2>
      <p class="intro">הכול פתוח לקריאה כאן באתר.</p>
      <!-- הוחלט (2026-11-05): בשלב ראשון הכל פתוח, בלי איסוף אימיילים. לא לבנות שער אימייל עד שנוגה תבקש. -->
      <!-- TODO (נוגה, 2026-11-07): מדריכים חדשים שנוגה רוצה, עוד אין להם תוכן: הקמת עסק, תודעה עסקית מנצחת, מציאת בידול. -->
      <ul class="shelf">
        {
          items.map((g, i) => {
            const isArticle = g.data.type === 'article';
            const soon = g.data.comingSoon;
            return (
              <li class:list={['item reveal', { 'item--soon': soon }]} style={`transition-delay: ${(i % 3) * 0.12}s`}>
                {soon ? (
                  <div class="item__cover">
                    <ContentCover title={g.data.coverTitle ?? g.data.title} motif={g.data.coverMotif} star={g.data.coverStar} kind={g.data.type} />
                    <span class="soon-badge">בקרוב</span>
                  </div>
                ) : (
                  <a class="item__cover" href={`/guides/${g.id}/`} tabindex="-1" aria-hidden="true">
                    <ContentCover title={g.data.coverTitle ?? g.data.title} motif={g.data.coverMotif} star={g.data.coverStar} kind={g.data.type} />
                  </a>
                )}
                <p class="meta">
                  <Icon name={isArticle ? 'book-open' : 'list'} size={16} /> <span>{isArticle ? 'מאמר' : 'מדריך'}</span> · {soon ? 'בכתיבה' : `${readingMinutes(g.body)} דק' קריאה`}
                </p>
                <h3 class="item__title">
                  {soon ? g.data.title : <a href={`/guides/${g.id}/`}>{g.data.title}</a>}
                </h3>
                {g.data.tagline && <p class="item__sub">{g.data.tagline}</p>}
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <!-- חלק 2: הדרכות מהיוטיוב, לצפייה בחינם. פס כהה. הכריכה שלנו מוצגת במקום התמונה של יוטיוב, והסרטון נטען רק בלחיצה.
       השאלון עבר לעמוד הבית (נוגה, 2026-11-07). -->
  <section class="section section--dark lectures atmo" style={linesStyle}>
    <div class="container">
      <h2>הדרכות לצפייה <span class="hl">בחינם</span></h2>
      <!-- ההרצאות שנוגה בחרה (src/data/lectures.ts): 6 = 3 בשורה במחשב, 2 בטאבלט, 1 בנייד -->
      <ul class="lecture-grid">
        {
          lectures.map((l, i) => (
            <li class="lecture reveal" style={`transition-delay: ${(i % 3) * 0.1}s`}>
              <YouTubeEmbed id={l.id} title={l.title}>
                <ContentCover title={l.coverTitle} motif={l.motif} kind="lecture" duration={l.duration} ratio="16/9" />
              </YouTubeEmbed>
              <p class="meta meta--dark">
                <Icon name="mic" size={16} /> <span>הרצאה</span> · {minutesOf(l.duration)} דק' צפייה
              </p>
              <h3 class="lecture__title">{l.title}</h3>
              <p class="lecture__short">{l.short}</p>
            </li>
          ))
        }
      </ul>
      <p class="trainings-link">
        מחפשים הרצאה או סדנה לקבוצה או לארגון? <a href="/trainings/">לקטלוג ההדרכות</a>
      </p>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .intro {
    margin-bottom: 1.75rem;
  }

  /* שורת סוג וזמן קריאה, מתחת לכל כריכה */
  .meta {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0.85rem 0 0.2rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: #4a5b73;
  }
  .meta span {
    color: var(--teal-dark);
    font-weight: 800;
  }
  .meta :global(svg) {
    color: var(--teal-dark);
  }
  .meta--dark,
  .meta--dark :global(svg) {
    color: var(--on-dark-soft);
  }
  .meta--dark span {
    color: var(--gold-light);
  }

  /* מדריכים: 3 בשורה במחשב, 2 בטאבלט, 1 בנייד. העמודה האמצעית נמוכה יותר (פריסה מדורגת). */
  .shelf {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem 1.5rem;
    align-items: start;
  }
  .shelf > li:nth-child(3n + 2) {
    margin-top: 3rem;
  }
  @media (max-width: 62rem) {
    .shelf {
      grid-template-columns: repeat(2, 1fr);
    }
    .shelf > li:nth-child(3n + 2) {
      margin-top: 0;
    }
    .shelf > li:nth-child(2n) {
      margin-top: 2.5rem;
    }
  }
  @media (max-width: 36rem) {
    .shelf {
      grid-template-columns: 1fr;
    }
    .shelf > li:nth-child(2n) {
      margin-top: 0;
    }
  }
  .item {
    position: relative;
    margin: 0;
  }
  .item__cover {
    display: block;
    transition: transform 0.3s ease;
  }
  .item:hover .item__cover {
    transform: translateY(-4px);
  }
  /* מדריך שעוד בכתיבה: בלי קישור, עם תג "בקרוב" */
  .item--soon .item__cover {
    position: relative;
  }
  .item--soon:hover .item__cover {
    transform: none;
  }
  .soon-badge {
    position: absolute;
    top: 0.75rem;
    inset-inline-start: 0.75rem;
    padding: 0.2rem 0.75rem;
    border-radius: 999px;
    background: var(--gold-gradient);
    color: var(--navy);
    font-size: 0.85rem;
    font-weight: 800;
  }
  .item__title {
    margin: 0 0 0.25rem;
    font-size: 1.15rem;
    line-height: 1.35;
  }
  .item__title a {
    color: var(--navy);
    text-decoration: none;
  }
  /* כל הכרטיס לחיץ, דרך הקישור שבכותרת */
  .item__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .item__title a:hover {
    color: var(--teal-dark);
  }
  .item__sub {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.5;
    color: #33445c;
  }

  /* הרצאות: פס כהה */
  .lecture-grid {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem 1.5rem;
  }
  @media (max-width: 62rem) {
    .lecture-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 36rem) {
    .lecture-grid {
      grid-template-columns: 1fr;
    }
  }
  .lecture {
    margin: 0;
  }
  .lecture__title {
    margin: 0 0 0.35rem;
    font-size: 1.15rem;
    font-weight: 800;
    line-height: 1.35;
    color: var(--white);
  }
  .lecture__short {
    margin: 0;
    font-size: 0.97rem;
    line-height: 1.6;
    color: var(--on-dark-soft);
  }
  .trainings-link {
    margin: 2rem 0 0;
  }
  .lectures .trainings-link a {
    color: var(--gold-light);
  }

  @media (prefers-reduced-motion: reduce) {
    .item__cover {
      transition: none;
    }
  }
</style>
