---
// עמוד מדריך או מאמר. התוכן נקרא מקובץ בתיקייה src/content/guides.
// תבנית קבועה לכל המדריכים (2026-11-05, לבקשת נוגה: "כל מדריך כמו עיצוב דף באתר"):
//   פתיח כהה במעבר צבעים עם כריכה (ספר וטאבלט) ← "מה תקבלו במדריך" ← תוכן עניינים ותוכן
//   ← על הכותבת ← קריאה לפעולה ← עוד מדריכים.
// בתוך קובצי ה-mdx אפשר להשתמש ברכיבים מ-src/components/guide בלי לייבא אותם (הם מועברים כאן).
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import ContentCover from '../../components/ContentCover.astro';
import Star from '../../components/Star.astro';
import { readingMinutes } from '../../utils/readingTime';
import ShareBar from '../../components/ShareBar.astro';
import Callout from '../../components/guide/Callout.astro';
import Cards from '../../components/guide/Cards.astro';
import Card from '../../components/guide/Card.astro';
import Steps from '../../components/guide/Steps.astro';
import Step from '../../components/guide/Step.astro';
import Compare from '../../components/guide/Compare.astro';
import Panel from '../../components/guide/Panel.astro';
import CopyBox from '../../components/guide/CopyBox.astro';
import Checklist from '../../components/guide/Checklist.astro';
import Band from '../../components/guide/Band.astro';
import Iceberg from '../../components/guide/Iceberg.astro';
import Ranking from '../../components/guide/Ranking.astro';
import Takeaways from '../../components/guide/Takeaways.astro';
import { contact } from '../../data/contact';
import nogaPhoto from '../../assets/contact/noga-bench.jpg';
import { atmoStyle } from '../../utils/atmo';
import road from '../../assets/atmosphere/dark-road.webp';
const roadStyle = await atmoStyle(road, 0.4);

export async function getStaticPaths() {
  // מדריכים שעוד אין להם תוכן (comingSoon) לא מקבלים עמוד
  const guides = (await getCollection('guides')).filter((g) => !g.data.comingSoon);
  return guides.map((guide) => ({ params: { slug: guide.id }, props: { guide, all: guides } }));
}

const { guide, all } = Astro.props;
const { Content, headings } = await render(guide);
const d = guide.data;
const isArticle = d.type === 'article';
const typeLabel = isArticle ? 'מאמר' : 'מדריך';
const toc = headings.filter((h) => h.depth === 2);

const minutes = readingMinutes(guide.body);
// אייקון לכל סוג (נוגה, 2026-11-06): מדריך = רשימה, מאמר = ספר פתוח
const typeIcon = isArticle ? 'book-open' : 'list';

const publishedText = d.published?.toLocaleDateString('he-IL', { day: 'numeric', month: 'long', year: 'numeric' });
const waText = encodeURIComponent(`היי נוגה, קראתי את ה${typeLabel} "${d.title}" ואשמח לשמוע עוד`);

const related = all
  .filter((g) => g.id !== guide.id && g.data.type === 'guide')
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const description = d.description;
const components = { Callout, Cards, Card, Steps, Step, Compare, Panel, CopyBox, Checklist, Band, Iceberg, Ranking, Takeaways };
const gainIcons = ['target', 'bulb', 'rocket', 'chart'] as const;
---

<BaseLayout title={d.title} description={description}>
  <!-- סימן מים להדפסה: המונוגרמה OR עם הכוכב, שקופה מאוד, בכל עמוד מודפס (מוסתרת במסך).
       נוגה (2026-11-06): שלא ישתמשו במדריך המודפס כאילו הוא שלהם. -->
  <div class="print-mark" aria-hidden="true"><img src="/images/or-mark.webp" alt="" width="800" height="565" /></div>
  <div class="print-head" aria-hidden="true">
    <img src="/images/logo-color-trim.webp" alt="" width="900" height="313" />
    <span>© נוגה דיין אור · כל הזכויות שמורות</span>
  </div>
  <!-- 1. פתיח -->
  <header class="g-hero">
    <div class="container g-hero__grid">
      <div class="g-hero__text">
        <p class="g-crumbs"><a href="/guides/">מדריכים והרצאות</a> <span aria-hidden="true">/</span> {typeLabel}</p>
        <h1 class="g-hero__title">{d.title}</h1>
        {d.tagline && <p class="g-hero__tagline">{d.tagline}</p>}
        <p class="g-hero__lead">{description}</p>
        <ul class="g-meta">
          <li><Icon name="clock" size={16} /> {minutes} דקות קריאה</li>
          <li><Icon name={typeIcon} size={16} /> {typeLabel}{!isArticle && ' חינמי'}</li>
          {publishedText && <li>{publishedText}</li>}
        </ul>
        {
          isArticle && d.sourceUrl && (
            <p class="g-source">
              פורסם לראשונה ב<a href={d.sourceUrl} rel="noopener">{d.sourceName}</a>
            </p>
          )
        }
        <ShareBar title={d.title} download={d.download} tone="dark" />
      </div>
      <div class="g-hero__cover">
        <ContentCover title={d.coverTitle ?? d.title} motif={d.coverMotif} star={d.coverStar} kind={d.type} />
      </div>
    </div>
  </header>

  <!-- 2. מה תקבלו -->
  {
    d.gains.length > 0 && (
      <section class="g-gains" aria-labelledby="gains-title">
        <div class="container">
          <h2 id="gains-title" class="sr-only">
            מה תקבלו ב{typeLabel}
          </h2>
          <ul class="g-gains__list">
            {d.gains.map((gain, i) => (
              <li>
                <span class="g-gains__icon">
                  <Icon name={gainIcons[i % gainIcons.length]} size={22} />
                </span>
                {gain}
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- 3. תוכן העניינים והתוכן -->
  <div class="section g-body">
    <div class="container g-body__grid">
      {
        toc.length > 2 && (
          <nav class="g-toc" aria-label="תוכן העניינים">
            <p class="g-toc__title">ב{typeLabel}:</p>
            <ol>
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }
      <article class:list={['prose', { 'prose--numbered': !isArticle }]}>
        <Content components={components} />

        <div class="g-endbar">
          <p>אהבתם? שתפו, הדפיסו או שמרו לעצמכם:</p>
          <ShareBar title={d.title} download={d.download} />
        </div>

        {
          d.keywords.length > 0 && (
            <ul class="g-tags" aria-label="נושאים">
              {d.keywords.map((k) => (
                <li>{k}</li>
              ))}
            </ul>
          )
        }

        <!-- על הכותבת. הנתונים אושרו על ידי נוגה (סעיף 6א בסקיל) -->
        <aside class="g-author" aria-label="על הכותבת">
          <Image class="g-author__photo" src={nogaPhoto} alt="נוגה דיין אור" widths={[160, 240]} sizes="7rem" />
          <div>
            <p class="g-author__name">נוגה דיין אור</p>
            <p class="g-author__role">יועצת עסקית וארגונית להגדלת הכנסות ושיפור רווחיות</p>
            <p class="g-author__facts">MBA במנהל עסקים · ליווי 450 עסקים · 20 שנה בהנהלה של בנק גדול · 4 שנות ייעוץ מטעם משרד הכלכלה (ציון 9.4)</p>
            <a class="g-author__link" href="/about/">עוד עליי</a>
          </div>
        </aside>
      </article>
    </div>
  </div>

  <!-- 4. קריאה לפעולה -->
  <section class="g-cta atmo atmo--full" style={roadStyle}>
    <div class="container g-cta__inner">
      <h2 class="g-cta__title"><Star size={30} class="g-cta__star" /> רוצים לדבר <span class="hl">על זה?</span></h2>
      <!-- הנוסח מתוך המדריכים של נוגה ("מוזמנים לפגישת זום קצרה...") -->
      <p class="g-cta__text">מוזמנים לפגישת זום קצרה, לשדרוג השיווק של העסק שלכם, לגמרי במתנה.</p>
      <div class="g-cta__actions">
        <a class="btn g-cta__btn" href={contact.booking} target="_blank" rel="noopener">
          <Icon name="calendar" size={20} /> לקביעת פגישת היכרות<span class="sr-only"> (נפתח בלשונית חדשה)</span>
        </a>
        <a class="g-cta__ghost" href={`${contact.whatsapp}?text=${waText}`} target="_blank" rel="noopener">
          <Icon name="whatsapp" size={20} /> לשיחה בוואטסאפ<span class="sr-only"> (נפתח בלשונית חדשה)</span>
        </a>
        <a class="g-cta__ghost" href={contact.whatsappGroup} target="_blank" rel="noopener">
          <Icon name="users" size={20} /> לקהילת "תודעה עסקית מנצחת"<span class="sr-only"> (נפתח בלשונית חדשה)</span>
        </a>
      </div>
      <p class="g-cta__note">{contact.bookingNote}.</p>
    </div>
  </section>

  <!-- 5. עוד מדריכים -->
  {
    related.length > 0 && (
      <section class="section section--mist" aria-labelledby="more-title">
        <div class="container">
          <h2 id="more-title" class="g-more__title">
            עוד <span class="hl--mark">מדריכים</span>
          </h2>
          <ul class="g-more">
            {related.map((g) => (
              <li class="g-more__item">
                <div class="g-more__cover">
                  <ContentCover title={g.data.coverTitle ?? g.data.title} motif={g.data.coverMotif} star={g.data.coverStar} kind={g.data.type} />
                </div>
                <div class="g-more__text">
                  <h3>
                    <a href={`/guides/${g.id}/`}>{g.data.title}</a>
                  </h3>
                  <p>{g.data.description}</p>
                </div>
              </li>
            ))}
          </ul>
          <p class="g-more__all">
            <a href="/guides/">לכל המדריכים, ההרצאות והמאמרים</a>
          </p>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  /* ---------- פתיח ---------- */
  .g-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2.25rem, 6vw, 4.5rem) clamp(3.5rem, 8vw, 5.5rem);
    color: var(--on-dark);
    background:
      radial-gradient(40rem 26rem at 100% 0, rgb(25 154 181 / 0.45), transparent 70%),
      radial-gradient(30rem 22rem at 0 100%, rgb(209 154 74 / 0.28), transparent 72%),
      linear-gradient(160deg, var(--navy-deep), var(--navy) 55%, #10345a);
  }
  /* רשת נקודות עדינה ברקע, כמו בעיצוב המדריכים */
  .g-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgb(255 255 255 / 0.12) 1.5px, transparent 1.6px);
    background-size: 26px 26px;
    -webkit-mask-image: radial-gradient(circle at 20% 40%, #000, transparent 65%);
    mask-image: radial-gradient(circle at 20% 40%, #000, transparent 65%);
  }
  .g-hero__grid {
    position: relative;
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 56rem) {
    .g-hero__grid {
      grid-template-columns: 1.25fr 1fr;
      gap: 3.5rem;
    }
  }
  .g-crumbs {
    margin: 0 0 0.9rem;
    font-size: 0.95rem;
    color: var(--on-dark-soft);
  }
  .g-crumbs a {
    color: var(--gold-light);
  }
  .g-hero__title {
    margin: 0 0 0.6rem;
    font-size: clamp(2.1rem, 5.5vw, 3.4rem);
    font-weight: 900;
    line-height: 1.15;
    color: var(--white);
    text-wrap: balance;
  }
  .g-hero__tagline {
    margin: 0 0 0.9rem;
    font-size: clamp(1.15rem, 2.4vw, 1.4rem);
    font-weight: 800;
    background: var(--gold-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .g-hero__lead {
    max-width: 36rem;
    font-size: 1.08rem;
    line-height: 1.7;
  }
  .g-meta {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .g-meta li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.08);
    border: 1px solid rgb(255 255 255 / 0.14);
    font-size: 0.92rem;
    font-weight: 700;
  }
  .g-meta :global(svg) {
    color: var(--gold-light);
  }
  .g-hero .sharebar {
    margin-top: 1.25rem;
  }
  .prose :global(.g-dl) {
    margin: 0 0 1.25rem;
  }
  .prose :global(.g-dl .btn) {
    text-decoration: none;
  }
  @media print {
    .prose :global(.g-dl) {
      display: none;
    }
  }
  .g-endbar {
    margin-top: 2.5rem;
    padding: 1.1rem 1.25rem;
    border-radius: 1.1rem;
    background: var(--mist);
    border: 1px solid var(--line);
  }
  .g-endbar p {
    margin: 0 0 0.6rem;
    font-weight: 800;
  }
  .g-source {
    margin: 1rem 0 0;
    font-size: 0.95rem;
  }
  .g-source a {
    color: var(--gold-light);
  }
  .g-hero__cover {
    width: min(100%, 30rem);
    margin-inline: auto;
  }

  /* ---------- מה תקבלו ---------- */
  .g-gains {
    position: relative;
    z-index: 1;
    margin-top: -2.5rem;
  }
  .g-gains__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
  }
  .g-gains__list li {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin: 0;
    padding: 1rem 1.1rem;
    border-radius: 1.1rem;
    background: var(--white);
    border: 1px solid var(--line);
    box-shadow: 0 22px 40px -30px rgb(11 26 51 / 0.55);
    font-weight: 700;
    line-height: 1.45;
  }
  .g-gains__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--teal), var(--teal-dark));
    color: var(--white);
  }
  .g-gains__list li:nth-child(even) .g-gains__icon {
    background: var(--gold-gradient);
    color: var(--navy);
  }

  /* ---------- גוף ---------- */
  .g-body__grid {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 64rem) {
    .g-body__grid {
      grid-template-columns: 15rem minmax(0, 46rem);
      justify-content: center;
      gap: 4rem;
    }
  }
  .g-toc {
    align-self: start;
    padding: 1.1rem 1.2rem;
    border-radius: 1.1rem;
    background: var(--mist);
    border: 1px solid var(--line);
    font-size: 0.95rem;
  }
  @media (min-width: 64rem) {
    .g-toc {
      position: sticky;
      top: 6rem;
    }
  }
  .g-toc__title {
    margin: 0 0 0.5rem;
    font-weight: 900;
    color: var(--navy);
  }
  .g-toc ol {
    margin: 0;
    padding-inline-start: 1.3em;
  }
  .g-toc li {
    margin-bottom: 0.4em;
  }
  .g-toc li::marker {
    color: var(--teal);
    font-weight: 800;
  }
  .g-toc a {
    color: var(--navy);
    text-decoration: none;
  }
  .g-toc a:hover {
    color: var(--teal-dark);
    text-decoration: underline;
  }

  /* הטקסט מתוך קובץ המדריך */
  .prose {
    min-width: 0;
    font-size: 1.07rem;
    line-height: 1.8;
  }
  .prose :global(h2) {
    scroll-margin-top: 6rem;
    margin: 2.75rem 0 1rem;
    font-size: clamp(1.55rem, 3.6vw, 2rem);
    font-weight: 900;
    line-height: 1.25;
    color: var(--navy);
  }
  .prose > :global(h2:first-child) {
    margin-top: 0;
  }
  /* במדריכים: כל כותרת מקבלת מספר בעיגול, ומתחלפת בין כחול לזהב */
  .prose--numbered {
    counter-reset: g-h2;
  }
  .prose--numbered :global(h2) {
    counter-increment: g-h2;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .prose--numbered :global(h2)::before {
    content: counter(g-h2, decimal-leading-zero);
    flex: none;
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 0.9rem;
    background: linear-gradient(135deg, var(--teal), var(--teal-dark));
    color: var(--white);
    font-size: 1rem;
    font-weight: 900;
  }
  .prose--numbered :global(h2:nth-of-type(even))::before {
    background: var(--gold-gradient);
    color: var(--navy);
  }
  .prose :global(h3) {
    margin: 1.9rem 0 0.6rem;
    font-size: 1.25rem;
    font-weight: 900;
    color: var(--teal-dark);
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-inline-start: 1.4em;
    margin: 0 0 1.25em;
  }
  .prose :global(li) {
    margin-bottom: 0.4em;
  }
  .prose :global(li::marker) {
    color: var(--teal);
    font-weight: 800;
  }
  .prose :global(strong) {
    color: var(--navy);
    font-weight: 800;
  }
  .prose :global(a) {
    color: var(--teal-dark);
    font-weight: 700;
  }
  /* ציטוט רגיל ב-Markdown (> ...) */
  .prose :global(blockquote) {
    margin: 1.75em 0;
    padding: 1.1em 1.4em;
    border-radius: 1.1rem;
    background: linear-gradient(135deg, rgb(25 154 181 / 0.12), rgb(25 154 181 / 0.03));
    border-inline-start: 5px solid var(--teal);
    font-weight: 700;
    color: var(--navy);
  }
  .prose :global(blockquote p:last-child) {
    margin-bottom: 0;
  }
  /* טבלאות: גלילה לצדדים בנייד */
  .prose :global(table) {
    display: block;
    overflow-x: auto;
    border-collapse: separate;
    border-spacing: 0;
    width: 100%;
    margin: 1.5em 0 2em;
    font-size: 0.98rem;
    border-radius: 1rem;
    border: 1px solid var(--line);
  }
  .prose :global(th),
  .prose :global(td) {
    padding: 0.7em 0.9em;
    text-align: start;
    vertical-align: top;
    min-width: 9rem;
    border-bottom: 1px solid var(--line);
  }
  .prose :global(th) {
    background: var(--navy);
    color: var(--white);
  }
  .prose :global(tr:nth-child(even) td) {
    background: var(--mist);
  }
  .prose :global(td:first-child) {
    font-weight: 800;
    color: var(--teal-dark);
  }

  .g-tags {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .g-tags li {
    margin: 0;
    padding: 0.25rem 0.8rem;
    border-radius: 999px;
    background: var(--mist);
    border: 1px solid var(--line);
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--teal-dark);
  }
  .g-tags li::marker {
    content: '';
  }

  .g-author {
    display: flex;
    gap: 1.25rem;
    align-items: center;
    margin-top: 2rem;
    padding: 1.4rem;
    border-radius: 1.5rem;
    background:
      radial-gradient(16rem 10rem at 100% 0, rgb(25 154 181 / 0.16), transparent 70%),
      var(--mist);
    border: 1px solid var(--line);
    line-height: 1.55;
  }
  .g-author :global(.g-author__photo) {
    flex: none;
    width: 6.5rem;
    height: 6.5rem;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 18%;
    border: 3px solid var(--gold-dark);
  }
  .g-author__name {
    margin: 0;
    font-weight: 900;
    font-size: 1.2rem;
    color: var(--navy);
  }
  .g-author__role {
    margin: 0 0 0.35rem;
    font-weight: 700;
    color: var(--teal-dark);
  }
  .g-author__facts {
    margin: 0 0 0.35rem;
    font-size: 0.92rem;
  }
  .g-author__link {
    font-weight: 800;
  }
  @media (max-width: 30rem) {
    .g-author {
      flex-direction: column;
      text-align: center;
    }
  }

  /* ---------- קריאה לפעולה ---------- */
  .g-cta {
    padding-block: clamp(2.75rem, 7vw, 4.5rem);
    text-align: center;
