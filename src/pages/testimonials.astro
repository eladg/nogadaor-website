---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBand from '../components/CtaBand.astro';
import YouTubeEmbed from '../components/YouTubeEmbed.astro';
import ReviewsCarousel from '../components/ReviewsCarousel.astro';
import { featuredVideo, videos } from '../data/testimonials';
import { allReviews } from '../data/reviews';
---

<BaseLayout title="המלצות לקוחות" description="לקוחות מספרים על תהליך הליווי העסקי עם נוגה דיין אור.">
  <PageHeader title="המלצות לקוחות">
    <!-- הנוסח לקוח מהדף שנוגה בנתה ב-Canva -->
    <p>קצת ממה שהלקוחות מספרים על תהליך הליווי</p>
  </PageHeader>

  <!-- הסרטון המרכזי: לקט ההמלצות -->
  <section class="section">
    <div class="container">
      <div class="featured">
        <YouTubeEmbed id={featuredVideo.id} title={featuredVideo.title} vertical={featuredVideo.vertical} />
      </div>
    </div>
  </section>

  <!-- כל סרטוני ההמלצות -->
  <section class="section section--mist">
    <div class="container">
      <h2 class="sr-only">סרטוני ההמלצות</h2>
      <ul class="videos">
        {
          videos.map((v) => (
            <li class:list={['videos__item', { 'videos__item--wide': !v.vertical }]}>
              <YouTubeEmbed id={v.id} title={v.title} vertical={v.vertical} />
              <p class="videos__caption">{v.title}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- המלצות כתובות: קרוסלה, מתעדכנת ידנית ב-src/data/reviews.ts -->
  <section class="section">
    <div class="container">
      <h2>מה אומרים עליי</h2>
      <!-- TODO: להוסיף המלצות מפייסבוק כשנוגה תבחר. אין לשנות ציטוטים. -->
      <ReviewsCarousel reviews={allReviews} label="המלצות לקוחות בכתב" />
      <!-- TODO: כפתורי "כתבו המלצה" בגוגל ובפייסבוק, כשיהיה קישור לכרטיס העסק בגוגל -->
    </div>
  </section>

  <!-- סיפורי מקרה -->
  <section class="section section--mist">
    <div class="container">
      <h2>סיפורי מקרה</h2>
      <!-- TODO: נוגה תספק סיפורי מקרה. אין להמציא. לפני פרסום שם של לקוח לוודא שאישר. -->
      <p class="placeholder">תוכן חסר: סיפורי מקרה. יתווספו אחרי שנוגה תספק אותם.</p>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .featured {
    max-width: 20rem;
    margin-inline: auto;
  }
  .videos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
    /* בנייד שני סרטונים אנכיים בשורה, כדי שכל סרטון לא יתפוס מסך שלם */
    grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
    gap: 1rem;
    align-items: start;
  }
  .videos__item--wide {
    grid-column: 1 / -1;
    max-width: 36rem;
  }
  .videos__caption {
    margin: 0.5rem 0 0;
    font-size: 0.95rem;
  }
  @media (min-width: 48rem) {
    .videos {
      grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
      gap: 1.5rem;
    }
    .videos__item--wide {
      grid-column: span 2;
    }
  }
</style>
