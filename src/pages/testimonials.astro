---
// עמוד ההמלצות: פתיח עם לקט ההמלצות, קרוסלת סרטונים, קרוסלת המלצות כתובות, וסיפורי מקרה.
// הסרטונים ב-src/data/testimonials.ts, ההמלצות הכתובות ב-src/data/reviews.ts
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import YouTubeEmbed from '../components/YouTubeEmbed.astro';
import Carousel from '../components/Carousel.astro';
import ReviewsCarousel from '../components/ReviewsCarousel.astro';
import { featuredVideo, videos } from '../data/testimonials';
import { allReviews } from '../data/reviews';
---

<BaseLayout title="המלצות לקוחות" description="לקוחות מספרים על תהליך הליווי העסקי עם נוגה דיין אור.">
  <section class="t-hero">
    <div class="container t-hero__grid">
      <div class="t-hero__text">
        <h1>המלצות לקוחות</h1>
        <!-- הנוסח לקוח מהדף שנוגה בנתה ב-Canva -->
        <p class="t-hero__lead">קצת ממה שהלקוחות מספרים על תהליך הליווי</p>

        <!-- מילים אישיות של נוגה בכתב יד (הנוסח שלה, 2026-11-05). במקום ספירת ההמלצות, שנוגה ביקשה להוריד -->
        <blockquote class="t-note">
          <p>
            תודה ללקוחות המהממים שלי על האמון, על הדרך המשותפת ועל המילים שמרגשות אותי כל כך.
            לעולם לא אפסיק להודות ולהעריך בחזרה <span role="img" aria-label="לב">❤️</span>
          </p>
          <p>
            מאחורי כל המלצה כאן יש תהליך של חשיבה ופיצוח, החלטות שקיבלו כיוון ורעיונות שהפכו
            למהלכים בעסק. עשייה משותפת שמביאה איתה גם תוצאות, ביטחון והרבה אנרגיה להמשיך קדימה.
          </p>
          <footer class="t-note__sign">נוגה</footer>
        </blockquote>

        <p class="t-hero__links">
          <a href="#videos">לסרטונים</a>
          <a href="#reviews">להמלצות הכתובות</a>
        </p>
      </div>

      <figure class="t-hero__video">
        <div class="phone">
          <YouTubeEmbed id={featuredVideo.id} title={featuredVideo.title} vertical />
        </div>
        <figcaption>{featuredVideo.name}</figcaption>
      </figure>
    </div>
  </section>

  <!-- סרטוני ההמלצות: שורה אחת שזזה לצדדים -->
  <section class="section" id="videos">
    <div class="container">
      <h2 class="t-title">לקוחות מספרים</h2>
      <Carousel label="סרטוני המלצות" itemWidth="clamp(10.5rem, 42%, 14rem)">
        {
          videos.map((v) => (
            <li class="v-card">
              <YouTubeEmbed id={v.id} title={v.title} vertical />
              <p class="v-card__name">{v.name}</p>
              {v.role && <p class="v-card__role">{v.role}</p>}
            </li>
          ))
        }
      </Carousel>
    </div>
  </section>

  <!-- המלצות כתובות: קרוסלה, מתעדכנת ידנית ב-src/data/reviews.ts -->
  <section class="section section--mist t-reviews" id="reviews">
    <div class="container">
      <h2 class="t-title">מה אומרים עליי</h2>
      <ReviewsCarousel reviews={allReviews} label="המלצות לקוחות בכתב" />
    </div>
  </section>

  <!-- סיפורי מקרה -->
  <section class="section">
    <div class="container">
      <h2 class="t-title">סיפורי מקרה</h2>
      <!-- TODO: נוגה תספק סיפורי מקרה. אין להמציא. לפני פרסום שם של לקוח לוודא שאישר. -->
      <p class="placeholder">תוכן חסר: סיפורי מקרה. יתווספו אחרי שנוגה תספק אותם.</p>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  /* פתיח: טקסט מצד אחד, לקט ההמלצות במסגרת של טלפון מהצד השני */
  .t-hero {
    background:
      radial-gradient(circle at 15% 20%, rgb(252 220 109 / 0.25), transparent 40%),
      radial-gradient(circle at 85% 90%, rgb(29 157 160 / 0.14), transparent 45%),
      var(--mist);
    border-bottom: 1px solid var(--line);
    padding-block: clamp(2.5rem, 7vw, 4.5rem);
  }
  .t-hero__grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 48rem) {
    .t-hero__grid {
      grid-template-columns: 1fr auto;
      gap: 4rem;
    }
  }
  .t-hero__kicker {
    margin: 0 0 0.25rem;
    font-weight: 700;
    color: var(--teal-dark);
    letter-spacing: 0.02em;
  }
  .t-hero h1 {
    margin-bottom: 0.35em;
  }
  .t-hero__lead {
    font-size: 1.3rem;
  }

  /* מילים אישיות בכתב יד, כמו פתק שנכתב ביד */
  .t-note {
    position: relative;
    margin: 1.75rem 0 0;
    max-width: 36rem;
    padding: 1.6rem 1.6rem 1.2rem;
    background: var(--white);
    border-radius: 1.25rem;
    box-shadow: 0 18px 40px -22px rgb(11 26 51 / 0.35);
    font-family: var(--font-hand);
    font-size: 1.25rem;
    line-height: 1.85;
    color: var(--navy);
    rotate: -0.6deg;
  }
  /* מירכאות זהב גדולות בפינה */
  .t-note::before {
    content: '”';
    position: absolute;
    inset-block-start: -0.42em;
    inset-inline-start: 0.35em;
    font-family: var(--font);
    font-size: 4.5rem;
    font-weight: 900;
    line-height: 1;
    background: var(--gold-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .t-note p {
    margin: 0 0 0.8em;
  }
  .t-note__sign {
    text-align: end;
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--teal-dark);
  }
  .t-hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    margin: 1.5rem 0 0;
    font-weight: 700;
  }

  .t-hero__video {
    margin: 0 auto;
    width: min(16rem, 70vw);
    text-align: center;
  }
  .phone {
    padding: 0.45rem;
    border-radius: 1.6rem;
    box-shadow: 0 18px 40px rgb(11 26 51 / 0.22);
    background: var(--gold-gradient); /* מסגרת זהב */
  }
  .phone :global(.yt-embed) {
    border-radius: 1.15rem;
  }
  .t-hero__video figcaption {
    margin-top: 0.75rem;
    font-weight: 700;
    color: var(--teal-dark);
  }

  /* כותרת אזור עם קו זהב קצר מתחת */
  .t-title::after {
    content: '';
    display: block;
    width: 3.5rem;
    height: 4px;
    margin-top: 0.6rem;
    border-radius: 2px;
    background: var(--gold-gradient);
  }

  .v-card__name {
    margin: 0.6rem 0 0;
    font-weight: 700;
    line-height: 1.3;
  }
  .v-card__role {
    margin: 0.15rem 0 0;
    font-size: 0.9rem;
    color: var(--teal-dark);
    line-height: 1.35;
  }

  /* צבע ההצללה בקצות הקרוסלה = צבע הרקע של האזור */
  .t-reviews {
    --carousel-bg: var(--mist);
  }
</style>
