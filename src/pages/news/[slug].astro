---
// כתובת קבועה לכל גיליון של המבזק החודשי (לשיתוף בוואטסאפ ובפייסבוק). העיצוב ב-src/components/NewsIssue.astro,
// הנתונים ב-src/data/news.ts. הגיליון החדש מוצג גם ישירות ב-/news/ (נוגה: בלי "עמוד שמוביל לעמוד").
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsIssue from '../../components/NewsIssue.astro';
import { issues, type Issue } from '../../data/news';

export function getStaticPaths() {
  return issues.map((issue) => ({ params: { slug: issue.slug }, props: { issue } }));
}

const { issue } = Astro.props as { issue: Issue };
---

<BaseLayout
  title={`המבזק החודשי, ${issue.month}`}
  description={`המבזק החודשי של נוגה דיין אור, ${issue.month}. ${issue.headline}`}
  crumbs={[
    { name: 'בית', path: '/' },
    { name: 'המבזק החודשי', path: '/news/' },
    { name: issue.month, path: `/news/${issue.slug}/` },
  ]}
  ogType="article"
>
  <NewsIssue issue={issue} />
</BaseLayout>
