---
// עמוד גיליון של המבזק השבועי (נוגה, 2026-11-17). הנתונים ב-src/data/news.ts
// מבנה: ראש גיליון (בסגנון עיתון) ← "בגיליון הזה" ← חלק 1 המשק והעסקים ← חלק 2 אצל נוגה (עדכונים ובקרוב) ← הרשמה לדיוור
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShareBar from '../../components/ShareBar.astro';
import Star from '../../components/Star.astro';
import Icon from '../../components/Icon.astro';
import { issues, hebDate, type Issue } from '../../data/news';
import { contact } from '../../data/contact';

export function getStaticPaths() {
  return issues.map((issue) => ({ params: { slug: issue.slug }, props: { issue } }));
}

const { issue } = Astro.props as { issue: Issue };
const d = hebDate(issue.date);

// תמונות העדכונים מתוך src/assets (המפתח בנתונים: "תיקייה/קובץ")
const assets = import.meta.glob<{ default: ImageMetadata }>('/src/assets/**/*.{webp,jpg,jpeg,png}', { eager: true });
const img = (p?: string) => (p ? assets[`/src/assets/${p}`]?.default : undefined);

// אירוע שהתאריך שלו עבר לא מוצג (נבדק בזמן הבנייה)
const today = new Date().toISOString().slice(0, 10);
const events = issue.events.filter((e) => e.date >= today || e.date >= issue.date);

const newer = issues.find((i) => i.number === issue.number + 1);
const older = issues.find((i) => i.number === issue.number - 1);
const pad = (n: number) => String(n).padStart(2, '0');
---

<BaseLayout
  title={`המבזק השבועי, ${d.full}`}
  description={`גיליון ${issue.number} של המבזק השבועי של נוגה דיין אור. ${issue.headline}`}
  crumbs={[
    { name: 'בית', path: '/' },
    { name: 'המבזק השבועי', path: '/news/' },
    { name: `גיליון ${issue.number}`, path: `/news/${issue.slug}/` },
  ]}
  ogType="article"
>
  <!-- ראש הגיליון -->
  <header class="nw-mast">
    <div class="container nw-mast__inner">
      <p class="nw-mast__crumbs"><a href="/news/">כל הגיליונות</a></p>
      <h1 class="nw-mast__title">המבזק השבועי</h1>
      <p class="nw-mast__sub">מה שחשוב לדעת השבוע במשק ובעסקים, ומה זה אומר לעסק שלך</p>
      <div class="nw-mast__rule">
        <span>גיליון {issue.number}</span>
        <Star size={14} />
        <time datetime={issue.date}>{d.full}</time>
      </div>
    </div>
  </header>

  <!-- בגיליון הזה -->
  <nav class="nw-toc container" aria-label="בגיליון הזה">
    <div class="nw-toc__col">
      <h2 class="nw-toc__title no-grad"><a href="#economy">המשק והעסקים</a></h2>
      <ol>
        {issue.economy.map((n, i) => (
          <li><a href={`#${n.id}`}><span class="nw-toc__n">{pad(i + 1)}</span>{n.title}</a></li>
        ))}
      </ol>
    </div>
    <div class="nw-toc__col">
      <h2 class="nw-toc__title no-grad"><a href="#noga">אצל נוגה</a></h2>
      <ol>
        {issue.updates.map((u) => <li><a href={`#${u.id}`}><Star size={11} />{u.title}</a></li>)}
        {events.length > 0 && <li><a href="#soon"><Star size={11} />בקרוב</a></li>}
      </ol>
    </div>
  </nav>

  <!-- חלק 1: המשק והעסקים -->
  <section id="economy" class="section nw-part" aria-labelledby="economy-title">
    <div class="container nw-narrow">
      <h2 id="economy-title" class="nw-part__title">המשק והעסקים</h2>
      {issue.economy.map((n, i) => (
        <article id={n.id} class="nw-item">
          <span class="nw-item__n" aria-hidden="true">{pad(i + 1)}</span>
          <div class="nw-item__body">
            <h3 class="nw-item__title">{n.title}</h3>
            <p class="nw-item__topic">{n.topic}</p>
            <p class="nw-item__text">{n.text}</p>
            <div class="nw-biz">
              <p class="nw-biz__title"><Star size={14} /> מה זה אומר לעסק שלך</p>
              <p class="nw-biz__text">{n.forBusiness}</p>
            </div>
            <p class="nw-item__src">
              <span>מקור</span>
              {n.sources.map((s) => (
                <a href={s.url} target="_blank" rel="noopener">{s.label}<span class="sr-only"> (נפתח בלשונית חדשה)</span></a>
              ))}
            </p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- חלק 2: אצל נוגה -->
  <section id="noga" class="section section--mist nw-part" aria-labelledby="noga-title">
    <div class="container">
      <h2 id="noga-title" class="nw-part__title nw-part__title--center">אצל נוגה</h2>
      <div class="nw-updates">
        {issue.updates.map((u) => {
          const im = img(u.image);
          const isToon = u.image?.startsWith('character/');
          return (
            <article id={u.id} class="nw-up">
              <div class:list={['nw-up__media', isToon && 'nw-up__media--toon']}>
                {im ? (
                  <Image src={im} alt="" widths={[480, 800]} sizes="(min-width: 60rem) 30vw, 100vw" class:list={[isToon && 'toon']} />
                ) : (
                  <div class="nw-up__ph">{u.imagePending ?? 'תמונה'}</div>
                )}
              </div>
              <div class="nw-up__body">
                <h3 class="nw-up__title">{u.title}</h3>
                <p>{u.text}</p>
                {u.draft && <p class="nw-draft">{u.draft}</p>}
                {u.link && (
                  <a class="nw-up__link" href={u.link.href} target={u.link.external ? '_blank' : undefined} rel={u.link.external ? 'noopener' : undefined}>
                    {u.link.label} <span aria-hidden="true">←</span>
                  </a>
                )}
              </div>
            </article>
          );
        })}
      </div>

      {events.length > 0 && (
        <div id="soon" class="nw-soon">
          <h3 class="nw-soon__title">בקרוב</h3>
          <ul class="nw-events">
            {events.map((e) => {
              const ed = hebDate(e.date);
              return (
                <li id={e.id} class="nw-ev">
                  <div class="nw-ev__date" aria-hidden="true">
                    <span class="nw-ev__day">{ed.day}</span>
                    <span class="nw-ev__month">{ed.month}</span>
                  </div>
                  <div class="nw-ev__body">
                    <p class="nw-ev__meta">
                      <time datetime={e.date}>{ed.full}</time>
                      {e.time && <> · {e.time}</>} · {e.where}
                    </p>
                    <h4 class="nw-ev__title">{e.title}</h4>
                    <p>{e.text}</p>
                    {e.draft && <p class="nw-draft">{e.draft}</p>}
                  </div>
                  {e.link && (
                    <a class="btn nw-ev__btn" href={e.link.href} target="_blank" rel="noopener">
                      {e.link.label}<span class="sr-only"> ל{e.title} (נפתח בלשונית חדשה)</span>
                    </a>
                  )}
                </li>
              );
            })}
          </ul>
        </div>
      )}
    </div>
  </section>

  <!-- הרשמה ושיתוף -->
  <section class="section nw-end">
    <div class="container">
      <div class="nw-sub">
        <Icon name="mail" size={30} />
        <h2 class="nw-sub__title">המבזק הבא, ישר למייל</h2>
        <p>פעם בשבוע, הידיעות שחשוב לעסק להכיר, בקצרה ועם המקורות</p>
        <div class="nw-sub__actions">
          <a class="btn" href="/contact/#news-title">להרשמה לדיוור</a>
          <a class="btn btn--ghost nw-sub__ghost" href={contact.whatsappGroup} target="_blank" rel="noopener">
            לקבוצת הוואטסאפ<span class="sr-only"> (נפתח בלשונית חדשה)</span>
          </a>
        </div>
      </div>
      <div class="nw-share">
        <ShareBar title={`המבזק השבועי של נוגה דיין אור, ${d.full}`} print={false} />
      </div>
      {(newer || older) && (
        <nav class="nw-pager" aria-label="גיליונות נוספים">
          {newer && <a href={`/news/${newer.slug}/`}>→ גיליון {newer.number}</a>}
          {older && <a href={`/news/${older.slug}/`}>גיליון {older.number} ←</a>}
        </nav>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  /* ראש הגיליון: כחול כהה, שם גדול, ופס תאריך בין שני קווי זהב, כמו ראש עיתון */
  .nw-mast {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(60rem 22rem at 85% -10%, rgb(12 138 168 / 0.35), transparent 60%),
      radial-gradient(40rem 18rem at 10% 120%, rgb(209 154 74 / 0.18), transparent 60%),
      var(--navy);
    color: var(--on-dark);
    text-align: center;
  }
  .nw-mast__inner {
    padding-block: 1.25rem 2.5rem;
  }
  .nw-mast__crumbs {
    margin: 0 0 1.5rem;
    text-align: start;
    font-size: 0.95rem;
  }
  .nw-mast__crumbs a {
    color: var(--on-dark-soft);
  }
  .nw-mast__title {
    margin: 0;
    font-size: clamp(2.4rem, 7vw, 4.4rem);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--white);
  }
  .nw-mast__sub {
    margin: 0.75rem auto 0;
    max-width: 36rem;
    font-size: clamp(1.05rem, 2.2vw, 1.25rem);
    color: var(--on-dark-soft);
  }
  .nw-mast__rule {
    margin: 1.75rem auto 0;
    max-width: 34rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    padding-block: 0.6rem;
    border-block: 1px solid var(--gold-dark);
    box-shadow: 0 -4px 0 -3px var(--gold-dark), 0 4px 0 -3px var(--gold-dark);
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--gold-light);
  }

  /* בגיליון הזה */
  .nw-toc {
    display: grid;
    gap: 1.5rem;
    margin-block: 2.5rem 0;
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
    box-shadow: 0 10px 30px -18px rgb(11 26 51 / 0.35);
    max-width: 62rem;
  }
  @media (min-width: 48rem) {
    .nw-toc {
      grid-template-columns: 1.4fr 1fr;
      padding: 1.75rem 2rem;
    }
    .nw-toc__col + .nw-toc__col {
      border-inline-start: 1px solid var(--line);
      padding-inline-start: 2rem;
    }
  }
  .nw-toc__title {
    margin: 0 0 0.6rem;
    font-size: 1.15rem;
  }
  .nw-toc__title a {
    color: var(--teal-dark);
    text-decoration: none;
  }
  .nw-toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
  }
  .nw-toc li a {
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
    color: var(--navy);
    text-decoration: none;
    line-height: 1.4;
  }
  .nw-toc li a:hover {
    color: var(--teal-dark);
  }
  .nw-toc li :global(svg) {
    flex: none;
    transform: translateY(0.1em);
  }
  .nw-toc__n {
    flex: none;
    font-weight: 800;
    color: var(--gold-dark);
    font-variant-numeric: tabular-nums;
  }

  /* כותרות החלקים */
  .nw-part__title {
    margin: 0 0 1.5rem;
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    padding-bottom: 0.6rem;
    border-bottom: 3px solid var(--navy);
  }
  .nw-part__title--center {
    text-align: center;
    border-bottom: 0;
  }
  .nw-narrow {
    max-width: 52rem;
  }

  /* ידיעה */
  .nw-item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0 1.25rem;
    padding-block: 2rem;
    border-bottom: 1px solid var(--line);
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }
  .nw-item:last-child {
    border-bottom: 0;
  }
  .nw-item__n {
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    font-weight: 900;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--gold-dark);
    font-variant-numeric: tabular-nums;
  }
  .nw-item__title {
    margin: 0;
    font-size: clamp(1.3rem, 2.8vw, 1.65rem);
    line-height: 1.3;
    color: var(--navy);
  }
  .nw-item__topic {
    margin: 0.35rem 0 0.9rem;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--teal-dark);
  }
  .nw-item__text {
    margin: 0 0 1.1rem;
    line-height: 1.75;
  }
  .nw-biz {
    padding: 1rem 1.25rem;
    border-radius: var(--radius);
    background: var(--mist);
    border-inline-start: 4px solid var(--teal);
  }
  .nw-biz__title {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0 0 0.35rem;
    font-weight: 800;
    color: var(--teal-dark);
  }
  .nw-biz__text {
    margin: 0;
    line-height: 1.7;
  }
  .nw-item__src {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1rem;
    margin: 0.9rem 0 0;
    font-size: 0.9rem;
    color: #4a5b73;
  }
  .nw-item__src > span {
    font-weight: 700;
  }
  .nw-item__src a {
    color: var(--teal-dark);
  }
  @media (max-width: 30rem) {
    .nw-item {
      grid-template-columns: 1fr;
    }
    .nw-item__n {
      margin-bottom: 0.4rem;
    }
  }

  /* אצל נוגה: עדכונים */
  .nw-updates {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 44rem) {
    .nw-updates {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .nw-up {
    display: flex;
    flex-direction: column;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: 0 12px 30px -20px rgb(11 26 51 / 0.4);
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }
  .nw-up__media {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--mist);
  }
  .nw-up__media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .nw-up__media--toon {
    background: var(--white);
  }
  .nw-up__media--toon :global(img) {
    object-position: 50% 8%;
  }
  .nw-up__ph {
    height: 100%;
    display: grid;
    place-items: center;
    padding: 1rem;
    border: 2px dashed var(--line);
    color: #6b7a90;
    font-weight: 600;
    text-align: center;
  }
  .nw-up__body {
    padding: 1.25rem 1.4rem 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .nw-up__title {
    margin: 0 0 0.5rem;
    font-size: 1.3rem;
    color: var(--navy);
  }
  .nw-up__body p {
    margin: 0 0 0.75rem;
    line-height: 1.7;
  }
  .nw-up__link {
    margin-top: auto;
    font-weight: 700;
    color: var(--teal-dark);
  }
  .nw-draft {
    padding: 0.5rem 0.75rem;
    border: 2px dashed var(--gold-dark);
    border-radius: 0.5rem;
    font-size: 0.9rem;
    color: #7a5a1e;
  }

  /* בקרוב */
  .nw-soon {
    margin-top: 3rem;
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }
  .nw-soon__title {
    margin: 0 0 1rem;
    font-size: 1.6rem;
    text-align: center;
    color: var(--navy);
  }
  .nw-events {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 56rem;
    display: grid;
    gap: 1rem;
  }
  .nw-ev {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem 1.25rem;
    align-items: center;
    padding: 1.25rem;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  @media (min-width: 44rem) {
    .nw-ev {
      grid-template-columns: auto 1fr auto;
      padding: 1.25rem 1.5rem;
    }
  }
  .nw-ev__date {
    display: grid;
    place-items: center;
    width: 4.6rem;
    padding: 0.55rem 0.3rem;
    border-radius: 0.6rem;
    background: var(--navy);
    color: var(--white);
    text-align: center;
  }
  .nw-ev__day {
    font-size: 1.9rem;
    font-weight: 900;
    line-height: 1;
    color: var(--gold-light);
  }
  .nw-ev__month {
    font-size: 0.85rem;
    font-weight: 700;
  }
  .nw-ev__meta {
    margin: 0 0 0.2rem;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--teal-dark);
  }
  .nw-ev__title {
    margin: 0 0 0.35rem;
    font-size: 1.25rem;
    color: var(--navy);
  }
  .nw-ev__body p:last-child {
    margin-bottom: 0;
  }
  .nw-ev__body p {
    margin: 0 0 0.5rem;
    line-height: 1.65;
  }
  .nw-ev__btn {
    grid-column: 1 / -1;
    justify-self: start;
  }
  @media (min-width: 44rem) {
    .nw-ev__btn {
      grid-column: auto;
    }
  }

  /* הרשמה: כרטיס כהה בתוך אזור בהיר, כי הפוטר כהה */
  .nw-sub {
    max-width: 46rem;
    margin: 0 auto;
    padding: 2.25rem 1.5rem;
    border-radius: calc(var(--radius) * 1.5);
    background:
      radial-gradient(30rem 14rem at 80% 0%, rgb(12 138 168 / 0.35), transparent 65%),
      var(--navy);
    color: var(--on-dark);
    text-align: center;
  }
  .nw-sub :global(svg) {
    color: var(--gold-light);
  }
  .nw-sub__title {
    margin: 0.5rem 0;
    font-size: clamp(1.6rem, 3.5vw, 2.1rem);
    color: var(--white);
  }
  .nw-sub p {
    margin: 0 0 1.25rem;
    color: var(--on-dark-soft);
  }
  .nw-sub__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }
  .nw-sub__ghost {
    color: var(--white);
    border-color: rgb(255 255 255 / 0.5);
  }
  .nw-share {
    display: flex;
    justify-content: center;
    margin-top: 1.5rem;
  }
  .nw-pager {
    display: flex;
    justify-content: space-between;
    margin-top: 1.5rem;
    font-weight: 700;
  }
  .nw-pager a {
    color: var(--teal-dark);
  }
</style>
