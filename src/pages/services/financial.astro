---
// ליווי פיננסי, עמוד משלו (נוגה, 2026-11-09): "לסדר את העמוד של הפיננסים", עסקי ומרשים.
// זה המקום היחיד באתר שמטפל ברווחיות ובתמחור. המהות: ההסתכלות הרחבה והאסטרטגית יחד עם התייעלות בתהליכי העבודה
// (גבייה, ניהול עובדים ועוד), שכולם תורמים לרווחיות. ניתוח הנתונים מגלה הכול, ואז מטפלים איפה שצריך.
// המומחים שנוגה מביאה לכל תחום לא נכתבים כאן (נוגה).
// סבב 2 (נוגה, 2026-11-09): "כל החומרים הטובים למטה". הסדר: קריאה חזקה "בואו נעשה סדר ונמצא את הכסף בעסק שלך"
//   ← פסקת תועלת למי שנמאס לו מהסטרס ← מה מקבלים בסוף התהליך (כהה) ← העקרונות ← איך זה מתבצע (תהליך)
//   ← על מה עובדים (מנופי הרווחיות, כהה) ← 20 שנה בבנק (זהב) ← סיום (כרטיס כהה בתוך אזור בהיר, כי הפוטר כהה).
// "מכל שקל שנכנס, כמה באמת נשאר?" אוחד לתוך כרטיסי המנופים (שורת "איפה הכסף מתפספס").
// הטקסטים ב-src/data/finance.ts. **טיוטה לאישור נוגה.**
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Star from '../../components/Star.astro';
import Timeline from '../../components/Timeline.astro';
import { serviceBySlug } from '../../data/services';
import { outcomes, principles, financeSteps, levers } from '../../data/finance';
import { contact } from '../../data/contact';
import { serviceSchema } from '../../utils/schema';
import desk from '../../assets/atmosphere/light-desk.webp';

const s = serviceBySlug('financial')!;
const wa = (text: string) => `${contact.whatsapp}?text=${encodeURIComponent(text)}`;
const waHref = wa('היי נוגה, אשמח לשמוע על ליווי פיננסי');
const num = (i: number) => String(i + 1).padStart(2, '0');

// גובה העמודות בלוח הנתונים המצויר (אחוזים, רק איור, בלי מספרים על המסך)
const bars = [38, 46, 41, 55, 62, 58, 74, 86];

const description =
  'ליווי פיננסי לשיפור רווחיות ותזרים. עושים סדר במספרים ומוצאים את הכסף בעסק, בתמחור, בגבייה, במימון ומחזור הלוואות, בעלויות, בתהליכי העבודה ובניהול העובדים.';
const path = '/services/financial/';
const schema = [serviceSchema(Astro.site, { name: s.title, description, path })];
const crumbs = [
  { name: 'בית', path: '/' },
  { name: 'שירותים', path: '/services/' },
  { name: s.title, path },
];
---

<BaseLayout title={s.title} description={description} schema={schema} crumbs={crumbs}>
  <!-- 1. פתיח: הקריאה החזקה בימין, ובשמאל "לוח נתונים" מצויר מעל תמונת השולחן -->
  <section class="fn-hero">
    <div class="fn-hero__bg" aria-hidden="true">
      <Image src={desk} alt="" widths={[640, 1024, 1600]} sizes="(min-width: 60rem) 60vw, 100vw" loading="eager" />
    </div>
    <div class="container fn-hero__grid">
      <div class="fn-hero__text">
        <p class="fn-crumbs"><a href="/services/">שירותים</a> <span aria-hidden="true">/</span> {s.title}</p>
        <h1 class="fn-hero__title">
          <span class="sr-only">{s.title} </span>{' '}<span>בואו נעשה סדר</span>{' '}<span class="fn-hero__mark">ונמצא את הכסף בעסק שלך</span>
        </h1>
        <p class="fn-hero__lead">
          ניתוח הנתונים מגלה איפה הכסף נמצא, איפה הוא מתפספס ומה מעכב את התזרים. משם מטפלים בדיוק איפה שצריך.
        </p>
        <div class="fn-actions">
          <a class="btn" href={waHref} target="_blank" rel="noopener">
            לשיחת היכרות<span class="sr-only"> (נפתח בלשונית חדשה)</span>
          </a>
          <a class="fn-actions__link" href="#outcomes">מה מקבלים בסוף?</a>
        </div>
      </div>

      <!-- לוח נתונים מצויר: איור בלבד, בלי מספרים, ולכן מוסתר מקוראי מסך -->
      <div class="dash reveal" aria-hidden="true">
        <div class="dash__head">
          <span class="dash__dots"><i></i><i></i><i></i></span>
          <span class="dash__name">תמונת מצב</span>
        </div>
        <div class="dash__chart">
          {bars.map((h, i) => <span class="dash__bar" style={`--h: ${h}%; --i: ${i}`} />)}
          <svg class="dash__line" viewBox="0 0 100 100" preserveAspectRatio="none">
            <path d="M4 70 L17 62 L30 66 L43 52 L56 44 L69 47 L82 30 L96 16" />
          </svg>
        </div>
        <ul class="dash__rows">
          <li><span>רווחיות לפי שירות</span><span class="dash__meter"><i style="--w: 78%"></i></span></li>
          <li><span>גבייה בזמן</span><span class="dash__meter dash__meter--teal"><i style="--w: 64%"></i></span></li>
          <li><span>תזרים מתוכנן</span><span class="dash__meter"><i style="--w: 88%"></i></span></li>
        </ul>
        <p class="dash__tag"><Icon name="chart" size={16} /> החלטות מבוססות נתונים</p>
      </div>
    </div>
  </section>

  <!-- 2. פסקת תועלת: פס תכלת צר, הטקסט לרוחב העמוד (נוגה, 2026-11-09: שהחלקים המשמעותיים יתחילו מהר יותר) -->
  <section class="fn-explain">
    <div class="container fn-explain__inner reveal">
      <p>
        העסק עובד, יש לקוחות ויש הכנסות, ובכל זאת הכסף מרגיש כמו מקור קבוע ללחץ. בודקים את חשבון הבנק לפני כל החלטה,
        מחכים לתשלומים שמתעכבים, ולא בטוחים מה באמת מרוויח.{' '}
        <strong>הגיע הזמן לעשות סדר פעם אחת ולתמיד</strong>, ולהחליף את הסטרס בשליטה, בשקט ובזמן פנוי לנהל ולהצמיח את
        העסק.
      </p>
    </div>
  </section>

  <!-- 3. מה מקבלים בסוף התהליך -->
  <section class="section section--deep fn-outcomes" id="outcomes" aria-labelledby="outcomes-title">
    <div class="container">
      <div class="center reveal">
        <h2 id="outcomes-title" class="sec-title fn-split">
          <span>עסק מסודר</span>{' '}<span class="hl">שהכסף בו עובד בשבילך</span>
        </h2>
      </div>
      <ul class="gains">
        {
          outcomes.map((o, i) => (
            <li class="gain reveal" style={`transition-delay: ${(i % 3) * 0.1}s`}>
              <span class="gain__icon">
                <Icon name={o.icon} size={30} />
              </span>
              <h3 class="gain__title">{o.title}</h3>
              <p class="gain__text">{o.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 4. העקרונות -->
  <section class="section fn-principles" aria-labelledby="principles-title">
    <div class="container">
      <div class="center reveal">
        <h2 id="principles-title" class="sec-title fn-split">
          <span>ארבעה עקרונות</span>{' '}<span class="hl--mark">שעושים את ההבדל</span>
        </h2>
      </div>
      <ol class="rules">
        {
          principles.map((p, i) => (
            <li class="rule reveal" style={`transition-delay: ${i * 0.1}s`}>
              <span class="rule__num" aria-hidden="true">{num(i)}</span>
              <h3 class="rule__title">{p.title}</h3>
              <p class="rule__text">{p.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 5. איך זה מתבצע -->
  <section class="section section--mist fn-process" aria-labelledby="process-title">
    <div class="container">
      <div class="center reveal">
        <h2 id="process-title" class="sec-title fn-split">
          <span>מהנתונים</span>{' '}<span class="hl--mark">אל השורה התחתונה</span>
        </h2>
      </div>
      <Timeline items={financeSteps} />
    </div>
  </section>

  <!-- 6. על מה עובדים: מנופי הרווחיות, ובכל אחד איפה הכסף מתפספס -->
  <section class="section section--deep fn-levers" aria-labelledby="levers-title">
    <div class="container">
      <div class="center reveal">
        <h2 id="levers-title" class="sec-title fn-split">
          <span>מטפלים בכל מקום</span>{' '}<span class="hl">שבו הכסף מתפספס</span>
        </h2>
      </div>
      <ul class="levers">
        {
          levers.map((l, i) => (
            <li class="lever reveal" style={`transition-delay: ${(i % 3) * 0.1}s`}>
              <span class="lever__icon">
                <Icon name={l.icon} size={28} />
              </span>
              <h3 class="lever__title">{l.title}</h3>
              <p class="lever__leak">{l.leak}</p>
              <ul class="lever__points">
                {l.points.map((p) => (
                  <li>
                    <Star size={16} />
                    <span>{p}</span>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 7. הניסיון בבנק -->
  <section class="fn-band">
    <div class="container fn-band__inner reveal">
      <span class="fn-band__big">20 שנה</span>
      <span class="fn-band__text">בהנהלה של בנק גדול, והיכרות מבפנים עם הדרך שבה בנק מסתכל על עסק</span>
    </div>
  </section>

  <!-- 8. סיום: כרטיס כהה בתוך אזור בהיר -->
  <section class="section section--mist fn-end" aria-labelledby="end-title">
    <div class="container">
      <div class="fn-end__card reveal">
        <Star size={30} />
        <h2 id="end-title" class="fn-end__title">
          <span>הכסף כבר נמצא בעסק</span>{' '}<span class="hl">בואו נמצא אותו יחד</span>
        </h2>
        <p class="fn-end__text">שיחת היכרות בוואטסאפ, ומשם בוחרים יחד מאיפה מתחילים.</p>
        <a class="btn fn-end__btn" href={waHref} target="_blank" rel="noopener">
          לשיחת היכרות בוואטסאפ<span class="sr-only"> (נפתח בלשונית חדשה)</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- פתיח ---------- */
  .fn-hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, var(--white), var(--mist));
    border-bottom: 1px solid var(--line);
  }
  .fn-hero__bg {
    position: absolute;
    inset: 0;
    /* בטלפון התמונה מאחורי הטקסט, ולכן עדינה מאוד */
    opacity: 0.18;
  }
  @media (min-width: 60rem) {
    .fn-hero__bg {
      opacity: 0.55;
    }
  }
  .fn-hero__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left bottom;
    -webkit-mask-image: linear-gradient(to left, transparent 35%, #000 85%);
    mask-image: linear-gradient(to left, transparent 35%, #000 85%);
  }
  .fn-hero__grid {
    position: relative;
    display: grid;
    gap: 2.5rem;
    padding-block: 2.5rem 3rem;
  }
  @media (min-width: 60rem) {
    .fn-hero__grid {
      grid-template-columns: 1.15fr 0.85fr;
      align-items: center;
      gap: clamp(2rem, 5vw, 5rem);
      min-height: min(78vh, 38rem);
      padding-block: 3.5rem;
    }
  }
  .fn-crumbs {
    margin: 0 0 0.75rem;
    font-size: 0.95rem;
    color: #4a5b73;
  }
  .fn-crumbs a {
    color: var(--teal-dark);
    font-weight: 700;
  }
  .fn-hero__title {
    margin: 0 0 1.25rem;
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    font-weight: 900;
    line-height: 1.12;
    color: var(--navy);
  }
  .fn-hero__title > span {
    display: block;
    text-wrap: balance;
  }
  .fn-hero__kicker {
    margin-bottom: 0.6rem;
    font-size: clamp(1.05rem, 2.2vw, 1.25rem);
    font-weight: 800;
    line-height: 1.3;
    color: var(--gold-dark);
  }
  .fn-hero__mark {
    color: var(--teal-dark);
  }
  .fn-hero__lead {
    max-width: 36rem;
    margin: 0 0 1.75rem;
    font-size: clamp(1.1rem, 2vw, 1.25rem);
    line-height: 1.75;
    color: #33445c;
  }
  .fn-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }
  .fn-actions__link {
    font-weight: 800;
    color: var(--teal-dark);
  }

  /* ---------- לוח הנתונים המצויר ---------- */
  /* בטלפון ובטאבלט הוא לא מוצג, כדי שהחלקים המשמעותיים יתחילו מהר (נוגה, 2026-11-09) */
  @media (max-width: 59.99rem) {
    .dash {
      display: none;
    }
  }
  .dash {
    position: relative;
    width: min(100%, 26rem);
    margin-inline: auto;
    padding: 1.25rem 1.35rem 1.4rem;
    border-radius: 1.5rem;
    color: var(--on-dark);
    background:
      radial-gradient(18rem 12rem at 100% 0, rgb(25 154 181 / 0.35), transparent 70%),
      radial-gradient(14rem 10rem at 0 100%, rgb(209 154 74 / 0.2), transparent 72%),
      var(--navy-deep);
    box-shadow: 0 2rem 4rem -1.5rem rgb(11 26 51 / 0.55);
  }
  .dash__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }
  .dash__dots {
    display: inline-flex;
    gap: 0.35rem;
  }
  .dash__dots i {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 0.15rem;
    background: rgb(255 255 255 / 0.25);
  }
  .dash__dots i:first-child {
    background: var(--gold-light);
  }
  .dash__name {
    font-weight: 800;
    font-size: 0.95rem;
    color: var(--white);
  }
  .dash__chart {
    position: relative;
    display: flex;
    align-items: flex-end;
    gap: 0.45rem;
    height: 9.5rem;
    padding: 0.5rem 0.25rem 0;
    border-bottom: 1px solid rgb(255 255 255 / 0.18);
    /* קווי רשת עדינים */
    background: repeating-linear-gradient(180deg, transparent 0 calc(25% - 1px), rgb(255 255 255 / 0.07) calc(25% - 1px) 25%);
    /* ציר הזמן בגרף נקרא משמאל לימין, גם בעמוד בעברית */
    direction: ltr;
  }
  .dash__bar {
    flex: 1;
    height: var(--h);
    border-radius: 0.35rem 0.35rem 0.1rem 0.1rem;
    background: linear-gradient(180deg, rgb(25 154 181 / 0.95), rgb(25 154 181 / 0.35));
    transform-origin: bottom;
    transition: transform 0.9s cubic-bezier(0.22, 0.61, 0.36, 1);
    transition-delay: calc(var(--i) * 0.07s + 0.2s);
  }
  .dash__bar:last-of-type {
    background: var(--gold-gradient);
  }
  .js .dash:not(.is-in) .dash__bar {
    transform: scaleY(0.08);
  }
  .dash__line {
    position: absolute;
    inset: 0.5rem 0.25rem 0;
    width: calc(100% - 0.5rem);
    height: calc(100% - 0.5rem);
    overflow: visible;
  }
  .dash__line path {
    fill: none;
    stroke: var(--gold-light);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 200;
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 1.4s ease 0.5s;
  }
  .js .dash:not(.is-in) .dash__line path {
    stroke-dashoffset: 200;
  }
  .dash__rows {
    list-style: none;
    margin: 1.1rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.7rem;
  }
  .dash__rows li {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.9rem;
    color: var(--on-dark-soft);
  }
  .dash__meter {
    height: 0.5rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.1);
    overflow: hidden;
  }
  .dash__meter i {
    display: block;
    width: var(--w);
    height: 100%;
    border-radius: inherit;
    background: var(--gold-gradient);
    transition: width 1s ease 0.6s;
  }
  .dash__meter--teal i {
    background: var(--teal);
  }
  .js .dash:not(.is-in) .dash__meter i {
    width: 0;
  }
  .dash__tag {
    position: absolute;
    inset-block-end: -1.1rem;
    inset-inline-start: 1.25rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background: var(--white);
    border: 1px solid var(--line);
    box-shadow: 0 0.75rem 1.5rem -0.75rem rgb(11 26 51 / 0.35);
    font-size: 0.9rem;
    font-weight: 800;
    color: var(--navy);
  }

  /* ---------- פסקת תועלת: פס תכלת צר, הטקסט לרוחב העמוד ---------- */
  .fn-explain {
    padding-block: clamp(1.5rem, 3.5vw, 2.25rem);
    background: var(--mist);
    border-bottom: 1px solid var(--line);
  }
  .fn-explain__inner p {
    max-width: 72rem;
    margin: 0 auto;
    text-align: center;
    font-size: clamp(1.05rem, 1.8vw, 1.2rem);
    line-height: 1.8;
    color: #33445c;
  }
  .fn-explain__inner strong {
    font-weight: 800;
    color: var(--teal-dark);
  }

  /* ---------- כותרות אזור ---------- */
  .fn-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 0.6rem;
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--teal-dark);
  }
  .fn-eyebrow::before,
  .fn-eyebrow::after {
    content: '';
    width: 2rem;
    height: 2px;
    border-radius: 2px;
    background: var(--gold-gradient);
  }
  .fn-eyebrow--dark {
    color: var(--gold-light);
  }
  .fn-split {
    margin-bottom: 2.25rem;
  }
  .fn-split > span {
    display: table;
    margin-inline: auto;
  }

  /* ---------- מה מקבלים: רשימה פתוחה בלי קופסאות, עם קווים מפרידים ---------- */
  .gains {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: auto auto 1fr;
    column-gap: clamp(1.5rem, 4vw, 3.5rem);
  }
  @media (max-width: 62rem) {
    .gains {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 36rem) {
    .gains {
      grid-template-columns: 1fr;
    }
  }
  .gain {
    display: grid;
    grid-template-rows: subgrid;
    grid-row: span 3;
    row-gap: 0.5rem;
    margin: 0;
    padding-block: 1.6rem;
    border-top: 1px solid rgb(255 255 255 / 0.14);
  }
  .gain__icon {
    color: var(--gold-light);
  }
  .gain__title {
    margin: 0;
    font-size: clamp(1.3rem, 2.4vw, 1.55rem);
    font-weight: 900;
    line-height: 1.25;
    color: var(--white);
  }
  .gain__text {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--on-dark-soft);
  }

  /* ---------- העקרונות: מספר זהב גדול, בלי קופסאות ---------- */
  .rules {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: auto auto 1fr;
    gap: 0 clamp(1.25rem, 3vw, 2.5rem);
  }
  @media (max-width: 62rem) {
