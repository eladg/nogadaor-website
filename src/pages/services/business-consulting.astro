---
// אסטרטגיה ושיווק, עמוד משלו (נוגה, 2026-11-10). יצא מהתבנית [slug].astro, כמו שאר עמודי השירות.
// סבב 7: **כל הטקסט הוא של נוגה, מילה במילה** (src/data/strategy.ts). נוגה אהבה את העיצוב של סבב 6
// (כותרת דביקה בצד, קו זהב ומספרים גדולים, רשימות עם קווים, בלי קופסאות), והוא משמש כאן לכל האזורים.
// הסדר לפי הטקסט שלה: פתיח ← משקיעים הרבה ← להבין, לזהות, לגרום לזה לקרות (4 שלבים) ← לבחור לאן העסק הולך
//   ← מה אפשר לקדם יחד (כהה) ← מה התהליך מאפשר ← שאלות נפוצות ← מחברים את מה שצריך ← הגיע הזמן.
// בלי תוויות קטנות מעל הכותרות (נוגה).
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Star from '../../components/Star.astro';
import Faq from '../../components/Faq.astro';
import { serviceBySlug, type Service } from '../../data/services';
import { hero, pains, approach, strategy, topics, enables, strategyFaq, connect, end } from '../../data/strategy';
import { contact } from '../../data/contact';
import { serviceSchema } from '../../utils/schema';
import whiteboard from '../../assets/atmosphere/light-whiteboard.webp';

const s = serviceBySlug('business-consulting')!;
const waHref = `${contact.whatsapp}?text=${encodeURIComponent('היי נוגה, אשמח לתאם שיחת היכרות על אסטרטגיה ושיווק')}`;
const num = (i: number) => String(i + 1).padStart(2, '0');
const connectLinks = connect.links.map(serviceBySlug).filter((x): x is Service => Boolean(x));

const description =
  'ייעוץ ופיתוח עסקי להגדלת הכנסות. לזהות הזדמנויות, לקבל החלטות ולבנות יחד את המהלכים שיאפשרו לעסק שלך לעלות מדרגה, באסטרטגיה, בשיווק, במכירות ובניהול לקוחות.';
const path = '/services/business-consulting/';
const schema = [serviceSchema(Astro.site, { name: s.title, description, path })];
const crumbs = [
  { name: 'בית', path: '/' },
  { name: 'שירותים', path: '/services/' },
  { name: s.title, path },
];
---

<BaseLayout title={s.title} description={description} schema={schema} crumbs={crumbs}>
  <!-- 1. פתיח -->
  <section class="st-hero">
    <div class="st-hero__bg" aria-hidden="true">
      <Image src={whiteboard} alt="" widths={[640, 1024, 1600]} sizes="100vw" loading="eager" />
    </div>
    <div class="container st-hero__inner">
      <p class="st-crumbs"><a href="/services/">שירותים</a> <span aria-hidden="true">/</span> {s.title}</p>
      <h1 class="st-hero__title">
        <span>{hero.title}</span>{' '}<span class="st-hero__mark">{hero.titleMark}</span>
      </h1>
      {hero.paras.map((p, i) => <p class:list={['st-hero__lead', { 'st-hero__lead--strong': i === 1 }]}>{p}</p>)}
      <div class="st-actions">
        <a class="btn" href={waHref} target="_blank" rel="noopener">
          {hero.cta}<span class="sr-only"> (נפתח בלשונית חדשה)</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 2. משקיעים הרבה: כותרת בצד ורשימה עם קווים -->
  <section class="section st-now" aria-labelledby="pains-title">
    <div class="container st-now__grid">
      <h2 id="pains-title" class="st-now__title reveal">
        <span>{pains.title}</span>{' '}<span class="hl--mark">{pains.titleMark}</span>
      </h2>
      <ul class="now-list">
        {
          pains.items.map((c, i) => (
            <li class="reveal" style={`transition-delay: ${i * 0.1}s`}>
              {c}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 3. להבין את העסק, לזהות מה יקדם אותו, לגרום לזה לקרות: כותרת דביקה ו-4 שלבים על קו זהב -->
  <section class="section section--mist st-rules" aria-labelledby="approach-title">
    <div class="container st-rules__grid">
      <div class="st-rules__head">
        <h2 id="approach-title" class="st-rules__title reveal">
          {approach.title.map((t, i) => (
            <>
              <span class:list={[{ 'hl--mark': i === approach.title.length - 1 }]}>{t}</span>{' '}
            </>
          ))}
        </h2>
        <a class="btn st-rules__btn reveal" href={waHref} target="_blank" rel="noopener">
          {hero.cta}<span class="sr-only"> (נפתח בלשונית חדשה)</span>
        </a>
      </div>
      <ol class="rules">
        {
          approach.steps.map((p, i) => (
            <li class="rule reveal">
              <span class="rule__num" aria-hidden="true">{num(i)}</span>
              <p class="rule__text">{p}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 4. לבחור לאן העסק הולך ואיך מגיעים לשם: עמודה עריכתית, וארבע ההחלטות בשורה -->
  <section class="section st-strategy" aria-labelledby="strategy-title">
    <div class="container st-strategy__inner">
      <h2 id="strategy-title" class="sec-title st-split reveal">
        <span>{strategy.title}</span>{' '}<span class="hl--mark">{strategy.titleMark}</span>
      </h2>
      <p class="st-strategy__lead reveal">{strategy.lead}</p>
      {strategy.paras.map((p) => <p class="st-strategy__text reveal">{p}</p>)}
      <div class="decisions reveal">
        <p class="decisions__lead">{strategy.decisionsLead}</p>
        <ul class="decisions__list">
          {strategy.decisions.map((d) => <li>{d}</li>)}
        </ul>
      </div>
      <p class="st-strategy__text st-strategy__close reveal">{strategy.close}</p>
    </div>
  </section>

  <!-- 5. מה אפשר לקדם יחד (כהה) -->
  <section class="section section--deep st-areas" id="areas" aria-labelledby="areas-title">
    <div class="container">
      <div class="center reveal">
        <h2 id="areas-title" class="sec-title st-split">{topics.title}</h2>
      </div>
      <ul class="areas">
        {
          topics.items.map((a, i) => (
            <li class="area reveal" style={`transition-delay: ${(i % 3) * 0.1}s`}>
              <span class="area__icon">
                <Icon name={a.icon} size={28} />
              </span>
              <h3 class="area__title">{a.title}</h3>
              <p class="area__text">{a.text}</p>
            </li>
          ))
        }
      </ul>
      <p class="st-areas__note reveal">{topics.note}</p>
    </div>
  </section>

  <!-- 6. מה התהליך מאפשר: כותרת בצד ורשימה עם קווים -->
  <section class="section st-now" aria-labelledby="enables-title">
    <div class="container st-now__grid">
      <h2 id="enables-title" class="st-now__title reveal">
        <span class="hl--mark">{enables.title}</span>
      </h2>
      <ul class="now-list now-list--check">
        {
          enables.items.map((c, i) => (
            <li class="reveal" style={`transition-delay: ${i * 0.08}s`}>
              <Icon name="check" size={18} />
              <span>{c}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 7. שאלות נפוצות -->
  <section class="section section--mist st-faq">
    <div class="container st-faq__inner">
      <Faq items={strategyFaq} />
    </div>
  </section>

  <!-- 8. מחברים את מה שצריך כדי להתקדם, עם קישורים לשלושת השירותים שנוגה הזכירה -->
  <section class="section st-connect" aria-labelledby="connect-title">
    <div class="container st-connect__inner reveal">
      <h2 id="connect-title" class="st-connect__title">{connect.title}</h2>
      <p class="st-connect__text">{connect.text}</p>
      <ul class="st-connect__links">
        {
          connectLinks.map((r) => (
            <li>
              <a href={r.href}>
                <Icon name={r.icon} size={20} />
                <span>{r.title}</span>
                <span aria-hidden="true">←</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 9. הגיע הזמן לקפיצת המדרגה שלך: סיום פתוח, בלי כרטיס -->
  <section class="section section--mist st-end" aria-labelledby="end-title">
    <div class="container st-end__inner reveal">
      <Star size={30} />
      <h2 id="end-title" class="st-end__title">
        <span>{end.title}</span>{' '}<span class="hl--mark">{end.titleMark}</span>
      </h2>
      <p class="st-end__text">{end.text}</p>
      <a class="btn st-end__btn" href={waHref} target="_blank" rel="noopener">
        {end.cta}<span class="sr-only"> (נפתח בלשונית חדשה)</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- פתיח ---------- */
  .st-hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, var(--white), var(--mist));
    border-bottom: 1px solid var(--line);
  }
  .st-hero__bg {
    position: absolute;
    inset: 0;
    opacity: 0.16;
  }
  @media (min-width: 60rem) {
    .st-hero__bg {
      opacity: 0.5;
    }
  }
  .st-hero__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left center;
    -webkit-mask-image: linear-gradient(to left, transparent 35%, #000 85%);
    mask-image: linear-gradient(to left, transparent 35%, #000 85%);
  }
  .st-hero__inner {
    position: relative;
    padding-block: 2.5rem 3rem;
  }
  @media (min-width: 60rem) {
    .st-hero__inner {
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: min(52vh, 26rem);
      padding-block: 3.5rem;
    }
    .st-hero__inner > * {
      max-width: 40rem;
    }
  }
  .st-crumbs {
    margin: 0 0 0.75rem;
    font-size: 0.95rem;
    color: #4a5b73;
  }
  .st-crumbs a {
    color: var(--teal-dark);
    font-weight: 700;
  }
  .st-hero__title {
    margin: 0 0 1.25rem;
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    font-weight: 900;
    line-height: 1.12;
    color: var(--navy);
  }
  .st-hero__title > span {
    display: block;
    text-wrap: balance;
  }
  .st-hero__mark {
    color: var(--teal-dark);
  }
  .st-hero__lead {
    max-width: 36rem;
    margin: 0 0 1.75rem;
    font-size: clamp(1.1rem, 2vw, 1.25rem);
    line-height: 1.75;
    color: #33445c;
  }
  .st-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }
  .st-actions__link {
    font-weight: 800;
    color: var(--teal-dark);
  }

  /* ---------- כותרות אזור ---------- */
  .st-split {
    margin-bottom: 2.25rem;
  }
  .st-split > span {
    display: table;
    margin-inline: auto;
  }

  .st-lead {
    max-width: 44rem;
    margin: -1.25rem auto 2.25rem;
  }

  /* ---------- על מה עובדים: כרטיסי זכוכית, הכול באותו גובה ---------- */
  .areas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: auto auto auto 1fr;
    gap: 0 1.25rem;
  }
  @media (max-width: 62rem) {
    .areas {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 36rem) {
    .areas {
      grid-template-columns: 1fr;
    }
  }
  .area {
    display: grid;
    grid-template-rows: subgrid;
    grid-row: span 4;
    row-gap: 0.5rem;
    margin: 0 0 1.25rem;
    padding: 1.5rem;
    border-radius: 1.25rem;
    background: rgb(255 255 255 / 0.05);
    border: 1px solid rgb(255 255 255 / 0.12);
    border-top: 3px solid var(--teal);
  }
  .area:nth-child(even) {
    border-top-color: var(--gold-dark);
  }
  .area__icon {
    color: var(--gold-light);
  }
  .area__title {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 900;
    color: var(--white);
  }
  .area__gain {
    margin: 0;
    font-size: 1.08rem;
    line-height: 1.5;
    color: var(--gold-light);
  }
  .area__points {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0.85rem 0 0;
    border-top: 1px solid rgb(255 255 255 / 0.12);
    display: grid;
    gap: 0.45rem;
    align-content: start;
  }
  .area__points li {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
    line-height: 1.45;
    color: var(--on-dark);
  }
  .area__points :global(svg) {
    flex: none;
    margin-top: 0.2rem;
    color: var(--teal);
  }

  /* ---------- מה השתנה: כותרת גדולה בצד, רשימה פתוחה עם קווים, ומשפט סיום ---------- */
  .st-now__grid {
    display: grid;
    gap: 1.75rem;
    align-items: start;
  }
  @media (min-width: 60rem) {
    .st-now__grid {
      grid-template-columns: 0.9fr 1.1fr;
      gap: clamp(2.5rem, 6vw, 5rem);
    }
  }
  .st-now__title {
    margin: 0;
    font-size: clamp(2rem, 4.6vw, 3rem);
    font-weight: 900;
    line-height: 1.15;
  }
  .st-now__title > span {
    display: table;
  }
  .now-list {
    list-style: none;
    margin: 0 0 1.75rem;
    padding: 0;
  }
  .now-list li {
    position: relative;
    padding: 0.95rem 0;
    padding-inline-start: 1.6rem;
    border-bottom: 1px solid var(--line);
    font-size: clamp(1.05rem, 1.9vw, 1.2rem);
    line-height: 1.55;
    color: #33445c;
  }
  .now-list li:first-child {
    border-top: 1px solid var(--line);
  }
  .now-list li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: 1.55rem;
    width: 0.7rem;
    height: 2px;
    background: var(--teal);
  }
  .st-now__punch {
    margin: 0;
    font-size: clamp(1.15rem, 2.2vw, 1.4rem);
    font-weight: 500;
    line-height: 1.6;
    color: var(--navy);
  }

  /* ---------- העקרונות: כותרת דביקה בצד, רשימה עם קו זהב ומספרים גדולים ---------- */
  .st-rules__grid {
    display: grid;
    gap: 2rem;
    align-items: start;
  }
  @media (min-width: 60rem) {
    .st-rules__grid {
      grid-template-columns: 0.8fr 1.2fr;
      gap: clamp(3rem, 6vw, 5.5rem);
    }
    .st-rules__head {
      position: sticky;
      top: calc(var(--header-h, 4.5rem) + 2rem);
    }
  }
  .st-rules__title {
    margin: 0 0 1rem;
    font-size: clamp(2rem, 4.6vw, 3rem);
    font-weight: 900;
    line-height: 1.15;
  }
  .st-rules__title > span {
    display: table;
  }
  .st-rules__lead {
    margin: 0 0 1.5rem;
    max-width: 26rem;
    font-size: clamp(1.05rem, 1.8vw, 1.15rem);
    line-height: 1.7;
    color: #33445c;
  }
  /* בטלפון הכפתור כבר בסיום העמוד */
  @media (max-width: 59.99rem) {
    .st-rules__btn {
      display: none;
    }
  }
  .rules {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* קו זהב שעובר לאורך כל העקרונות */
  .rules::before {
    content: '';
    position: absolute;
    inset-block: 1.5rem;
    inset-inline-start: 2.1rem;
    width: 2px;
    background: linear-gradient(180deg, var(--gold-light), var(--teal) 55%, var(--gold-dark));
    opacity: 0.55;
  }
  .rule {
    position: relative;
    display: grid;
    grid-template-columns: 4.2rem 1fr;
    gap: 1.25rem;
    padding-block: 1.6rem;
  }
  .rule + .rule {
    border-top: 1px solid var(--line);
  }
  .rule__num {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    height: 4.2rem;
    font-size: 2.6rem;
    font-weight: 900;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 2px var(--gold-dark);
    background: var(--mist);
  }
  .rule:nth-child(even) .rule__num {
    -webkit-text-stroke-color: var(--teal);
  }
  .rule__title {
    margin: 0.35rem 0 0.45rem;
    font-size: clamp(1.35rem, 2.6vw, 1.7rem);
    font-weight: 900;
    line-height: 1.25;
    color: var(--navy);
  }
  .rule__text {
    margin: 0;
    align-self: center;
    max-width: 40rem;
    font-size: 1.08rem;
    line-height: 1.75;
    color: #33445c;
  }
  /* הקומות: ארבע מילים שעולות במדרגות, האסטרטגיה למעלה */
  .ladder {
    list-style: none;
    margin: 1.1rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column-reverse;
    gap: 0.35rem;
  }
  .ladder li {
    margin-inline-start: calc(var(--j) * 1.6rem);
    padding-inline-start: 0.9rem;
    border-inline-start: 3px solid var(--line);
    font-weight: 700;
    line-height: 1.6;
    color: #5a6b82;
  }
  .ladder li:last-child {
    border-inline-start-color: var(--gold-dark);
    font-size: 1.15rem;
    font-weight: 900;
    color: var(--teal-dark);
  }

  /* ---------- סיום פתוח ---------- */
  .st-end__inner {
    text-align: center;
  }
  .st-end__title {
    margin: 0.5rem 0 1rem;
    font-size: clamp(1.8rem, 4.4vw, 2.6rem);
    font-weight: 900;
    line-height: 1.25;
  }
  .st-end__title > span {
    display: table;
    margin-inline: auto;
  }
  .st-end__text {
    margin: 0 0 1.75rem;
    font-size: 1.1rem;
    color: #33445c;
  }
  .st-end__btn {
    font-size: 1.1rem;
  }
  /* ---------- פתיח: שתי הפסקאות של נוגה ---------- */
  .st-hero__lead {
    max-width: 40rem;
    margin: 0 0 1rem;
    font-size: clamp(1.05rem, 1.9vw, 1.2rem);
    line-height: 1.75;
    color: #33445c;
  }
  .st-hero__lead--strong {
    margin-bottom: 1.75rem;
    color: var(--navy);
  }

  /* ---------- רשימה עם וי (מה התהליך מאפשר) ---------- */
  .now-list--check li {
    display: flex;
    gap: 0.65rem;
    align-items: flex-start;
    padding-inline-start: 0;
  }
  .now-list--check li::before {
    display: none;
  }
  .now-list--check :global(svg) {
    flex: none;
    margin-top: 0.3rem;
    color: var(--gold-dark);
  }

  /* ---------- לבחור לאן העסק הולך: עמודה עריכתית אחת ---------- */
  .st-strategy__inner {
    max-width: 50rem;
    text-align: center;
  }
  .st-strategy__lead {
    margin: -0.75rem auto 1.25rem;
    font-size: clamp(1.25rem, 2.6vw, 1.6rem);
    font-weight: 600;
    line-height: 1.5;
    color: var(--navy);
  }
  .st-strategy__text {
    margin: 0 auto 1rem;
    font-size: clamp(1.05rem, 1.8vw, 1.15rem);
    line-height: 1.85;
    color: #33445c;
  }
  .st-strategy__close {
    margin-bottom: 0;
  }
  /* ארבע ההחלטות: שורה טיפוגרפית בין שני קווי זהב, בלי קופסאות */
  .decisions {
    margin: 2rem auto;
    padding-block: 1.35rem;
    border-block: 1px solid var(--gold-dark);
  }
  .decisions__lead {
    margin: 0 0 0.85rem;
    font-weight: 700;
    color: var(--teal-dark);
  }
  .decisions__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 0;
  }
  .decisions__list li {
    padding-inline: 1.1rem;
    font-size: clamp(1.15rem, 2.4vw, 1.45rem);
    font-weight: 900;
    color: var(--navy);
  }
  .decisions__list li + li {
