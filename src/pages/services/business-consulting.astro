---
// אסטרטגיה ושיווק, עמוד משלו (נוגה, 2026-11-09). יצא מהתבנית [slug].astro, כמו שאר עמודי השירות.
// סבב 6: כותרת שנוגה בחרה, בלי משפט מתחתיה ← "מה שעבד אתמול / כבר לא מספיק היום" (השינויים של השנה האחרונה,
//   וחזרה עדינה על המסר של עמוד הבית) ← "כל מה שמביא לקוחות / ומגדיל מכירות" (כהה, נוגה: "החלק הזה טוב")
//   ← שישה עקרונות בעיצוב פתוח, בלי קופסאות (כותרת דביקה בצד, ורשימה עם קו זהב ומספרים גדולים) ← סיום פתוח.
// בלי תוויות קטנות מעל הכותרות, בלי הדמיה בפתיח ובלי איור גשר (נוגה). הטקסטים ב-src/data/strategy.ts. **טיוטה לאישור נוגה.**
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Star from '../../components/Star.astro';
import { serviceBySlug } from '../../data/services';
import { changes, strategyAreas, principles } from '../../data/strategy';
import { contact } from '../../data/contact';
import { serviceSchema } from '../../utils/schema';
import whiteboard from '../../assets/atmosphere/light-whiteboard.webp';

const s = serviceBySlug('business-consulting')!;
const waHref = `${contact.whatsapp}?text=${encodeURIComponent('היי נוגה, אשמח לשמוע על אסטרטגיה ושיווק')}`;
const num = (i: number) => String(i + 1).padStart(2, '0');

const description =
  'יסודות אסטרטגיים ברורים שמוציאים מהשיווק את המקסימום. אסטרטגיה ושיווק מבפנים החוצה, בידול ומסרים, ניהול לקוחות חכם, מותג וקהילה, להגדלת הכנסות ושיפור רווחיות.';
const path = '/services/business-consulting/';
const schema = [serviceSchema(Astro.site, { name: s.title, description, path })];
const crumbs = [
  { name: 'בית', path: '/' },
  { name: 'שירותים', path: '/services/' },
  { name: s.title, path },
];
---

<BaseLayout title={s.title} description={description} schema={schema} crumbs={crumbs}>
  <!-- 1. פתיח: הכותרת שנוגה בחרה, בלי משפט מתחתיה -->
  <section class="st-hero">
    <div class="st-hero__bg" aria-hidden="true">
      <Image src={whiteboard} alt="" widths={[640, 1024, 1600]} sizes="100vw" loading="eager" />
    </div>
    <div class="container st-hero__inner">
      <p class="st-crumbs"><a href="/services/">שירותים</a> <span aria-hidden="true">/</span> {s.title}</p>
      <h1 class="st-hero__title">
        <span>יסודות אסטרטגיים ברורים</span>{' '}<span class="st-hero__mark">מוציאים מהשיווק את המקסימום</span>
      </h1>
      <div class="st-actions">
        <a class="btn" href={waHref} target="_blank" rel="noopener">
          לשיחת היכרות<span class="sr-only"> (נפתח בלשונית חדשה)</span>
        </a>
        <a class="st-actions__link" href="#areas">מה משתפר בעסק?</a>
      </div>
    </div>
  </section>

  <!-- 2. מה השתנה בשנה האחרונה, וחזרה עדינה על המסר של עמוד הבית -->
  <section class="section st-now" aria-labelledby="now-title">
    <div class="container st-now__grid">
      <h2 id="now-title" class="st-now__title reveal">
        <span>מה שעבד אתמול</span>{' '}<span class="hl--mark">כבר לא מספיק היום</span>
      </h2>
      <div class="st-now__body">
        <ul class="now-list">
          {
            changes.map((c, i) => (
              <li class="reveal" style={`transition-delay: ${i * 0.1}s`}>
                {c}
              </li>
            ))
          }
        </ul>
        <p class="st-now__punch reveal">
          דווקא עכשיו, כשהעולם משתנה בקצב מהיר, זה הזמן של העסק שלך לגדול, להגדיל הכנסות ולשפר רווחיות, עם אסטרטגיה ושיווק
          שמתאימים לשוק של היום ולא לשוק של אתמול.
        </p>
      </div>
    </div>
  </section>

  <!-- 3. מה משתפר בעסק: 6 תחומים, ובכל אחד מה העסק מרוויח (נוגה: "החלק הזה טוב") -->
  <section class="section section--deep st-areas" id="areas" aria-labelledby="areas-title">
    <div class="container">
      <div class="center reveal">
        <h2 id="areas-title" class="sec-title st-split">
          <span>כל מה שמביא לקוחות</span>{' '}<span class="hl">ומגדיל מכירות</span>
        </h2>
      </div>
      <ul class="areas">
        {
          strategyAreas.map((a, i) => (
            <li class="area reveal" style={`transition-delay: ${(i % 3) * 0.1}s`}>
              <span class="area__icon">
                <Icon name={a.icon} size={28} />
              </span>
              <h3 class="area__title">{a.title}</h3>
              <p class="area__gain">{a.gain}</p>
              <ul class="area__points">
                {a.points.map((p) => (
                  <li>
                    <Icon name="check" size={16} />
                    <span>{p}</span>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 4. העקרונות: כותרת דביקה בצד, ורשימה פתוחה עם קו זהב ומספרים גדולים, בלי קופסאות -->
  <section class="section st-rules" aria-labelledby="rules-title">
    <div class="container st-rules__grid">
      <div class="st-rules__head">
        <h2 id="rules-title" class="st-rules__title reveal">
          <span>אסטרטגיה ושיווק</span>{' '}<span class="hl--mark">מבפנים החוצה</span>
        </h2>
        <p class="st-rules__lead reveal">שישה עקרונות שעליהם נבנים יסודות אסטרטגיים ברורים, ששיווק טוב יכול לעמוד עליהם.</p>
        <a class="btn st-rules__btn reveal" href={waHref} target="_blank" rel="noopener">
          לשיחת היכרות<span class="sr-only"> (נפתח בלשונית חדשה)</span>
        </a>
      </div>
      <ol class="rules">
        {
          principles.map((p, i) => (
            <li class="rule reveal">
              <span class="rule__num" aria-hidden="true">{num(i)}</span>
              <div class="rule__body">
                <h3 class="rule__title">{p.title}</h3>
                <p class="rule__text">{p.text}</p>
                {p.ladder && (
                  <ol class="ladder" aria-label="הקומות, מלמטה למעלה">
                    {p.ladder.map((step, j) => (
                      <li style={`--j: ${j}`}>{step}</li>
                    ))}
                  </ol>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 5. סיום פתוח, בלי כרטיס -->
  <section class="section section--mist st-end" aria-labelledby="end-title">
    <div class="container st-end__inner reveal">
      <Star size={30} />
      <h2 id="end-title" class="st-end__title">
        <span>העסק שלך יכול להגיע</span>{' '}<span class="hl--mark">הרבה יותר רחוק</span>
      </h2>
      <p class="st-end__text">שיחת היכרות בוואטסאפ, ומשם בוחרים יחד את המהלך הראשון.</p>
      <a class="btn st-end__btn" href={waHref} target="_blank" rel="noopener">
        לשיחת היכרות בוואטסאפ<span class="sr-only"> (נפתח בלשונית חדשה)</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- פתיח ---------- */
  .st-hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, var(--white), var(--mist));
    border-bottom: 1px solid var(--line);
  }
  .st-hero__bg {
    position: absolute;
    inset: 0;
    opacity: 0.16;
  }
  @media (min-width: 60rem) {
    .st-hero__bg {
      opacity: 0.5;
    }
  }
  .st-hero__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left center;
    -webkit-mask-image: linear-gradient(to left, transparent 35%, #000 85%);
    mask-image: linear-gradient(to left, transparent 35%, #000 85%);
  }
  .st-hero__inner {
    position: relative;
    padding-block: 2.5rem 3rem;
  }
  @media (min-width: 60rem) {
    .st-hero__inner {
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: min(52vh, 26rem);
      padding-block: 3.5rem;
    }
    .st-hero__inner > * {
      max-width: 40rem;
    }
  }
  .st-crumbs {
    margin: 0 0 0.75rem;
    font-size: 0.95rem;
    color: #4a5b73;
  }
  .st-crumbs a {
    color: var(--teal-dark);
    font-weight: 700;
  }
  .st-hero__title {
    margin: 0 0 1.25rem;
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    font-weight: 900;
    line-height: 1.12;
    color: var(--navy);
  }
  .st-hero__title > span {
    display: block;
    text-wrap: balance;
  }
  .st-hero__mark {
    color: var(--teal-dark);
  }
  .st-hero__lead {
    max-width: 36rem;
    margin: 0 0 1.75rem;
    font-size: clamp(1.1rem, 2vw, 1.25rem);
    line-height: 1.75;
    color: #33445c;
  }
  .st-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }
  .st-actions__link {
    font-weight: 800;
    color: var(--teal-dark);
  }

  /* ---------- כותרות אזור ---------- */
  .st-split {
    margin-bottom: 2.25rem;
  }
  .st-split > span {
    display: table;
    margin-inline: auto;
  }

  .st-lead {
    max-width: 44rem;
    margin: -1.25rem auto 2.25rem;
  }

  /* ---------- על מה עובדים: כרטיסי זכוכית, הכול באותו גובה ---------- */
  .areas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: auto auto auto 1fr;
    gap: 0 1.25rem;
  }
  @media (max-width: 62rem) {
    .areas {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 36rem) {
    .areas {
      grid-template-columns: 1fr;
    }
  }
  .area {
    display: grid;
    grid-template-rows: subgrid;
    grid-row: span 4;
    row-gap: 0.5rem;
    margin: 0 0 1.25rem;
    padding: 1.5rem;
    border-radius: 1.25rem;
    background: rgb(255 255 255 / 0.05);
    border: 1px solid rgb(255 255 255 / 0.12);
    border-top: 3px solid var(--teal);
  }
  .area:nth-child(even) {
    border-top-color: var(--gold-dark);
  }
  .area__icon {
    color: var(--gold-light);
  }
  .area__title {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 900;
    color: var(--white);
  }
  .area__gain {
    margin: 0;
    font-size: 1.08rem;
    line-height: 1.5;
    color: var(--gold-light);
  }
  .area__points {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0.85rem 0 0;
    border-top: 1px solid rgb(255 255 255 / 0.12);
    display: grid;
    gap: 0.45rem;
    align-content: start;
  }
  .area__points li {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
    line-height: 1.45;
    color: var(--on-dark);
  }
  .area__points :global(svg) {
    flex: none;
    margin-top: 0.2rem;
    color: var(--teal);
  }

  /* ---------- מה השתנה: כותרת גדולה בצד, רשימה פתוחה עם קווים, ומשפט סיום ---------- */
  .st-now__grid {
    display: grid;
    gap: 1.75rem;
    align-items: start;
  }
  @media (min-width: 60rem) {
    .st-now__grid {
      grid-template-columns: 0.9fr 1.1fr;
      gap: clamp(2.5rem, 6vw, 5rem);
    }
  }
  .st-now__title {
    margin: 0;
    font-size: clamp(2rem, 4.6vw, 3rem);
    font-weight: 900;
    line-height: 1.15;
  }
  .st-now__title > span {
    display: table;
  }
  .now-list {
    list-style: none;
    margin: 0 0 1.75rem;
    padding: 0;
  }
  .now-list li {
    position: relative;
    padding: 0.95rem 0;
    padding-inline-start: 1.6rem;
    border-bottom: 1px solid var(--line);
    font-size: clamp(1.05rem, 1.9vw, 1.2rem);
    line-height: 1.55;
    color: #33445c;
  }
  .now-list li:first-child {
    border-top: 1px solid var(--line);
  }
  .now-list li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: 1.55rem;
    width: 0.7rem;
    height: 2px;
    background: var(--teal);
  }
  .st-now__punch {
    margin: 0;
    font-size: clamp(1.15rem, 2.2vw, 1.4rem);
    font-weight: 500;
    line-height: 1.6;
    color: var(--navy);
  }

  /* ---------- העקרונות: כותרת דביקה בצד, רשימה עם קו זהב ומספרים גדולים ---------- */
  .st-rules__grid {
    display: grid;
    gap: 2rem;
    align-items: start;
  }
  @media (min-width: 60rem) {
    .st-rules__grid {
      grid-template-columns: 0.8fr 1.2fr;
      gap: clamp(3rem, 6vw, 5.5rem);
    }
    .st-rules__head {
      position: sticky;
      top: calc(var(--header-h, 4.5rem) + 2rem);
    }
  }
  .st-rules__title {
    margin: 0 0 1rem;
    font-size: clamp(2rem, 4.6vw, 3rem);
    font-weight: 900;
    line-height: 1.15;
  }
  .st-rules__title > span {
    display: table;
  }
  .st-rules__lead {
    margin: 0 0 1.5rem;
    max-width: 26rem;
    font-size: clamp(1.05rem, 1.8vw, 1.15rem);
    line-height: 1.7;
    color: #33445c;
  }
  /* בטלפון הכפתור כבר בסיום העמוד */
  @media (max-width: 59.99rem) {
    .st-rules__btn {
      display: none;
    }
  }
  .rules {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* קו זהב שעובר לאורך כל העקרונות */
  .rules::before {
    content: '';
    position: absolute;
    inset-block: 1.5rem;
    inset-inline-start: 2.1rem;
    width: 2px;
    background: linear-gradient(180deg, var(--gold-light), var(--teal) 55%, var(--gold-dark));
    opacity: 0.55;
  }
  .rule {
    position: relative;
    display: grid;
    grid-template-columns: 4.2rem 1fr;
    gap: 1.25rem;
    padding-block: 1.6rem;
  }
  .rule + .rule {
    border-top: 1px solid var(--line);
  }
  .rule__num {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    height: 4.2rem;
    font-size: 2.6rem;
    font-weight: 900;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 2px var(--gold-dark);
    background: var(--white);
  }
  .rule:nth-child(even) .rule__num {
    -webkit-text-stroke-color: var(--teal);
  }
  .rule__title {
    margin: 0.35rem 0 0.45rem;
    font-size: clamp(1.35rem, 2.6vw, 1.7rem);
    font-weight: 900;
    line-height: 1.25;
    color: var(--navy);
  }
  .rule__text {
    margin: 0;
    max-width: 40rem;
    font-size: 1.08rem;
    line-height: 1.75;
    color: #33445c;
  }
  /* הקומות: ארבע מילים שעולות במדרגות, האסטרטגיה למעלה */
  .ladder {
    list-style: none;
    margin: 1.1rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column-reverse;
    gap: 0.35rem;
  }
  .ladder li {
    margin-inline-start: calc(var(--j) * 1.6rem);
    padding-inline-start: 0.9rem;
    border-inline-start: 3px solid var(--line);
    font-weight: 700;
    line-height: 1.6;
    color: #5a6b82;
  }
  .ladder li:last-child {
    border-inline-start-color: var(--gold-dark);
    font-size: 1.15rem;
    font-weight: 900;
    color: var(--teal-dark);
  }

  /* ---------- סיום פתוח ---------- */
  .st-end__inner {
    text-align: center;
  }
  .st-end__title {
    margin: 0.5rem 0 1rem;
    font-size: clamp(1.8rem, 4.4vw, 2.6rem);
    font-weight: 900;
    line-height: 1.25;
  }
  .st-end__title > span {
    display: table;
    margin-inline: auto;
  }
  .st-end__text {
    margin: 0 0 1.75rem;
    font-size: 1.1rem;
    color: #33445c;
  }
  .st-end__btn {
    font-size: 1.1rem;
  }
</style>
