---
// אסטרטגיה ושיווק, עמוד משלו (נוגה, 2026-11-09). יצא מהתבנית [slug].astro, כמו שאר עמודי השירות.
// סבב 4: המסרים מהפגישה עם שרון (drafts/strategy-messages-2026-11-09.md). ההדמיה בפתיח נמחקה ("מקטינה את המהות
// של האסטרטגיה"), ותוכן הגשר חזר בלי איור. בלי סלנג, מילים פשוטות, ערך כבר מהפגישה הראשונה, בלי סיפורים מהשטח.
// הסדר: פתיח ← פס הסבר (כל מומחה והפתרון שלו) ← העסק מבפנים והלקוחות מבחוץ ← מה משתפר בעסק (כהה, 6 תחומים)
//   ← לפני שמגדילים תקציב (כל הדרך של הלקוח) ← העתיד של העסקים (במקום / עושים) ← העקרונות ← סיום.
// בלי תוויות קטנות מעל הכותרות (נוגה). הטקסטים ב-src/data/strategy.ts. **טיוטה לאישור נוגה.**
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Star from '../../components/Star.astro';
import { serviceBySlug } from '../../data/services';
import { insideOut, strategyAreas, journey, shifts, strategyPrinciples } from '../../data/strategy';
import { contact } from '../../data/contact';
import { serviceSchema } from '../../utils/schema';
import whiteboard from '../../assets/atmosphere/light-whiteboard.webp';

const s = serviceBySlug('business-consulting')!;
const waHref = `${contact.whatsapp}?text=${encodeURIComponent('היי נוגה, אשמח לשמוע על אסטרטגיה ושיווק')}`;
const num = (i: number) => String(i + 1).padStart(2, '0');

const description =
  'אסטרטגיה ושיווק להגדלת המכירות מתוך העסק שכבר בנית. מבט מבחוץ, בידול ומסרים, הדרך מהפנייה ועד העסקה, לקוחות קיימים, הצעות, שיתופי פעולה, מותג וקהילה.';
const path = '/services/business-consulting/';
const schema = [serviceSchema(Astro.site, { name: s.title, description, path })];
const crumbs = [
  { name: 'בית', path: '/' },
  { name: 'שירותים', path: '/services/' },
  { name: s.title, path },
];
---

<BaseLayout title={s.title} description={description} schema={schema} crumbs={crumbs}>
  <!-- 1. פתיח: ההבטחה, על תמונת הלוח שנמוגה לטקסט -->
  <section class="st-hero">
    <div class="st-hero__bg" aria-hidden="true">
      <Image src={whiteboard} alt="" widths={[640, 1024, 1600]} sizes="100vw" loading="eager" />
    </div>
    <div class="container st-hero__inner">
      <p class="st-crumbs"><a href="/services/">שירותים</a> <span aria-hidden="true">/</span> {s.title}</p>
      <h1 class="st-hero__title">
        <span>יותר לקוחות ויותר מכירות</span>{' '}<span class="st-hero__mark">מתוך העסק שכבר בנית</span>
      </h1>
      <p class="st-hero__lead">
        מבט מבחוץ שמוצא את ההזדמנויות שקשה לראות מבפנים, ובוחר את המהלכים האסטרטגיים והשיווקיים שיביאו לעסק הכי הרבה
        ערך והכנסות.
      </p>
      <div class="st-actions">
        <a class="btn" href={waHref} target="_blank" rel="noopener">
          לשיחת היכרות<span class="sr-only"> (נפתח בלשונית חדשה)</span>
        </a>
        <a class="st-actions__link" href="#areas">מה משתפר בעסק?</a>
      </div>
    </div>
  </section>

  <!-- 2. פס הסבר: כל מומחה והפתרון שלו -->
  <section class="st-explain">
    <div class="container reveal">
      <p>
        בעלי עסקים שומעים המון רעיונות. מומחה לקמפיינים ממליץ על פרסום ממומן, מומחה לתוכן על עוד פוסטים, ומישהו אחר בטוח
        שהפתרון הוא אתר חדש או AI. כל רעיון נשמע הגיוני, ובסוף נשארת רשימה ארוכה בלי ודאות מה מתוכה מתאים לעסק שלך.{' '}
        <strong>אסטרטגיה טובה עושה סדר</strong>, ובוחרת את מה שנכון לעסק הזה, ללקוחות שלו ולתקופה הזו.
      </p>
    </div>
  </section>

  <!-- 3. העסק מבפנים והלקוחות מבחוץ: התפיסה של נוגה, בלי איור -->
  <section class="section st-io" aria-labelledby="io-title">
    <div class="container">
      <div class="center reveal">
        <h2 id="io-title" class="sec-title st-split">
          <span>שיווק טוב מחבר</span>{' '}<span class="hl--mark">בין העסק ללקוחות שלו</span>
        </h2>
        <p class="sec-lead st-io__lead">
          כל אסטרטגיה מתחילה מבפנים. כשמכירים לעומק את העסק ומבינים בדיוק את הלקוחות, המסרים, ההצעות והמכירות מתחברים.
        </p>
      </div>
      <div class="io reveal">
        {
          [insideOut.inside, insideOut.outside].map((side, i) => (
            <div class:list={['io__side', { 'io__side--out': i === 1 }]}>
              <h3 class="io__title">
                <Icon name={i === 0 ? 'compass' : 'users'} size={24} />
                {side.title}
              </h3>
              <ul>
                {side.items.map((it) => (
                  <li>{it}</li>
                ))}
              </ul>
            </div>
          ))
        }
        <p class="io__close">{insideOut.close}</p>
      </div>
    </div>
  </section>

  <!-- 4. מה משתפר בעסק: 6 תחומים, ובכל אחד מה העסק מרוויח -->
  <section class="section section--deep st-areas" id="areas" aria-labelledby="areas-title">
    <div class="container">
      <div class="center reveal">
        <h2 id="areas-title" class="sec-title st-split">
          <span>כל מה שמביא לקוחות</span>{' '}<span class="hl">ומגדיל מכירות</span>
        </h2>
      </div>
      <ul class="areas">
        {
          strategyAreas.map((a, i) => (
            <li class="area reveal" style={`transition-delay: ${(i % 3) * 0.1}s`}>
              <span class="area__icon">
                <Icon name={a.icon} size={28} />
              </span>
              <h3 class="area__title">{a.title}</h3>
              <p class="area__gain">{a.gain}</p>
              <ul class="area__points">
                {a.points.map((p) => (
                  <li>
                    <Icon name="check" size={16} />
                    <span>{p}</span>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 5. לפני שמגדילים תקציב: כל הדרך של הלקוח, מהפרסום ועד הקשר אחרי הקנייה -->
  <section class="section st-journey" aria-labelledby="journey-title">
    <div class="container st-journey__grid">
      <div class="reveal">
        <h2 id="journey-title" class="st-journey__title">
          <span>לפני שמגדילים את תקציב הפרסום</span>{' '}<span class="hl--mark">בודקים מה קורה אחרי שהלקוח פונה</span>
        </h2>
        <p class="st-journey__text">
          הרבה עסקים מנסים לגדול בעזרת עוד פרסום ועוד פניות. אבל כשהמסר לא מדויק, כשהשיחה הראשונה לא מסבירה מספיק, וכשהפגישה
          לא עונה על מה שהלקוח צריך, גם יותר פניות לא יהפכו ליותר לקוחות.
        </p>
        <p class="st-journey__text st-journey__text--strong">
          לכן בודקים את כל הדרך, מהפרסום ועד הקשר אחרי הקנייה, ומשפרים כל שלב. כך מגדילים מכירות בלי להגדיל את תקציב
          השיווק ובלי להוסיף עובדים.
        </p>
      </div>
      <ol class="journey">
        {
          journey.map((j, i) => (
            <li class="journey__step reveal" style={`transition-delay: ${i * 0.08}s`}>
              <span class="journey__num" aria-hidden="true">{num(i)}</span>
              <div>
                <h3 class="journey__name">{j.title}</h3>
                <p class="journey__q">{j.question}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 6. העתיד של העסקים: במקום / עושים -->
  <section class="section section--mist st-future" aria-labelledby="future-title">
    <div class="container st-future__grid">
      <div class="reveal">
        <h2 id="future-title" class="st-future__title">
          <span>העסקים שיובילו</span>{' '}<span class="hl--mark">הם העסקים שבתנועה</span>
        </h2>
        <p class="st-future__text">
          השוק משתנה מהר, והלקוחות מצפים ליותר. עסק חזק משלב פיתוח עסקי בעבודה השוטפת, ומייצר כל הזמן הצעות ערך, מבצעים
          ושיתופי פעולה חדשים, עם כלים חדשניים ומבט קדימה. זה לא דורש פרויקטים גדולים. זה דורש התמדה, חשיבה יצירתית
          והרבה עשייה.
        </p>
      </div>
      <ul class="shifts">
        {
          shifts.map((x, i) => (
            <li class="shift reveal" style={`transition-delay: ${i * 0.08}s`}>
              <span class="shift__from">
                <span class="shift__label">במקום</span>
                {x.from}
              </span>
              <span class="shift__arrow" aria-hidden="true">←</span>
              <span class="shift__to">{x.to}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 7. העקרונות -->
  <section class="section st-principles" aria-labelledby="principles-title">
    <div class="container">
      <div class="center reveal">
        <h2 id="principles-title" class="sec-title st-split">
          <span>כולם יודעים מה צריך לעשות</span>{' '}<span class="hl--mark">ההבדל הוא לגרום לזה לקרות</span>
        </h2>
      </div>
      <ol class="rules">
        {
          strategyPrinciples.map((p, i) => (
            <li class="rule reveal" style={`transition-delay: ${i * 0.1}s`}>
              <span class="rule__num" aria-hidden="true">{num(i)}</span>
              <h3 class="rule__title">{p.title}</h3>
              <p class="rule__text">{p.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 8. סיום: ההזמנה של נוגה להיכרות, בכרטיס כהה בתוך אזור בהיר -->
  <section class="section section--mist st-end" aria-labelledby="end-title">
    <div class="container">
      <div class="st-end__card reveal">
        <Star size={30} />
        <h2 id="end-title" class="st-end__title">
          <span>העסק שלך יכול להגיע</span>{' '}<span class="hl">הרבה יותר רחוק</span>
        </h2>
        <p class="st-end__text">שיחת היכרות בוואטסאפ, ומשם בוחרים יחד את המהלך הראשון.</p>
        <a class="btn st-end__btn" href={waHref} target="_blank" rel="noopener">
          לשיחת היכרות בוואטסאפ<span class="sr-only"> (נפתח בלשונית חדשה)</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- פתיח ---------- */
  .st-hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, var(--white), var(--mist));
    border-bottom: 1px solid var(--line);
  }
  .st-hero__bg {
    position: absolute;
    inset: 0;
    opacity: 0.16;
  }
  @media (min-width: 60rem) {
    .st-hero__bg {
      opacity: 0.5;
    }
  }
  .st-hero__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left center;
    -webkit-mask-image: linear-gradient(to left, transparent 35%, #000 85%);
    mask-image: linear-gradient(to left, transparent 35%, #000 85%);
  }
  .st-hero__inner {
    position: relative;
    padding-block: 2.5rem 3rem;
  }
  @media (min-width: 60rem) {
    .st-hero__inner {
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: min(66vh, 32rem);
      padding-block: 3.5rem;
    }
    .st-hero__inner > * {
      max-width: 40rem;
    }
  }
  .st-crumbs {
    margin: 0 0 0.75rem;
    font-size: 0.95rem;
    color: #4a5b73;
  }
  .st-crumbs a {
    color: var(--teal-dark);
    font-weight: 700;
  }
  .st-hero__title {
    margin: 0 0 1.25rem;
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    font-weight: 900;
    line-height: 1.12;
    color: var(--navy);
  }
  .st-hero__title > span {
    display: block;
    text-wrap: balance;
  }
  .st-hero__mark {
    color: var(--teal-dark);
  }
  .st-hero__lead {
    max-width: 36rem;
    margin: 0 0 1.75rem;
    font-size: clamp(1.1rem, 2vw, 1.25rem);
    line-height: 1.75;
    color: #33445c;
  }
  .st-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }
  .st-actions__link {
    font-weight: 800;
    color: var(--teal-dark);
  }

  /* ---------- פס הסבר: תכלת צר, הטקסט לרוחב העמוד ---------- */
  .st-explain {
    padding-block: clamp(1.5rem, 3.5vw, 2.25rem);
    background: var(--mist);
    border-bottom: 1px solid var(--line);
  }
  .st-explain p {
    max-width: 72rem;
    margin: 0 auto;
    text-align: center;
    font-size: clamp(1.05rem, 1.8vw, 1.2rem);
    line-height: 1.8;
    color: #33445c;
  }
  .st-explain strong {
    font-weight: 800;
    color: var(--teal-dark);
  }

  /* ---------- כותרות אזור ---------- */
  .st-split {
    margin-bottom: 2.25rem;
  }
  .st-split > span {
    display: table;
    margin-inline: auto;
  }

  /* ---------- העסק מבפנים והלקוחות מבחוץ: שני טורים, ופס כהה שמחבר ביניהם ---------- */
  .st-io__lead {
    max-width: 44rem;
    margin: -1.25rem auto 2.25rem;
  }
  .io {
    display: grid;
    max-width: 62rem;
    margin-inline: auto;
    border-radius: 1.5rem;
    overflow: hidden;
    border: 1px solid var(--line);
    box-shadow: 0 1.5rem 3rem -2rem rgb(11 26 51 / 0.35);
  }
  @media (min-width: 48rem) {
    .io {
      grid-template-columns: 1fr 1fr;
    }
  }
  .io__side {
    padding: clamp(1.4rem, 3vw, 2rem);
    background: var(--white);
    border-top: 4px solid var(--teal);
  }
  .io__side--out {
    background: var(--mist);
    border-top-color: var(--gold-dark);
  }
  .io__title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1rem;
    font-size: 1.4rem;
    font-weight: 900;
    color: var(--navy);
  }
  .io__title :global(svg) {
    color: var(--teal-dark);
  }
  .io__side--out .io__title :global(svg) {
    color: var(--gold-dark);
  }
  .io__side ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.75rem;
  }
  .io__side li {
    position: relative;
    padding-inline-start: 1.1rem;
    line-height: 1.55;
    color: #33445c;
  }
  .io__side li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: 0.6em;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 0.1rem;
    background: var(--teal);
    transform: rotate(45deg);
  }
  .io__side--out li::before {
    background: var(--gold-dark);
  }
  .io__close {
    grid-column: 1 / -1;
    margin: 0;
    padding: 1.1rem 1.5rem;
    text-align: center;
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    font-weight: 700;
    line-height: 1.5;
    color: var(--white);
    background:
      radial-gradient(20rem 8rem at 100% 0, rgb(25 154 181 / 0.35), transparent 70%),
      var(--navy-deep);
  }

  /* ---------- על מה עובדים: כרטיסי זכוכית, הכול באותו גובה ---------- */
  .areas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: auto auto auto 1fr;
    gap: 0 1.25rem;
  }
  @media (max-width: 62rem) {
    .areas {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 36rem) {
    .areas {
      grid-template-columns: 1fr;
    }
  }
  .area {
    display: grid;
    grid-template-rows: subgrid;
    grid-row: span 4;
    row-gap: 0.5rem;
    margin: 0 0 1.25rem;
    padding: 1.5rem;
    border-radius: 1.25rem;
    background: rgb(255 255 255 / 0.05);
    border: 1px solid rgb(255 255 255 / 0.12);
    border-top: 3px solid var(--teal);
  }
  .area:nth-child(even) {
    border-top-color: var(--gold-dark);
  }
  .area__icon {
    color: var(--gold-light);
  }
  .area__title {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 900;
    color: var(--white);
  }
  .area__gain {
    margin: 0;
    font-size: 1.08rem;
    line-height: 1.5;
    color: var(--gold-light);
  }
  .area__points {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0.85rem 0 0;
    border-top: 1px solid rgb(255 255 255 / 0.12);
    display: grid;
    gap: 0.45rem;
    align-content: start;
  }
  .area__points li {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
    line-height: 1.45;
    color: var(--on-dark);
  }
  .area__points :global(svg) {
    flex: none;
    margin-top: 0.2rem;
    color: var(--teal);
  }

  /* ---------- לפני שמגדילים תקציב: טקסט בימין, הדרך של הלקוח בשמאל ---------- */
  .st-journey__grid {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  @media (min-width: 60rem) {
    .st-journey__grid {
      grid-template-columns: 1fr 1.05fr;
      gap: clamp(2.5rem, 5vw, 4.5rem);
    }
  }
  .st-journey__title {
    margin: 0 0 1rem;
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    font-weight: 900;
    line-height: 1.2;
  }
  .st-journey__title > span {
    display: table;
  }
  .st-journey__text {
    margin: 0 0 1rem;
    font-size: clamp(1.05rem, 1.8vw, 1.15rem);
    line-height: 1.8;
    color: #33445c;
  }
  .st-journey__text--strong {
    margin: 0;
    padding-inline-start: 1rem;
    border-inline-start: 3px solid var(--gold-dark);
    color: var(--navy);
  }
  .journey {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
    display: grid;
    gap: 0.75rem;
  }
  /* קו שמחבר בין השלבים */
  .journey::before {
    content: '';
    position: absolute;
    inset-block: 1.5rem;
    inset-inline-start: 1.6rem;
    width: 2px;
    background: linear-gradient(180deg, var(--teal), var(--gold-dark));
    opacity: 0.5;
  }
  .journey__step {
    position: relative;
    display: grid;
    grid-template-columns: 3.2rem 1fr;
    gap: 1rem;
    align-items: start;
    padding: 1rem 1.25rem 1rem 1rem;
    border-radius: 1rem;
    background: var(--white);
    border: 1px solid var(--line);
  }
  .journey__num {
    display: grid;
    place-items: center;
    width: 2.6rem;
