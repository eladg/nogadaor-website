---
// אסטרטגיה ושיווק, עמוד משלו (נוגה, 2026-11-09). יצא מהתבנית [slug].astro, כמו שאר עמודי השירות.
// סבב 3: נוגה על הגרסה הקודמת "אחד העמודים המכוערים באתר, הגשר מזעזע, המסרים לא תועלתיים".
// לכן בלי איור הגשר (הרעיון שלה נשאר, במילים, בפסקת ההסבר), וכל ניסוח מדבר על מה שהלקוח מקבל.
// הסדר, לפי "כל עמוד חייב להתחיל הכי חזק ואז להגביר": פתיח עם הבטחה ותוכנית צמיחה מצוירת
//   ← פס הסבר (הבעיה והתשובה) ← על מה עובדים (כהה, 6 תחומים עם מה מרוויחים) ← העתיד של העסקים (במקום / עושים)
//   ← העקרונות ← התהליך ← סיום (כרטיס כהה בתוך אזור בהיר, כי הפוטר כהה).
// הטקסטים ב-src/data/strategy.ts. **טיוטה לאישור נוגה.**
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Star from '../../components/Star.astro';
import Timeline from '../../components/Timeline.astro';
import { serviceBySlug } from '../../data/services';
import { planMoves, strategyAreas, shifts, strategyPrinciples, strategySteps } from '../../data/strategy';
import { contact } from '../../data/contact';
import { serviceSchema } from '../../utils/schema';
import whiteboard from '../../assets/atmosphere/light-whiteboard.webp';

const s = serviceBySlug('business-consulting')!;
const waHref = `${contact.whatsapp}?text=${encodeURIComponent('היי נוגה, אשמח לשמוע על אסטרטגיה ושיווק')}`;
const num = (i: number) => String(i + 1).padStart(2, '0');

const description =
  'אסטרטגיה ושיווק להגדלת הכנסות מתוך העסק שכבר בנית. בידול, מסרים, הצעות ערך, ניהול לקוחות חכם, קהילה ומותג, במהלכים ממוקדים ויישומיים.';
const path = '/services/business-consulting/';
const schema = [serviceSchema(Astro.site, { name: s.title, description, path })];
const crumbs = [
  { name: 'בית', path: '/' },
  { name: 'שירותים', path: '/services/' },
  { name: s.title, path },
];
---

<BaseLayout title={s.title} description={description} schema={schema} crumbs={crumbs}>
  <!-- 1. פתיח: ההבטחה בימין, ובשמאל "תוכנית צמיחה" מצוירת מעל תמונת הלוח -->
  <section class="st-hero">
    <div class="st-hero__bg" aria-hidden="true">
      <Image src={whiteboard} alt="" widths={[640, 1024, 1600]} sizes="(min-width: 60rem) 60vw, 100vw" loading="eager" />
    </div>
    <div class="container st-hero__grid">
      <div>
        <p class="st-crumbs"><a href="/services/">שירותים</a> <span aria-hidden="true">/</span> {s.title}</p>
        <h1 class="st-hero__title">
          <span>יותר לקוחות ויותר הכנסות</span>{' '}<span class="st-hero__mark">מתוך העסק שכבר בנית</span>
        </h1>
        <p class="st-hero__lead">
          כל מומחה ממליץ על הפתרון שלו. כאן מתחילים מהעסק שלך, ובוחרים רק את המהלכים האסטרטגיים והשיווקיים שיביאו לו
          הכי הרבה ערך והכנסות.
        </p>
        <div class="st-actions">
          <a class="btn" href={waHref} target="_blank" rel="noopener">
            לשיחת היכרות<span class="sr-only"> (נפתח בלשונית חדשה)</span>
          </a>
          <a class="st-actions__link" href="#areas">על מה עובדים?</a>
        </div>
      </div>

      <!-- תוכנית צמיחה מצוירת: איור בלבד, ולכן מוסתר מקוראי מסך. מוצג רק במחשב. -->
      <div class="plan reveal" aria-hidden="true">
        <div class="plan__head">
          <span class="plan__name">תוכנית הצמיחה</span>
          <span class="plan__chip">הרבעון הקרוב</span>
        </div>
        <ul class="plan__moves">
          {
            planMoves.map((m, i) => (
              <li style={`--i: ${i}`}>
                <span class="plan__check">
                  <Icon name="check" size={14} />
                </span>
                {m}
              </li>
            ))
          }
        </ul>
        <svg class="plan__curve" viewBox="0 0 300 70" preserveAspectRatio="none">
          <path class="plan__area" d="M0 64 C60 60 90 52 130 44 S210 22 300 6 V70 H0 Z" />
          <path class="plan__line" d="M0 64 C60 60 90 52 130 44 S210 22 300 6" />
        </svg>
        <p class="plan__tag"><Star size={16} /> מהלכים ממוקדים, בלי פרויקטים מסובכים</p>
      </div>
    </div>
  </section>

  <!-- 2. פס הסבר: הבעיה (כל מומחה והפתרון שלו) והתשובה (הגשר של נוגה, במילים) -->
  <section class="st-explain">
    <div class="container reveal">
      <p>
        מומחה לקמפיינים ממליץ על ממומן, מומחה לתוכן על עוד פוסטים, ומישהו אחר בטוח שהפתרון הוא אתר חדש או AI. כל רעיון
        נשמע הגיוני, ובסוף נשארת רשימה ארוכה בלי ודאות מה באמת מתאים לעסק שלך.{' '}
        <strong>שיווק טוב מתחיל מבפנים</strong>, ממה שהעסק יודע לעשות הכי טוב, ומתחבר בדיוק למה שהלקוחות שלו צריכים.
      </p>
    </div>
  </section>

  <!-- 3. על מה עובדים: 6 תחומים, ובכל אחד מה העסק מרוויח -->
  <section class="section section--deep st-areas" id="areas" aria-labelledby="areas-title">
    <div class="container">
      <div class="center reveal">
        <p class="st-eyebrow st-eyebrow--dark">על מה עובדים</p>
        <h2 id="areas-title" class="sec-title st-split">
          <span>כל מה שמביא לקוחות</span>{' '}<span class="hl">וגורם להם להישאר</span>
        </h2>
      </div>
      <ul class="areas">
        {
          strategyAreas.map((a, i) => (
            <li class="area reveal" style={`transition-delay: ${(i % 3) * 0.1}s`}>
              <span class="area__icon">
                <Icon name={a.icon} size={28} />
              </span>
              <h3 class="area__title">{a.title}</h3>
              <p class="area__gain">{a.gain}</p>
              <ul class="area__points">
                {a.points.map((p) => (
                  <li>
                    <Icon name="check" size={16} />
                    <span>{p}</span>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 4. העתיד של העסקים: הדוגמה של נוגה, בניסוח אחר -->
  <section class="section st-future" aria-labelledby="future-title">
    <div class="container st-future__grid">
      <div class="reveal">
        <p class="st-eyebrow st-eyebrow--start">העתיד של העסקים</p>
        <h2 id="future-title" class="st-future__title">
          <span>העסקים שיובילו</span>{' '}<span class="hl--mark">הם העסקים שבתנועה</span>
        </h2>
        <p class="st-future__text">
          השוק משתנה מהר, והלקוחות מצפים ליותר. עסק חזק משלב פיתוח עסקי בעבודה השוטפת, ומייצר כל הזמן הצעות ערך, מבצעים
          ושיתופי פעולה חדשים, עם כלים חדשניים ומבט קדימה. זה לא דורש פרויקטים גדולים. זה דורש התמדה, חשיבה יצירתית
          והרבה עשייה.
        </p>
      </div>
      <ul class="shifts">
        {
          shifts.map((x, i) => (
            <li class="shift reveal" style={`transition-delay: ${i * 0.08}s`}>
              <span class="shift__from">
                <span class="shift__label">במקום</span>
                {x.from}
              </span>
              <span class="shift__arrow" aria-hidden="true">←</span>
              <span class="shift__to">{x.to}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 5. העקרונות -->
  <section class="section section--mist st-principles" aria-labelledby="principles-title">
    <div class="container">
      <div class="center reveal">
        <p class="st-eyebrow">איך עובדים</p>
        <h2 id="principles-title" class="sec-title st-split">
          <span>אסטרטגיה שנבנית</span>{' '}<span class="hl--mark">בדיוק בשביל העסק שלך</span>
        </h2>
      </div>
      <ol class="rules">
        {
          strategyPrinciples.map((p, i) => (
            <li class="rule reveal" style={`transition-delay: ${i * 0.1}s`}>
              <span class="rule__num" aria-hidden="true">{num(i)}</span>
              <h3 class="rule__title">{p.title}</h3>
              <p class="rule__text">{p.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 6. התהליך -->
  <section class="section st-process" aria-labelledby="process-title">
    <div class="container">
      <div class="center reveal">
        <p class="st-eyebrow">איך זה מתבצע</p>
        <h2 id="process-title" class="sec-title st-split">
          <span>מהיכרות עם העסק</span>{' '}<span class="hl--mark">למהלכים שיוצאים לדרך</span>
        </h2>
      </div>
      <Timeline items={strategySteps} />
    </div>
  </section>

  <!-- 7. סיום: ההזמנה של נוגה להיכרות, בכרטיס כהה בתוך אזור בהיר -->
  <section class="section section--mist st-end" aria-labelledby="end-title">
    <div class="container">
      <div class="st-end__card reveal">
        <Star size={30} />
        <h2 id="end-title" class="st-end__title">
          <span>העסק שלך יכול להגיע</span>{' '}<span class="hl">הרבה יותר רחוק</span>
        </h2>
        <p class="st-end__text">שיחת היכרות בוואטסאפ, ומשם בוחרים יחד את המהלך הראשון.</p>
        <a class="btn st-end__btn" href={waHref} target="_blank" rel="noopener">
          לשיחת היכרות בוואטסאפ<span class="sr-only"> (נפתח בלשונית חדשה)</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- פתיח ---------- */
  .st-hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, var(--white), var(--mist));
    border-bottom: 1px solid var(--line);
  }
  .st-hero__bg {
    position: absolute;
    inset: 0;
    opacity: 0.16;
  }
  @media (min-width: 60rem) {
    .st-hero__bg {
      opacity: 0.5;
    }
  }
  .st-hero__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left center;
    -webkit-mask-image: linear-gradient(to left, transparent 35%, #000 85%);
    mask-image: linear-gradient(to left, transparent 35%, #000 85%);
  }
  .st-hero__grid {
    position: relative;
    display: grid;
    gap: 2.5rem;
    padding-block: 2.5rem 3rem;
  }
  @media (min-width: 60rem) {
    .st-hero__grid {
      grid-template-columns: 1.15fr 0.85fr;
      align-items: center;
      gap: clamp(2rem, 5vw, 5rem);
      min-height: min(74vh, 36rem);
      padding-block: 3.5rem;
    }
  }
  .st-crumbs {
    margin: 0 0 0.75rem;
    font-size: 0.95rem;
    color: #4a5b73;
  }
  .st-crumbs a {
    color: var(--teal-dark);
    font-weight: 700;
  }
  .st-hero__title {
    margin: 0 0 1.25rem;
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    font-weight: 900;
    line-height: 1.12;
    color: var(--navy);
  }
  .st-hero__title > span {
    display: block;
    text-wrap: balance;
  }
  .st-hero__mark {
    color: var(--teal-dark);
  }
  .st-hero__lead {
    max-width: 36rem;
    margin: 0 0 1.75rem;
    font-size: clamp(1.1rem, 2vw, 1.25rem);
    line-height: 1.75;
    color: #33445c;
  }
  .st-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }
  .st-actions__link {
    font-weight: 800;
    color: var(--teal-dark);
  }

  /* ---------- תוכנית הצמיחה המצוירת (רק במחשב) ---------- */
  @media (max-width: 59.99rem) {
    .plan {
      display: none;
    }
  }
  .plan {
    position: relative;
    width: min(100%, 26rem);
    margin-inline: auto;
    padding: 1.35rem 1.4rem 1.6rem;
    border-radius: 1.5rem;
    color: var(--on-dark);
    background:
      radial-gradient(18rem 12rem at 100% 0, rgb(25 154 181 / 0.35), transparent 70%),
      radial-gradient(14rem 10rem at 0 100%, rgb(209 154 74 / 0.2), transparent 72%),
      var(--navy-deep);
    box-shadow: 0 2rem 4rem -1.5rem rgb(11 26 51 / 0.55);
  }
  .plan__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }
  .plan__name {
    font-weight: 900;
    font-size: 1.05rem;
    color: var(--white);
  }
  .plan__chip {
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 800;
    color: var(--navy);
    background: var(--gold-gradient);
  }
  .plan__moves {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }
  .plan__moves li {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.65rem 0.8rem;
    border-radius: 0.8rem;
    background: rgb(255 255 255 / 0.06);
    border: 1px solid rgb(255 255 255 / 0.1);
    font-size: 0.95rem;
    transition:
      opacity 0.5s ease,
      transform 0.5s ease;
    transition-delay: calc(var(--i) * 0.15s + 0.2s);
  }
  .js .plan:not(.is-in) .plan__moves li {
    opacity: 0;
    transform: translateX(-0.75rem);
  }
  .plan__check {
    flex: none;
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 0.45rem;
    background: var(--teal);
    color: var(--white);
  }
  .plan__moves li:nth-child(even) .plan__check {
    background: var(--gold-gradient);
    color: var(--navy);
  }
  .plan__curve {
    display: block;
    width: 100%;
    height: 4.5rem;
    margin-top: 1rem;
    /* הצמיחה עולה משמאל לימין, כמו בכל גרף, גם בעמוד בעברית */
  }
  .plan__area {
    fill: rgb(25 154 181 / 0.18);
  }
  .plan__line {
    fill: none;
    stroke: var(--gold-light);
    stroke-width: 2.5;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 400;
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 1.4s ease 0.8s;
  }
  .js .plan:not(.is-in) .plan__line {
    stroke-dashoffset: 400;
  }
  .plan__tag {
    position: absolute;
    inset-block-end: -1.1rem;
    inset-inline-start: 1.25rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background: var(--white);
    border: 1px solid var(--line);
    box-shadow: 0 0.75rem 1.5rem -0.75rem rgb(11 26 51 / 0.35);
    font-size: 0.9rem;
    font-weight: 800;
    color: var(--navy);
  }

  /* ---------- פס הסבר: תכלת צר, הטקסט לרוחב העמוד ---------- */
  .st-explain {
    padding-block: clamp(1.5rem, 3.5vw, 2.25rem);
    background: var(--mist);
    border-bottom: 1px solid var(--line);
  }
  .st-explain p {
    max-width: 72rem;
    margin: 0 auto;
    text-align: center;
    font-size: clamp(1.05rem, 1.8vw, 1.2rem);
    line-height: 1.8;
    color: #33445c;
  }
  .st-explain strong {
    font-weight: 800;
    color: var(--teal-dark);
  }

  /* ---------- כותרות אזור ---------- */
  .st-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 0.6rem;
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--teal-dark);
  }
  .st-eyebrow::before,
  .st-eyebrow::after {
    content: '';
    width: 2rem;
    height: 2px;
    border-radius: 2px;
    background: var(--gold-gradient);
  }
  .st-eyebrow--start::after {
    display: none;
  }
  .st-eyebrow--dark {
    color: var(--gold-light);
  }
  .st-split {
    margin-bottom: 2.25rem;
  }
  .st-split > span {
    display: table;
    margin-inline: auto;
  }

  /* ---------- על מה עובדים: כרטיסי זכוכית, הכול באותו גובה ---------- */
  .areas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: auto auto auto 1fr;
    gap: 0 1.25rem;
  }
  @media (max-width: 62rem) {
    .areas {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 36rem) {
    .areas {
      grid-template-columns: 1fr;
    }
  }
  .area {
    display: grid;
    grid-template-rows: subgrid;
    grid-row: span 4;
    row-gap: 0.5rem;
    margin: 0 0 1.25rem;
    padding: 1.5rem;
    border-radius: 1.25rem;
    background: rgb(255 255 255 / 0.05);
    border: 1px solid rgb(255 255 255 / 0.12);
    border-top: 3px solid var(--teal);
  }
  .area:nth-child(even) {
    border-top-color: var(--gold-dark);
  }
  .area__icon {
    color: var(--gold-light);
  }
  .area__title {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 900;
    color: var(--white);
  }
  .area__gain {
    margin: 0;
    font-size: 1.08rem;
    line-height: 1.5;
    color: var(--gold-light);
  }
  .area__points {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0.85rem 0 0;
    border-top: 1px solid rgb(255 255 255 / 0.12);
    display: grid;
    gap: 0.45rem;
    align-content: start;
  }
  .area__points li {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
    line-height: 1.45;
    color: var(--on-dark);
  }
  .area__points :global(svg) {
    flex: none;
    margin-top: 0.2rem;
    color: var(--teal);
  }

  /* ---------- העתיד של העסקים: טקסט בימין, "במקום / עושים" בשמאל ---------- */
  .st-future__grid {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  @media (min-width: 60rem) {
    .st-future__grid {
      grid-template-columns: 1fr 1.05fr;
      gap: clamp(2.5rem, 5vw, 4.5rem);
    }
  }
  .st-future__title {
    margin: 0 0 1rem;
    font-size: clamp(1.9rem, 4.2vw, 2.6rem);
    font-weight: 900;
    line-height: 1.2;
  }
  .st-future__title > span {
    display: table;
  }
  .st-future__text {
    margin: 0;
    font-size: clamp(1.05rem, 1.8vw, 1.15rem);
    line-height: 1.8;
    color: #33445c;
  }
  .shifts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  .shift {
    display: grid;
    grid-template-columns: 1fr auto 1.2fr;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border-radius: 1rem;
    background: var(--mist);
    border: 1px solid var(--line);
  }
  .shift__from {
    display: grid;
    line-height: 1.4;
    color: #5a6b82;
  }
  .shift__label {
    font-size: 0.8rem;
