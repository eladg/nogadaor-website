---
// אסטרטגיה ושיווק, עמוד משלו (נוגה, 2026-11-09). יצא מהתבנית [slug].astro, כמו שאר עמודי השירות.
// סבב 5: "אסטרטגיה עושים מבפנים החוצה, והיסודות צריכים להיות חזקים כדי לעמוד בכל השינויים של השוק".
// הכול מתוך התוכן של נוגה (הוובינר, ההקלטה בסטודיו, הפגישה עם שרון וההנחיות שלה), בלי להמציא. המקורות ב-strategy.ts.
// הסדר: פתיח ← פס הסבר בשפת הקורא ← מבחוץ פנימה מול מבפנים החוצה ← שיווק הוא הגשר (העסק מבפנים, הלקוחות מבחוץ)
//   ← שיווק דיגיטלי הוא רק הקומה הראשונה (4 קומות, האסטרטגיה בראש) ← מה משתפר בעסק (כהה, 6 תחומים)
//   ← כשהיסודות חזקים (במקום / עושים) ← העקרונות ← סיום.
// בלי תוויות קטנות מעל הכותרות, בלי הדמיה בפתיח ובלי איור גשר (נוגה). **טיוטה לאישור נוגה.**
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Star from '../../components/Star.astro';
import { serviceBySlug } from '../../data/services';
import { focus, insideOut, floors, strategyAreas, shifts, strategyPrinciples } from '../../data/strategy';
import { contact } from '../../data/contact';
import { serviceSchema } from '../../utils/schema';
import whiteboard from '../../assets/atmosphere/light-whiteboard.webp';

const s = serviceBySlug('business-consulting')!;
const waHref = `${contact.whatsapp}?text=${encodeURIComponent('היי נוגה, אשמח לשמוע על אסטרטגיה ושיווק')}`;
const num = (i: number) => String(i + 1).padStart(2, '0');

const description =
  'אסטרטגיה ושיווק מבפנים החוצה. יסודות עסקיים חזקים שעומדים בשינויים בשוק, בידול ומסרים, החלטות שיווקיות, ניהול לקוחות חכם, מותג וקהילה, והגדלת מכירות מתוך מה שכבר קיים בעסק.';
const path = '/services/business-consulting/';
const schema = [serviceSchema(Astro.site, { name: s.title, description, path })];
const crumbs = [
  { name: 'בית', path: '/' },
  { name: 'שירותים', path: '/services/' },
  { name: s.title, path },
];
---

<BaseLayout title={s.title} description={description} schema={schema} crumbs={crumbs}>
  <!-- 1. פתיח: המסר של נוגה, על תמונת הלוח שנמוגה לטקסט -->
  <section class="st-hero">
    <div class="st-hero__bg" aria-hidden="true">
      <Image src={whiteboard} alt="" widths={[640, 1024, 1600]} sizes="100vw" loading="eager" />
    </div>
    <div class="container st-hero__inner">
      <p class="st-crumbs"><a href="/services/">שירותים</a> <span aria-hidden="true">/</span> {s.title}</p>
      <h1 class="st-hero__title">
        <span>אסטרטגיה שמתחילה מבפנים</span>{' '}<span class="st-hero__mark">ועומדת בכל שינוי בשוק</span>
      </h1>
      <p class="st-hero__lead">
        כשהיסודות של העסק חזקים וברורים, קל יותר לבחור את המהלכים הנכונים, לבלוט מול המתחרים ולהגדיל מכירות מתוך מה
        שכבר קיים, בלי להגדיל את תקציב השיווק.
      </p>
      <div class="st-actions">
        <a class="btn" href={waHref} target="_blank" rel="noopener">
          לשיחת היכרות<span class="sr-only"> (נפתח בלשונית חדשה)</span>
        </a>
        <a class="st-actions__link" href="#areas">מה משתפר בעסק?</a>
      </div>
    </div>
  </section>

  <!-- 2. פס הסבר בשפה של הקורא -->
  <section class="st-explain">
    <div class="container reveal">
      <p>
        העסק עובד, יש לקוחות, ועדיין יש תחושה שהוא יכול להגיע הרבה יותר רחוק. מכל כיוון מגיעים רעיונות, שיטות שיווק
        חדשות, כלים חדשים ומומחים שכל אחד ממליץ על הפתרון שלו, ולא ברור מה מכל זה באמת מתאים לעסק שלך.{' '}
        <strong>מה שחסר הוא לא עוד רעיון, אלא כיוון ברור</strong>, שנבנה מתוך העסק עצמו ומאפשר לבחור בביטחון מה עושים
        עכשיו ומה עוזבים.
      </p>
    </div>
  </section>

  <!-- 3. מבחוץ פנימה מול מבפנים החוצה (הוובינר) -->
  <section class="section st-focus" aria-labelledby="focus-title">
    <div class="container">
      <div class="center reveal">
        <h2 id="focus-title" class="sec-title st-split">
          <span>פיתוח עסקי</span>{' '}<span class="hl--mark">מבפנים החוצה</span>
        </h2>
        <p class="sec-lead st-lead">
          הרבה עסקים מחפשים את הפתרון בחוץ, בעוד שיטה, עוד קורס או עוד ערוץ. אסטרטגיה טובה מתחילה במקום אחר, בעסק
          עצמו.
        </p>
      </div>
      <div class="focus reveal">
        <div class="focus__col focus__col--out">
          <h3 class="focus__title">{focus.outside.title}</h3>
          <ul>
            {
              focus.outside.items.map((it) => (
                <li>
                  <span class="focus__mark" aria-hidden="true">–</span>
                  {it}
                </li>
              ))
            }
          </ul>
        </div>
        <div class="focus__col focus__col--in">
          <h3 class="focus__title">{focus.inside.title}</h3>
          <ul>
            {
              focus.inside.items.map((it) => (
                <li>
                  <Icon name="check" size={18} />
                  {it}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. שיווק הוא הגשר: העסק מבפנים והלקוחות מבחוץ, בלי איור -->
  <section class="section section--mist st-io" aria-labelledby="io-title">
    <div class="container">
      <div class="center reveal">
        <h2 id="io-title" class="sec-title st-split">
          <span>שיווק הוא הגשר</span>{' '}<span class="hl--mark">בין העסק ללקוחות שלו</span>
        </h2>
        <p class="sec-lead st-lead">
          קודם מכירים לעומק את העסק, ומבינים בדיוק את הלקוחות ואת השוק. מתוך שני הצדדים בוחרים את המהלכים המדויקים לעסק.
        </p>
      </div>
      <div class="io reveal">
        {
          [insideOut.inside, insideOut.outside].map((side, i) => (
            <div class:list={['io__side', { 'io__side--out': i === 1 }]}>
              <h3 class="io__title">
                <Icon name={i === 0 ? 'compass' : 'users'} size={24} />
                {side.title}
              </h3>
              <ul>
                {side.items.map((it) => (
                  <li>{it}</li>
                ))}
              </ul>
            </div>
          ))
        }
        <p class="io__close">{insideOut.close}</p>
      </div>
    </div>
  </section>

  <!-- 5. שיווק דיגיטלי הוא רק הקומה הראשונה (הוובינר): ארבע קומות, האסטרטגיה בראש -->
  <section class="section st-floors" aria-labelledby="floors-title">
    <div class="container st-floors__grid">
      <div class="reveal">
        <h2 id="floors-title" class="st-side-title">
          <span>שיווק דיגיטלי</span>{' '}<span class="hl--mark">הוא רק הקומה הראשונה</span>
        </h2>
        <p class="st-side-text">
          פוסטים, סרטונים וקמפיינים הם החלק שרואים. הם עובדים טוב רק כשמעליהם יש החלטות שיווקיות ברורות, ניהול מסודר
          ואסטרטגיה.
        </p>
        <p class="st-side-text st-side-text--strong">
          לכן האסטרטגיה לא נכתבת פעם אחת ונשארת במגירה. היא משפיעה על השיווק, מושפעת ממנו ומהמגמות בשוק, ומתעדכנת כל
          הזמן.
        </p>
      </div>
      <ol class="floors reveal" aria-label="ארבע הקומות, מלמעלה למטה">
        {
          floors.map((f, i) => (
            <li class="floor" style={`--w: ${64 + i * 12}%`}>
              <span class="floor__level">קומה {f.level}</span>
              <span class="floor__title">{f.title}</span>
              <span class="floor__text">{f.text}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 6. מה משתפר בעסק: 6 תחומים, ובכל אחד מה העסק מרוויח -->
  <section class="section section--deep st-areas" id="areas" aria-labelledby="areas-title">
    <div class="container">
      <div class="center reveal">
        <h2 id="areas-title" class="sec-title st-split">
          <span>כל מה שמביא לקוחות</span>{' '}<span class="hl">ומגדיל מכירות</span>
        </h2>
      </div>
      <ul class="areas">
        {
          strategyAreas.map((a, i) => (
            <li class="area reveal" style={`transition-delay: ${(i % 3) * 0.1}s`}>
              <span class="area__icon">
                <Icon name={a.icon} size={28} />
              </span>
              <h3 class="area__title">{a.title}</h3>
              <p class="area__gain">{a.gain}</p>
              <ul class="area__points">
                {a.points.map((p) => (
                  <li>
                    <Icon name="check" size={16} />
                    <span>{p}</span>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 7. כשהיסודות חזקים: במקום / עושים -->
  <section class="section st-future" aria-labelledby="future-title">
    <div class="container st-future__grid">
      <div class="reveal">
        <h2 id="future-title" class="st-future__title">
          <span>כשהיסודות חזקים</span>{' '}<span class="hl--mark">כל שינוי בשוק הוא הזדמנות</span>
        </h2>
        <p class="st-future__text">
          עסק לא עומד במקום. הוא גדל או שהוא קטן. השוק זז, הלקוחות משתנים והטכנולוגיה מתקדמת, ועסקים גדולים נעלמו כשהפסיקו
          להיות רלוונטיים ללקוחות שלהם. עסק שבנוי על יסודות חזקים לא צריך לרדוף אחרי כל שינוי. הוא יודע מי הוא, למי הוא פונה
          ומה הוא נותן, ולכן יכול להתאים את עצמו מהר ולהמשיך לצמוח.
        </p>
      </div>
      <ul class="shifts">
        {
          shifts.map((x, i) => (
            <li class="shift reveal" style={`transition-delay: ${i * 0.08}s`}>
              <span class="shift__from">
                <span class="shift__label">במקום</span>
                {x.from}
              </span>
              <span class="shift__arrow" aria-hidden="true">←</span>
              <span class="shift__to">{x.to}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 8. העקרונות -->
  <section class="section section--mist st-principles" aria-labelledby="principles-title">
    <div class="container">
      <div class="center reveal">
        <h2 id="principles-title" class="sec-title st-split">
          <span>כולם יודעים מה צריך לעשות</span>{' '}<span class="hl--mark">ההבדל הוא לגרום לזה לקרות</span>
        </h2>
      </div>
      <ol class="rules">
        {
          strategyPrinciples.map((p, i) => (
            <li class="rule reveal" style={`transition-delay: ${i * 0.1}s`}>
              <span class="rule__num" aria-hidden="true">{num(i)}</span>
              <h3 class="rule__title">{p.title}</h3>
              <p class="rule__text">{p.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 9. סיום: ההזמנה של נוגה להיכרות, בכרטיס כהה בתוך אזור בהיר -->
  <section class="section st-end" aria-labelledby="end-title">
    <div class="container">
      <div class="st-end__card reveal">
        <Star size={30} />
        <h2 id="end-title" class="st-end__title">
          <span>העסק שלך יכול להגיע</span>{' '}<span class="hl">הרבה יותר רחוק</span>
        </h2>
        <p class="st-end__text">שיחת היכרות בוואטסאפ, ומשם בוחרים יחד את המהלך הראשון.</p>
        <a class="btn st-end__btn" href={waHref} target="_blank" rel="noopener">
          לשיחת היכרות בוואטסאפ<span class="sr-only"> (נפתח בלשונית חדשה)</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- פתיח ---------- */
  .st-hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, var(--white), var(--mist));
    border-bottom: 1px solid var(--line);
  }
  .st-hero__bg {
    position: absolute;
    inset: 0;
    opacity: 0.16;
  }
  @media (min-width: 60rem) {
    .st-hero__bg {
      opacity: 0.5;
    }
  }
  .st-hero__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left center;
    -webkit-mask-image: linear-gradient(to left, transparent 35%, #000 85%);
    mask-image: linear-gradient(to left, transparent 35%, #000 85%);
  }
  .st-hero__inner {
    position: relative;
    padding-block: 2.5rem 3rem;
  }
  @media (min-width: 60rem) {
    .st-hero__inner {
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: min(66vh, 32rem);
      padding-block: 3.5rem;
    }
    .st-hero__inner > * {
      max-width: 40rem;
    }
  }
  .st-crumbs {
    margin: 0 0 0.75rem;
    font-size: 0.95rem;
    color: #4a5b73;
  }
  .st-crumbs a {
    color: var(--teal-dark);
    font-weight: 700;
  }
  .st-hero__title {
    margin: 0 0 1.25rem;
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    font-weight: 900;
    line-height: 1.12;
    color: var(--navy);
  }
  .st-hero__title > span {
    display: block;
    text-wrap: balance;
  }
  .st-hero__mark {
    color: var(--teal-dark);
  }
  .st-hero__lead {
    max-width: 36rem;
    margin: 0 0 1.75rem;
    font-size: clamp(1.1rem, 2vw, 1.25rem);
    line-height: 1.75;
    color: #33445c;
  }
  .st-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }
  .st-actions__link {
    font-weight: 800;
    color: var(--teal-dark);
  }

  /* ---------- פס הסבר: תכלת צר, הטקסט לרוחב העמוד ---------- */
  .st-explain {
    padding-block: clamp(1.5rem, 3.5vw, 2.25rem);
    background: var(--mist);
    border-bottom: 1px solid var(--line);
  }
  .st-explain p {
    max-width: 72rem;
    margin: 0 auto;
    text-align: center;
    font-size: clamp(1.05rem, 1.8vw, 1.2rem);
    line-height: 1.8;
    color: #33445c;
  }
  .st-explain strong {
    font-weight: 800;
    color: var(--teal-dark);
  }

  /* ---------- כותרות אזור ---------- */
  .st-split {
    margin-bottom: 2.25rem;
  }
  .st-split > span {
    display: table;
    margin-inline: auto;
  }

  .st-lead {
    max-width: 44rem;
    margin: -1.25rem auto 2.25rem;
  }

  /* ---------- מבחוץ פנימה מול מבפנים החוצה: טור עמום וטור חזק ---------- */
  .focus {
    display: grid;
    gap: 1rem;
    max-width: 62rem;
    margin-inline: auto;
  }
  @media (min-width: 48rem) {
    .focus {
      grid-template-columns: 1fr 1fr;
      align-items: stretch;
    }
  }
  .focus__col {
    padding: clamp(1.4rem, 3vw, 2rem);
    border-radius: 1.5rem;
  }
  .focus__col--out {
    background: var(--mist);
    border: 1px dashed #b9cdd2;
  }
  .focus__col--in {
    color: var(--on-dark);
    background:
      radial-gradient(22rem 12rem at 100% 0, rgb(25 154 181 / 0.35), transparent 70%),
      radial-gradient(18rem 10rem at 0 100%, rgb(209 154 74 / 0.2), transparent 72%),
      var(--navy-deep);
    box-shadow: 0 1.5rem 3rem -2rem rgb(11 26 51 / 0.6);
  }
  .focus__title {
    margin: 0 0 1rem;
    font-size: 1.35rem;
    font-weight: 900;
    color: #5a6b82;
  }
  .focus__col--in .focus__title {
    color: var(--gold-light);
  }
  .focus__col ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.8rem;
  }
  .focus__col li {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    line-height: 1.55;
  }
  .focus__col--out li {
    color: #5a6b82;
  }
  .focus__mark {
    flex: none;
    width: 1.1rem;
    font-weight: 900;
    color: #9aaab8;
  }
  .focus__col--in li {
    color: var(--white);
  }
  .focus__col--in :global(svg) {
    flex: none;
    margin-top: 0.2rem;
    color: var(--teal);
  }

  /* ---------- העסק מבפנים והלקוחות מבחוץ: שני טורים, ופס כהה שמחבר ביניהם ---------- */
  .io {
    display: grid;
    max-width: 62rem;
    margin-inline: auto;
    border-radius: 1.5rem;
    overflow: hidden;
    border: 1px solid var(--line);
    box-shadow: 0 1.5rem 3rem -2rem rgb(11 26 51 / 0.35);
  }
  @media (min-width: 48rem) {
    .io {
      grid-template-columns: 1fr 1fr;
    }
  }
  .io__side {
    padding: clamp(1.4rem, 3vw, 2rem);
    background: var(--white);
    border-top: 4px solid var(--teal);
  }
  .io__side--out {
    background: var(--mist);
    border-top-color: var(--gold-dark);
  }
  .io__title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1rem;
    font-size: 1.4rem;
    font-weight: 900;
    color: var(--navy);
  }
  .io__title :global(svg) {
    color: var(--teal-dark);
  }
  .io__side--out .io__title :global(svg) {
    color: var(--gold-dark);
  }
  .io__side ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.75rem;
  }
  .io__side li {
    position: relative;
    padding-inline-start: 1.1rem;
    line-height: 1.55;
    color: #33445c;
  }
  .io__side li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: 0.6em;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 0.1rem;
    background: var(--teal);
    transform: rotate(45deg);
  }
  .io__side--out li::before {
    background: var(--gold-dark);
  }
  .io__close {
    grid-column: 1 / -1;
    margin: 0;
    padding: 1.1rem 1.5rem;
    text-align: center;
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    font-weight: 700;
    line-height: 1.5;
    color: var(--white);
    background:
      radial-gradient(20rem 8rem at 100% 0, rgb(25 154 181 / 0.35), transparent 70%),
      var(--navy-deep);
  }

  /* ---------- כותרת וטקסט בצד (קומות, ויסודות) ---------- */
  .st-side-title {
    margin: 0 0 1rem;
    font-size: clamp(1.9rem, 4.2vw, 2.6rem);
    font-weight: 900;
    line-height: 1.2;
  }
  .st-side-title > span {
    display: table;
  }
