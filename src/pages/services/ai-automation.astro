---
// ייעול תהליכים עם AI, עמוד משלו (נוגה, 2026-11-09): "חזק, בועט, קולע, בלי בירבורים, הבטחות ישימות,
// ראייה מלמעלה של העסק, בחירת תהליכים חשובים לייעול ויישום בפועל".
// סבב 2 (נוגה, 2026-11-09): הכול בתועלת ללקוח, לא בטכני. תווית אחת מעל הכותרת ("שירותים / שם השירות"), לא שתיים.
// הסדר: פתיח (בינה מלאכותית עם ראש עסקי, ולצדו "קורה עכשיו בעסק") ← פגישה ראשונה בחינם בשווי 700 ₪ (בגדול, זהב)
//   ← מה משתנה בעסק (כהה, שלוש התועלות של נוגה) ← למי זה מתאים (מה מאתגר ביום יום ומה משתפר)
//   ← איך זה עובד (הגישה והשלבים יחד, 3) ← סיום (כרטיס כהה בתוך אזור בהיר, כי הפוטר כהה).
// הטקסטים ב-src/data/ai.ts. **טיוטה לאישור נוגה.**
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Star from '../../components/Star.astro';
import Timeline from '../../components/Timeline.astro';
import { serviceBySlug, type IconName } from '../../data/services';
import { pillars, aiSteps, aiFit, aiIndustries, firstMeeting } from '../../data/ai';
import { contact } from '../../data/contact';
import { serviceSchema } from '../../utils/schema';
import meeting from '../../assets/atmosphere/light-meeting-table.webp';

const s = serviceBySlug('ai-automation')!;
const wa = (text: string) => `${contact.whatsapp}?text=${encodeURIComponent(text)}`;
const waHref = wa('היי נוגה, אשמח לתאם פגישה ראשונה לבירור הצרכים של העסק (ייעול תהליכים עם AI)');

// "קורה עכשיו בעסק": איור בלבד, פעולות שמתבצעות לבד (מתוך תחומי היישום)
const feed: { icon: IconName; text: string }[] = [
  { icon: 'users', text: 'ליד חדש נקלט ושויך לעובד' },
  { icon: 'whatsapp', text: 'תזכורת לפגישה נשלחה בוואטסאפ' },
  { icon: 'list', text: 'סטטוס התיק עודכן ללקוח' },
  { icon: 'coins', text: 'תזכורת תשלום יצאה בזמן' },
  { icon: 'chart', text: 'דוח הבוקר מוכן לבעלים' },
];

const description =
  'ייעול תהליכים עם AI לעסקים. פחות עבודה ידנית, יותר סדר מול הלקוחות ובפיננסים, ותמונת מצב ברורה בכל רגע. פגישה ראשונה לבירור צרכים בחינם.';
const path = '/services/ai-automation/';
const schema = [serviceSchema(Astro.site, { name: s.title, description, path })];
const crumbs = [
  { name: 'בית', path: '/' },
  { name: 'שירותים', path: '/services/' },
  { name: s.title, path },
];
---

<BaseLayout title={s.title} description={description} schema={schema} crumbs={crumbs}>
  <!-- 1. פתיח: הקריאה החזקה בימין, ובשמאל "קורה עכשיו בעסק" מצויר מעל תמונת חדר הישיבות -->
  <section class="ai-hero">
    <div class="ai-hero__bg" aria-hidden="true">
      <Image src={meeting} alt="" widths={[640, 1024, 1600]} sizes="(min-width: 60rem) 60vw, 100vw" loading="eager" />
    </div>
    <div class="container ai-hero__grid">
      <div class="ai-hero__text">
        <p class="ai-crumbs"><a href="/services/">שירותים</a> <span aria-hidden="true">/</span> {s.title}</p>
        <h1 class="ai-hero__title">
          <span>בינה מלאכותית</span>{' '}<span class="ai-hero__mark">עם ראש עסקי</span>
        </h1>
        <p class="ai-hero__lead">
          מסתכלים על העסק מלמעלה, בוחרים את התהליכים שהכי שווה לייעל, ומיישמים אותם בפועל. פחות עבודה ידנית, פחות תלות
          בבעלים, ויותר זמן להגדיל הכנסות ורווחיות.
        </p>
        <a class="btn" href={waHref} target="_blank" rel="noopener">
          לתיאום פגישה ראשונה<span class="sr-only"> (נפתח בלשונית חדשה)</span>
        </a>
      </div>

      <!-- איור בלבד, ולכן מוסתר מקוראי מסך -->
      <div class="feed reveal" aria-hidden="true">
        <div class="feed__head">
          <span class="feed__dots"><i></i><i></i><i></i></span>
          <span class="feed__name">קורה עכשיו בעסק</span>
        </div>
        <ul class="feed__list">
          {
            feed.map((f, i) => (
              <li class="feed__row" style={`--i: ${i}`}>
                <span class="feed__icon">
                  <Icon name={f.icon} size={18} />
                </span>
                <span class="feed__text">{f.text}</span>
                <span class="feed__done">
                  <Icon name="check" size={16} />
                </span>
              </li>
            ))
          }
        </ul>
        <p class="feed__tag"><Icon name="robot" size={16} /> בלי שאף אחד הקליד</p>
      </div>
    </div>
  </section>

  <!-- 2. פגישה ראשונה בחינם, כמתנה (נוגה: בטורקיז, חגיגי, חדשני כיאה לעמוד AI) -->
  <section class="free" aria-labelledby="free-title">
    <div class="free__glow" aria-hidden="true"></div>
    <div class="container free__inner">
      <div class="free__copy reveal">
        <p class="free__chip"><Icon name="gift" size={18} /> מתנה לעסק שלך</p>
        <h2 id="free-title" class="free__title">
          <span>פגישה ראשונה לבירור צרכים</span>{' '}<span class="free__big">בחינם</span>
        </h2>
        <p class="free__worth">פגישה בשווי <s>{firstMeeting.worth}</s></p>
        <p class="free__text">{firstMeeting.text}</p>
        <a class="btn free__btn" href={waHref} target="_blank" rel="noopener">
          לתיאום הפגישה בוואטסאפ<span class="sr-only"> (נפתח בלשונית חדשה)</span>
        </a>
      </div>

      <!-- המתנה והשאלות הנכונות שמרחפות סביבה: איור בלבד -->
      <div class="gift reveal" aria-hidden="true">
        <span class="gift__ring"></span>
        <span class="gift__ring gift__ring--2"></span>
        <span class="gift__rays"></span>
        <svg class="gift__box" viewBox="0 0 160 160">
          <defs>
            <linearGradient id="giftGold" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#fde58a" />
              <stop offset="1" stop-color="#d19a4a" />
            </linearGradient>
            <linearGradient id="giftBody" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#0f2a4d" />
              <stop offset="1" stop-color="#0b1a33" />
            </linearGradient>
          </defs>
          <!-- הקופסה -->
          <rect x="30" y="78" width="100" height="70" rx="8" fill="url(#giftBody)" stroke="url(#giftGold)" stroke-width="2" />
          <rect x="72" y="78" width="16" height="70" fill="url(#giftGold)" />
          <!-- המכסה, מורם קצת -->
          <g class="gift__lid">
            <rect x="24" y="58" width="112" height="22" rx="6" fill="url(#giftBody)" stroke="url(#giftGold)" stroke-width="2" />
            <rect x="72" y="58" width="16" height="22" fill="url(#giftGold)" />
            <path d="M80 58 C66 34 44 38 50 50 C54 58 70 58 80 58 Z" fill="url(#giftGold)" />
            <path d="M80 58 C94 34 116 38 110 50 C106 58 90 58 80 58 Z" fill="url(#giftGold)" />
            <circle cx="80" cy="57" r="6" fill="#fde58a" />
          </g>
        </svg>
        <span class="gift__spark"><Star size={22} /></span>
        <span class="gift__glint gift__glint--1"></span>
        <span class="gift__glint gift__glint--2"></span><span class="gift__glint gift__glint--3"></span>
        <ul class="gift__qs">
          {firstMeeting.questions.map((q, i) => <li class={`gift__q gift__q--${i + 1}`} style={`--i: ${i}`}>{q}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- 3. מה משתנה בעסק: שלוש התועלות -->
  <section class="section section--deep ai-pillars" aria-labelledby="pillars-title">
    <div class="container">
      <div class="center reveal">
        <p class="ai-eyebrow ai-eyebrow--dark">מה משתנה בעסק</p>
        <h2 id="pillars-title" class="sec-title ai-split">
          <span>פחות עבודה ידנית</span>{' '}<span class="hl">יותר זמן לנהל ולהצמיח</span>
        </h2>
      </div>
      <ul class="pillars">
        {
          pillars.map((p, i) => (
            <li class="pillar reveal" style={`transition-delay: ${i * 0.1}s`}>
              <span class="pillar__icon">
                <Icon name={p.icon} size={30} />
              </span>
              <h3 class="pillar__title">{p.title}</h3>
              <p class="pillar__text">{p.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 4. למי זה מתאים: מה מאתגר ביום יום, ומה משתפר -->
  <section class="section ai-fit" aria-labelledby="fit-title">
    <div class="container">
      <div class="center reveal">
        <p class="ai-eyebrow">למי זה מתאים</p>
        <h2 id="fit-title" class="sec-title ai-split">
          <span>מה שמעסיק אותך היום</span>{' '}<span class="hl--mark">יכול לעבוד אחרת</span>
        </h2>
      </div>
      <ul class="fit">
        {
          aiFit.map((f, i) => (
            <li class="fit__item reveal" style={`transition-delay: ${(i % 3) * 0.1}s`}>
              <span class="fit__icon">
                <Icon name={f.icon} size={24} />
              </span>
              <p class="fit__pain">{f.pain}</p>
              <p class="fit__gain">
                <Icon name="arrow" size={18} />
                <span>{f.gain}</span>
              </p>
            </li>
          ))
        }
      </ul>
      <p class="fit__industries reveal">{aiIndustries}</p>
    </div>
  </section>

  <!-- 5. איך זה עובד: הגישה והשלבים יחד -->
  <section class="section section--mist ai-process" aria-labelledby="process-title">
    <div class="container">
      <div class="center reveal">
        <p class="ai-eyebrow">איך זה עובד</p>
        <h2 id="process-title" class="sec-title ai-split">
          <span>מהפגישה הראשונה</span>{' '}<span class="hl--mark">ועד שזה עובד אצלך בעסק</span>
        </h2>
      </div>
      <Timeline items={aiSteps} />
    </div>
  </section>

  <!-- 6. סיום: כרטיס כהה בתוך אזור בהיר -->
  <section class="section ai-end" aria-labelledby="end-title">
    <div class="container">
      <div class="ai-end__card reveal">
        <Star size={30} />
        <h2 id="end-title" class="ai-end__title">
          <span>העסק יכול לעבוד חכם יותר</span>{' '}<span class="hl">בואו נבחר מאיפה מתחילים</span>
        </h2>
        <p class="ai-end__text">פגישה ראשונה לבירור הצרכים של העסק, בחינם.</p>
        <a class="btn ai-end__btn" href={waHref} target="_blank" rel="noopener">
          לתיאום בוואטסאפ<span class="sr-only"> (נפתח בלשונית חדשה)</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- פתיח ---------- */
  .ai-hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, var(--white), var(--mist));
  }
  .ai-hero__bg {
    position: absolute;
    inset: 0;
    opacity: 0.18;
  }
  @media (min-width: 60rem) {
    .ai-hero__bg {
      opacity: 0.55;
    }
  }
  .ai-hero__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left center;
    -webkit-mask-image: linear-gradient(to left, transparent 35%, #000 85%);
    mask-image: linear-gradient(to left, transparent 35%, #000 85%);
  }
  .ai-hero__grid {
    position: relative;
    display: grid;
    gap: 2.5rem;
    padding-block: 2.5rem 3rem;
  }
  @media (min-width: 60rem) {
    .ai-hero__grid {
      grid-template-columns: 1.15fr 0.85fr;
      align-items: center;
      gap: clamp(2rem, 5vw, 5rem);
      min-height: min(70vh, 34rem);
      padding-block: 3rem;
    }
  }
  .ai-crumbs {
    margin: 0 0 0.75rem;
    font-size: 1rem;
    font-weight: 700;
    color: var(--gold-dark);
  }
  .ai-crumbs a {
    color: var(--teal-dark);
  }
  .ai-hero__title {
    margin: 0 0 1.25rem;
    font-size: clamp(2.4rem, 5.6vw, 3.8rem);
    font-weight: 900;
    line-height: 1.1;
    color: var(--navy);
  }
  .ai-hero__title > span {
    display: block;
    text-wrap: balance;
  }
  .ai-hero__mark {
    color: var(--teal-dark);
  }
  .ai-hero__lead {
    max-width: 36rem;
    margin: 0 0 1.75rem;
    font-size: clamp(1.1rem, 2vw, 1.25rem);
    line-height: 1.75;
    color: #33445c;
  }

  /* ---------- "קורה עכשיו בעסק" (רק במחשב) ---------- */
  @media (max-width: 59.99rem) {
    .feed {
      display: none;
    }
  }
  .feed {
    position: relative;
    width: min(100%, 26rem);
    margin-inline: auto;
    padding: 1.25rem 1.35rem 1.9rem;
    border-radius: 1.5rem;
    color: var(--on-dark);
    background:
      radial-gradient(18rem 12rem at 100% 0, rgb(25 154 181 / 0.35), transparent 70%),
      radial-gradient(14rem 10rem at 0 100%, rgb(209 154 74 / 0.2), transparent 72%),
      var(--navy-deep);
    box-shadow: 0 2rem 4rem -1.5rem rgb(11 26 51 / 0.55);
  }
  .feed__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }
  .feed__dots {
    display: inline-flex;
    gap: 0.35rem;
  }
  .feed__dots i {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 0.15rem;
    background: rgb(255 255 255 / 0.25);
  }
  .feed__dots i:first-child {
    background: var(--gold-light);
  }
  .feed__name {
    font-weight: 800;
    font-size: 0.95rem;
    color: var(--white);
  }
  .feed__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .feed__row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 0.85rem;
    border-radius: 0.9rem;
    background: rgb(255 255 255 / 0.06);
    border: 1px solid rgb(255 255 255 / 0.1);
    font-size: 0.95rem;
    transition:
      opacity 0.5s ease,
      transform 0.5s ease;
    transition-delay: calc(var(--i) * 0.35s + 0.2s);
  }
  .js .feed:not(.is-in) .feed__row {
    opacity: 0;
    transform: translateY(0.5rem);
  }
  .feed__icon {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.6rem;
    background: rgb(25 154 181 / 0.25);
    color: var(--white);
  }
  .feed__done {
    display: grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    background: var(--gold-gradient);
    color: var(--navy);
  }
  .feed__tag {
    position: absolute;
    inset-block-end: -1.1rem;
    inset-inline-start: 1.25rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background: var(--white);
    border: 1px solid var(--line);
    box-shadow: 0 0.75rem 1.5rem -0.75rem rgb(11 26 51 / 0.35);
    font-size: 0.9rem;
    font-weight: 800;
    color: var(--navy);
  }

  /* ---------- פגישה ראשונה בחינם: מתנה בטורקיז (נוגה, 2026-11-09) ---------- */
  .free {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2.75rem, 6vw, 4.5rem);
    color: var(--white);
    background:
      radial-gradient(40rem 22rem at 15% 50%, rgb(252 220 109 / 0.22), transparent 65%),
      radial-gradient(36rem 24rem at 95% 0%, rgb(255 255 255 / 0.14), transparent 60%),
      linear-gradient(135deg, #0d5a6b 0%, var(--teal-dark) 45%, #168aa3 100%);
  }
  /* רשת נקודות עדינה, תחושה טכנולוגית */
  .free::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgb(255 255 255 / 0.16) 1px, transparent 1.4px);
    background-size: 22px 22px;
    -webkit-mask-image: linear-gradient(to left, #000, transparent 75%);
    mask-image: linear-gradient(to left, #000, transparent 75%);
    pointer-events: none;
  }
  /* פס אור שעובר לאורך הקצה העליון */
  .free::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 3px;
    background: linear-gradient(90deg, transparent, var(--gold-light), transparent);
    background-size: 40% 100%;
    background-repeat: no-repeat;
    animation: free-sweep 5s linear infinite;
  }
  @keyframes free-sweep {
    from {
      background-position: -40% 0;
    }
    to {
      background-position: 140% 0;
    }
  }
  .free__inner {
    position: relative;
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 56rem) {
    .free__inner {
      grid-template-columns: 1.1fr 0.9fr;
      gap: clamp(2rem, 5vw, 4.5rem);
    }
  }
  .free__copy {
    text-align: center;
  }
  @media (min-width: 56rem) {
    .free__copy {
      text-align: start;
    }
  }
  .free__chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0 0 1rem;
    padding: 0.4rem 1rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.12);
    border: 1px solid rgb(255 255 255 / 0.3);
    backdrop-filter: blur(6px);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--gold-light);
  }
  .free__title {
    margin: 0;
    font-size: clamp(1.4rem, 3vw, 1.8rem);
    font-weight: 800;
    line-height: 1.25;
    color: var(--white);
  }
  .free__title > span {
    display: block;
  }
  .free__big {
    margin-top: 0.1rem;
    font-size: clamp(3.4rem, 9vw, 5rem);
    font-weight: 900;
    line-height: 1.05;
    background: linear-gradient(100deg, #fff6cf 0%, var(--gold-light) 35%, #ffffff 50%, var(--gold-light) 65%, #e9b860 100%);
    background-size: 200% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: free-shine 4s ease-in-out infinite;
  }
  @keyframes free-shine {
    0%,
    100% {
      background-position: 100% 0;
    }
    50% {
      background-position: 0% 0;
    }
  }
  .free__worth {
    display: inline-block;
    margin: 0.75rem 0 1.25rem;
    padding: 0.35rem 1rem;
    border-radius: 999px;
    background: var(--navy);
    font-size: 1rem;
    font-weight: 700;
    color: var(--on-dark);
  }
  .free__worth s {
    color: var(--gold-light);
    text-decoration-thickness: 2px;
  }
  .free__text {
    max-width: 36rem;
    margin: 0 auto 1.75rem;
    font-size: clamp(1.08rem, 1.9vw, 1.22rem);
    line-height: 1.75;
    color: rgb(255 255 255 / 0.92);
  }
  @media (min-width: 56rem) {
    .free__text {
      margin-inline: 0;
    }
  }
  .free__btn {
    font-size: 1.1rem;
    animation: free-pulse 2.6s ease-out infinite;
  }
  @keyframes free-pulse {
    0% {
      box-shadow: 0 0 0 0 rgb(252 220 109 / 0.55);
    }
    70%,
    100% {
      box-shadow: 0 0 0 1rem rgb(252 220 109 / 0);
    }
  }

  /* ---------- המתנה, והשאלות הנכונות סביבה ---------- */
  .gift {
    position: relative;
    display: grid;
    place-items: center;
    width: min(100%, 26rem);
    aspect-ratio: 1;
    margin-inline: auto;
