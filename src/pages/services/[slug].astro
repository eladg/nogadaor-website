---
// עמוד לכל שירות (2026-11-07). התוכן ב-src/data/services.ts (טיוטה לאישור נוגה).
// הסדר (2026-11-08): פתיח בהיר (שם, תועלת, משפט פתיחה) ← פסקת הסבר בשפת הקורא ← בלוקים עליונים ← הגשר ← מה עושים
//   ← משפט השראה ← בלוקים תחתונים ← (פס הדגשה) ← (ציר) ← (מה משתנה) ← (שאלות) ← משתלב עם ← קריאה לפעולה. כל אזור מוצג רק אם יש לו נתונים.
// ההדרכות לא כאן: יש להן עמוד משלהן (/trainings/).
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
import LightHero from '../../components/LightHero.astro';
import Star from '../../components/Star.astro';
import Timeline from '../../components/Timeline.astro';
import Faq from '../../components/Faq.astro';
import Icon from '../../components/Icon.astro';
import { servicePages, serviceBySlug, faqs, type Service } from '../../data/services';
import { contact } from '../../data/contact';

export function getStaticPaths() {
  // לפגישת הייעוץ, לליווי הפיננסי ולייעול עם AI יש עמוד משלהם (consulting-session.astro, financial.astro,
  // ai-automation.astro, נוגה 2026-11-09)
  const ownPages = ['consulting-session', 'financial', 'ai-automation'];
  return servicePages
    .filter((s) => !ownPages.includes(s.slug))
    .map((s) => ({ params: { slug: s.slug }, props: { service: s } }));
}

const { service: s } = Astro.props as { service: Service };
const related = (s.related ?? []).map(serviceBySlug).filter((r): r is Service => Boolean(r));
const faqItems = (s.faq ?? []).map((id) => faqs[id]).filter(Boolean);
const waHref = `${contact.whatsapp}?text=${encodeURIComponent(`היי נוגה, אשמח לשמוע על ${s.title}`)}`;
const isWhatsapp = s.cta === 'whatsapp';

// נוגה (2026-11-08): הפתיח בהיר (היא לא אוהבת את הכותרת על רקע כהה), ו"נשמע מוכר?" הוסר מכל עמודי השירות.
// לכל שירות תמונת אווירה בהירה בצד שמאל (LightHero). התמונות הבהירות נוצרו עם צד ימין ריק לטקסט.
import whiteboard from '../../assets/atmosphere/light-whiteboard.webp';
import team from '../../assets/atmosphere/light-team.webp';
import desk from '../../assets/atmosphere/light-desk.webp';
import meeting from '../../assets/atmosphere/light-meeting-table.webp';

const heroImages: Record<string, ImageMetadata> = {
  'business-consulting': whiteboard,
  'organizational-consulting': team,
  'ai-automation': meeting,
  financial: desk,
};
const heroImage = heroImages[s.slug] ?? desk;
const topBlocks = (s.blocks ?? []).filter((b) => b.place !== 'bottom');
const bottomBlocks = (s.blocks ?? []).filter((b) => b.place === 'bottom');

// נתונים מובנים: השירות, ושביל ניווט (src/utils/schema.ts)
import { serviceSchema } from '../../utils/schema';
const pageDescription = `${s.title}: ${s.lead}. ${s.opening ?? s.intro ?? ''}`.trim();
const path = `/services/${s.slug}/`;
const schema = [serviceSchema(Astro.site, { name: s.title, description: pageDescription, path })];
const crumbs = [
  { name: 'בית', path: '/' },
  { name: 'שירותים', path: '/services/' },
  { name: s.title, path },
];
---

<BaseLayout title={s.title} description={pageDescription} schema={schema} crumbs={crumbs}>
  <!-- 1. פתיח בהיר: שם השירות, שורת התועלת ומשפט הפתיחה -->
  <LightHero image={heroImage} title={s.title} crumbs={{ href: '/services/', label: 'שירותים', current: s.title }}>
    <p class="sv-lead">{s.lead}</p>
    {s.opening ? <p class="sv-opening">{s.opening}</p> : s.intro && <p>{s.intro}</p>}
    <div class="sv-actions">
      {
        isWhatsapp ? (
          <a class="btn" href={waHref} target="_blank" rel="noopener">
            לתיאום פגישה בוואטסאפ<span class="sr-only"> (נפתח בלשונית חדשה)</span>
          </a>
        ) : (
          <a class="btn" href={contact.whatsapp} target="_blank" rel="noopener">
            לשיחת היכרות<span class="sr-only"> (נפתח בלשונית חדשה)</span>
          </a>
        )
      }
      <a class="sv-actions__link" href="/services/">לכל השירותים</a>
    </div>
  </LightHero>

  <!-- 2. פסקת הסבר בשפה של הקורא (נוגה, 2026-11-08) -->
  {
    s.explain && (
      <section class="section sv-explain">
        <div class="container sv-explain__inner reveal">
          {s.explain.map((para) => (
            <p>{para}</p>
          ))}
        </div>
      </section>
    )
  }

  <!-- 2ב. בלוקי טקסט (אסטרטגיה ושיווק): בלי גוף ראשון. כאן הבלוקים העליונים, והתחתונים אחרי "מה עושים". -->
  {
    topBlocks.length > 0 && (
      <section class="section section--mist sv-blocks">
        <div class="container">
          {topBlocks.map((b, i) => (
            <div class:list={['block reveal', { 'block--alt': i % 2 === 1 }]}>
              <h2 class="block__title">{b.title}</h2>
              <div class="block__body">
                {b.paras.map((para) => (
                  <p>{para}</p>
                ))}
                {b.strong && <p class="block__strong">{b.strong}</p>}
              </div>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <!-- 2ג. הגשר: שיווק מחבר בין העסק (מבפנים) ללקוחות (מבחוץ). התפיסה של נוגה. -->
  {
    s.bridge && (
      <section class="section sv-bridge">
        <div class="container">
          <h2 class="sec-title center reveal sv-split">
            <span>{s.bridge.title}</span>{' '}<span class="hl--mark">{s.bridge.titleMark}</span>
          </h2>
          <p class="sec-lead center reveal">{s.bridge.lead}</p>
          <div class="bridge">
            {[s.bridge.inside, s.bridge.outside].map((side, i) => (
              <div class:list={['bridge__side reveal', { 'bridge__side--out': i === 1 }]} style={`order: ${i * 2}; transition-delay: ${i * 0.15}s`}>
                <p class="bridge__kicker">{side.kicker}</p>
                <h3 class="bridge__title">{side.title}</h3>
                <ul>
                  {side.items.map((it) => (
                    <li>{it}</li>
                  ))}
                </ul>
              </div>
            ))}
            <div class="bridge__span reveal" style="order: 1">
              <svg class="bridge__arc" viewBox="0 0 200 70" aria-hidden="true" preserveAspectRatio="none">
                <path d="M4 66 Q100 -10 196 66" />
                <path class="bridge__deck" d="M4 66 H196" />
                {[40, 70, 100, 130, 160].map((x) => {
                  const y = 66 - (1 - ((x - 100) / 96) ** 2) * 38;
                  return <line x1={x} y1={y} x2={x} y2="66" />;
                })}
              </svg>
              <p class="bridge__close">
                <Star size={18} /> {s.bridge.close}
              </p>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- 3. מה עושים בפועל -->
  {
    s.does && (
      <section class="section section--mist">
        <div class="container">
          <h2 class="sec-title reveal">{s.doesTitle ?? 'מה עושים בפועל'}</h2>
          <ul class="does">
            {s.does.map((d, i) => (
              <li class="do reveal" style={`transition-delay: ${(i % 3) * 0.1}s`}>
                <span class="do__icon">
                  <Icon name={d.icon} size={28} />
                </span>
                <h3 class="do__title">{d.title}</h3>
                <p class="do__text">{d.text}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- 3א. משפט השראה -->
  {
    s.quote && (
      <section class="section sv-quote">
        <div class="container">
          <p class="sv-quote__text reveal">
            <Star size={22} />
            <span>{s.quote}</span>
          </p>
        </div>
      </section>
    )
  }

  <!-- 3ב. בלוקים תחתונים (אסטרטגיה ושיווק: ליווי שעובד ביחד) -->
  {
    bottomBlocks.length > 0 && (
      <section class="section section--mist sv-blocks">
        <div class="container">
          {bottomBlocks.map((b) => (
            <div class="block reveal">
              <h2 class="block__title">{b.title}</h2>
              <div class="block__body">
                {b.paras.map((para) => (
                  <p>{para}</p>
                ))}
                {b.strong && <p class="block__strong">{b.strong}</p>}
              </div>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <!-- 4. פס הדגשה (ליווי פיננסי: הניסיון בבנק) -->
  {
    s.highlight && (
      <section class="sv-band">
        <div class="container sv-band__inner reveal">
          <span class="sv-band__big hl">{s.highlight.big}</span>
          <span class="sv-band__text">{s.highlight.text}</span>
        </div>
      </section>
    )
  }

  <!-- 5. ציר תהליך (כרגע רק בשירות ה-AI) -->
  {
    s.process && (
      <section class="section">
        <div class="container">
          <h2 class="sec-title reveal">
            איך זה <span class="hl--mark">עובד</span>
          </h2>
          <Timeline items={s.process} />
        </div>
      </section>
    )
  }

  <!-- 6. מה משתנה -->
  {
    s.changes && (
      <section class="section section--deep">
        <div class="container">
          <h2 class="sec-title reveal">
            מה <span class="hl">משתנה</span>
          </h2>
          <ul class="changes">
            {s.changes.map((c, i) => (
              <li class="change reveal" style={`transition-delay: ${i * 0.1}s`}>
                <span class="change__mark" aria-hidden="true">
                  <Icon name="check" size={20} />
                </span>
                <p>{c}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- 7. שאלות -->
  {
    faqItems.length > 0 && (
      <section class="section">
        <div class="container">
          <!-- הקישור "לכל השאלות הנפוצות" הוסר: עמוד השירותים כבר בלי שאלות נפוצות (2026-11-08) -->
          <Faq items={faqItems} />
        </div>
      </section>
    )
  }

  <!-- 8. משתלב עם: הבידול של נוגה הוא השילוב בין התחומים -->
  {
    related.length > 0 && (
      <section class="section section--mist">
        <div class="container">
          <h2 class="sec-title reveal">משתלב עם</h2>
          <p class="sec-lead">ברוב העסקים הכול מחובר: הכנסות, אנשים, תהליכים ומספרים. לכן אפשר לשלב כמה תחומים באותו ליווי.</p>
          <ul class="rel">
            {related.map((r) => (
              <li>
                <a class="rel__card" href={r.href}>
                  <span class="rel__icon">
                    <Icon name={r.icon} size={26} />
                  </span>
                  <span>
                    <span class="rel__title">{r.title}</span>
                    <span class="rel__lead">{r.lead}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- 9. קריאה לפעולה. בפגישת ייעוץ: וואטסאפ (היומן מיועד לפגישת היכרות של חצי שעה). -->
  {
    isWhatsapp ? (
      <section class="section section--dark sv-cta">
        <div class="container">
          <h2>מוכנים לפצח את האתגר?</h2>
          <p>כתבו בוואטסאפ, וקובעים פגישה.</p>
          <p>
            <a class="btn" href={waHref} target="_blank" rel="noopener">
              לתיאום פגישה בוואטסאפ<span class="sr-only"> (נפתח בלשונית חדשה)</span>
            </a>
          </p>
        </div>
      </section>
    ) : (
      <CtaBand />
    )
  }
</BaseLayout>

<style>
  /* ---------- פתיח בהיר (LightHero): שורת התועלת, משפט הפתיחה וכפתורים ---------- */
  .sv-lead {
    margin: 0 0 0.6rem;
    font-size: clamp(1.2rem, 2.6vw, 1.5rem);
    font-weight: 800;
    line-height: 1.4;
    color: var(--teal-dark);
  }
  .sv-opening {
    margin: 0 0 1.5rem;
    font-size: clamp(1.15rem, 2.3vw, 1.35rem);
    line-height: 1.6;
    color: var(--navy);
  }
  .sv-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: 1.25rem;
  }
  .sv-actions__link {
    font-weight: 700;
    color: var(--teal-dark);
  }

  /* ---------- פסקת הסבר: טקסט רציף וממורכז, בגובה העיניים ---------- */
  .sv-explain__inner {
    max-width: 46rem;
    text-align: center;
  }
  .sv-explain__inner p {
    font-size: clamp(1.1rem, 2vw, 1.25rem);
    line-height: 1.85;
    color: #33445c;
  }
  .sv-explain__inner p:first-child {
    color: var(--navy);
  }
  .sv-explain__inner p:last-child {
    margin-bottom: 0;
  }

  /* ---------- הגשר: העסק מימין, הלקוחות משמאל, והגשר ביניהם ---------- */
  .sv-split > span {
    display: table;
    margin-inline: auto;
  }
  .sv-bridge .sec-lead {
    margin-inline: auto;
  }
  .bridge {
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
    align-items: center;
  }
  @media (min-width: 60rem) {
    .bridge {
      grid-template-columns: 1fr minmax(12rem, 0.9fr) 1fr;
      gap: 0;
    }
  }
  .bridge__side {
    padding: 1.5rem 1.6rem;
    border-radius: 1.25rem;
    background: var(--mist);
    border-top: 4px solid var(--teal);
  }
  .bridge__side--out {
    border-top-color: var(--gold-dark);
  }
  .bridge__kicker {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--teal-dark);
  }
  .bridge__side--out .bridge__kicker {
    color: var(--gold-dark);
  }
  .bridge__title {
    margin: 0.1rem 0 0.75rem;
    font-size: 1.6rem;
    font-weight: 900;
  }
  .bridge__side ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.5rem;
  }
  .bridge__side li {
    padding-inline-start: 1rem;
    border-inline-start: 2px solid var(--line);
    line-height: 1.5;
    color: #33445c;
  }
  .bridge__span {
    text-align: center;
  }
  .bridge__arc {
    display: none;
  }
  @media (min-width: 60rem) {
    .bridge__arc {
      display: block;
      width: 100%;
      height: 4.5rem;
      overflow: visible;
    }
    .bridge__arc path,
    .bridge__arc line {
      fill: none;
      stroke: var(--gold-dark);
      stroke-width: 2;
      vector-effect: non-scaling-stroke;
    }
    .bridge__arc line {
      stroke-width: 1;
      opacity: 0.6;
    }
    .bridge__arc .bridge__deck {
      stroke: var(--teal);
      stroke-width: 3;
    }
  }
  .bridge__close {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0.6rem 0.75rem 0;
    font-weight: 700;
    line-height: 1.45;
    color: var(--navy);
  }
  .bridge__close :global(svg) {
    flex: none;
  }

  /* ---------- משפט השראה: טקסט גדול וממורכז, במשקל רגיל ---------- */
  .sv-quote {
    padding-block: clamp(2.5rem, 6vw, 4rem);
  }
  .sv-quote__text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    max-width: 44rem;
    margin: 0 auto;
    text-align: center;
    font-size: clamp(1.35rem, 3vw, 1.9rem);
    font-weight: 500;
    line-height: 1.5;
    color: var(--navy);
  }

  /* ---------- מה עושים ---------- */
  .does {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  @media (max-width: 62rem) {
    .does {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 36rem) {
    .does {
      grid-template-columns: 1fr;
    }
  }
  .do {
    margin: 0;
    padding: 1.5rem;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 1.25rem;
  }
  .do__icon {
    display: inline-block;
    color: var(--teal-dark);
    margin-bottom: 0.5rem;
  }
  .do:nth-child(even) .do__icon {
    color: var(--gold-dark);
  }
  .do__title {
    margin: 0 0 0.35rem;
    font-size: 1.15rem;
    font-weight: 900;
  }
  .do__text {
    margin: 0;
    line-height: 1.6;
    color: #33445c;
  }

  /* ---------- פס הדגשה ---------- */
  .sv-band {
    background: var(--gold-gradient);
    padding-block: 1.75rem;
  }
  .sv-band__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 0.5rem 1rem;
    text-align: center;
  }
  .sv-band__big {
    font-size: clamp(2rem, 5vw, 2.8rem);
    font-weight: 900;
    background: none;
    -webkit-background-clip: border-box;
    background-clip: border-box;
    color: var(--navy);
  }
  .sv-band__text {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--navy);
  }

  /* ---------- מה משתנה ---------- */
  .changes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  @media (max-width: 52rem) {
    .changes {
      grid-template-columns: 1fr;
    }
  }
  .change {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    margin: 0;
    padding: 1.25rem;
    border-radius: 1.25rem;
    background: rgb(255 255 255 / 0.05);
    border: 1px solid rgb(255 255 255 / 0.12);
  }
  .change__mark {
    flex: none;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--gold-gradient);
    color: var(--navy);
  }
  .change p {
    margin: 0.2rem 0 0;
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.5;
    color: var(--white);
  }

  /* ---------- משתלב עם ---------- */
  .rel {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1rem;
  }
  .rel li {
    margin: 0;
  }
  .rel__card {
    display: flex;
    gap: 0.9rem;
    align-items: center;
    height: 100%;
    padding: 1.1rem 1.25rem;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 1rem;
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .rel__card:hover {
    border-color: var(--teal);
  }
  @media (hover: hover) {
    .rel__card:hover {
      transform: translateY(-2px);
    }
  }
  .rel__icon {
    flex: none;
    color: var(--teal-dark);
  }
  .rel__title {
    display: block;
    font-weight: 900;
    color: var(--navy);
  }
  .rel__lead {
    display: block;
    font-size: 0.95rem;
    color: #4a5b73;
  }

  .sv-cta {
    text-align: center;
  }
  @media (prefers-reduced-motion: reduce) {
    .rel__card {
      transition: none;
    }
  }

  /* ---------- בלוקי טקסט: כותרת בצד, הטקסט לידה ---------- */
  .block {
    display: grid;
    gap: 0.75rem;
    padding-block: 1.75rem;
  }
  .block + .block {
    border-top: 1px solid var(--line);
  }
  @media (min-width: 52rem) {
    .block {
      grid-template-columns: 1fr 1.8fr;
      gap: 3rem;
      padding-block: 2.25rem;
    }
  }
  .block__title {
    margin: 0;
    font-size: clamp(1.5rem, 3.4vw, 2rem);
    font-weight: 900;
    line-height: 1.25;
    padding-top: 0.75rem;
    border-top: 4px solid var(--gold-dark);
    align-self: start;
  }
  .block--alt .block__title {
    border-top-color: var(--teal);
  }
  .block__body p {
    font-size: 1.08rem;
