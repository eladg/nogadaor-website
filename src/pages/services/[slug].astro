  }
  /* בטלפון: ארבעת הנושאים ברשת של 2 על 2 */
  @media (max-width: 40rem) {
    .tabs {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
    .tab {
      justify-content: center;
      border-radius: 1rem;
      padding: 0.65rem 0.6rem;
