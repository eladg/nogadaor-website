---
// ייעוץ ארגוני, עמוד משלו (נוגה, 2026-11-09, סבב 2). המסר: אפשר להגדיל הכנסות רק מלארגן ולנהל טוב יותר.
// שפה סופר מקצועית וגבוהה. מתאים לעסק כולו או למחלקה, ולכן לא מדברים על "בעל הבית". **לא** בניית צוותים, פסיכולוגיה
// או משברים. נוגה לא אהבה את הכותרת "העסק גדל / גם הניהול צריך להתקדם" ואת איור המבנה הארגוני (הציג רק חלק מהעסק).
// סבב 3 (נוגה): בלי ארבע השכבות ובלי הפרק "מה שמודדים גדל" (מאפיין אחד בתועלות), תועלות במקום עקרונות,
// ניסוחים של תוצאה ולא של תהליך, ומשפט עדין שלא מחפשים שינויים גדולים.
// נוגה (2026-11-09): בלי תוויות קטנות מעל הכותרות, והמשפט העדין ("שינוי לא צריך להיות גדול...") בפסקת הפתיח.
// הסדר: פתיח ← פס המסר ← התוצאות (4 תועלות) ← תחומי העבודה (כהה, 6) ← 20 שנה בבנק (זהב) ← איך זה עובד (3)
//   ← סיום (כרטיס כהה בתוך אזור בהיר, כי הפוטר כהה).
// "למי זה מתאים" הוסר (נוגה: "לא להגיד מה שלא צריך להגיד").
// הטקסטים ב-src/data/org.ts. **טיוטה לאישור נוגה.**
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Star from '../../components/Star.astro';
import Timeline from '../../components/Timeline.astro';
import { serviceBySlug } from '../../data/services';
import { orgAreas, orgBenefits, orgSteps, orgGentle } from '../../data/org';
import { contact } from '../../data/contact';
import { serviceSchema } from '../../utils/schema';
import team from '../../assets/atmosphere/light-team.webp';

const s = serviceBySlug('organizational-consulting')!;
const waHref = `${contact.whatsapp}?text=${encodeURIComponent('היי נוגה, אשמח לשמוע על ייעוץ ארגוני')}`;

const description =
  'ייעוץ ארגוני להגדלת הכנסות באמצעות ניהול וארגון נכונים. מבנה ארגוני, הגדרות תפקידים, נהלי עבודה, התייעלות בתהליכי עבודה, תהליכי שיווק ומכירות, ושגרות ניהול ובקרה לעסק כולו או למחלקה.';
const path = '/services/organizational-consulting/';
const schema = [serviceSchema(Astro.site, { name: s.title, description, path })];
const crumbs = [
  { name: 'בית', path: '/' },
  { name: 'שירותים', path: '/services/' },
  { name: s.title, path },
];
---

<BaseLayout title={s.title} description={description} schema={schema} crumbs={crumbs}>
  <!-- 1. פתיח: הקריאה החזקה בימין, ותמונת הצוות נמוגה בשמאל (בלי איור) -->
  <section class="og-hero">
    <div class="og-hero__bg" aria-hidden="true">
      <Image src={team} alt="" widths={[640, 1024, 1600]} sizes="(min-width: 60rem) 60vw, 100vw" loading="eager" />
    </div>
    <div class="container og-hero__grid">
      <div class="og-hero__text">
        <p class="og-crumbs"><a href="/services/">שירותים</a> <span aria-hidden="true">/</span> {s.title}</p>
        <h1 class="og-hero__title">
          <span class="sr-only">{s.title} </span>{' '}<span>ארגון וניהול מדויקים</span>{' '}<span class="og-hero__mark">שמגדילים הכנסות</span>
        </h1>
        <p class="og-hero__lead">
          מבנה, תפקידים, נהלים ותהליכי ניהול שמדויקים לאופי הפעילות, לארגון כולו או למחלקה אחת. {orgGentle}
        </p>
        <div class="og-actions">
          <a class="btn" href={waHref} target="_blank" rel="noopener">
            לשיחת היכרות<span class="sr-only"> (נפתח בלשונית חדשה)</span>
          </a>
          <a class="og-actions__link" href="#areas">תחומי העבודה</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. המסר: פס תכלת צר, הטקסט לרוחב העמוד ("הרווח הוא תוצאה של מכלול הפעולות", מההרצאה של נוגה) -->
  <section class="og-pain">
    <div class="container og-pain__inner reveal">
      <p>
        הרווח של כל עסק הוא תוצאה של מכלול הפעולות השיווקיות, התפעוליות והניהוליות שמתקיימות בו. לכן חלק ניכר מהפוטנציאל
        העסקי טמון בתוך הארגון, באופן שבו הוא בנוי, עובד ומנוהל.{' '}
        <strong>ארגון וניהול נכונים הם מנוע הכנסות בפני עצמו.</strong>
      </p>
    </div>
  </section>

  <!-- 3. התוצאות: 4 תועלות -->
  <section class="section og-benefits" aria-labelledby="benefits-title">
    <div class="container">
      <div class="center reveal">
        <h2 id="benefits-title" class="sec-title og-split">
          <span>ארגון שעובד נכון</span>{' '}<span class="hl--mark">ניכר בשורה התחתונה</span>
        </h2>
      </div>
      <ul class="rules">
        {
          orgBenefits.map((b, i) => (
            <li class="rule reveal" style={`transition-delay: ${i * 0.1}s`}>
              <span class="rule__icon">
                <Icon name={b.icon} size={24} />
              </span>
              <h3 class="rule__title">{b.title}</h3>
              <p class="rule__text">{b.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 4. תחומי העבודה: 6 -->
  <section class="section section--deep og-areas" id="areas" aria-labelledby="areas-title">
    <div class="container">
      <div class="center reveal">
        <h2 id="areas-title" class="sec-title og-split">
          <span>מבנה, תהליכים וניהול</span>{' '}<span class="hl">שפועלים כמערכת אחת</span>
        </h2>
      </div>
      <ul class="areas">
        {
          orgAreas.map((a, i) => (
            <li class="area reveal" style={`transition-delay: ${(i % 3) * 0.1}s`}>
              <span class="area__icon">
                <Icon name={a.icon} size={28} />
              </span>
              <h3 class="area__title">{a.title}</h3>
              <p class="area__text">{a.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 5. הניסיון בבנק (מתוך הסיפור באודות, בלי מספרים מדויקים) -->
  <section class="og-band">
    <div class="container og-band__inner reveal">
      <span class="og-band__big">20 שנה</span>
      <span class="og-band__text">
        בהנהלה של בנק גדול, בבניית נהלים, בקרות ודוחות עבודה שהניעו עשרות סניפים ומאות יועצי השקעות
      </span>
    </div>
  </section>

  <!-- 6. איך זה עובד (עם המשפט העדין שלא מחפשים שינויים גדולים) -->
  <section class="section section--mist og-process" aria-labelledby="process-title">
    <div class="container">
      <div class="center reveal">
        <h2 id="process-title" class="sec-title og-split">
          <span>מאבחון</span>{' '}<span class="hl--mark">להטמעה בשטח</span>
        </h2>
      </div>
      <Timeline items={orgSteps} />
    </div>
  </section>

  <!-- 7. סיום: כרטיס כהה בתוך אזור בהיר -->
  <section class="section og-end" aria-labelledby="end-title">
    <div class="container">
      <div class="og-end__card reveal">
        <Star size={30} />
        <h2 id="end-title" class="og-end__title">
          <span>בואו נבחן יחד</span>{' '}<span class="hl">היכן טמון הפוטנציאל בארגון שלכם</span>
        </h2>
        <p class="og-end__text">שיחת היכרות בוואטסאפ, בלי התחייבות.</p>
        <a class="btn og-end__btn" href={waHref} target="_blank" rel="noopener">
          לשיחת היכרות בוואטסאפ<span class="sr-only"> (נפתח בלשונית חדשה)</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- פתיח ---------- */
  .og-hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, var(--white), var(--mist));
    border-bottom: 1px solid var(--line);
  }
  .og-hero__bg {
    position: absolute;
    inset: 0;
    opacity: 0.18;
  }
  @media (min-width: 60rem) {
    .og-hero__bg {
      opacity: 0.55;
    }
  }
  .og-hero__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left center;
    -webkit-mask-image: linear-gradient(to left, transparent 35%, #000 85%);
    mask-image: linear-gradient(to left, transparent 35%, #000 85%);
  }
  .og-hero__grid {
    position: relative;
    display: grid;
    gap: 2.5rem;
    padding-block: 2.5rem 3rem;
  }
  @media (min-width: 60rem) {
    .og-hero__grid {
      align-items: center;
      min-height: min(64vh, 32rem);
      padding-block: 3.5rem;
    }
    .og-hero__text {
      max-width: 40rem;
    }
  }
  .og-crumbs {
    margin: 0 0 0.75rem;
    font-size: 0.95rem;
    color: #4a5b73;
  }
  .og-crumbs a {
    color: var(--teal-dark);
    font-weight: 700;
  }
  .og-hero__title {
    margin: 0 0 1.25rem;
    font-size: clamp(2.4rem, 5.6vw, 3.8rem);
    font-weight: 900;
    line-height: 1.1;
    color: var(--navy);
  }
  .og-hero__title > span {
    display: block;
    text-wrap: balance;
  }
  .og-hero__kicker {
    margin-bottom: 0.6rem;
    font-size: clamp(1.05rem, 2.2vw, 1.25rem);
    font-weight: 800;
    line-height: 1.3;
    color: var(--gold-dark);
  }
  .og-hero__mark {
    color: var(--teal-dark);
  }
  .og-hero__lead {
    max-width: 36rem;
    margin: 0 0 1.75rem;
    font-size: clamp(1.1rem, 2vw, 1.25rem);
    line-height: 1.75;
    color: #33445c;
  }
  .og-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }
  .og-actions__link {
    font-weight: 800;
    color: var(--teal-dark);
  }

  /* ---------- פס הכאב ---------- */
  .og-pain {
    padding-block: clamp(1.5rem, 3.5vw, 2.25rem);
    background: var(--mist);
    border-bottom: 1px solid var(--line);
  }
  .og-pain__inner p {
    max-width: 72rem;
    margin: 0 auto;
    text-align: center;
    font-size: clamp(1.05rem, 1.8vw, 1.2rem);
    line-height: 1.8;
    color: #33445c;
  }
  .og-pain__inner strong {
    font-weight: 800;
    color: var(--teal-dark);
  }

  /* ---------- כותרות אזור ---------- */
  .og-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 0.6rem;
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--teal-dark);
  }
  .og-eyebrow::before,
  .og-eyebrow::after {
    content: '';
    width: 2rem;
    height: 2px;
    border-radius: 2px;
    background: var(--gold-gradient);
  }
  .og-eyebrow--dark {
    color: var(--gold-light);
  }
  .og-split {
    margin-bottom: 2.25rem;
  }
  .og-split > span {
    display: table;
    margin-inline: auto;
  }

  /* ---------- מה בונים: 6 כרטיסי זכוכית, הכול באותו גובה ---------- */
  .areas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: auto auto 1fr;
    gap: 0 1.25rem;
  }
  @media (max-width: 62rem) {
    .areas {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 36rem) {
    .areas {
      grid-template-columns: 1fr;
    }
  }
  .area {
    display: grid;
    grid-template-rows: subgrid;
    grid-row: span 3;
    row-gap: 0.6rem;
    margin: 0 0 1.25rem;
    padding: 1.6rem 1.5rem;
    border-radius: 1.25rem;
    background: rgb(255 255 255 / 0.05);
    border: 1px solid rgb(255 255 255 / 0.12);
    border-top: 3px solid var(--teal);
  }
  .area:nth-child(even) {
    border-top-color: var(--gold-dark);
  }
  .area__icon {
    color: var(--gold-light);
  }
  .area__title {
    margin: 0;
    font-size: clamp(1.25rem, 2.3vw, 1.4rem);
    font-weight: 900;
    line-height: 1.25;
    color: var(--white);
  }
  .area__text {
    margin: 0;
    line-height: 1.65;
    color: var(--on-dark-soft);
  }

  /* ---------- 20 שנה בבנק ---------- */
  .og-band {
    background: var(--gold-gradient);
    padding-block: 1.75rem;
  }
  .og-band__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 0.5rem 1rem;
    text-align: center;
  }
  .og-band__big {
    font-size: clamp(2rem, 5vw, 2.8rem);
    font-weight: 900;
    color: var(--navy);
  }
  .og-band__text {
    max-width: 44rem;
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.5;
    color: var(--navy);
  }

  /* ---------- התוצאות: אייקון, כותרת וטקסט, בלי קופסאות ---------- */
  .rules {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: auto auto 1fr;
    gap: 0 clamp(1.25rem, 3vw, 2.5rem);
  }
  @media (max-width: 62rem) {
    .rules {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 36rem) {
    .rules {
      grid-template-columns: 1fr;
    }
  }
  .rule {
    display: grid;
    grid-template-rows: subgrid;
    grid-row: span 3;
    row-gap: 0.75rem;
    margin: 0 0 1.75rem;
    padding-top: 1rem;
    border-top: 3px solid var(--teal);
  }
  .rule:nth-child(even) {
    border-top-color: var(--gold-dark);
  }
  .rule__icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 0.9rem;
    background: var(--navy-deep);
    color: var(--gold-light);
  }
  .og-gentle {
    max-width: 44rem;
    margin: -1.25rem auto 2.5rem;
    font-size: 1.12rem;
    line-height: 1.75;
    color: #33445c;
  }
  .rule__title {
    margin: 0;
    font-size: 1.3rem;
    font-weight: 900;
    color: var(--navy);
  }
  .rule__text {
    margin: 0;
    line-height: 1.65;
    color: #33445c;
  }

  /* ---------- סיום ---------- */
  .og-end__card {
    max-width: 52rem;
    margin-inline: auto;
    padding: clamp(2rem, 5vw, 3.25rem) clamp(1.25rem, 4vw, 3rem);
    border-radius: 2rem;
    text-align: center;
    color: var(--on-dark);
    background:
      radial-gradient(30rem 18rem at 100% 0, rgb(25 154 181 / 0.3), transparent 70%),
      radial-gradient(26rem 16rem at 0 100%, rgb(209 154 74 / 0.18), transparent 72%),
      var(--navy-deep);
  }
  .og-end__title {
    margin: 0.5rem 0 1rem;
    font-size: clamp(1.7rem, 4.4vw, 2.5rem);
    font-weight: 900;
    line-height: 1.25;
    color: var(--white);
  }
  .og-end__title > span {
    display: block;
  }
  .og-end__text {
    margin: 0 0 1.75rem;
    font-size: 1.1rem;
    color: var(--on-dark-soft);
  }
  .og-end__btn {
    font-size: 1.1rem;
  }

</style>
