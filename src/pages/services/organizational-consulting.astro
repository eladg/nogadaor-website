---
// ייעוץ ארגוני, עמוד משלו (נוגה, 2026-11-09, סבב 2). המסר: אפשר להגדיל הכנסות רק מלארגן ולנהל טוב יותר.
// שפה סופר מקצועית וגבוהה. מתאים לעסק כולו או למחלקה, ולכן לא מדברים על "בעל הבית". **לא** בניית צוותים, פסיכולוגיה
// או משברים. נוגה לא אהבה את הכותרת "העסק גדל / גם הניהול צריך להתקדם" ואת איור המבנה הארגוני (הציג רק חלק מהעסק).
// הסדר: פתיח ← פס המסר ← תחומי העבודה (כהה, 6) ← ארבע השכבות של הניהול (מההרצאה של נוגה) ← מה שמודדים גדל
//   ← 20 שנה בבנק (זהב) ← עקרונות (4) ← איך זה עובד (3) ← סיום (כרטיס כהה בתוך אזור בהיר, כי הפוטר כהה).
// "למי זה מתאים" הוסר (נוגה: "לא להגיד מה שלא צריך להגיד").
// הטקסטים ב-src/data/org.ts. **טיוטה לאישור נוגה.**
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Star from '../../components/Star.astro';
import Timeline from '../../components/Timeline.astro';
import { serviceBySlug } from '../../data/services';
import { orgAreas, orgLayers, orgRhythm, orgPrinciples, orgSteps } from '../../data/org';
import { contact } from '../../data/contact';
import { serviceSchema } from '../../utils/schema';
import team from '../../assets/atmosphere/light-team.webp';

const s = serviceBySlug('organizational-consulting')!;
const waHref = `${contact.whatsapp}?text=${encodeURIComponent('היי נוגה, אשמח לשמוע על ייעוץ ארגוני')}`;
const num = (i: number) => String(i + 1).padStart(2, '0');

const description =
  'ייעוץ ארגוני להגדלת הכנסות באמצעות ניהול וארגון נכונים. מבנה ארגוני, הגדרות תפקידים, נהלי עבודה, התייעלות בתהליכי עבודה, תהליכי שיווק ומכירות, ושגרות ניהול ובקרה לעסק כולו או למחלקה.';
const path = '/services/organizational-consulting/';
const schema = [serviceSchema(Astro.site, { name: s.title, description, path })];
const crumbs = [
  { name: 'בית', path: '/' },
  { name: 'שירותים', path: '/services/' },
  { name: s.title, path },
];
---

<BaseLayout title={s.title} description={description} schema={schema} crumbs={crumbs}>
  <!-- 1. פתיח: הקריאה החזקה בימין, ותמונת הצוות נמוגה בשמאל (בלי איור) -->
  <section class="og-hero">
    <div class="og-hero__bg" aria-hidden="true">
      <Image src={team} alt="" widths={[640, 1024, 1600]} sizes="(min-width: 60rem) 60vw, 100vw" loading="eager" />
    </div>
    <div class="container og-hero__grid">
      <div class="og-hero__text">
        <p class="og-crumbs"><a href="/services/">שירותים</a> <span aria-hidden="true">/</span> {s.title}</p>
        <h1 class="og-hero__title">
          <span class="og-hero__kicker">{s.title}</span>{' '}<span>ארגון וניהול מדויקים</span>{' '}<span class="og-hero__mark">שמגדילים הכנסות</span>
        </h1>
        <p class="og-hero__lead">
          איתור מה שמעכב בתהליכי העבודה, מבנה ותפקידים מוגדרים, ותהליכי ניהול שמובילים לתוצאות. בארגון כולו, במחלקה או
          ביחידה אחת.
        </p>
        <div class="og-actions">
          <a class="btn" href={waHref} target="_blank" rel="noopener">
            לשיחת היכרות<span class="sr-only"> (נפתח בלשונית חדשה)</span>
          </a>
          <a class="og-actions__link" href="#areas">תחומי העבודה</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. המסר: פס תכלת צר, הטקסט לרוחב העמוד ("הרווח הוא תוצאה של מכלול הפעולות", מההרצאה של נוגה) -->
  <section class="og-pain">
    <div class="container og-pain__inner reveal">
      <p>
        הרווח של כל עסק הוא תוצאה של מכלול הפעולות השיווקיות, התפעוליות והניהוליות שמתקיימות בו. לכן הפוטנציאל הגדול
        נמצא לא פעם בתוך הארגון, בתהליכים יעילים, בתפקידים מוגדרים ובניהול שוטף שמחובר ליעדים.{' '}
        <strong>ארגון וניהול נכונים הם מנוע הכנסות בפני עצמו.</strong>
      </p>
    </div>
  </section>

  <!-- 3. תחומי העבודה: 6 -->
  <section class="section section--deep og-areas" id="areas" aria-labelledby="areas-title">
    <div class="container">
      <div class="center reveal">
        <p class="og-eyebrow og-eyebrow--dark">תחומי העבודה</p>
        <h2 id="areas-title" class="sec-title og-split">
          <span>מבנה, תהליכים וניהול</span>{' '}<span class="hl">שפועלים כמערכת אחת</span>
        </h2>
      </div>
      <ul class="areas">
        {
          orgAreas.map((a, i) => (
            <li class="area reveal" style={`transition-delay: ${(i % 3) * 0.1}s`}>
              <span class="area__icon">
                <Icon name={a.icon} size={28} />
              </span>
              <h3 class="area__title">{a.title}</h3>
              <p class="area__text">{a.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 4. ארבע השכבות של הניהול (מההרצאה של נוגה "איך מנהלים בחברות ותאגידים"), מדרגות שעולות -->
  <section class="section og-layers" aria-labelledby="layers-title">
    <div class="container">
      <div class="center reveal">
        <p class="og-eyebrow">איך מנהלים ארגון</p>
        <h2 id="layers-title" class="sec-title og-split">
          <span>מהחזון</span>{' '}<span class="hl--mark">ועד הניהול השוטף</span>
        </h2>
        <p class="og-layers__lead">
          ארגונים מצליחים מחברים בין ארבע שכבות של ניהול. כשהן מחוברות, כל החלטה בשטח משרתת את הכיוון של הארגון.
        </p>
      </div>
      <ol class="layers">
        {
          orgLayers.map((l, i) => (
            <li class="layer reveal" style={`--i: ${i}; transition-delay: ${i * 0.12}s`}>
              <span class="layer__step" aria-hidden="true">{num(i)}</span>
              <h3 class="layer__title">{l.title}</h3>
              <p class="layer__text">{l.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 5. מה שמודדים גדל: תהליכי הניהול, בלי פירוט -->
  <section class="section section--mist og-measure" aria-labelledby="measure-title">
    <div class="container og-measure__inner">
      <div class="reveal">
        <p class="og-eyebrow">תהליכי ניהול</p>
        <h2 id="measure-title" class="og-measure__title">
          <span>מה שמודדים</span>{' '}<span class="hl--mark">גדל</span>
        </h2>
        <p class="og-measure__text">
          תהליכי הניהול הם שמניעים את הארגון קדימה. תכנון, בקרה ומעקב קבועים הופכים החלטות לביצוע, ומאפשרים לזהות בזמן מה
          מתקדם ומה דורש התערבות.
        </p>
      </div>
      <ul class="rhythm">
        {
          orgRhythm.map((r, i) => (
            <li class="rhythm__item reveal" style={`transition-delay: ${i * 0.12}s`}>
              <span class="rhythm__icon">
                <Icon name={r.icon} size={24} />
              </span>
              <span>{r.text}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 6. הניסיון בבנק (מתוך הסיפור באודות, בלי מספרים מדויקים) -->
  <section class="og-band">
    <div class="container og-band__inner reveal">
      <span class="og-band__big">20 שנה</span>
      <span class="og-band__text">
        בהנהלה של בנק גדול, בבניית נהלים, בקרות ודוחות עבודה שהניעו עשרות סניפים ומאות יועצי השקעות
      </span>
    </div>
  </section>

  <!-- 7. עקרונות העבודה -->
  <section class="section og-principles" aria-labelledby="principles-title">
    <div class="container">
      <div class="center reveal">
        <p class="og-eyebrow">עקרונות העבודה</p>
        <h2 id="principles-title" class="sec-title og-split">
          <span>שינוי מדויק</span>{' '}<span class="hl--mark">שנטמע לאורך זמן</span>
        </h2>
      </div>
      <ol class="rules">
        {
          orgPrinciples.map((p, i) => (
            <li class="rule reveal" style={`transition-delay: ${i * 0.1}s`}>
              <span class="rule__num" aria-hidden="true">{num(i)}</span>
              <h3 class="rule__title">{p.title}</h3>
              <p class="rule__text">{p.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 8. איך זה עובד -->
  <section class="section section--mist og-process" aria-labelledby="process-title">
    <div class="container">
      <div class="center reveal">
        <p class="og-eyebrow">איך זה עובד</p>
        <h2 id="process-title" class="sec-title og-split">
          <span>מאבחון</span>{' '}<span class="hl--mark">להטמעה בשטח</span>
        </h2>
      </div>
      <Timeline items={orgSteps} />
    </div>
  </section>

  <!-- 9. סיום: כרטיס כהה בתוך אזור בהיר -->
  <section class="section og-end" aria-labelledby="end-title">
    <div class="container">
      <div class="og-end__card reveal">
        <Star size={30} />
        <h2 id="end-title" class="og-end__title">
          <span>בואו נבחן יחד</span>{' '}<span class="hl">איפה הארגון יכול לעבוד טוב יותר</span>
        </h2>
        <p class="og-end__text">שיחת היכרות בוואטסאפ, בלי התחייבות.</p>
        <a class="btn og-end__btn" href={waHref} target="_blank" rel="noopener">
          לשיחת היכרות בוואטסאפ<span class="sr-only"> (נפתח בלשונית חדשה)</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- פתיח ---------- */
  .og-hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, var(--white), var(--mist));
    border-bottom: 1px solid var(--line);
  }
  .og-hero__bg {
    position: absolute;
    inset: 0;
    opacity: 0.18;
  }
  @media (min-width: 60rem) {
    .og-hero__bg {
      opacity: 0.55;
    }
  }
  .og-hero__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left center;
    -webkit-mask-image: linear-gradient(to left, transparent 35%, #000 85%);
    mask-image: linear-gradient(to left, transparent 35%, #000 85%);
  }
  .og-hero__grid {
    position: relative;
    display: grid;
    gap: 2.5rem;
    padding-block: 2.5rem 3rem;
  }
  @media (min-width: 60rem) {
    .og-hero__grid {
      align-items: center;
      min-height: min(64vh, 32rem);
      padding-block: 3.5rem;
    }
    .og-hero__text {
      max-width: 40rem;
    }
  }
  .og-crumbs {
    margin: 0 0 0.75rem;
    font-size: 0.95rem;
    color: #4a5b73;
  }
  .og-crumbs a {
    color: var(--teal-dark);
    font-weight: 700;
  }
  .og-hero__title {
    margin: 0 0 1.25rem;
    font-size: clamp(2.4rem, 5.6vw, 3.8rem);
    font-weight: 900;
    line-height: 1.1;
    color: var(--navy);
  }
  .og-hero__title > span {
    display: block;
    text-wrap: balance;
  }
  .og-hero__kicker {
    margin-bottom: 0.6rem;
    font-size: clamp(1.05rem, 2.2vw, 1.25rem);
    font-weight: 800;
    line-height: 1.3;
    color: var(--gold-dark);
  }
  .og-hero__mark {
    color: var(--teal-dark);
  }
  .og-hero__lead {
    max-width: 36rem;
    margin: 0 0 1.75rem;
    font-size: clamp(1.1rem, 2vw, 1.25rem);
    line-height: 1.75;
    color: #33445c;
  }
  .og-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }
  .og-actions__link {
    font-weight: 800;
    color: var(--teal-dark);
  }

  /* ---------- פס הכאב ---------- */
  .og-pain {
    padding-block: clamp(1.5rem, 3.5vw, 2.25rem);
    background: var(--mist);
    border-bottom: 1px solid var(--line);
  }
  .og-pain__inner p {
    max-width: 72rem;
    margin: 0 auto;
    text-align: center;
    font-size: clamp(1.05rem, 1.8vw, 1.2rem);
    line-height: 1.8;
    color: #33445c;
  }
  .og-pain__inner strong {
    font-weight: 800;
    color: var(--teal-dark);
  }

  /* ---------- כותרות אזור ---------- */
  .og-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 0.6rem;
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--teal-dark);
  }
  .og-eyebrow::before,
  .og-eyebrow::after {
    content: '';
    width: 2rem;
    height: 2px;
    border-radius: 2px;
    background: var(--gold-gradient);
  }
  .og-eyebrow--dark {
    color: var(--gold-light);
  }
  .og-split {
    margin-bottom: 2.25rem;
  }
  .og-split > span {
    display: table;
    margin-inline: auto;
  }

  /* ---------- מה בונים: 6 כרטיסי זכוכית, הכול באותו גובה ---------- */
  .areas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: auto auto 1fr;
    gap: 0 1.25rem;
  }
  @media (max-width: 62rem) {
    .areas {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 36rem) {
    .areas {
      grid-template-columns: 1fr;
    }
  }
  .area {
    display: grid;
    grid-template-rows: subgrid;
    grid-row: span 3;
    row-gap: 0.6rem;
    margin: 0 0 1.25rem;
    padding: 1.6rem 1.5rem;
    border-radius: 1.25rem;
    background: rgb(255 255 255 / 0.05);
    border: 1px solid rgb(255 255 255 / 0.12);
    border-top: 3px solid var(--teal);
  }
  .area:nth-child(even) {
    border-top-color: var(--gold-dark);
  }
  .area__icon {
    color: var(--gold-light);
  }
  .area__title {
    margin: 0;
    font-size: clamp(1.25rem, 2.3vw, 1.4rem);
    font-weight: 900;
    line-height: 1.25;
    color: var(--white);
  }
  .area__text {
    margin: 0;
    line-height: 1.65;
    color: var(--on-dark-soft);
  }

  /* ---------- ארבע השכבות: מדרגות שעולות מימין לשמאל ---------- */
  .og-layers__lead {
    max-width: 44rem;
    margin: -1.25rem auto 2.5rem;
    font-size: 1.12rem;
    line-height: 1.75;
    color: #33445c;
  }
  .layers {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: auto auto 1fr;
    gap: 0 clamp(0.75rem, 2vw, 1.25rem);
    align-items: end;
  }
  @media (max-width: 62rem) {
    .layers {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 36rem) {
    .layers {
      grid-template-columns: 1fr;
    }
  }
  .layer {
    display: grid;
    grid-template-rows: subgrid;
    grid-row: span 3;
    row-gap: 0.5rem;
    margin: 0 0 1.75rem;
  }
  /* המדרגה: כל שכבה גבוהה מהקודמת, כחול שמעמיק עד הניהול השוטף */
  .layer__step {
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
    align-self: end;
    height: calc(3.25rem + var(--i) * 1.6rem);
    padding: 0.7rem 1rem;
    border-radius: 1rem 1rem 0.35rem 0.35rem;
    background: color-mix(in srgb, var(--teal) calc(90% - var(--i) * 22%), var(--navy-deep));
    font-size: 1.35rem;
    font-weight: 900;
    line-height: 1;
    color: var(--white);
  }
  @media (max-width: 62rem) {
    .layer__step {
      height: 3rem;
    }
  }
  /* בטלפון: טור אחד, והמדרגות מתארכות לרוחב */
  @media (max-width: 36rem) {
    .layers {
      grid-auto-rows: auto;
    }
    .layer {
      display: block;
      margin-bottom: 1.5rem;
    }
    .layer__step {
      width: calc(40% + var(--i) * 20%);
      margin-bottom: 0.75rem;
    }
  }
  .layer__title {
    margin: 0.4rem 0 0;
    font-size: 1.35rem;
    font-weight: 900;
    color: var(--navy);
  }
  .layer__text {
    margin: 0;
    line-height: 1.65;
    color: #33445c;
  }

  /* ---------- מה שמודדים גדל ---------- */
  .og-measure__inner {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  @media (min-width: 60rem) {
    .og-measure__inner {
      grid-template-columns: 1.1fr 0.9fr;
      gap: clamp(2rem, 6vw, 5rem);
    }
  }
  .og-measure__title {
    margin: 0 0 1rem;
    font-size: clamp(2.6rem, 7vw, 4.4rem);
    font-weight: 900;
    line-height: 1.1;
    color: var(--navy);
  }
  .og-measure__text {
    max-width: 36rem;
    margin: 0;
    font-size: clamp(1.1rem, 2vw, 1.25rem);
    line-height: 1.8;
    color: #33445c;
  }
  .rhythm {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }
  .rhythm__item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 1.25rem;
    border-radius: 1.1rem;
    background: var(--mist);
    border: 1px solid var(--line);
    border-inline-start: 4px solid var(--teal);
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--navy);
  }
  .rhythm__item:nth-child(2) {
    border-inline-start-color: var(--gold-dark);
  }
  .rhythm__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.8rem;
    background: var(--navy-deep);
    color: var(--gold-light);
  }

  /* ---------- 20 שנה בבנק ---------- */
  .og-band {
    background: var(--gold-gradient);
    padding-block: 1.75rem;
  }
  .og-band__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 0.5rem 1rem;
    text-align: center;
  }
  .og-band__big {
    font-size: clamp(2rem, 5vw, 2.8rem);
    font-weight: 900;
    color: var(--navy);
  }
  .og-band__text {
    max-width: 44rem;
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.5;
    color: var(--navy);
  }

  /* ---------- הגישה: מספר זהב גדול, בלי קופסאות ---------- */
  .rules {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: auto auto 1fr;
    gap: 0 clamp(1.25rem, 3vw, 2.5rem);
  }
  @media (max-width: 62rem) {
