---
// עמוד השירותים (2026-11-07). התוכן ב-src/data/services.ts. הכול טיוטה לאישור נוגה.
// הסדר: פתיח עם הבטחה ← ריבועי השירותים (מתהפכים) ← מסתכלים על העסק כולו (8 תחומים) ← תהליך הליווי (3 שלבים של נוגה)
//   ← למי זה מתאים ← מה משתנה (היום / המטרה) ← שאלות נפוצות ← קריאה לפעולה.
// ההשראות שנוגה בחרה: incentive-group (הבטחה, "לא לכולם", "אחרי", שאלות), yanivless (ריבועים מתהפכים, ציר), pitron10 (שפת צורך).
// השראה בלבד, לא העתקה. הביקורת והציונים: drafts/critique-2026-11-07.md.
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
import Ribbon from '../../components/Ribbon.astro';
import Timeline from '../../components/Timeline.astro';
import Faq from '../../components/Faq.astro';
import Icon from '../../components/Icon.astro';
import Star from '../../components/Star.astro';
import { services, areas, steps, fit, beforeAfter, faqs, overviewFaq } from '../../data/services';
import { advances } from '../../data/advances';
import { contact } from '../../data/contact';
// תמונות אווירה (AI) והדמות המצוירת, נוגה 2026-11-07
import stairs from '../../assets/atmosphere/dark-stairs.webp';
import meeting from '../../assets/atmosphere/light-meeting-table.webp';
import flipchart from '../../assets/character/flipchart.webp';
const stairsBg = await getImage({ src: stairs, width: 1800, format: 'webp' });
const meetingBg = await getImage({ src: meeting, width: 1400, format: 'webp' });
// גובה כל בניין בקו הרקיע (rem)
const skyHeights = [7, 10, 5.5, 8.5, 11, 6.5, 9.5, 7.5];
---

<BaseLayout
  title="שירותים"
  description="ייעוץ עסקי, ייעוץ ארגוני, ייעול תהליכים עם AI, ליווי פיננסי, פגישת ייעוץ והדרכות: ייעוץ עסקי וארגוני לעסקים מבוססים להגדלת הכנסות ושיפור רווחיות."
>
  <!-- 1. פתיח קצר שמרים לשירותים (נוגה, 2026-11-08): בלי תווית, בלי תגיות ובלי כפתור "לכל השירותים".
       "להגדלת הכנסות ושיפור רווחיות" בזהב, בשורה משלה, ובטלפון בלי מעבר שורה. -->
  <section class="s-hero section--deep" style={`--bg: url(${stairsBg.src})`}>
    <div class="container s-hero__inner">
      <!-- התואר של נוגה -->
      <h1 class="s-hero__title">ייעוץ עסקי וארגוני <span class="s-hero__gold">להגדלת הכנסות ושיפור רווחיות</span></h1>
      <!-- נוגה (2026-11-08): רחב ומקצועי יותר, ישים ופרקטי, חדשני ויצירתי, מסתכל קדימה על המגמות, "מקדם מטרות ותוכניות גדולות". הניסוח שלי, ממתין לאישור. -->
      <p class="s-hero__lead">ליווי מקצועי שמקדם מטרות ותוכניות גדולות, בפתרונות ישימים, חדשניים ויצירתיים, שממצים את הפוטנציאל הקיים בעסק ומסתכלים קדימה אל המגמות של השוק.</p>
      <a class="btn" href={contact.whatsapp} target="_blank" rel="noopener">לשיחת היכרות<span class="sr-only"> (נפתח בלשונית חדשה)</span></a>
    </div>
  </section>

  <!-- 1א. הסרט הנע, הפעם בזהב (נוגה, 2026-11-08) -->
  <Ribbon items={advances} tone="gold" />

  <!-- 2. השירותים: בעמוד הבית הם כרטיסים כהים שמתהפכים, וכאן רשימה מפורטת יותר, כדי לא לחזור על אותו עיצוב
       (נוגה, 2026-11-08). הכותרת היא הצעה שלי. -->
  <section class="section s-list" id="services">
    <div class="container">
      <h2 class="sec-title center reveal">כל מה שהעסק שלך צריך <span class="hl--mark">כדי לצמוח</span></h2>
      <ul class="svc-list">
        {
          services.map((s, i) => (
            <li class="svc-row reveal" style={`transition-delay: ${(i % 2) * 0.08}s`}>
              <span class="svc-row__icon" aria-hidden="true"><Icon name={s.icon} size={26} /></span>
              <div class="svc-row__body">
                <h3 class="svc-row__title"><a href={s.href}>{s.title}</a></h3>
                <p class="svc-row__lead">{s.lead}</p>
                <p class="svc-row__text">{s.card}</p>
                <span class="svc-row__more" aria-hidden="true">לפרטים ←</span>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 3. מסתכלים על העסק כולו: הבידול של נוגה (שילוב, ולא נושא מבודד) -->
  <section class="section section--mist">
    <div class="container">
      <!-- הכותרת של נוגה (2026-11-08), מתוך "הבידול של נוגה" במסמך העבודה. שאר המילים סביבה הוסרו. -->
      <h2 class="sec-title center s-split reveal">ראייה מערכתית של העסק,{' '}<span class="hl--mark">לצד ירידה לפרטים המעשיים</span></h2>
      <!-- קו רקיע של בניינים (נוגה בחרה, 2026-11-08): קווים עדינים, שקופים ומאווררים. שם התחום מעל הבניין,
           וההסבר מתחת לקו הקרקע. בלי אייקונים. במעבר עכבר החלונות נדלקים בזהב. בטלפון גוללים לצדדים. -->
      <ul class="sky" aria-label="התחומים שהליווי מסתכל עליהם">
        {
          areas.map((a, i) => (
            <li class="sky__item reveal" style={`--h: ${skyHeights[i % skyHeights.length]}rem; transition-delay: ${i * 0.06}s`}>
              <div class="sky__zone">
                <h3 class="sky__title">{a.title}</h3>
                <span class:list={['sky__bld', { 'sky__bld--antenna': i % 3 === 1 }]} aria-hidden="true"></span>
              </div>
              <p class="sky__text">{a.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 4. תהליך הליווי: שלושת השלבים של נוגה (2026-11-07). הפתיחה מטקסט האתר הקודם שלה ("ההיגיון אומר..."). -->
  <section class="section s-process" id="process">
    <div class="container">
      <div class="s-process__head">
        <div>
          <h2 class="sec-title reveal">הגדלת הכנסות לא מתחילה <span class="hl--mark">בעוד משימות</span></h2>
          <!-- בלי נקודתיים (נוגה, 2026-11-08). הניסוח שלי מתוך הטקסט שלה. -->
          <p class="sec-lead">הגדלת הכנסות לא מגיעה מעוד רעיונות, עוד מאמץ או עוד הוצאות. היא מתחילה בהבנה עמוקה של העסק, של הלקוחות, של הצעת הערך והמסרים, ושל תהליכי העבודה ושגרות הניהול.</p>
          <h3 class="process-title">תהליך ליווי עסקי וארגוני להגדלת הכנסות ושיפור הרווחיות</h3>
        </div>
        <Image src={flipchart} alt="" widths={[240, 380]} sizes="12rem" class="toon s-process__toon" />
      </div>
      <Timeline items={steps} />
      <!-- משפט הסיום של נוגה, כמו בעמוד הבית (2026-11-08). במקום "המטרה...". -->
      <p class="principle reveal">תובנות, החלטות ופעולות פשוטות וישימות שמקדמות את העסק בכל פגישה.</p>
    </div>
  </section>

  <!-- 5. למי זה מתאים: שני טורים, ותמונת אווירה (חדר ישיבות) מאחור בצד שמאל -->
  <section class="section s-fit" style={`--bg: url(${meetingBg.src})`}>
    <div class="container">
      <h2 class="sec-title reveal">הליווי מתאים לעסקים <span class="hl--mark">שכבר בנו משהו</span></h2>
      <div class="fit">
        <div class="fit__col fit__col--yes reveal">
          <h3 class="fit__title">זה בשבילכם אם</h3>
          <ul>
            {fit.yes.map((t) => <li><span class="fit__mark" aria-hidden="true"><Icon name="check" size={18} /></span>{t}</li>)}
          </ul>
        </div>
        <div class="fit__col fit__col--no reveal" style="transition-delay: 0.12s">
          <h3 class="fit__title">זה פחות מתאים אם</h3>
          <ul>
            {
              fit.no.map((t, i) => (
                <li>
                  <span class="fit__mark" aria-hidden="true">✕</span>
                  {i === fit.no.length - 1 ? (
                    <span>
                      העסק עוד בשלב ההקמה (בשבילכם יש <a href="/guides/">מדריכים חינמיים</a>)
                    </span>
                  ) : (
                    t
                  )}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. מה משתנה: היום מול המטרה. בלי הבטחה לתוצאות. -->
  <section class="section section--mist">
    <div class="container">
      <div class="ba-head">
        <h2 class="sec-title reveal">מה <span class="hl--mark">משתנה</span> בעסק</h2>
        <!-- מתג: לוחצים ורואים את כל השורות עוברות מ"היום" ל"המטרה". בלי JavaScript מוצגים שני הצדדים. -->
        <button class="ba-toggle" type="button" aria-pressed="false" hidden>
          <span class="ba-toggle__opt">היום</span>
          <span class="ba-toggle__track" aria-hidden="true"><span class="ba-toggle__knob"></span></span>
          <span class="ba-toggle__opt">המטרה</span>
        </button>
      </div>
      <ul class="ba">
        {
          beforeAfter.map((row, i) => (
            <li class="ba__row reveal" style={`transition-delay: ${i * 0.08}s`}>
              <div class="ba__cell ba__cell--today">
                <span class="ba__label">היום</span>
                <p>{row.today}</p>
              </div>
              <span class="ba__arrow" aria-hidden="true">←</span>
              <div class="ba__cell ba__cell--goal">
                <span class="ba__label">המטרה</span>
                <p>{row.goal}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 7. שאלות נפוצות -->
  <section class="section" id="faq-all">
    <div class="container">
      <Faq items={overviewFaq.map((id) => faqs[id])} />
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  /* ---------- פתיח: מדרגות מוארות (תמונת אווירה) בצד שמאל ---------- */
  .s-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3rem, 8vw, 5.5rem);
  }
  .s-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--bg) left center / cover no-repeat;
    opacity: 0.75;
    mask-image: linear-gradient(to left, transparent 20%, #000 75%);
    -webkit-mask-image: linear-gradient(to left, transparent 20%, #000 75%);
  }
  .s-hero__inner {
    position: relative;
  }
  .s-hero__inner {
    max-width: 52rem;
  }
  .s-hero__title {
    margin: 0 0 1rem;
    color: var(--white);
    font-size: clamp(1.9rem, 5.2vw, 3.2rem);
    font-weight: 900;
    line-height: 1.2;
  }
  /* בשורה משלה, בזהב, ובלי מעבר שורה גם בטלפון: הגודל מתכווץ לפי רוחב המסך */
  .s-hero__gold {
    display: block;
    width: fit-content;
    white-space: nowrap;
    font-size: min(0.9em, 6.6vw);
    background: var(--gold-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .s-hero__lead {
    max-width: 40rem;
    font-size: clamp(1.1rem, 2.2vw, 1.25rem);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  /* ---------- השירותים: רשימה מפורטת, שני טורים במחשב, בלי קופסאות ---------- */
  .svc-list {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0 3rem;
  }
  @media (max-width: 52rem) {
    .svc-list {
      grid-template-columns: 1fr;
    }
  }
  .svc-row {
    position: relative;
    display: flex;
    gap: 1.1rem;
    align-items: flex-start;
    margin: 0;
    padding: 1.4rem 0.25rem;
    border-bottom: 1px solid var(--line);
  }
  .svc-row__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 3.2rem;
    height: 3.2rem;
    border-radius: 0.9rem;
    background: var(--gold-gradient);
    color: var(--navy);
    transition: transform 0.3s ease;
  }
  .svc-row:hover .svc-row__icon {
    transform: translateY(-3px) rotate(-4deg);
  }
  .svc-row__title {
    margin: 0;
    font-size: 1.3rem;
    font-weight: 900;
  }
  .svc-row__title a {
    color: var(--navy);
    text-decoration: none;
  }
  /* כל השורה לחיצה, דרך הקישור שבכותרת */
  .svc-row__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .svc-row:hover .svc-row__title a {
    color: var(--teal-dark);
  }
  .svc-row__lead {
    margin: 0.2rem 0 0.4rem;
    font-weight: 700;
    color: var(--teal-dark);
  }
  .svc-row__text {
    margin: 0;
    line-height: 1.65;
    color: #33445c;
  }
  .svc-row__more {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: 0.92rem;
    font-weight: 800;
    color: var(--teal-dark);
  }

  /* כותרת בשתי שורות: החלק המודגש בשורה משלו, ברוחב המילים בלבד */
  .s-split .hl--mark {
    display: table;
    margin-inline: auto;
  }

  /* ---------- 8 תחומים: קו רקיע עדין של בניינים ---------- */
  .sky {
    --zone: 13.5rem;
    list-style: none;
    margin: 2.25rem 0 0;
    padding: 0;
    display: flex;
    justify-content: center;
  }
  .sky__item {
    flex: 1 1 0;
    max-width: 9.5rem;
    margin: 0;
    text-align: center;
  }
  /* אזור הבניין: גובה קבוע, כך שקו הקרקע ישר לאורך כל השורה */
  .sky__zone {
    position: relative;
    height: var(--zone);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    border-bottom: 1px solid rgb(209 154 74 / 0.55);
  }
  .sky__title {
    margin: 0 0 0.6rem;
    padding-inline: 0.25rem;
    font-size: 1rem;
    font-weight: 800;
    line-height: 1.3;
    color: var(--navy);
  }
  /* מעל בניין עם אנטנה: יותר מרווח, כדי שהאנטנה לא תיגע בכותרת */
  .sky__zone:has(.sky__bld--antenna) .sky__title {
    margin-bottom: 1.8rem;
  }
  .sky__bld {
    position: relative;
    width: 3.6rem;
    height: var(--h);
    border: 1px solid rgb(25 154 181 / 0.55);
    border-bottom: 0;
    border-radius: 0.35rem 0.35rem 0 0;
    background:
      repeating-linear-gradient(90deg, transparent 0 0.7rem, rgb(25 154 181 / 0.22) 0.7rem calc(0.7rem + 1px)),
      repeating-linear-gradient(180deg, transparent 0 0.85rem, rgb(25 154 181 / 0.22) 0.85rem calc(0.85rem + 1px)),
      linear-gradient(180deg, rgb(25 154 181 / 0.03), rgb(25 154 181 / 0.12));
    transition:
      background 0.4s ease,
      border-color 0.4s ease;
  }
  .sky__bld--antenna::before {
    content: '';
    position: absolute;
    bottom: 100%;
    left: 50%;
    width: 1px;
    height: 1.1rem;
    background: rgb(25 154 181 / 0.55);
  }
  .sky__item:hover .sky__bld {
    border-color: rgb(209 154 74 / 0.8);
    background:
      repeating-linear-gradient(90deg, transparent 0 0.7rem, rgb(209 154 74 / 0.45) 0.7rem calc(0.7rem + 1px)),
      repeating-linear-gradient(180deg, transparent 0 0.85rem, rgb(209 154 74 / 0.45) 0.85rem calc(0.85rem + 1px)),
      linear-gradient(180deg, rgb(252 220 109 / 0.12), rgb(252 220 109 / 0.32));
  }
  .sky__text {
    margin: 0.8rem 0 0;
    padding-inline: 0.5rem;
    font-size: 0.86rem;
    line-height: 1.45;
    color: #4a5b73;
  }
  /* טאבלט וטלפון: אותו קו רקיע, גוללים לצדדים */
  @media (max-width: 60rem) {
    .sky {
      justify-content: flex-start;
      overflow-x: auto;
      padding-bottom: 0.5rem;
      scroll-snap-type: x proximity;
    }
    .sky__item {
      flex: 0 0 8.5rem;
      scroll-snap-align: start;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sky__bld {
      transition: none;
    }
  }

  /* ---------- תהליך הליווי: בהיר, עם הדמות ליד הלוח ---------- */
  .s-process {
    background: linear-gradient(180deg, var(--white), var(--mist));
  }
  .s-process__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .s-process__head :global(.s-process__toon) {
    flex: none;
    width: clamp(7rem, 15vw, 12rem);
  }
  /* בטלפון: הדמות מתחת לטקסט, כדי שהטקסט לא יידחק לעמודה צרה */
  @media (max-width: 40rem) {
    .s-process__head {
      flex-direction: column;
      align-items: flex-start;
    }
    .s-process__head :global(.s-process__toon) {
      width: 8rem;
      align-self: flex-end;
    }
  }
  .process-title {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--teal-dark);
  }

  /* ---------- למי זה מתאים: תמונת אווירה מאחור ---------- */
  .s-fit {
    position: relative;
    overflow: hidden;
  }
  .s-fit::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--bg) left center / cover no-repeat;
    opacity: 0.5;
    mask-image: linear-gradient(to left, transparent 25%, #000 85%);
    -webkit-mask-image: linear-gradient(to left, transparent 25%, #000 85%);
  }
  .s-fit .container {
    position: relative;
  }

  /* ---------- מתג היום / המטרה ---------- */
  .ba-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .ba-head .sec-title {
    margin: 0;
  }
  .ba-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--white);
    font: inherit;
    font-weight: 800;
    color: var(--navy);
    cursor: pointer;
  }
  .ba-toggle[hidden] {
    display: none;
  }
  .ba-toggle__track {
    position: relative;
    width: 3rem;
    height: 1.6rem;
    border-radius: 999px;
    background: #cfd9e3;
    transition: background 0.3s ease;
  }
  .ba-toggle__knob {
    position: absolute;
    top: 0.2rem;
    right: 0.2rem;
    width: 1.2rem;
    height: 1.2rem;
    border-radius: 50%;
    background: var(--white);
    box-shadow: 0 2px 6px rgb(0 0 0 / 0.25);
    transition: transform 0.3s ease;
  }
  .ba-toggle[aria-pressed='true'] .ba-toggle__track {
    background: var(--gold-gradient);
  }
  .ba-toggle[aria-pressed='true'] .ba-toggle__knob {
    transform: translateX(-1.4rem);
  }
  /* כשהמתג פעיל (יש JavaScript): כל שורה מציגה צד אחד, ומתחלפת בהופעה עדינה */
  .ba.is-live .ba__row {
    grid-template-columns: 1fr;
  }
  .ba.is-live .ba__arrow,
  .ba.is-live .ba__cell--goal {
    display: none;
  }
  .ba.is-live.show-goal .ba__cell--goal {
    display: block;
    animation: ba-in 0.45s ease both;
  }
  .ba.is-live.show-goal .ba__cell--today {
    display: none;
  }
  @keyframes ba-in {
    from {
      opacity: 0;
      transform: translateY(0.5rem);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ba.is-live.show-goal .ba__cell--goal {
      animation: none;
    }
    .ba-toggle__track,
    .ba-toggle__knob {
      transition: none;
    }
  }

  /* ---------- העיקרון ---------- */
  .principle {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    margin: 2.5rem 0 0;
    font-size: clamp(1.1rem, 2.2vw, 1.3rem);
    font-weight: 500;
    color: var(--teal-dark);
    text-align: center;
  }

  /* ---------- למי זה מתאים ---------- */
  .fit {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }
  @media (max-width: 48rem) {
    .fit {
      grid-template-columns: 1fr;
    }
  }
  .fit__col {
    padding: 1.75rem;
    border-radius: 1.25rem;
    border: 1px solid var(--line);
  }
  .fit__col--yes {
    background: linear-gradient(160deg, rgb(25 154 181 / 0.09), transparent 60%), var(--white);
    border-top: 4px solid var(--teal);
  }
  .fit__col--no {
    background: var(--mist);
    border-top: 4px solid #b9c6d3;
  }
  .fit__title {
    margin: 0 0 1rem;
    font-size: 1.25rem;
    font-weight: 900;
  }
  .fit ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }
  .fit li {
    display: flex;
    gap: 0.65rem;
    align-items: flex-start;
    line-height: 1.55;
  }
  .fit__mark {
    flex: none;
    display: grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    margin-top: 0.05rem;
    border-radius: 50%;
    font-weight: 900;
    font-size: 0.85rem;
  }
  .fit__col--yes .fit__mark {
    background: var(--teal);
    color: var(--white);
  }
  .fit__col--no .fit__mark {
    background: #dbe3ea;
    color: #5b6b80;
  }
  .fit a {
    color: var(--teal-dark);
    font-weight: 700;
  }

  /* ---------- היום / המטרה ---------- */
  .ba {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }
  .ba__row {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: stretch;
    gap: 0.75rem;
    margin: 0;
  }
  .ba__cell {
    padding: 1rem 1.25rem;
    border-radius: 1rem;
  }
  .ba__cell p {
    margin: 0.2rem 0 0;
    line-height: 1.5;
    font-weight: 600;
  }
  .ba__cell--today {
    background: var(--white);
    border: 1px solid var(--line);
    color: #4a5b73;
  }
  .ba__cell--goal {
    background: var(--navy);
    color: var(--white);
  }
  .ba__label {
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.04em;
  }
  .ba__cell--today .ba__label {
    color: #7a8899;
  }
  .ba__cell--goal .ba__label {
    color: var(--gold-light);
  }
  .ba__arrow {
    align-self: center;
    font-size: 1.5rem;
    font-weight: 900;
    color: var(--gold-dark);
  }
  @media (max-width: 40rem) {
    .ba__row {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }
    .ba__arrow {
      justify-self: center;
      transform: rotate(-90deg);
      line-height: 1;
    }
  }
</style>

<script>
  // מתג "היום / המטרה": מחליף את כל השורות יחד. בלי JavaScript המתג מוסתר ושני הצדדים מוצגים.
  const toggle = document.querySelector<HTMLButtonElement>('.ba-toggle');
  const list = document.querySelector<HTMLElement>('.ba');
  if (toggle && list) {
    toggle.hidden = false;
    list.classList.add('is-live');
    toggle.addEventListener('click', () => {
      const on = toggle.getAttribute('aria-pressed') !== 'true';
      toggle.setAttribute('aria-pressed', String(on));
      list.classList.toggle('show-goal', on);
    });
  }
</script>
