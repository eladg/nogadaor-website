---
// עמוד השירותים (2026-11-07). התוכן ב-src/data/services.ts. הכול טיוטה לאישור נוגה.
// הסדר: פתיח עם הבטחה ← ריבועי השירותים (מתהפכים) ← מסתכלים על העסק כולו (8 תחומים) ← תהליך הליווי (3 שלבים של נוגה)
//   ← למי זה מתאים ← מה משתנה (היום / המטרה) ← שאלות נפוצות ← קריאה לפעולה.
// ההשראות שנוגה בחרה: incentive-group (הבטחה, "לא לכולם", "אחרי", שאלות), yanivless (ריבועים מתהפכים, ציר), pitron10 (שפת צורך).
// השראה בלבד, לא העתקה. הביקורת והציונים: drafts/critique-2026-11-07.md.
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
import Ribbon from '../../components/Ribbon.astro';
import Timeline from '../../components/Timeline.astro';
import Icon from '../../components/Icon.astro';
import Star from '../../components/Star.astro';
import { services, areas, steps } from '../../data/services';
import { advances } from '../../data/advances';
import { launch } from '../../data/launch';
// למי הליווי מתאים: הרשימה של נוגה (2026-11-08), עם תיקוני ניסוח קלים. השניים האחרונים הם תוספת שלי
// (עשרות אלפי לקוחות, לבקשתה, ומתוך "מה משתנה בעסק" שהוסר). טיוטה לאישור.
const fitFor = [
  'עסקים מבוססי שליחות ונותני שירותים מגוונים',
  'עסקים עמוסים בעבודה שרוצים להתייעל',
  'עסקים עם הרבה עובדים שצריכים סדר בתהליכי הניהול',
  'עסקים שמחפשים תכלס, פתרונות ממוקדים, חדשניים ומעשיים',
  'עסקים עם עשרות אלפי לקוחות שרוצים להפיק יותר מבסיס הלקוחות',
  'עסקים עם מחזור משמעותי שרוצים שיישאר יותר כסף בסוף',
];
import { contact } from '../../data/contact';
// תמונות אווירה (AI) והדמות המצוירת, נוגה 2026-11-07
import stairs from '../../assets/atmosphere/dark-stairs.webp';
import meeting from '../../assets/atmosphere/light-meeting-table.webp';
import flipchart from '../../assets/character/flipchart.webp';
const stairsBg = await getImage({ src: stairs, width: 1800, format: 'webp' });
const meetingBg = await getImage({ src: meeting, width: 1400, format: 'webp' });
---

<BaseLayout
  title="שירותי ייעוץ עסקי וארגוני"
  description="ייעוץ עסקי וארגוני להגדלת הכנסות ושיפור רווחיות. אסטרטגיה ושיווק, ייעוץ ארגוני, ייעול תהליכים עם AI, ליווי פיננסי, פגישת ייעוץ והדרכות."
>
  <!-- 1. פתיח קצר שמרים לשירותים (נוגה, 2026-11-08): בלי תווית, בלי תגיות ובלי כפתור "לכל השירותים".
       "להגדלת הכנסות ושיפור רווחיות" בזהב, בשורה משלה, ובטלפון בלי מעבר שורה. -->
  <section class="s-hero section--deep" style={`--bg: url(${stairsBg.src})`}>
    <div class="container s-hero__inner">
      <!-- התואר של נוגה -->
      <h1 class="s-hero__title">ייעוץ עסקי וארגוני <span class="s-hero__gold">להגדלת הכנסות ושיפור רווחיות</span></h1>
      <!-- נוגה (2026-11-08): רחב ומקצועי יותר, ישים ופרקטי, חדשני ויצירתי, מסתכל קדימה על המגמות, "מקדם מטרות ותוכניות גדולות". הניסוח שלי, ממתין לאישור. -->
      <p class="s-hero__lead">ליווי מקצועי שמקדם מטרות ותוכניות גדולות, בפתרונות ישימים, חדשניים ויצירתיים, שממצים את הפוטנציאל הקיים בעסק ומסתכלים קדימה אל המגמות של השוק.</p>
      <a class="btn" href={contact.whatsapp} target="_blank" rel="noopener">לשיחת היכרות<span class="sr-only"> (נפתח בלשונית חדשה)</span></a>
    </div>
  </section>

  <!-- 1א. הסרט הנע, הפעם בזהב (נוגה, 2026-11-08) -->
  <Ribbon items={advances} tone="gold" />

  <!-- 2. השירותים: בעמוד הבית הם כרטיסים כהים שמתהפכים, וכאן רשימה מפורטת יותר, כדי לא לחזור על אותו עיצוב
       (נוגה, 2026-11-08). הכותרת היא הצעה שלי. -->
  <section class="section s-list" id="services">
    <div class="container">
      <h2 class="sec-title center reveal">כל מה שהעסק שלך צריך <span class="hl--mark">כדי לצמוח</span></h2>
      <ul class="svc-list">
        {
          services.map((s, i) => (
            <li class="svc-row reveal" style={`transition-delay: ${(i % 2) * 0.08}s`}>
              <span class="svc-row__icon" aria-hidden="true"><Icon name={s.icon} size={26} /></span>
              <div class="svc-row__body">
                <h3 class="svc-row__title"><a href={s.href}>{s.title}</a></h3>
                <p class="svc-row__lead">{s.lead}</p>
                <p class="svc-row__text">{s.card}</p>
                {launch.servicePagesLive && <span class="svc-row__more" aria-hidden="true">לפרטים ←</span>}
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 3. מסתכלים על העסק כולו: הבידול של נוגה (שילוב, ולא נושא מבודד) -->
  <section class="section section--deep s-areas">
    <div class="container">
      <!-- הכותרת של נוגה (2026-11-08), מתוך "הבידול של נוגה" במסמך העבודה. שאר המילים סביבה הוסרו. -->
      <h2 class="sec-title center s-split s-areas__title reveal">ראייה מערכתית של העסק,{' '}<span class="hl">לצד ירידה לפרטים המעשיים</span></h2>
      <!-- נוגה (2026-11-08): בלי הבניינים. כרטיסים בכחול חזק, כולם בשורה אחת, והאייקון, הכותרת והמשפט באותו גובה בכל הכרטיסים. -->
      <ul class="areas">
        {
          areas.map((a, i) => (
            <li class="area reveal" style={`transition-delay: ${i * 0.06}s`}>
              <span class="area__icon" aria-hidden="true"><Icon name={a.icon} size={24} /></span>
              <h3 class="area__title">{a.title}</h3>
              <p class="area__text">{a.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 4. תהליך הליווי: שלושת השלבים של נוגה (2026-11-07). הפתיחה מטקסט האתר הקודם שלה ("ההיגיון אומר..."). -->
  <section class="section s-process" id="process">
    <div class="container">
      <div class="s-process__head">
        <div>
          <!-- הסדר של נוגה (2026-11-08): המשפט שלה ככותרת ראשית, ואחריו הפסקה שלה (תוקנו רק שגיאות כתיב) -->
          <h2 class="sec-title s-proc-title reveal">תובנות, החלטות ופעולות פשוטות וישימות{' '}<span class="hl--mark">שמקדמות את העסק בכל פגישה</span></h2>
          <p class="sec-lead">טעות לחשוב שהגדלת הכנסות צריכה להגיע עם שינויים גדולים, רעיונות חדשניים, פרויקטים והשקעות. צריך להסתכל על הדברים מלמעלה, אבל להבין איך לעשות שינויים קטנים ואפקטיביים שמייצרים הבדל גדול.</p>
        </div>
        <Image src={flipchart} alt="" widths={[240, 380]} sizes="12rem" class="toon s-process__toon" />
      </div>
      <Timeline items={steps} />
      <!-- מתוך הצעת הליווי של נוגה (2026-11-08), כללי ולא מתחייב. קטן, מתחת לשלבים. -->
      <p class="s-process__note reveal">הליווי מותאם אישית לצורכי העסק ולממצאים שעולים במהלך העבודה, ותחומי העבודה, עומק הבדיקה וסדרי העדיפויות נקבעים במשותף.</p>
    </div>
  </section>

  <!-- 5. למי זה מתאים (נוגה, 2026-11-08): משפט ההשראה, ורשימת סוגי העסקים שלה. בלי "פחות מתאים",
       בלי "מה משתנה בעסק" ובלי שאלות נפוצות (הוסרו לבקשתה). הבולטים בלי נקודה בסוף. -->
  <section class="section s-fit" style={`--bg: url(${meetingBg.src})`}>
    <div class="container">
      <figure class="s-quote reveal">
        <blockquote>אי שפיות היא לעשות את אותו הדבר שוב ושוב, ולצפות לתוצאות שונות</blockquote>
        <figcaption>אלברט איינשטיין</figcaption>
      </figure>
      <h2 class="sec-title center reveal">למי <span class="hl--mark">הליווי מתאים?</span></h2>
      <ul class="fit-list">
        {
          fitFor.map((item, i) => (
            <li class="reveal" style={`transition-delay: ${(i % 3) * 0.08}s`}>
              <span class="fit-list__check" aria-hidden="true">
                <Star size={22} tone="navy" />
              </span>
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 6. לאן ממשיכים: הפניה לעמודי השירות, לשאלון ולמדריכים (נוגה, 2026-11-08: "צריך להפנות אותם לעמודים הרלוונטיים") -->
  <section class="section section--mist s-next">
    <div class="container">
      <h2 class="sec-title center reveal">מאיפה <span class="hl--mark">מתחילים?</span></h2>
      <ul class="next-links">
        {services.map((s) => <li><a href={s.href}>{s.title}</a></li>)}
      </ul>
      <p class="next-more">
        עוד לא בטוחים?{' '}<a href="/guides/business-focus-quiz/">לשאלון המיקוד החינמי</a>{' '}או{' '}<a href="/guides/">למדריכים במרכז הידע</a>
      </p>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  /* ---------- פתיח: מדרגות מוארות (תמונת אווירה) בצד שמאל ---------- */
  .s-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3rem, 8vw, 5.5rem);
  }
  .s-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--bg) left center / cover no-repeat;
    opacity: 0.75;
    mask-image: linear-gradient(to left, transparent 20%, #000 75%);
    -webkit-mask-image: linear-gradient(to left, transparent 20%, #000 75%);
  }
  .s-hero__inner {
    position: relative;
  }
  .s-hero__inner {
    max-width: 52rem;
  }
  .s-hero__title {
    margin: 0 0 1rem;
    color: var(--white);
    font-size: clamp(1.9rem, 5.2vw, 3.2rem);
    font-weight: 900;
    line-height: 1.2;
  }
  /* בשורה משלה, בזהב, ובלי מעבר שורה גם בטלפון: הגודל מתכווץ לפי רוחב המסך */
  .s-hero__gold {
    display: block;
    width: fit-content;
    white-space: nowrap;
    font-size: min(0.9em, 6.6vw);
    background: var(--gold-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .s-hero__lead {
    max-width: 40rem;
    font-size: clamp(1.1rem, 2.2vw, 1.25rem);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  /* ---------- השירותים: רשימה מפורטת, שני טורים במחשב, בלי קופסאות ---------- */
  .svc-list {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0 3rem;
  }
  @media (max-width: 52rem) {
    .svc-list {
      grid-template-columns: 1fr;
    }
  }
  .svc-row {
    position: relative;
    display: flex;
    gap: 1.1rem;
    align-items: flex-start;
    margin: 0;
    padding: 1.4rem 0.25rem;
    border-bottom: 1px solid var(--line);
  }
  .svc-row__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 3.2rem;
    height: 3.2rem;
    border-radius: 0.9rem;
    background: var(--gold-gradient);
    color: var(--navy);
    transition: transform 0.3s ease;
  }
  @media (hover: hover) {
    .svc-row:hover .svc-row__icon {
      transform: translateY(-3px) rotate(-4deg);
    }
  }
  .svc-row__title {
    margin: 0;
    font-size: 1.3rem;
    font-weight: 900;
  }
  .svc-row__title a {
    color: var(--navy);
    text-decoration: none;
  }
  /* כל השורה לחיצה, דרך הקישור שבכותרת */
  .svc-row__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .svc-row:hover .svc-row__title a {
    color: var(--teal-dark);
  }
  .svc-row__lead {
    margin: 0.2rem 0 0.4rem;
    font-weight: 700;
    color: var(--teal-dark);
  }
  .svc-row__text {
    margin: 0;
    line-height: 1.65;
    color: #33445c;
  }
  .svc-row__more {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: 0.92rem;
    font-weight: 800;
    color: var(--teal-dark);
  }

  /* כותרת בשתי שורות: החלק המודגש בשורה משלו, ברוחב המילים בלבד */
  .s-split .hl--mark {
    display: table;
    margin-inline: auto;
  }

  /* ---------- התחומים: כרטיסים בכחול חזק, כולם בשורה אחת, באותו גובה (subgrid) ---------- */
  /* רקע כהה וכרטיסים לבנים (נוגה, 2026-11-08) */
  .s-areas__title {
    color: var(--white);
  }
  .s-split .hl {
    display: block;
  }
  .areas {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 0.75rem;
  }
  .area {
    display: grid;
    grid-row: span 3;
    grid-template-rows: subgrid;
    row-gap: 0.6rem;
    justify-items: center;
    align-items: start;
    margin: 0;
    padding: 1.35rem 0.85rem 1.25rem;
    border-radius: 1.1rem;
    text-align: center;
    color: var(--navy);
    background: var(--white);
    border-top: 3px solid var(--gold-dark);
    box-shadow: 0 18px 34px -24px rgb(0 0 0 / 0.9);
    transition: transform 0.3s ease;
  }
  @media (hover: hover) {
    .area:hover {
      transform: translateY(-4px);
    }
  }
  .area__icon {
    display: grid;
    place-items: center;
    width: 2.8rem;
    height: 2.8rem;
    border-radius: 0.8rem;
    background: var(--gold-gradient);
    color: var(--navy);
  }
  .area__title {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 900;
    line-height: 1.3;
    color: var(--navy);
  }
  .area__text {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.55;
    color: #33445c;
  }
  /* טאבלט וטלפון: בלי גלילה לצדדים (נוגה, 2026-11-12). כל תחום בשורה, האייקון מימין לכותרת ולהסבר.
     בטאבלט שני טורים. */
  @media (max-width: 64rem) {
    .areas {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.75rem;
    }
    .area {
      grid-row: auto;
      grid-template-rows: none;
      grid-template-columns: auto 1fr;
      column-gap: 0.85rem;
      row-gap: 0.2rem;
      justify-items: start;
      padding: 1rem 1.1rem;
      text-align: start;
      border-top: 0;
      border-inline-start: 3px solid var(--gold-dark);
    }
    .area__icon {
      grid-row: span 2;
      width: 2.5rem;
      height: 2.5rem;
    }
  }
  @media (max-width: 40rem) {
    .areas {
      grid-template-columns: 1fr;
      gap: 0.6rem;
    }
  }

  /* ---------- תהליך הליווי: בהיר, עם הדמות ליד הלוח ---------- */
  .s-process {
    background: linear-gradient(180deg, var(--white), var(--mist));
  }
  .s-process__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .s-process__head :global(.s-process__toon) {
    flex: none;
    width: clamp(7rem, 15vw, 12rem);
  }
  /* בטלפון: הדמות מתחת לטקסט, כדי שהטקסט לא יידחק לעמודה צרה */
  @media (max-width: 40rem) {
    .s-process__head {
      flex-direction: column;
      align-items: flex-start;
    }
    .s-process__head :global(.s-process__toon) {
      width: 8rem;
      align-self: flex-end;
    }
  }
  .process-title {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--teal-dark);
  }

  /* ---------- למי זה מתאים: תמונת אווירה מאחור ---------- */
  .s-fit {
    position: relative;
    overflow: hidden;
  }
  .s-fit::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--bg) left center / cover no-repeat;
    opacity: 0.5;
    mask-image: linear-gradient(to left, transparent 25%, #000 85%);
    -webkit-mask-image: linear-gradient(to left, transparent 25%, #000 85%);
  }
  .s-fit .container {
    position: relative;
  }

  /* ---------- העיקרון ---------- */
  /* החלק המודגש בשורה משלו (הכלל של נוגה: בלי מילה צבועה בסוף שורה) */
  .s-proc-title .hl--mark {
    display: table;
  }
  .s-process__note {
    max-width: 40rem;
    margin: 2rem auto 0;
    text-align: center;
    font-size: 0.9rem;
    line-height: 1.6;
    color: #5b6b82;
  }
  .principle--top {
    justify-content: flex-start;
    text-align: start;
    margin: 0.5rem 0 0;
  }
  .principle {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    margin: 1rem 0 0;
    font-size: clamp(1.1rem, 2.2vw, 1.3rem);
    font-weight: 500;
    color: var(--teal-dark);
    text-align: center;
  }

  /* ---------- למי זה מתאים: משפט השראה ורשימה ---------- */
  .s-quote {
    max-width: 44rem;
    margin: 0 auto 2.5rem;
    text-align: center;
  }
  .s-quote blockquote {
    margin: 0;
    font-size: clamp(1.4rem, 3.2vw, 2rem);
    font-weight: 800;
    line-height: 1.4;
    color: var(--navy);
  }
  .s-quote blockquote::before,
  .s-quote blockquote::after {
    color: var(--gold-dark);
  }
  .s-quote blockquote::before {
    content: '"';
  }
  .s-quote blockquote::after {
    content: '"';
  }
  .s-quote figcaption {
    margin-top: 0.6rem;
    font-weight: 700;
    color: var(--teal-dark);
  }
  .fit-list {
    list-style: none;
    max-width: 62rem;
    margin: 1.75rem auto 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.1rem;
  }
  @media (max-width: 62rem) {
    .fit-list {
