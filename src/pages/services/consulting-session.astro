---
// פגישת ייעוץ, עמוד משלו (נוגה, 2026-11-09): "עמוד מאוד שימושי, מרשים ושונה", כל סוגי הפגישות אחת אחרי השנייה,
// בלי פגישת פיננסים, עם תמונות מזמינות, ושיהיה ברור מאוד איזו בעיה כל פגישה פותרת ועם מה יוצאים.
// הסדר: פתיח (נוגה לוחצת יד ללקוח) ← "מה הכי בוער" (בורר שמוביל לפגישה) ← ארבעה פרקים, פגישה בכל פרק
//   (משפט הפתיח של נוגה, מה עושים בפגישה, יוצאים עם, המלצה אמיתית וכפתור וואטסאפ עם שם הפגישה) ← איך קובעים.
// כל התמונות הן תמונות האילוסטרציה של פגישות עם לקוחות שנוגה שלחה (2026-11-09).
// הטקסטים ב-src/data/services.ts (topics). ההמלצות מ-reviews.ts לפי שם, בנוסח של נוגה בלי שינוי.
// אין כאן "משתלב עם": הוא הציג את הליווי הפיננסי.
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Star from '../../components/Star.astro';
import { serviceBySlug } from '../../data/services';
import { allReviews } from '../../data/reviews';
import { contact } from '../../data/contact';
import { serviceSchema } from '../../utils/schema';

// עדכון (נוגה, 2026-11-13, אחרי השיחה עם המעצבת): תמונת קאבר חדשה, נוגה במשרד בצד שמאל והטקסט מימין.
// התמונות של הפגישות הוחלפו בארבע תמונות חדשות שנוגה שלחה, ומופיעות פעם אחת בלבד, בפרק של כל פגישה.
import cover from '../../assets/consulting/cover-office-2026-11-13.webp';
import meetStrategy from '../../assets/consulting/meet-strategy.webp';
import meetDigital from '../../assets/consulting/meet-digital.webp';
import meetCommunity from '../../assets/consulting/meet-community.webp';
import meetWebinar from '../../assets/consulting/meet-webinar.webp';

const s = serviceBySlug('consulting-session')!;
const topics = s.topics ?? [];

// תמונה לכל פגישה (בפרק של הפגישה בלבד)
const photos: Record<string, { src: ImageMetadata; alt: string; pos: string }> = {
  strategy: { src: meetStrategy, alt: 'לוח אסטרטגיה: רעיונות, מטרות ונתונים שמתחברים להחלטה אחת ולתוכנית צמיחה', pos: '50% 50%' },
  digital: { src: meetDigital, alt: 'טלפון ומחשב נייד עם אתר ועמוד ברשתות של עסק, באותה שפה עיצובית', pos: '50% 50%' },
  community: { src: meetCommunity, alt: 'רשת של קבוצות שמחוברות לקהילה אחת במרכז', pos: '50% 50%' },
  presentation: { src: meetWebinar, alt: 'שלבי בניית הדרכה: רעיון, סרטון וקריאה לפעולה, ומיקרופון', pos: '50% 50%' },
};

const wa = (text: string) => `${contact.whatsapp}?text=${encodeURIComponent(text)}`;
const reviewOf = (name?: string, starts?: string) =>
  name ? allReviews.find((r) => r.name === name && (!starts || r.text.startsWith(starts))) : undefined;
const num = (i: number) => String(i + 1).padStart(2, '0');

const description =
  'פגישת ייעוץ עסקי בנושא אחד, ייעוץ אסטרטגי, נוכחות שיווקית בדיגיטל, בניית קהילה או בניית הדרכה ווובינר. עובדים בפועל, מקבלים החלטות, ויוצאים עם כיוון ברור, סיכום מסודר והקלטה.';
const path = '/services/consulting-session/';
const schema = [serviceSchema(Astro.site, { name: s.title, description, path })];
const crumbs = [
  { name: 'בית', path: '/' },
  { name: 'שירותים', path: '/services/' },
  { name: s.title, path },
];
---

<BaseLayout title={s.title} description={description} schema={schema} crumbs={crumbs}>
  <!-- 1. פתיח (נוגה, 2026-11-13): תמונת הקאבר החדשה, נוגה במשרד בצד שמאל והכותרת מימין על הכחול -->
  <section class="cs-hero">
    <div class="cs-hero__media">
      <Image src={cover} alt="נוגה דיין אור במשרד, מחייכת" widths={[640, 1024, 1672]} sizes="100vw" loading="eager" fetchpriority="high" />
    </div>
    <div class="container cs-hero__inner">
      <div class="cs-hero__text">
        <p class="cs-crumbs"><a href="/services/">שירותים</a> <span aria-hidden="true">/</span> {s.title}</p>
        <h1 class="cs-hero__title">
          <span>{s.title}</span>{' '}<span class="cs-hero__sub hl">לפיצוח אתגר עסקי בפגישה אחת</span>
        </h1>
      </div>
    </div>
  </section>

  <!-- 2. ההבטחה וארבע הפגישות (נוגה, 2026-11-13): במקום כל הפירוט למעלה, רק ארבעה כרטיסים עם שם הפגישה, בולטים ובמרכז,
       ומעליהם הבטחה שפגישה אחת יכולה לייצר שינוי משמעותי. המשפט שמתחת לכותרת הוא הנוסח של נוגה (s.intro). הכותרת הצעה שלי, לאישור.
       לחיצה על כרטיס מורידה לפרק של הפגישה. -->
  <section class="cs-choose" id="choose" aria-labelledby="choose-title">
    <div class="container">
      <h2 id="choose-title" class="cs-promise reveal">פגישה אחת נכונה{' '}<span class="hl">יכולה להזיז את העסק קדימה</span></h2>
      <p class="cs-promise__text reveal">{s.intro}</p>
      <ul class="picks">
        {
          topics.map((t, i) => (
            <li class="reveal">
              <a class="pick" href={'#' + t.id}>
                <span class="pick__num" aria-hidden="true">{num(i)}</span>
                <span class="pick__icon" aria-hidden="true"><Icon name={t.icon} size={34} /></span>
                <span class="pick__title">{t.title}</span>
                <span class="pick__go" aria-hidden="true">↓</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="cs-choose__wa reveal">
        <a class="btn" href={wa('היי נוגה, אשמח לתאם פגישת ייעוץ')} target="_blank" rel="noopener">לתיאום פגישה בוואטסאפ<span class="sr-only"> (נפתח בלשונית חדשה)</span></a>
      </p>
    </div>
  </section>

  <!-- 3. הפגישות, אחת אחרי השנייה -->
  {
    topics.map((t, i) => {
      const photo = photos[t.id];
      const rv = reviewOf(t.review, t.reviewStarts);
      return (
        <section id={t.id} class:list={['ch', { 'ch--mist': i % 2 === 0, 'ch--flip': i % 2 === 1 }]} aria-labelledby={`${t.id}-title`}>
          <div class="container ch__grid">
            <div class="ch__head reveal">
              <p class="ch__num" aria-hidden="true">{num(i)}</p>
              <h2 id={`${t.id}-title`} class="ch__title">
                {t.title}
              </h2>
              <p class="ch__challenge">{t.pain}</p>
              <p class="ch__promise">{t.promise}</p>
            </div>

            <div class="ch__media reveal">
              {photo && (
                <Image
                  src={photo.src}
                  alt={photo.alt}
                  widths={[640, 1024, 1536]}
                  sizes="(min-width: 60rem) 46vw, 100vw"
                  style={`object-position: ${photo.pos}`}
                />
              )}
            </div>

            <div class="ch__body reveal">
              <p class="ch__label">מה עושים בפגישה</p>
              {t.paras.map((p) => (
                <p>{p}</p>
              ))}
            </div>

            <div class="ch__out reveal">
              <p class="ch__out-title">יוצאים מהפגישה עם</p>
              <ul>
                {t.outcomes.map((o) => (
                  <li>
                    <Star size={18} />
                    <span>{o}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="ch__foot reveal">
              {rv && (
                <figure class="ch__quote">
                  <blockquote>
                    <p>{rv.text}</p>
                  </blockquote>
                  <figcaption>
                    <strong>{rv.name}</strong> <span>מקור {rv.source}</span>
                  </figcaption>
                </figure>
              )}
              <a class="ch__cta" href={wa(`היי נוגה, אשמח לתאם פגישת ייעוץ בנושא ${t.title}`)} target="_blank" rel="noopener">
                <Icon name="whatsapp" size={20} />
                לתיאום פגישת {t.title}
                <span class="sr-only"> (נפתח בלשונית חדשה)</span>
              </a>
            </div>
          </div>
        </section>
      );
    })
  }

  <!-- 4. איך קובעים. כרטיס כהה בתוך אזור בהיר, כדי שלא יהיו שני אזורים כהים ברצף עם הפוטר. -->
  <section class:list={['section cs-end', { 'section--mist': topics.length % 2 === 0 }]} aria-labelledby="end-title">
    <div class="container">
      <div class="cs-end__card reveal">
        <div class="cs-end__content">
        <Star size={30} />
        <h2 id="end-title" class="cs-end__title">
          <span>בוחרים נושא</span>{' '}<span class="hl">ומתאמים בוואטסאפ</span>
        </h2>
        <ol class="cs-steps">
          <li><span class="cs-steps__n">1</span>בוחרים את הנושא שהכי בוער בעסק עכשיו</li>
          <li><span class="cs-steps__n">2</span>שולחים הודעה בוואטסאפ ומתאמים מועד</li>
          <li><span class="cs-steps__n">3</span>נפגשים, עובדים בפועל, ומקבלים סיכום והקלטה</li>
        </ol>
        <a class="btn cs-end__btn" href={wa('היי נוגה, אשמח לתאם פגישת ייעוץ')} target="_blank" rel="noopener">
          לתיאום פגישה בוואטסאפ<span class="sr-only"> (נפתח בלשונית חדשה)</span>
        </a>
        <p class="cs-end__note">
          עוד לא בטוחים איזו פגישה מתאימה?{' '}
          <a href={wa('היי נוגה, אשמח להתייעץ איזו פגישת ייעוץ מתאימה לי')} target="_blank" rel="noopener">
            כתבו בכמה מילים מה מעסיק אתכם<span class="sr-only"> (נפתח בלשונית חדשה)</span></a>, ובוחרים יחד.
        </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- פתיח (נוגה, 2026-11-13): התמונה על כל הרוחב, נוגה משמאל והטקסט מימין ---------- */
  .cs-hero {
    position: relative;
    overflow: hidden;
    background: #011430;
    color: var(--on-dark);
  }
  .cs-hero__media {
    position: relative;
    height: min(80vw, 24rem);
  }
  .cs-hero__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 12% 20%;
  }
  .cs-hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(1 20 48 / 0) 65%, #011430 100%);
  }
  .cs-hero__inner {
    position: relative;
    padding-block: 0 1.5rem;
  }
  @media (min-width: 52rem) {
    .cs-hero {
      display: flex;
      align-items: center;
      min-height: clamp(22rem, 52vh, 30rem);
    }
    .cs-hero__media {
      position: absolute;
      inset: 0;
      height: auto;
    }
    .cs-hero__media :global(img) {
      object-position: left 25%;
    }
    .cs-hero__media::after {
      background:
        linear-gradient(to left, rgb(1 20 48 / 0.5) 0%, rgb(1 20 48 / 0) 40%),
        linear-gradient(180deg, rgb(1 20 48 / 0) 70%, #011430 100%);
    }
    .cs-hero__inner {
      padding-block: 3rem;
    }
    /* הטקסט בצד ימין, מעל הכחול */
    .cs-hero__text {
      max-width: min(34rem, 48vw);
    }
  }
  .cs-crumbs {
    margin: 0 0 0.75rem;
    font-size: 0.95rem;
    color: var(--on-dark-soft);
  }
  .cs-crumbs a {
    color: var(--gold-light);
    font-weight: 700;
  }
  .cs-hero__title {
    margin: 0;
    font-size: clamp(2.6rem, 7vw, 4.2rem);
    font-weight: 900;
    line-height: 1.05;
    color: var(--white);
  }
  .cs-hero__title > span {
    display: block;
  }
  .cs-hero__sub {
    margin-top: 0.6rem;
    font-size: clamp(1.35rem, 3vw, 1.9rem);
    font-weight: 800;
    line-height: 1.3;
  }

  /* ---------- ההבטחה וארבעת הכרטיסים: ממשיכים את הכחול של הפתיח, הכול במרכז ---------- */
  .cs-choose {
    margin-top: -1px;
    padding-block: clamp(2rem, 5vw, 3.5rem) clamp(3rem, 7vw, 4.75rem);
    text-align: center;
    color: var(--on-dark);
    background:
      radial-gradient(40rem 20rem at 50% 100%, rgb(12 138 168 / 0.28), transparent 70%),
      radial-gradient(30rem 16rem at 90% 30%, rgb(252 220 109 / 0.1), transparent 70%),
      #011430;
    scroll-margin-top: var(--header-h);
  }
  .cs-promise {
    max-width: 46rem;
    margin: 0 auto 1rem;
    font-size: clamp(1.9rem, 4.6vw, 2.9rem);
    font-weight: 900;
    line-height: 1.2;
    color: var(--white);
  }
  .cs-promise .hl {
    display: block;
  }
  .cs-promise__text {
    max-width: 40rem;
    margin: 0 auto clamp(2rem, 4vw, 2.75rem);
    font-size: clamp(1.1rem, 2vw, 1.28rem);
    line-height: 1.75;
    color: var(--on-dark);
  }
  .picks {
    list-style: none;
    max-width: 64rem;
    margin: 0 auto;
    padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(2, 1fr);
  }
  @media (min-width: 60rem) {
    .picks {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.25rem;
    }
  }
  .picks li {
    margin: 0;
  }
  /* כרטיס: מספר, אייקון בזהב (בלי ריבוע), שם הפגישה גדול, וחץ למטה */
  .pick {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    height: 100%;
    padding: 1.75rem 1rem 1.25rem;
    border-radius: 1.5rem;
    color: var(--white);
    text-decoration: none;
    background: linear-gradient(165deg, rgb(255 255 255 / 0.12), rgb(255 255 255 / 0.03));
    border: 1px solid rgb(252 220 109 / 0.3);
    box-shadow:
      0 24px 48px -28px rgb(0 0 0 / 0.8),
      inset 0 1px 0 rgb(255 255 255 / 0.12);
    transition:
      transform 0.3s ease,
      border-color 0.3s ease;
  }
  .pick__num {
    position: absolute;
    top: 0.8rem;
    inset-inline-start: 1rem;
    font-size: 0.85rem;
    font-weight: 800;
    color: rgb(252 220 109 / 0.7);
  }
  .pick__icon {
    color: var(--gold-light);
  }
  .pick__title {
    font-size: clamp(1.2rem, 2.2vw, 1.45rem);
    font-weight: 900;
    line-height: 1.3;
  }
  .pick__go {
    margin-top: auto;
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--gold-light);
    transition: transform 0.3s ease;
  }
  .pick:focus-visible {
    outline: 3px solid var(--gold-light);
    outline-offset: 3px;
  }
  @media (hover: hover) {
    .pick:hover {
      transform: translateY(-0.35rem);
      border-color: var(--gold-light);
    }
    .pick:hover .pick__go {
      transform: translateY(0.25rem);
    }
  }
  .cs-choose__wa {
    margin: clamp(2rem, 4vw, 2.75rem) 0 0;
  }

  /* ---------- פרק לכל פגישה ---------- */
  .ch {
    padding-block: clamp(3rem, 8vw, 6rem);
    scroll-margin-top: var(--header-h);
  }
  .ch--mist {
    background: var(--mist);
  }
  .ch__grid {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 60rem) {
    .ch__grid {
      grid-template-columns: 1.05fr 1fr;
      grid-template-areas:
        'head media'
        'body media'
        'foot out';
      column-gap: clamp(2.5rem, 5vw, 5rem);
      row-gap: 1.25rem;
      align-items: start;
    }
    .ch--flip .ch__grid {
      grid-template-columns: 1fr 1.05fr;
      grid-template-areas:
        'media head'
        'media body'
        'out foot';
    }
    .ch__head {
      grid-area: head;
    }
    .ch__media {
      grid-area: media;
      align-self: stretch;
    }
    .ch__body {
      grid-area: body;
    }
    .ch__foot {
      grid-area: foot;
    }
    /* "יוצאים עם" עולה על התחתית של התמונה */
    .ch__out {
      grid-area: out;
      position: relative;
      z-index: 1;
      margin-top: -7rem;
      margin-inline: 2rem -1.5rem;
    }
    .ch--flip .ch__out {
      margin-inline: -1.5rem 2rem;
    }
  }

  .ch__num {
    margin: 0 0 -0.4rem;
    font-size: clamp(4rem, 10vw, 7rem);
    font-weight: 900;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 2px var(--gold-dark);
    opacity: 0.75;
  }
  .ch__kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0 0 0.25rem;
    font-weight: 800;
    color: var(--teal-dark);
  }
  .ch__title {
    margin: 0 0 1.5rem;
    font-size: clamp(2rem, 4.8vw, 3rem);
    font-weight: 900;
    line-height: 1.15;
    color: var(--navy);
  }
  .ch__label {
    margin: 0 0 0.4rem;
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    color: var(--gold-dark);
  }
  .ch__challenge {
    margin: 0;
    padding-inline-start: 1rem;
    border-inline-start: 4px solid var(--teal);
    font-size: clamp(1.2rem, 2.5vw, 1.5rem);
    font-weight: 700;
    line-height: 1.5;
    color: var(--navy);
  }
  .ch__promise {
    margin: 0.85rem 0 0;
    font-size: clamp(1.08rem, 2vw, 1.22rem);
    line-height: 1.65;
    color: var(--teal-dark);
    font-weight: 600;
  }
  .ch__body p:not(.ch__label) {
    font-size: 1.08rem;
    line-height: 1.8;
    color: #33445c;
  }
  .ch__body p:last-child {
    margin-bottom: 0;
  }

  /* תמונה גדולה ומעוגלת, בלי מסגרת */
  .ch__media {
    position: relative;
    min-height: 16rem;
  }
  .ch__media > :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 16 / 11;
    object-fit: cover;
    border-radius: 1.75rem;
    box-shadow: 0 1.5rem 3rem -1.5rem rgb(11 26 51 / 0.35);
  }
  @media (min-width: 60rem) {
    .ch__media {
      min-height: 32rem;
    }
    .ch__media > :global(img) {
      position: absolute;
      inset: 0;
      aspect-ratio: auto;
    }
  }

  /* יוצאים עם: כרטיס כחול כהה */
  .ch__out {
    padding: clamp(1.25rem, 3vw, 1.75rem);
    border-radius: 1.4rem;
    background:
      radial-gradient(16rem 10rem at 100% 0, rgb(12 138 168 / 0.35), transparent 70%),
      var(--navy);
    color: var(--white);
    box-shadow: 0 1.5rem 3rem -1.25rem rgb(11 26 51 / 0.55);
  }
  .ch__out-title {
    margin: 0 0 0.85rem;
    font-size: 1.15rem;
    font-weight: 900;
    color: var(--gold-light);
  }
  .ch__out ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.65rem;
  }
  .ch__out li {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    line-height: 1.45;
    font-size: 1.05rem;
  }
