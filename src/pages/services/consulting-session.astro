---
// פגישת ייעוץ, עמוד משלו (נוגה, 2026-11-09): "עמוד מאוד שימושי, מרשים ושונה", כל סוגי הפגישות אחת אחרי השנייה,
// בלי פגישת פיננסים, עם תמונות מזמינות, ושיהיה ברור מאוד איזו בעיה כל פגישה פותרת ועם מה יוצאים.
// הסדר: פתיח (נוגה לוחצת יד ללקוח) ← "מה הכי בוער" (בורר שמוביל לפגישה) ← ארבעה פרקים, פגישה בכל פרק
//   (משפט הפתיח של נוגה, מה עושים בפגישה, יוצאים עם, המלצה אמיתית וכפתור וואטסאפ עם שם הפגישה) ← איך קובעים.
// כל התמונות הן תמונות האילוסטרציה של פגישות עם לקוחות שנוגה שלחה (2026-11-09).
// הטקסטים ב-src/data/services.ts (topics). ההמלצות מ-reviews.ts לפי שם, בנוסח של נוגה בלי שינוי.
// אין כאן "משתלב עם": הוא הציג את הליווי הפיננסי.
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Star from '../../components/Star.astro';
import { serviceBySlug } from '../../data/services';
import { allReviews } from '../../data/reviews';
import { contact } from '../../data/contact';
import { serviceSchema } from '../../utils/schema';

// תמונות האילוסטרציה של פגישות עם לקוחות שנוגה שלחה (2026-11-09). המקור ב"חומרים גרפיים לאתר/תמונות לפגישות ייעוץ 2026-11-09".
import handshakeMan from '../../assets/consulting/handshake-man.webp';
import handshakeWoman from '../../assets/consulting/handshake-woman.webp';
import explaining from '../../assets/consulting/explaining-to-client.webp';
import laptop from '../../assets/consulting/laptop-laughing.webp';
import group from '../../assets/consulting/group-of-three.webp';
import writing from '../../assets/consulting/writing-notebook.webp';

const s = serviceBySlug('consulting-session')!;
const topics = s.topics ?? [];

// תמונה לכל פגישה. pos = החיתוך, כך שנוגה תמיד בתמונה.
const photos: Record<string, { src: ImageMetadata; alt: string; pos: string }> = {
  strategy: { src: explaining, alt: 'נוגה מסבירה ללקוח בפגישת ייעוץ', pos: '45% 40%' },
  digital: { src: laptop, alt: 'נוגה ולקוחה צוחקות מול המחשב בפגישה', pos: '85% 35%' },
  community: { src: group, alt: 'נוגה בפגישה עם שני לקוחות', pos: '10% 35%' },
  presentation: { src: writing, alt: 'נוגה כותבת במחברת לצד לקוחה', pos: '30% 35%' },
};

const wa = (text: string) => `${contact.whatsapp}?text=${encodeURIComponent(text)}`;
const reviewOf = (name?: string) => (name ? allReviews.find((r) => r.name === name) : undefined);
const num = (i: number) => String(i + 1).padStart(2, '0');

const description =
  'פגישת ייעוץ עסקי בנושא אחד, ייעוץ אסטרטגי, נוכחות שיווקית בדיגיטל, בניית קהילה או בניית הדרכה ווובינר. עובדים בפועל, מקבלים החלטות, ויוצאים עם כיוון ברור, סיכום מסודר והקלטה.';
const path = '/services/consulting-session/';
const schema = [serviceSchema(Astro.site, { name: s.title, description, path })];
const crumbs = [
  { name: 'בית', path: '/' },
  { name: 'שירותים', path: '/services/' },
  { name: s.title, path },
];
---

<BaseLayout title={s.title} description={description} schema={schema} crumbs={crumbs}>
  <!-- 1. פתיח: נוגה לוחצת יד ללקוח, בצד שמאל ופונה אל הטקסט -->
  <section class="cs-hero">
    <div class="cs-hero__media">
      <Image src={handshakeMan} alt="נוגה לוחצת יד ללקוח בתחילת פגישת ייעוץ" widths={[640, 1024, 1536]} sizes="(min-width: 60rem) 50vw, 100vw" loading="eager" />
    </div>
    <div class="container cs-hero__inner">
      <div class="cs-hero__text">
        <p class="cs-crumbs"><a href="/services/">שירותים</a> <span aria-hidden="true">/</span> {s.title}</p>
        <h1 class="cs-hero__title">
          <span>{s.title}</span>{' '}<span class="cs-hero__sub">לפיצוח אתגר עסקי בפגישה אחת</span>
        </h1>
        <p class="cs-hero__lead">{s.intro}</p>
        <ul class="cs-chips">
          {
            ['עבודה מעשית', 'קבלת החלטות', 'סיכום מסודר והקלטה'].map((c) => (
              <li>
                <Icon name="check" size={16} />
                {c}
              </li>
            ))
          }
        </ul>
        <div class="cs-actions">
          <a class="btn" href={wa('היי נוגה, אשמח לתאם פגישת ייעוץ')} target="_blank" rel="noopener">
            לתיאום פגישה בוואטסאפ<span class="sr-only"> (נפתח בלשונית חדשה)</span>
          </a>
          <a class="cs-actions__link" href="#choose">איזו פגישה מתאימה לי?</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. מה הכי בוער: כל שורה היא אתגר, ומובילה לפגישה שפותרת אותו -->
  <section class="section cs-choose" id="choose" aria-labelledby="choose-title">
    <div class="container">
      <p class="cs-eyebrow">{topics.length} סוגי פגישות</p>
      <h2 id="choose-title" class="sec-title center reveal">מה הכי <span class="hl--mark">בוער</span> בעסק עכשיו?</h2>
      <ol class="picks">
        {
          topics.map((t, i) => (
            <li>
              <a class="pick reveal" href={`#${t.id}`}>
                <span class="pick__num" aria-hidden="true">{num(i)}</span>
                <span class="pick__text">
                  <span class="pick__pain">{t.pain}</span>
                  <span class="pick__promise">{t.promise}</span>
                </span>
                <span class="pick__go">
                  <Icon name={t.icon} size={20} />
                  {t.title}
                  <span class="pick__arrow" aria-hidden="true">←</span>
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 3. הפגישות, אחת אחרי השנייה -->
  {
    topics.map((t, i) => {
      const photo = photos[t.id];
      const rv = reviewOf(t.review);
      return (
        <section id={t.id} class:list={['ch', { 'ch--mist': i % 2 === 0, 'ch--flip': i % 2 === 1 }]} aria-labelledby={`${t.id}-title`}>
          <div class="container ch__grid">
            <div class="ch__head reveal">
              <p class="ch__num" aria-hidden="true">{num(i)}</p>
              <p class="ch__kicker">
                <Icon name={t.icon} size={20} /> פגישת ייעוץ
              </p>
              <h2 id={`${t.id}-title`} class="ch__title">
                {t.title}
              </h2>
              <p class="ch__challenge">{t.pain}</p>
              <p class="ch__promise">{t.promise}</p>
            </div>

            <div class="ch__media reveal">
              {photo && (
                <Image
                  src={photo.src}
                  alt={photo.alt}
                  widths={[640, 1024, 1536]}
                  sizes="(min-width: 60rem) 46vw, 100vw"
                  style={`object-position: ${photo.pos}`}
                />
              )}
            </div>

            <div class="ch__body reveal">
              <p class="ch__label">מה עושים בפגישה</p>
              {t.paras.map((p) => (
                <p>{p}</p>
              ))}
            </div>

            <div class="ch__out reveal">
              <p class="ch__out-title">יוצאים מהפגישה עם</p>
              <ul>
                {t.outcomes.map((o) => (
                  <li>
                    <Icon name="check" size={18} />
                    <span>{o}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="ch__foot reveal">
              {rv && (
                <figure class="ch__quote">
                  <blockquote>
                    <p>{rv.text}</p>
                  </blockquote>
                  <figcaption>
                    <strong>{rv.name}</strong> <span>מקור {rv.source}</span>
                  </figcaption>
                </figure>
              )}
              <a class="ch__cta" href={wa(`היי נוגה, אשמח לתאם פגישת ייעוץ בנושא ${t.title}`)} target="_blank" rel="noopener">
                <Icon name="whatsapp" size={20} />
                לתיאום פגישת {t.title}
                <span class="sr-only"> (נפתח בלשונית חדשה)</span>
              </a>
            </div>
          </div>
        </section>
      );
    })
  }

  <!-- 4. איך קובעים. כרטיס כהה בתוך אזור בהיר, כדי שלא יהיו שני אזורים כהים ברצף עם הפוטר. -->
  <section class:list={['section cs-end', { 'section--mist': topics.length % 2 === 0 }]} aria-labelledby="end-title">
    <div class="container">
      <div class="cs-end__card reveal">
        <div class="cs-end__media">
          <Image src={handshakeWoman} alt="נוגה לוחצת יד ללקוחה" widths={[640, 1024]} sizes="(min-width: 60rem) 26rem, 100vw" />
        </div>
        <div class="cs-end__content">
        <Star size={30} />
        <h2 id="end-title" class="cs-end__title">
          <span>בוחרים נושא</span>{' '}<span class="hl">ומתאמים בוואטסאפ</span>
        </h2>
        <ol class="cs-steps">
          <li><span class="cs-steps__n">1</span>בוחרים את הנושא שהכי בוער בעסק עכשיו</li>
          <li><span class="cs-steps__n">2</span>שולחים הודעה בוואטסאפ ומתאמים מועד</li>
          <li><span class="cs-steps__n">3</span>נפגשים, עובדים בפועל, ומקבלים סיכום והקלטה</li>
        </ol>
        <a class="btn cs-end__btn" href={wa('היי נוגה, אשמח לתאם פגישת ייעוץ')} target="_blank" rel="noopener">
          לתיאום פגישה בוואטסאפ<span class="sr-only"> (נפתח בלשונית חדשה)</span>
        </a>
        <p class="cs-end__note">
          עוד לא בטוחים איזו פגישה מתאימה?{' '}
          <a href={wa('היי נוגה, אשמח להתייעץ איזו פגישת ייעוץ מתאימה לי')} target="_blank" rel="noopener">
            כתבו בכמה מילים מה מעסיק אתכם<span class="sr-only"> (נפתח בלשונית חדשה)</span></a>, ובוחרים יחד.
        </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- פתיח ---------- */
  .cs-hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, var(--white), var(--mist));
  }
  .cs-hero__media {
    position: relative;
    height: min(95vw, 24rem);
  }
  .cs-hero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 30% 30%;
    /* בטלפון התמונה נעלמת כלפי מטה אל הטקסט */
    -webkit-mask-image: linear-gradient(180deg, #000 62%, transparent 100%);
    mask-image: linear-gradient(180deg, #000 62%, transparent 100%);
  }
  .cs-hero__inner {
    position: relative;
    padding-block: 0 3rem;
  }
  @media (min-width: 60rem) {
    .cs-hero {
      min-height: min(82vh, 40rem);
      display: flex;
      align-items: center;
    }
    /* במחשב התמונה בצד שמאל לכל הגובה, ונעלמת ימינה אל הטקסט */
    .cs-hero__media {
      position: absolute;
      inset-block: 0;
      inset-inline-end: 0;
      width: 52%;
      height: auto;
    }
    .cs-hero__media :global(img) {
      object-position: 28% 35%;
      -webkit-mask-image: linear-gradient(to right, #000 55%, transparent 100%);
      mask-image: linear-gradient(to right, #000 55%, transparent 100%);
    }
    .cs-hero__inner {
      padding-block: 4rem;
    }
    .cs-hero__text {
      max-width: 36rem;
    }
  }
  .cs-crumbs {
    margin: 0 0 0.75rem;
    font-size: 0.95rem;
    color: #4a5b73;
  }
  .cs-crumbs a {
    color: var(--teal-dark);
    font-weight: 700;
  }
  .cs-hero__title {
    margin: 0 0 1rem;
    font-size: clamp(2.6rem, 7vw, 4.2rem);
    font-weight: 900;
    line-height: 1.05;
    color: var(--navy);
  }
  .cs-hero__title > span {
    display: block;
  }
  .cs-hero__sub {
    margin-top: 0.6rem;
    font-size: clamp(1.25rem, 3vw, 1.7rem);
    font-weight: 800;
    line-height: 1.3;
    color: var(--teal-dark);
  }
  .cs-hero__lead {
    margin: 0 0 1.25rem;
    font-size: clamp(1.1rem, 2vw, 1.25rem);
    line-height: 1.75;
    color: #33445c;
  }
  .cs-chips {
    list-style: none;
    margin: 0 0 1.75rem;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .cs-chips li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    background: var(--white);
    border: 1px solid var(--line);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--navy);
  }
  .cs-chips :global(svg) {
    color: var(--gold-dark);
  }
  .cs-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }
  .cs-actions__link {
    font-weight: 800;
    color: var(--teal-dark);
  }

  /* ---------- מה הכי בוער: רשימה טיפוגרפית, בלי קופסאות ---------- */
  .cs-eyebrow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin: 0 0 0.5rem;
    font-weight: 800;
    color: var(--gold-dark);
  }
  .cs-eyebrow::before,
  .cs-eyebrow::after {
    content: '';
    width: 2rem;
    height: 2px;
    background: var(--gold-gradient);
  }
  .picks {
    list-style: none;
    max-width: 62rem;
    margin: 2rem auto 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .picks li {
    margin: 0;
    border-bottom: 1px solid var(--line);
  }
  .pick {
    display: grid;
    grid-template-columns: 3.2rem 1fr;
    gap: 0.35rem 1rem;
    align-items: center;
    padding: 1.25rem 0.75rem;
    color: inherit;
    text-decoration: none;
    background: linear-gradient(270deg, var(--mist), var(--mist)) no-repeat right / 0% 100%;
    transition: background-size 0.45s ease;
  }
  @media (min-width: 48rem) {
    .pick {
      grid-template-columns: 4.5rem 1fr auto;
      padding: 1.6rem 1rem;
    }
  }
  .pick:hover,
  .pick:focus-visible {
    background-size: 100% 100%;
  }
  .pick__num {
    grid-row: span 2;
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    font-weight: 900;
    line-height: 1;
    background: var(--gold-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  @media (min-width: 48rem) {
    .pick__num {
      grid-row: auto;
    }
  }
  .pick__text {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .pick__pain {
    font-size: clamp(1.15rem, 2.4vw, 1.45rem);
    font-weight: 800;
    line-height: 1.4;
    color: var(--navy);
  }
  .pick__promise {
    font-size: 1.02rem;
    line-height: 1.55;
    color: #4a5b73;
  }
  .pick__go {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 800;
    color: var(--teal-dark);
  }
  @media (min-width: 48rem) {
    .pick__go {
      white-space: nowrap;
    }
  }
  .pick__arrow {
    display: inline-block;
    transition: transform 0.3s ease;
  }
  .pick:hover .pick__arrow,
  .pick:focus-visible .pick__arrow {
    transform: translateX(-0.4rem);
  }

  /* ---------- פרק לכל פגישה ---------- */
  .ch {
    padding-block: clamp(3rem, 8vw, 6rem);
    scroll-margin-top: var(--header-h);
  }
  .ch--mist {
    background: var(--mist);
  }
  .ch__grid {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 60rem) {
    .ch__grid {
      grid-template-columns: 1.05fr 1fr;
      grid-template-areas:
        'head media'
        'body media'
        'foot out';
      column-gap: clamp(2.5rem, 5vw, 5rem);
      row-gap: 1.25rem;
      align-items: start;
    }
    .ch--flip .ch__grid {
      grid-template-columns: 1fr 1.05fr;
      grid-template-areas:
        'media head'
        'media body'
        'out foot';
    }
    .ch__head {
      grid-area: head;
    }
    .ch__media {
      grid-area: media;
      align-self: stretch;
    }
    .ch__body {
      grid-area: body;
    }
    .ch__foot {
      grid-area: foot;
    }
    /* "יוצאים עם" עולה על התחתית של התמונה */
    .ch__out {
      grid-area: out;
      position: relative;
      z-index: 1;
      margin-top: -7rem;
      margin-inline: 2rem -1.5rem;
    }
    .ch--flip .ch__out {
      margin-inline: -1.5rem 2rem;
    }
  }

  .ch__num {
    margin: 0 0 -0.4rem;
    font-size: clamp(4rem, 10vw, 7rem);
    font-weight: 900;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 2px var(--gold-dark);
    opacity: 0.75;
  }
  .ch__kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0 0 0.25rem;
    font-weight: 800;
    color: var(--teal-dark);
  }
  .ch__title {
    margin: 0 0 1.5rem;
    font-size: clamp(2rem, 4.8vw, 3rem);
    font-weight: 900;
    line-height: 1.15;
    color: var(--navy);
  }
  .ch__label {
    margin: 0 0 0.4rem;
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    color: var(--gold-dark);
  }
  .ch__challenge {
    margin: 0;
    padding-inline-start: 1rem;
    border-inline-start: 4px solid var(--teal);
    font-size: clamp(1.2rem, 2.5vw, 1.5rem);
    font-weight: 700;
    line-height: 1.5;
    color: var(--navy);
  }
  .ch__promise {
    margin: 0.85rem 0 0;
    font-size: clamp(1.08rem, 2vw, 1.22rem);
    line-height: 1.65;
    color: var(--teal-dark);
    font-weight: 600;
  }
  .ch__body p:not(.ch__label) {
    font-size: 1.08rem;
    line-height: 1.8;
    color: #33445c;
  }
  .ch__body p:last-child {
    margin-bottom: 0;
  }

  /* תמונה גדולה ומעוגלת, בלי מסגרת */
  .ch__media {
    position: relative;
    min-height: 16rem;
  }
  .ch__media > :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 16 / 11;
    object-fit: cover;
    border-radius: 1.75rem;
    box-shadow: 0 1.5rem 3rem -1.5rem rgb(11 26 51 / 0.35);
  }
  @media (min-width: 60rem) {
    .ch__media {
      min-height: 32rem;
    }
    .ch__media > :global(img) {
      position: absolute;
      inset: 0;
      aspect-ratio: auto;
    }
  }

  /* יוצאים עם: כרטיס כחול כהה */
  .ch__out {
    padding: clamp(1.25rem, 3vw, 1.75rem);
    border-radius: 1.4rem;
    background:
      radial-gradient(16rem 10rem at 100% 0, rgb(25 154 181 / 0.35), transparent 70%),
      var(--navy);
    color: var(--white);
    box-shadow: 0 1.5rem 3rem -1.25rem rgb(11 26 51 / 0.55);
  }
  .ch__out-title {
    margin: 0 0 0.85rem;
    font-size: 1.15rem;
    font-weight: 900;
    color: var(--gold-light);
  }
  .ch__out ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.65rem;
  }
  .ch__out li {
