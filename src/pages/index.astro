---
// עמוד הבית. הסדר שנוגה קבעה (2026-11-07, סבב 3):
//   פתיח ← סרט נע בטורקיז (כ-20 נושאים שמקדמים) ← שירותים בשורה אחת ← המלצות (רק על ליווי, צר, 6 בבת אחת, בלי כותרת)
//   ← עקרונות הליווי (עלו שני שלבים) ← תהליך הליווי (3 שלבים, "מה מקבלים" עם כוכבים) ← "מתי נכון לבוא לייעוץ עסקי" (ריבועים)
//   ← שאלון ← נעים להכיר ← סרטון הכנס ← קריאה לפעולה ← "כל מה שתמצאו באתר".
//   "בכל עסק הכסף נמצא במקום אחר" הוסר מהבית (נוגה). כל הכותרות ממורכזות.
// בלי גוף ראשון. הביקורת והציונים: drafts/critique-2026-11-07.md.
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import YouTubeEmbed from '../components/YouTubeEmbed.astro';
import QuizFeature from '../components/QuizFeature.astro';
import ServiceStrip from '../components/ServiceStrip.astro';
import QuoteGrid from '../components/QuoteGrid.astro';
import Ribbon from '../components/Ribbon.astro';
import Timeline from '../components/Timeline.astro';
import Icon from '../components/Icon.astro';
import { contact } from '../data/contact';
import { services, situations, steps } from '../data/services';
import { featuredReviews } from '../data/reviews';
import { ways, icons } from '../data/principles';
import { trainings } from '../data/trainings';
import { quizYear } from '../data/quiz';
import { atmoStyle } from '../utils/atmo';
// תמונת הפתיח שנוגה בחרה (2026-11-07): על הבמה בבלייזר הלבן, עם הדוכן של "עסקים במקסימום"
import heroPhoto from '../assets/hero/stage-blazer.jpg';
// "נעים להכיר": אחת משתי התמונות שנוגה שלחה (2026-11-07). השנייה (על הספסל) כבר בעמוד צור קשר.
import introPhoto from '../assets/hero/headshot.webp';
// תמונות אווירה (AI) ששלחה נוגה. הדמות המצוירת: רק במקומות מתאימים ובאזורים בהירים (רקע לבן).
import darkLines from '../assets/atmosphere/dark-lines.webp';
import darkStairs from '../assets/atmosphere/dark-stairs.webp';
import pointing from '../assets/character/pointing-down.webp';
// תמונות מהכנסים (נוגה שלחה אותן לאודות). בעמוד הבית: עוד תמונות, לבקשתה (2026-11-07)
import pAudience from '../assets/about/gallery/14-audience.jpg';
import pStage from '../assets/about/gallery/16-stage-participants.jpg';
import pGroup from '../assets/about/gallery/07-group-five.jpg';
import pAmong from '../assets/about/gallery/19-among-audience.jpg';
const stagePhotos = [
  { src: pAudience, alt: 'קהל המשתתפים באולם הכנס' },
  { src: pStage, alt: 'נוגה עם משתתפים על הבמה בכנס "עסקים במקסימום"' },
  { src: pGroup, alt: 'נוגה עם משתתפות בכנס' },
  { src: pAmong, alt: 'נוגה בין המשתתפים בזמן שאלה מהקהל' },
];

const linesStyle = await atmoStyle(darkLines, 0.55);
const stairsStyle = await atmoStyle(darkStairs, 0.4);

// הסרט הנע: מה מקדמים יחד (נוגה, 2026-11-07: כ-20 מילים, בלי לחזור על אותן מילים, בלי הכיתוב "מקדמים יחד")
const advances = [
  'יעדים', 'מטרות', 'אסטרטגיה', 'שיווק', 'התייעלות', 'בינה מלאכותית', 'חדשנות', 'פרויקטים',
  'משימות', 'תהליכי עבודה', 'צוותים', 'מכירות', 'רווחיות', 'תמחור', 'תזרים', 'מנהיגות',
  'קבלת החלטות', 'שירות לקוחות', 'הצעות ערך', 'אוטומציות', 'שגרות ניהול', 'מהלכי צמיחה',
];

// המספרים שנוגה אישרה (SKILL.md סעיף 6א). עולים בספירה כשמגיעים אליהם.
const stats = [
  { num: 20, label: 'שנה בהנהלה של בנק גדול' },
  { num: 450, label: 'עסקים בליווי' },
  { num: 10, label: 'שנות ניסיון בייעוץ עסקי' },
  { num: 9.4, label: 'ציון ב-4 שנות ייעוץ מטעם משרד הכלכלה' },
];

// "כל מה שתמצאו באתר": רק עמודים שקיימים (נוגה: "מכל מה שיש באתר ולא דברים שאין")
const guides = (await getCollection('guides'))
  .filter((g) => !g.data.comingSoon)
  .sort((a, b) => (a.data.type === b.data.type ? a.data.order - b.data.order : a.data.type === 'guide' ? -1 : 1));
const index = [
  { title: 'שירותים', links: services.map((s) => ({ href: s.href, label: s.title })) },
  { title: 'הדרכות', links: trainings.map((t) => ({ href: `/trainings/${t.slug}/`, label: t.title })) },
  { title: 'מדריכים ומאמרים', links: guides.map((g) => ({ href: `/guides/${g.id}/`, label: g.data.title })) },
  {
    title: 'עוד באתר',
    links: [
      { href: '/guides/business-focus-quiz/', label: `שאלון מיקוד פיתוח עסקי ${quizYear}` },
      { href: '/about/', label: 'אודות נוגה דיין אור' },
      { href: '/testimonials/', label: 'המלצות לקוחות' },
      { href: '/guides/', label: 'מרכז הידע: הרצאות לצפייה בחינם' },
      { href: '/contact/', label: 'צור קשר' },
      { href: '/contact/', label: 'הקהילה: תודעה עסקית מנצחת' },
    ],
  },
];
---

<BaseLayout
  title="ייעוץ עסקי וארגוני"
  description="נוגה דיין אור: ייעוץ עסקי וארגוני להגדלת הכנסות ושיפור רווחיות באמצעות אסטרטגיה, שיווק ושיפור תהליכי עבודה עם בינה מלאכותית. ייעוץ עסקי, ייעוץ ארגוני, אוטומציות ו-AI, ליווי פיננסי והדרכות."
>
  <!-- 1. פתיח (נוגה, 2026-11-07): התמונה מימין, כך שהפנים פונות אל הטקסט; רואים גם את הדוכן.
       הכותרת ממורכזת, והפתיח לא תופס את כל המסך הראשון. "מקדמים יחד" עבר לסרט הנע שמתחת. -->
  <section class="h-hero">
    <div class="h-hero__media">
      <Image
        src={heroPhoto}
        alt="נוגה דיין אור מרצה על הבמה בכנס עסקים במקסימום"
        widths={[640, 1024, 1600, 2000]}
        sizes="(min-width: 52rem) 58vw, 100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="container h-hero__inner">
      <div class="h-hero__text">
        <p class="h-hero__kicker">נוגה דיין אור · ייעוץ עסקי וארגוני</p>
        <h1 class="h-hero__title">העולם משתנה בקצב מהיר{' '}<span class="hl">וזה הזמן של העסק שלך לגדול</span></h1>
        <p class="h-hero__lead">להגדיל הכנסות ולשפר רווחיות באמצעות אסטרטגיה, שיווק ושיפור תהליכי עבודה עם בינה מלאכותית.</p>
        <div class="h-hero__actions">
          <a class="btn" href={contact.booking} target="_blank" rel="noopener">קביעת שיחת היכרות<span class="sr-only"> (נפתח בלשונית חדשה)</span></a>
          <a class="btn btn--ghost" href="/services/">לשירותים</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 1א. סרט נע בטורקיז: מה מקדמים יחד (השראה מהפס הנע של מאשה, בלי להעתיק; אופקי, עם הכוכב של נוגה) -->
  <Ribbon items={advances} tone="teal" />

  <!-- 2. שש קוביות השירותים, בלי כותרת (נוגה). כותרת נסתרת רק לקוראי מסך. -->
  <section class="section h-services" aria-labelledby="services-title">
    <div class="container">
      <h2 id="services-title" class="sr-only">השירותים</h2>
      <ServiceStrip />
    </div>
  </section>

  <!-- 3. המלצות: רק על ליווי, צר, 6 בבת אחת, באותו גובה, ההתחלה ו"קרא עוד". בלי כותרת (נוגה: "הכותרת ממש מתייתרת"). -->
  <section class="section section--mist h-reviews" aria-labelledby="reviews-title">
    <div class="container">
      <h2 id="reviews-title" class="sr-only">מה אומרים הלקוחות</h2>
      <QuoteGrid reviews={featuredReviews} />
      <p class="more center"><a href="/testimonials/">לכל ההמלצות ←</a></p>
    </div>
  </section>

  <!-- 4. עקרונות הליווי: שש הקוביות מהאודות (עלו שני שלבים, נוגה 2026-11-07). src/data/principles.ts -->
  <section class="section section--deep atmo h-ways" style={stairsStyle}>
    <div class="container">
      <div class="h-head reveal">
        <p class="eyebrow">איך עובדים</p>
        <h2 class="h-title">עקרונות <span class="hl">הליווי</span></h2>
      </div>
      <ul class="ways">
        {
          ways.map((w, i) => (
            <li class="way reveal" style={`transition-delay: ${(i % 3) * 0.1}s`}>
              <span class="way__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" set:html={icons[w.icon]} />
              </span>
              <h3>{w.title}</h3>
              <p>{w.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 5. תהליך הליווי: שלושה שלבים, ו"מה מקבלים" באותו גובה בכל שלב, עם הכוכב כתבליט (src/data/services.ts, steps) -->
  <section class="section h-process">
    <div class="container">
      <div class="h-head reveal">
        <p class="eyebrow">שלב אחר שלב</p>
        <h2 class="h-title">תהליך ליווי <span class="hl--mark">עסקי וארגוני</span></h2>
        <p class="h-sub">להגדלת הכנסות ושיפור הרווחיות</p>
      </div>
      <Timeline items={steps} />
      <!-- המשפט של נוגה מתוך "תהליך ליווי עסקי וארגוני" -->
      <p class="h-goal reveal">המטרה: לא רק להבין מה צריך לשנות, אלא לגרום לשינויים לקרות, ולבנות עסק שמנוהל טוב יותר, מרוויח יותר וממשיך לצמוח.</p>
    </div>
  </section>

  <!-- 6. מתי נכון לבוא לייעוץ עסקי: 6 מצבים בריבועים בולטים (נוגה, 2026-11-07) -->
  <section class="section section--deep atmo h-when" style={linesStyle}>
    <div class="container">
      <div class="h-head reveal">
        <p class="eyebrow">הזמן הנכון</p>
        <h2 class="h-title">מתי נכון לבוא <span class="hl">לייעוץ עסקי?</span></h2>
      </div>
      <ul class="moments">
        {
          situations.map((m, i) => (
            <li class="moment reveal" style={`transition-delay: ${(i % 3) * 0.1}s`}>
              <span class="moment__icon" aria-hidden="true">
                <Icon name={m.icon} size={28} />
              </span>
              <p>{m.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 7. שאלון המיקוד. הדמות מצביעה על השאלון. -->
  <section class="section section--mist">
    <div class="container">
      <div class="h-quiz-head">
        <div class="h-head reveal">
          <!-- הכותרת היא הצעה שלי -->
          <p class="eyebrow">שאלון חינמי</p>
          <h2 class="h-title">איפה העסק שלך <span class="hl--mark">עומד היום?</span></h2>
          <p class="h-sub">שאלון קצר שעושה סדר: פרופיל של העסק ושלושה מיקודים לשנה הקרובה.</p>
        </div>
        <Image src={pointing} alt="" widths={[220, 340]} sizes="11rem" class="toon h-quiz-head__toon" />
      </div>
      <QuizFeature />
    </div>
  </section>

  <!-- 8. נעים להכיר: תמונה של נוגה כרקע (נוגה מעדיפה תמונה כרקע ולא במסגרת). הפתיח האישי מהאסטרטגיה שלה, עם MBA והמספרים. -->
  <section class="h-meet">
    <div class="h-meet__media">
      <Image src={introPhoto} alt="נוגה דיין אור מחייכת" widths={[600]} sizes="(min-width: 52rem) 52vw, 100vw" />
    </div>
    <div class="container h-meet__inner">
      <div class="h-meet__text reveal">
        <h2 class="h-meet__hi">נעים להכיר, <span class="hl">נוגה דיין אור</span></h2>
        <p class="h-meet__voice">חיה ונושמת פיתוח עסקים והגדלת הכנסות! אוהבת להיכנס לעסק, להכיר את האנשים, להבין איך דברים עובדים, לגלות הזדמנויות עסקיות, לחבר בין רעיונות, לעשות סדר ובעיקר לגרום לדברים טובים לקרות.</p>
        <p class="h-meet__cred">יועצת עסקית וארגונית להגדלת הכנסות ושיפור רווחיות, בעלת תואר שני במנהל עסקים (MBA), עם ניסיון בליווי 450 עסקים ו-20 שנה של תהליכי ניהול, פיתוח עסקי ואסטרטגיה בהנהלה של בנק גדול.</p>
        <ul class="stats">
          {
            stats.map((s) => (
              <li class="stat">
                <span class="stat__num" data-count={s.num}>{s.num}</span>
                <span class="stat__label">{s.label}</span>
              </li>
            ))
          }
        </ul>
        <p class="more more--dark"><a href="/about/">עוד על נוגה ←</a></p>
      </div>
    </div>
  </section>

  <!-- 9. סרטון הכנס שנוגה הפיקה, ותמונות מהשטח. הסרטון מופיע בשני מקומות: כאן ובעמוד ההדרכות (2026-11-07).
       הכותרת לקוחה מהדף ב-Canva. -->
  <section class="section h-stage">
    <div class="container">
      <div class="h-head reveal">
        <p class="eyebrow">מהשטח</p>
        <h2 class="h-title">קצת מכנס העסקים <span class="hl--mark">שפתח את השנה</span></h2>
      </div>
      <div class="conference reveal">
        <YouTubeEmbed id="RJd6_sdT62U" title="נוגה דיין אור - כנס עסקים במקסימום" />
      </div>
      <ul class="stage-photos">
        {
          stagePhotos.map((ph, i) => (
            <li class="reveal" style={`transition-delay: ${i * 0.08}s`}>
              <Image src={ph.src} alt={ph.alt} widths={[320, 520]} sizes="(min-width: 52rem) 25vw, 50vw" />
            </li>
          ))
        }
      </ul>
      <p class="more center"><a href="/about/#moments-title">לעוד רגעים מהכנסים ←</a></p>
    </div>
  </section>

  <CtaBand />

  <!-- 10. כל מה שתמצאו באתר: רשימה שעונה על הרבה חיפושים, רק ממה שקיים באתר (נוגה, 2026-11-07) -->
  <section class="h-index" aria-labelledby="index-title">
    <div class="container">
      <h2 id="index-title" class="h-index__title">כל מה שתמצאו באתר</h2>
      <div class="h-index__cols">
        {
          index.map((col) => (
            <div>
              <h3 class="h-index__col-title">{col.title}</h3>
              <ul>
                {col.links.map((l) => (
                  <li>
                    <a href={l.href}>{l.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- 1. פתיח: התמונה בצד ימין (נוגה פונה אל הטקסט), הטקסט ממורכז משמאל ---------- */
  .h-hero {
    position: relative;
    overflow: hidden;
    background: var(--navy-deep);
    color: var(--on-dark);
  }
  .h-hero__media {
    position: relative;
    height: min(64vw, 19rem);
  }
  .h-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* בנייד: נוגה והדוכן */
    object-position: 78% 30%;
  }
  .h-hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(7 17 31 / 0.05) 50%, var(--navy-deep) 100%);
  }
  .h-hero__inner {
    position: relative;
    padding-block: 0.25rem 2.25rem;
  }
  .h-hero__text {
    text-align: center;
  }
  .h-hero__kicker {
    margin: 0 0 0.6rem;
    font-weight: 800;
    color: var(--gold-light);
  }
  .h-hero__title {
    margin: 0 0 0.85rem;
    color: var(--white);
    font-size: clamp(1.8rem, 3.8vw, 2.7rem);
    font-weight: 900;
    line-height: 1.2;
  }
  .h-hero__title .hl {
    display: block;
    text-shadow: none;
  }
  .h-hero__lead {
    max-width: 32rem;
    margin: 0 auto 1.5rem;
    font-size: clamp(1.05rem, 1.8vw, 1.2rem);
    line-height: 1.6;
  }
  .h-hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }
  @media (min-width: 52rem) {
    .h-hero {
      display: flex;
      align-items: center;
      min-height: clamp(24rem, 54vh, 30rem);
    }
    /* התמונה בצד ימין, נעלמת לכיוון הטקסט שמשמאל. השקף שמעל מוחשך, הדוכן נראה. */
    .h-hero__media {
      position: absolute;
      top: 0;
      bottom: 0;
      right: 0;
      width: 58%;
      height: auto;
    }
    .h-hero__media img {
      object-position: 82% 32%;
    }
    .h-hero__media::after {
      background:
        linear-gradient(to right, var(--navy-deep) 0%, rgb(7 17 31 / 0.75) 16%, rgb(7 17 31 / 0) 45%),
        linear-gradient(to bottom, rgb(7 17 31 / 0.6) 0%, rgb(7 17 31 / 0) 40%),
        linear-gradient(0deg, rgb(7 17 31 / 0.45) 0%, rgb(7 17 31 / 0) 25%);
    }
    .h-hero__inner {
      padding-block: 2.75rem;
    }
    .h-hero__text {
      max-width: min(34rem, 46vw);
      margin-right: auto;
      margin-left: 0;
      text-shadow: 0 2px 18px rgb(7 17 31 / 0.6);
    }
  }

  /* ---------- 2. שירותים ---------- */
  .h-services {
    padding-block: clamp(1.75rem, 4vw, 2.75rem);
  }

  /* ---------- כותרות ממורכזות ומושכות (נוגה, 2026-11-07) ---------- */
  .h-head {
    max-width: 46rem;
    margin: 0 auto 2rem;
    text-align: center;
  }
  /* תווית קטנה מעל הכותרת, עם קווים קצרים משני הצדדים */
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 0.6rem;
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--teal-dark);
  }
  .eyebrow::before,
  .eyebrow::after {
    content: '';
    width: 2rem;
    height: 2px;
    border-radius: 2px;
