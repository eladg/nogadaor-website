---
// עמוד הבית. הסדר שנוגה קבעה (2026-11-07, סבב 3):
//   פתיח ← סרט נע בטורקיז (כ-20 נושאים שמקדמים) ← שירותים בשורה אחת ← המלצות (רק על ליווי, צר, 6 בבת אחת, בלי כותרת)
//   ← עקרונות הליווי (עלו שני שלבים) ← תהליך הליווי (3 שלבים, "מה מקבלים" עם כוכבים) ← "מתי נכון לבוא לייעוץ עסקי" (ריבועים)
//   ← שאלון ← נעים להכיר ← סרטון הכנס ← קריאה לפעולה ← "כל מה שתמצאו באתר".
//   "בכל עסק הכסף נמצא במקום אחר" הוסר מהבית (נוגה). כל הכותרות ממורכזות.
// בלי גוף ראשון. הביקורת והציונים: drafts/critique-2026-11-07.md.
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import MomentsReel from '../components/MomentsReel.astro';
import ServiceCards from '../components/ServiceCards.astro';
import QuoteMarquee from '../components/QuoteMarquee.astro';
import Ribbon from '../components/Ribbon.astro';
import { advances } from '../data/advances';
import Timeline from '../components/Timeline.astro';
import Icon from '../components/Icon.astro';
import { contact } from '../data/contact';
import { services, situations, steps } from '../data/services';
import { homeReviews } from '../data/reviews';
import { ways } from '../data/principles';
import ContentCover from '../components/ContentCover.astro';
import Star from '../components/Star.astro';
import { quizYear, quizAreas } from '../data/quiz';
import { atmoStyle } from '../utils/atmo';
// תמונת הפתיח: התמונה החלופית שנוגה הכינה (2026-11-08, בלי השקעים), עם מסך המקרן מוכהה לכחול כהה.
// המקור: "חומרים גרפיים לאתר/תמונות לפתיח הבית 2026-11-07/noga-replacement-2026-11-08.webp"
// stage-noga-2 (2026-11-08): המסך הכחול נבנה מחדש סביב היד, המיקרופון והשרוול (היה קצה שבור), והפינה ליד השיער נוקתה
// עדכון (נוגה, 2026-11-13): תמונת קאבר חדשה שנוגה הכינה. נוגה בצד ימין, והצד השמאלי כחול כהה, לטקסט.
import heroPhoto from '../assets/hero/noga-cover-2026-11-13.webp';
// "נעים להכיר": אחת משתי התמונות שנוגה שלחה (2026-11-07). השנייה (על הספסל) כבר בעמוד צור קשר.
import introPhoto from '../assets/hero/headshot.webp';
// תמונות אווירה (AI) ששלחה נוגה. הדמות המצוירת: רק במקומות מתאימים ובאזורים בהירים (רקע לבן).
import darkLines from '../assets/atmosphere/dark-lines.webp';
import darkStairs from '../assets/atmosphere/dark-stairs.webp';
// הדמות חתוכה מתחת לידיים (נוגה, 2026-11-08: "לחתוך את החלק של הרגליים")
// הדמות בלי רקע (שקופה), כדי שתעמוד על הרקע הכהה של השאלון
import pointing from '../assets/character/pointing-down-bust-clear.webp';
// כריכת סרטון הכנס (נוגה, 2026-11-08): נוגה על הבמה מגבה, מול כל הקהל. חתוכה בלי הכיסאות הריקים והתקרה.
import ConferenceVideo from '../components/ConferenceVideo.astro';
// גלריה קלה: שורה אחת, רק תמונות קהל ותמונות עם לקוחות, בלי תמונות שכבר מופיעות באתר
// (23, 08, 12 באודות, 14 בצור קשר, 15 בכריכת הסרטון) ובלי תמונות במה של נוגה לבד (נוגה, 2026-11-08)
const momentRows = [['07', '19', '09', '16', '10', '13', '11', '06']];
const linesStyle = await atmoStyle(darkLines, 0.55);
const stairsStyle = await atmoStyle(darkStairs, 0.4);

// המספרים שנוגה אישרה (SKILL.md סעיף 6א). עולים בספירה כשמגיעים אליהם.
const stats = [
  { num: 20, label: 'שנה בהנהלה של בנק גדול' },
  { num: 450, label: 'עסקים בליווי' },
  { num: 10, label: 'שנות ניסיון בייעוץ עסקי' },
];

// שורת מדריכים חינמיים בסוף העמוד (נוגה, 2026-11-08: במקום "כל מה שתמצאו באתר", שנראה כמו פוטר מיותר)
// קודם המדריכים הפתוחים, ואם אין ארבעה, משלימים במדריכים "בקרוב" (בלי קישור), כדי שהשורה תישאר מלאה (נוגה, 2026-11-12)
const guideList = (await getCollection('guides'))
  .filter((g) => g.data.type === 'guide')
  .sort((a, b) => a.data.order - b.data.order);
const guides = [...guideList.filter((g) => !g.data.comingSoon), ...guideList.filter((g) => g.data.comingSoon)].slice(0, 4);

// נתונים מובנים לגוגל ול-AI: מי נוגה, מה העסק ומה האתר (src/utils/schema.ts)
import { personSchema, businessSchema, websiteSchema } from '../utils/schema';
const schema = [personSchema(Astro.site), businessSchema(Astro.site), websiteSchema(Astro.site)];
---

<BaseLayout
  schema={schema}
  title="ייעוץ עסקי וארגוני"
  description="ייעוץ עסקי וארגוני של נוגה דיין אור, להגדלת הכנסות ושיפור רווחיות באמצעות אסטרטגיה, שיווק ושיפור תהליכי עבודה עם בינה מלאכותית."
>
  <!-- 1. פתיח (נוגה, 2026-11-07): התמונה מימין, כך שהפנים פונות אל הטקסט; רואים גם את הדוכן.
       הכותרת ממורכזת, והפתיח לא תופס את כל המסך הראשון. "מקדמים יחד" עבר לסרט הנע שמתחת. -->
  <!-- עדכון (נוגה, 2026-11-13, אחרי השיחה עם המעצבת): תמונת הקאבר שנוגה הכינה, נוגה בצד ימין והטקסט על הכחול משמאל.
       בלי כפתורים לשירותים ולשיחת היכרות (שיחת ההיכרות עברה לכפתור הקבוע בתפריט). במקומם הנעה לשאלון,
       עם משפט שמסביר למה למלא אותו, וכפתור שגולל למטה אל השאלון. המשפטים הם הצעה שלי, ממתינים לאישור. -->
  <section class="h-hero">
    <div class="h-hero__media">
      <Image
        src={heroPhoto}
        alt="נוגה דיין אור מחייכת, בחולצה שחורה על רקע כחול"
        widths={[640, 1024, 1672]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="container h-hero__inner">
      <div class="h-hero__text">
        <h1 class="h-hero__title">העולם משתנה בקצב מהיר{' '}<span class="hl">וזה הזמן של העסק שלך לגדול</span></h1>
        <p class="h-hero__lead">להגדיל הכנסות ולשפר רווחיות באמצעות אסטרטגיה, שיווק ושיפור תהליכי עבודה עם בינה מלאכותית.</p>
        <div class="h-hero__quiz">
          <p class="h-hero__punch">כמה הכנסות כבר מחכות בתוך העסק שלך?</p>
          <p class="h-hero__why">שאלון קצר על העסק שלך, ובסופו תמונה ברורה של ההזדמנויות להגדלת הכנסות ומאיפה כדאי להתחיל.</p>
          <a class="btn h-hero__btn" href="#quiz">לבדיקת העסק שלך <span aria-hidden="true">↓</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- 1א. סרט נע בטורקיז: מה מקדמים יחד (השראה מהפס הנע של מאשה, בלי להעתיק; אופקי, עם הכוכב של נוגה) -->
  <Ribbon items={advances} tone="teal" />

  <!-- 1ב. פסקת פתיחה שמסבירה את הכותרת (נוגה, 2026-11-08, סבב 2). המסר של נוגה: חייבים לגדול, כל עסק מיוחד,
       ומתוך הקיים מוצאים את הדרך שלו להצלחה עסקית. הניסוח שלי מהמילים שלה, ממתין לאישור. בלי גוף ראשון.
       המשפט הראשון כולו בצבע אחד, כדי שלא תהיה שבירה באמצע שורה (נוגה). -->
  <section class="h-intro" aria-label="על הליווי">
    <div class="container">
      <p class="h-intro__lead reveal">העסק שלך חייב לגדול ולחשוב קדימה כל הזמן, במיוחד בתקופה שבה הטכנולוגיה משנה את העולם בקצב מסחרר.</p>
      <p class="h-intro__text reveal">כל עסק הוא שונה ומיוחד, עם מטרות, תהליכי עבודה, חוזקות ומשאבים משלו. לכן הליווי מתחיל בלמידה של המצב הקיים ושל מה שרוצים להשיג, ומתוך מה שכבר יש בעסק מוצאים את הדרך שלו להצלחה עסקית, להגדלת ההכנסות, לשיפור הרווחיות ולייעול העבודה בכלים חדשניים ומעודכנים.</p>
    </div>
  </section>

  <!-- 2. שש קוביות השירותים, בלי כותרת (נוגה). כותרת נסתרת רק לקוראי מסך. -->
  <section class="section h-services" aria-labelledby="services-title">
    <div class="container">
      <h2 id="services-title" class="sr-only">השירותים</h2>
      <ServiceCards variant="row" />
    </div>
  </section>

  <!-- 3. המלצות: רק על ליווי. שורה אחת של כרטיסים צרים שזזה לאט, "קרא עוד" והשם באותו גובה בכל הכרטיסים.
       הכותרת "לקוחות משתפים" והקישור לכל ההמלצות למעלה, כדי שהקישור לא ייתקע מעל הכותרת הבאה (נוגה, 2026-11-08). -->
  <section class="section section--mist h-reviews" aria-labelledby="reviews-title">
    <div class="container">
      <div class="h-head reveal">
        <h2 id="reviews-title" class="h-title">לקוחות <span class="hl--mark">משתפים</span></h2>
        <p class="h-sub"><a href="/testimonials/">לכל ההמלצות ←</a></p>
      </div>
    </div>
    <QuoteMarquee reviews={homeReviews} />
  </section>

  <!-- 3ב. האתגרים (לשעבר "מתקדמים עם נוגה"), אחרי "לקוחות משתפים" ולפני "נעים להכיר" (נוגה, 2026-11-13).
       רשימה ממורכזת עם הכוכב כתבליט, והנוסח הוא האתגר כפי שבעל העסק מכיר אותו. הכותרת הצעה שלי, ממתינה לאישור. -->
  <section class="section section--deep atmo h-when" style={linesStyle} aria-labelledby="when-title">
    <div class="container">
      <div class="h-head reveal">
        <h2 id="when-title" class="h-title h-title--split">אתגרים שאיתם עסקים <span class="hl">מגיעים לליווי</span></h2>
      </div>
      <ul class="challenges">
        {
          situations.map((m) => (
            <li class="challenge reveal">
              <Star size={18} class="challenge__star" />
              <span>{m.text}</span>
            </li>
          ))
        }
      </ul>
      <p class="h-when__cta reveal"><a class="btn" href={contact.whatsapp} target="_blank" rel="noopener">לשיחת היכרות<span class="sr-only"> (נפתח בלשונית חדשה)</span></a></p>
    </div>
  </section>

  <!-- 3א. נעים להכיר: מיד אחרי "לקוחות משתפים" (נוגה, 2026-11-08). אזור בהיר, התמונה קטנה יותר כרקע בצד (נוגה מעדיפה תמונה כרקע ולא במסגרת,
       ו"לא באה לדגמן"). בלי 9.4 במספרים, בלי סוגריים ל-MBA, ובלי משפט המספרים שחזר על עצמו. -->
  <section class="h-meet">
    <div class="h-meet__media">
      <Image src={introPhoto} alt="נוגה דיין אור מחייכת" widths={[600]} sizes="(min-width: 52rem) 34vw, 100vw" />
    </div>
    <div class="container h-meet__inner">
      <div class="h-meet__text reveal">
        <h2 class="h-meet__hi">נעים להכיר, <span class="hl--mark">נוגה דיין אור</span></h2>
        <!-- נוגה (2026-11-13): בלי טקסט צבעוני באמצע, והמשפט על "היהלום של כל עסק" נמחק -->
        <p class="h-meet__voice">חיה ונושמת פיתוח עסקים והגדלת הכנסות! אוהבת להיכנס לעסק, להכיר את האנשים, להבין איך דברים עובדים, לגלות הזדמנויות עסקיות, לחבר בין רעיונות, לעשות סדר ובעיקר לגרום לדברים טובים לקרות.</p>
        <p class="h-meet__voice">יועצת עסקית וארגונית להגדלת הכנסות ושיפור רווחיות, בעלת תואר שני במנהל עסקים.</p>
        <ul class="stats">
          {
            stats.map((s) => (
              <li class="stat">
                <span class="stat__num" data-count={s.num}>{s.num}</span>
                <span class="stat__label">{s.label}</span>
              </li>
            ))
          }
        </ul>
        <p class="more"><a href="/about/">עוד על נוגה ←</a></p>
      </div>
    </div>
  </section>

  <!-- 4. שש הקוביות של עקרונות הליווי (src/data/principles.ts, משותף לאודות).
       הכותרת של נוגה (2026-11-08) מחליפה את "איך עובדים / עקרונות הליווי". שורת המשנה על "נוסחאות מוכנות" הוסרה, כי היא חוזרת על הכותרת. -->
  <section class="section section--deep atmo h-ways" style={stairsStyle}>
    <div class="container">
      <div class="h-head reveal">
        <h2 class="h-title h-title--split">הצלחה עסקית בדרך שלך{' '}<span class="hl">עם נוסחה מיוחדת משלך</span></h2>
      </div>
      <!-- נוגה (2026-11-13): בבית רק הכותרות, בלי הסברים ובלי אייקונים. העקרונות המלאים באודות -->
      <ol class="ways-lite">
        {
          ways.map((w, i) => (
            <li class="ways-lite__item reveal">
              <span class="ways-lite__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="ways-lite__title">{w.short}</span>
            </li>
          ))
        }
      </ol>
      <p class="more more--dark center reveal"><a href="/about/#principles">לעקרונות הליווי המלאים ←</a></p>
    </div>
  </section>

  <!-- 5. תהליך הליווי: שלושת השלבים עם הטקסט, בלי "מה מקבלים" (נוגה, 2026-11-08). הפירוט המלא בעמוד השירותים. -->
  <section class="section h-process">
    <div class="container">
      <div class="h-head reveal">
        <h2 class="h-title">תהליך ליווי <span class="hl--mark">עסקי וארגוני</span></h2>
      </div>
      <!-- נוגה (2026-11-08): "קיצצת מדי". השלבים עם הטקסט, בלי "מה מקבלים" -->
      <Timeline items={steps.map(({ gets, ...s }) => s)} />
      <!-- משפט הסיום של נוגה (2026-11-08) -->
      <p class="h-goal reveal">תובנות, החלטות ופעולות פשוטות וישימות שמקדמות את העסק בכל פגישה.</p>
      <p class="more center"><a href="/services/#process">לפירוט תהליך הליווי ←</a></p>
    </div>
  </section>

  <!-- 6א. סרטון הכנס וכל התמונות מהכנסים, מיד אחרי "מתקדמים עם נוגה" (נוגה, 2026-11-08).
       הכריכה: תמונה של נוגה מגבה מול כל הקהל, במקום התמונה של יוטיוב. הסרטון מופיע גם בעמוד ההדרכות. -->
  <section class="section h-stage">
    <div class="container">
      <div class="h-head reveal">
        <h2 class="h-title h-title--split">קצת מכנס העסקים{' '}<span class="hl--mark">שפתח את השנה</span></h2>
      </div>
      <ConferenceVideo class="reveal" />
    </div>
    <div class="h-moments">
      <MomentsReel rows={momentRows} />
    </div>
  </section>

  <!-- 7. השאלון: הדבר הכי מרשים באתר, כי הוא מביא לידים (נוגה, 2026-11-08). אזור כהה בכחול של האתר עם זוהר טורקיז וזהב,
       כרטיס עם מסגרת זוהרת, הדמות (בלי רקע) ממורכזת מעל הכותרת, וכפתור זהב גדול. בלי מספר שאלות (עשוי להשתנות).
       מספר המסלולים נלקח מהנתונים. הנוסח מתאר את מה שהשאלון באמת נותן: פרופיל, חוזקות ושלושה מיקודים. הצעה שלי, ממתינה לאישור. -->
  <section id="quiz" class="h-quiz" aria-labelledby="quiz-title">
    <div class="container">
      <div class="h-quiz__card">
        <Image src={pointing} alt="" widths={[260, 420]} sizes="13rem" class="h-quiz__toon" />
        <h2 id="quiz-title" class="h-quiz__title h-title--split reveal">מה המיקוד הנכון{' '}<span class="hl">לעסק שלך ב-{quizYear}?</span></h2>
        <p class="h-quiz__text reveal">שאלון קצר שמסתכל על העסק מלמעלה, כמו בפגישת ייעוץ, ובסופו מקבלים מיד</p>
        <!-- מה מקבלים, בבולטים בולטים (נוגה, 2026-11-13: "לתת יותר דגש למה מקבלים"). אותם שלושה דברים כמו בפתיח של השאלון -->
        <ul class="h-quiz__gets reveal">
          <li><Star size={18} /> תמונת מצב של העסק ב-{quizAreas.length} תחומים</li>
          <li><Star size={18} /> העצות שכדאי להתחיל מהן, לפי התשובות שלך</li>
          <li><Star size={18} /> מה כבר עובד אצלך ושווה לחזק</li>
        </ul>
        <a class="h-quiz__btn reveal" href="/guides/business-focus-quiz/">לבדיקת העסק שלך <span aria-hidden="true">←</span></a>
      </div>
    </div>
  </section>


  <!-- 10. מדריכים חינמיים: שורה אחת והפניה למרכז הידע, ובסוף משפט סיום, ואז הפוטר (נוגה, 2026-11-08).
       במקום "כל מה שתמצאו באתר". -->
  <section class="section h-guides" aria-labelledby="guides-title">
    <div class="container">
      <div class="h-head reveal">
        <h2 id="guides-title" class="h-title">מדריכים <span class="hl--mark">חינמיים</span></h2>
        <p class="h-sub"><a href="/guides/">לכל המדריכים וההרצאות במרכז הידע ←</a></p>
      </div>
      <ul class="guides-row">
        {
          guides.map((g, i) => (
            <li class:list={['guide-card reveal', { 'guide-card--soon': g.data.comingSoon }]} style={`transition-delay: ${i * 0.08}s`}>
              {g.data.comingSoon ? (
                <div class="guide-card__inner">
                  <span class="guide-card__cover">
                    <ContentCover title={g.data.coverTitle ?? g.data.title} motif={g.data.coverMotif} star={g.data.coverStar} kind="guide" fit />
                    <span class="guide-card__soon">בקרוב</span>
                  </span>
                  <span class="guide-card__title">{g.data.title}</span>
                </div>
              ) : (
                <a href={`/guides/${g.id}/`}>
                  <ContentCover title={g.data.coverTitle ?? g.data.title} motif={g.data.coverMotif} star={g.data.coverStar} kind="guide" fit />
                  <span class="guide-card__title">{g.data.title}</span>
                </a>
              )}
            </li>
          ))
        }
      </ul>
      <!-- הזמנה עדינה להדרכות לארגונים, בשורה אחת ולא עוד אזור (הצעה שלי) -->
      <p class="h-guides__trainings reveal">מחפשים הרצאה או סדנה לצוות או לארגון?{' '}<a href="/trainings/">לקטלוג ההדרכות ←</a></p>
    </div>
  </section>

  <!-- סיום: במקום הפס הכהה "העסק שלך חייב לגדול" (נוגה, 2026-11-08: "לאחד את הדברים בצורה זורמת יותר").
       הסיסמה המאושרת, הכפתור לוואטסאפ, והסיסמה שחותמת כל פוסט של נוגה (באותו גופן, לא בכתב יד). -->
  <section class="h-sign" aria-labelledby="sign-title">
    <div class="container">
      <h2 id="sign-title" class="h-title reveal">העסק שלך <span class="hl--mark">חייב לגדול</span></h2>
      <p class="h-sign__lead reveal">ביחד נדאג שתהיה לך הצלחה עסקית בדרך שלך.</p>
      <a class="btn reveal" href={contact.whatsapp} target="_blank" rel="noopener">לשיחת היכרות<span class="sr-only"> (נפתח בלשונית חדשה)</span></a>
      <p class="h-sign__motto reveal">קמים ונהיים ענקיים מהחיים <Star size={26} /></p>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- 1. פתיח (נוגה, 2026-11-13): תמונת הקאבר, נוגה בצד ימין והטקסט על הכחול משמאל ---------- */
  .h-hero {
    position: relative;
    overflow: hidden;
    background: #01112b;
    color: var(--on-dark);
  }
  /* טלפון: התמונה למעלה (נוגה והכחול סביבה), והטקסט מתחתיה */
  .h-hero__media {
    position: relative;
    height: calc(min(78vw, 26rem) + var(--header-h));
  }
  .h-hero__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 82% 20%;
  }
  .h-hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(1 17 43 / 0.7) 0%, rgb(1 17 43 / 0) 22%, rgb(1 17 43 / 0) 70%, #01112b 100%);
  }
  .h-hero__inner {
    position: relative;
    padding-block: 0.25rem 2.5rem;
  }
  .h-hero__text {
    text-align: center;
  }
  .h-hero__title {
    margin: 0 0 1rem;
    color: var(--white);
    font-size: clamp(1.8rem, 3.3vw, 2.6rem);
    font-weight: 900;
    line-height: 1.25;
  }
  .h-hero__title .hl {
    display: block;
  }
  .h-hero__lead {
    max-width: 30rem;
    margin: 0 auto 1.6rem;
    font-size: clamp(1.02rem, 1.7vw, 1.15rem);
    line-height: 1.7;
    color: var(--on-dark-soft);
  }
  /* ההנעה לשאלון: משפט מחץ, משפט תועלת וכפתור שגולל אל השאלון */
  .h-hero__quiz {
    max-width: 31rem;
    margin-inline: auto;
    padding-top: 1.4rem;
    border-top: 1px solid rgb(252 220 109 / 0.3);
  }
  .h-hero__punch {
    margin: 0 0 0.4rem;
    font-size: clamp(1.3rem, 2.4vw, 1.6rem);
    font-weight: 800;
    line-height: 1.35;
    color: var(--gold-light);
  }
  .h-hero__why {
    margin: 0 0 1.25rem;
    font-size: 1.02rem;
    line-height: 1.6;
    color: var(--on-dark);
  }
  .h-hero__btn {
    padding: 0.75em 1.9em;
    font-size: 1.05rem;
    font-weight: 800;
    box-shadow: 0 14px 34px -14px rgb(252 220 109 / 0.65);
  }
  @media (min-width: 52rem) {
    .h-hero {
      display: flex;
      align-items: center;
      min-height: calc(clamp(27rem, 62vh, 36rem) + var(--header-h));
      padding-top: var(--header-h);
    }
    /* התמונה על כל הרוחב. נוגה בצד ימין, והצד השמאלי כחול כהה אחיד שעליו יושב הטקסט */
    .h-hero__media {
      position: absolute;
      inset: 0;
      height: auto;
    }
    .h-hero__media :global(img) {
      object-position: right 25%;
    }
    .h-hero__media::after {
      background:
        linear-gradient(to bottom, rgb(1 17 43 / 0.7) 0%, rgb(1 17 43 / 0) 20%),
        linear-gradient(to right, rgb(1 17 43 / 0.55) 0%, rgb(1 17 43 / 0) 45%);
    }
    .h-hero__inner {
      padding-block: 3rem;
    }
    /* הטקסט בצד שמאל (מעל הכחול), נוגה בימין */
    .h-hero__text {
      max-width: min(38rem, 50vw);
      margin-right: auto;
      margin-left: 0;
    }
  }
  @media (min-width: 90rem) {
    .h-hero__text {
      margin-left: 4%;
    }
  }

  /* כותרת בשתי שורות: החלק המודגש תמיד בשורה משלו, כדי שלא תישאר מילה צבועה בסוף השורה הראשונה (נוגה, 2026-11-08) */
  .h-title--split .hl {
    display: block;
  }
  /* עם הקו הזהב: שורה משלו, אבל ברוחב המילים בלבד, כדי שהקו לא יימתח על כל הרוחב */
  .h-title--split .hl--mark {
    display: table;
    margin-inline: auto;
  }

  /* ---------- 1ב. פסקת הפתיחה ---------- */
  .h-intro {
    padding-block: clamp(2.5rem, 6vw, 3.75rem) 0;
    text-align: center;
  }
  /* המשפט הראשון כולו בטורקיז כהה, בלי שבירת צבע באמצע שורה (נוגה, 2026-11-08) */
  .h-intro__lead {
    max-width: 44rem;
    margin: 0 auto 1rem;
    font-size: clamp(1.3rem, 2.6vw, 1.65rem);
    font-weight: 500;
    line-height: 1.45;
    color: var(--teal-dark);
  }
  .h-intro__text {
    max-width: 46rem;
    margin: 0 auto;
    font-size: clamp(1.05rem, 1.8vw, 1.15rem);
    line-height: 1.85;
    color: #33445c;
  }

  /* ---------- 2. שירותים ---------- */
  .h-services {
    padding-block: clamp(1.75rem, 4vw, 2.75rem);
  }
  /* הכרטיסים קצת יותר רחבים מהתוכן הרגיל (נוגה, 2026-11-08) */
  .h-services .container {
    width: min(100% - 2rem, 80rem);
  }

  /* ---------- כותרות ממורכזות ומושכות (נוגה, 2026-11-07) ---------- */
  .h-head {
    max-width: 46rem;
    margin: 0 auto 2rem;
    text-align: center;
  }
  /* תווית קטנה מעל הכותרת, עם קווים קצרים משני הצדדים */
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 0.6rem;
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--teal-dark);
  }
  .eyebrow::before,
  .eyebrow::after {
    content: '';
    width: 2rem;
    height: 2px;
    border-radius: 2px;
    background: var(--gold-gradient);
  }
  .section--deep .eyebrow {
    color: var(--gold-light);
  }
  .h-title {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 900;
    line-height: 1.2;
  }
  .h-sub {
    margin: 0.75rem auto 0;
    max-width: 36rem;
    font-size: 1.15rem;
    line-height: 1.6;
    color: #33445c;
  }
  .section--deep .h-sub {
    color: var(--on-dark-soft);
  }

  /* ---------- 3. המלצות ---------- */
  .h-reviews .more {
    margin-top: 2rem;
  }
  /* רקע עדין ומושך מאחורי ההמלצות: הילות רכות בטורקיז ובזהב ורשת נקודות דקה (נוגה, 2026-11-13) */
  .h-reviews {
    position: relative;
    background:
      radial-gradient(36rem 18rem at 85% 15%, rgb(12 138 168 / 0.1), transparent 70%),
      radial-gradient(30rem 16rem at 10% 90%, rgb(252 220 109 / 0.14), transparent 70%),
      radial-gradient(rgb(11 26 51 / 0.07) 1px, transparent 1.4px) 0 0 / 22px 22px,
      var(--mist);
  }

  /* ---------- 5. תהליך ---------- */
  .h-process {
    background: linear-gradient(180deg, var(--white), var(--mist));
  }
  .h-goal {
    max-width: 44rem;
    margin: 2.5rem auto 0;
    text-align: center;
    font-size: clamp(1.1rem, 2.2vw, 1.3rem);
    /* בלי בולד: נוגה לא אוהבת תוכן שכולו מודגש (2026-11-08) */
    font-weight: 500;
    line-height: 1.55;
    color: var(--teal-dark);
  }

  /* ---------- 3ב. האתגרים: רשימה ממורכזת עם כוכב (נוגה, 2026-11-13) ---------- */
  .challenges {
    list-style: none;
    max-width: 44rem;
    margin: 0 auto;
    padding: 0;
    display: grid;
    gap: 0.25rem;
  }
  .challenge {
    display: flex;
    justify-content: center;
    align-items: baseline;
    gap: 0.7rem;
    margin: 0;
    padding: 0.85rem 0.5rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.1);
    text-align: center;
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    font-weight: 500;
    line-height: 1.5;
    color: var(--white);
  }
  .challenge:last-child {
    border-bottom: 0;
  }
  /* בטלפון השורות נשברות, ולכן מיישרים לימין עם הכוכב בתחילת השורה */
  @media (max-width: 40rem) {
    .challenge {
      justify-content: flex-start;
      text-align: start;
      padding-inline: 0;
      font-size: 1.05rem;
    }
  }
  .challenge :global(.challenge__star) {
    flex: none;
    position: relative;
    top: 0.15em;
  }
  .h-when__cta {
    margin: 2rem 0 0;
    text-align: center;
  }

  /* ---------- 4. עקרונות הליווי בבית: רק הכותרות, בלי אייקונים (נוגה, 2026-11-13) ---------- */
  .ways-lite {
    list-style: none;
    max-width: 58rem;
    margin: 0 auto;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0 2rem;
  }
  .ways-lite__item {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin: 0;
    padding: 1.15rem 0;
    border-top: 1px solid rgb(255 255 255 / 0.16);
  }
  .ways-lite__num {
    flex: none;
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--gold-light);
    font-variant-numeric: tabular-nums;
  }
  .ways-lite__title {
    font-size: clamp(1.15rem, 1.9vw, 1.35rem);
    font-weight: 700;
    line-height: 1.35;
    color: var(--white);
  }
  @media (max-width: 52rem) {
    .ways-lite {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 34rem) {
    .ways-lite {
      grid-template-columns: 1fr;
    }
    .ways-lite__item {
      padding: 0.85rem 0;
    }
  }

  /* ---------- 7. שאלון: הדבר הכי מרשים באתר (נוגה, 2026-11-08) ---------- */
  .h-quiz {
    scroll-margin-top: var(--header-h);
    padding-block: clamp(3rem, 7vw, 5rem);
    background:
      radial-gradient(40rem 26rem at 15% 20%, rgb(12 138 168 / 0.32), transparent 70%),
      radial-gradient(36rem 24rem at 85% 90%, rgb(252 220 109 / 0.2), transparent 70%),
      var(--navy);
    color: var(--on-dark);
    text-align: center;
  }
  /* כרטיס עם מסגרת זוהרת בטורקיז וזהב */
  .h-quiz__card {
    position: relative;
    max-width: 50rem;
    margin-inline: auto;
    padding: clamp(1.75rem, 4vw, 2.75rem) clamp(1.25rem, 4vw, 3rem) clamp(2rem, 4vw, 3rem);
    border-radius: 2rem;
    background: linear-gradient(160deg, rgb(19 40 74 / 0.95), rgb(11 26 51 / 0.95));
    box-shadow:
      0 0 0 1px rgb(252 220 109 / 0.35),
      0 30px 80px -30px rgb(12 138 168 / 0.55),
      0 0 60px -20px rgb(252 220 109 / 0.35);
  }
  .h-quiz :global(.h-quiz__toon) {
    display: block;
    width: clamp(9rem, 20vw, 13rem);
    height: auto;
    margin: calc(-1 * clamp(3.5rem, 8vw, 5.5rem)) auto 0.5rem;
    filter: drop-shadow(0 18px 30px rgb(0 0 0 / 0.45));
  }
  .h-quiz__tag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0 0 0.75rem;
    padding: 0.3rem 0.9rem;
    border-radius: 999px;
    background: rgb(252 220 109 / 0.12);
    color: var(--gold-light);
    font-size: 0.9rem;
    font-weight: 800;
  }
  .h-quiz__title {
    margin: 0;
    color: var(--white);
    font-size: clamp(2rem, 5vw, 3.1rem);
    font-weight: 900;
    line-height: 1.2;
  }
  .h-quiz__gets {
    list-style: none;
    display: grid;
    gap: 0.6rem;
    width: fit-content;
    max-width: 100%;
    margin: 0 auto 2rem;
    padding: 1.1rem 1.4rem;
    border-radius: 1.1rem;
    background: rgb(255 255 255 / 0.06);
    border: 1px solid rgb(252 220 109 / 0.25);
    text-align: start;
  }
  .h-quiz__gets li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    font-size: clamp(1.05rem, 1.9vw, 1.2rem);
    font-weight: 700;
    color: var(--white);
  }
  .h-quiz__gets :global(svg) {
    flex: none;
  }
  .h-quiz__text {
    max-width: 36rem;
    margin: 1rem auto 1rem;
    font-size: clamp(1.05rem, 1.9vw, 1.2rem);
    line-height: 1.7;
    color: var(--on-dark-soft);
  }
  /* כפתור זהב גדול עם ברק שעובר עליו */
  .h-quiz__btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    overflow: hidden;
    padding: 1em 2.6em;
    border-radius: 999px;
    background: var(--gold-gradient);
    color: var(--navy);
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    font-weight: 900;
    text-decoration: none;
    box-shadow: 0 16px 40px -14px rgb(252 220 109 / 0.7);
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }
  .h-quiz__btn::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(110deg, transparent 30%, rgb(255 255 255 / 0.55) 50%, transparent 70%);
    transform: translateX(-120%);
    animation: quiz-shine 3.6s ease-in-out infinite;
  }
  @media (hover: hover) {
    .h-quiz__btn:hover {
      transform: translateY(-3px) scale(1.02);
      box-shadow: 0 22px 50px -14px rgb(252 220 109 / 0.85);
    }
  }
  @keyframes quiz-shine {
    0%,
    55% {
      transform: translateX(-120%);
    }
    100% {
      transform: translateX(120%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .h-quiz__btn::after {
      animation: none;
      display: none;
    }
  }

  /* ---------- 3א. נעים להכיר: אזור בהיר, התמונה קטנה כרקע בצד ימין ונעלמת אל הטקסט (נוגה, 2026-11-08) ---------- */
  .h-meet {
    position: relative;
    overflow: hidden;
    background: var(--white);
    color: var(--navy);
  }
  /* טלפון (נוגה, 2026-11-13): רואים את קו הכתפיים ולא חותכים בסנטר, והטשטוש רק בתחתית, רחוק מהפנים */
  .h-meet__media {
    position: relative;
    height: min(92vw, 24rem);
  }
  .h-meet__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 15%;
  }
  .h-meet__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(255 255 255 / 0) 82%, var(--white) 100%);
  }
  .h-meet__inner {
    position: relative;
    padding-block: 0.5rem 2.75rem;
  }
  .h-meet__hi {
    margin: 0 0 0.85rem;
    font-size: clamp(1.7rem, 4vw, 2.4rem);
    font-weight: 900;
    color: var(--navy);
  }
  .h-meet__voice {
    margin: 0 0 0.75rem;
    font-size: 1.12rem;
    line-height: 1.7;
    color: var(--navy);
  }
  /* המספרים בריבועים כחולים כהים, כמו האזורים הכהים באתר (נוגה, 2026-11-13) */
  .stats {
    list-style: none;
    margin: 1.75rem 0 0.5rem;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.85rem;
  }
  .stat {
    margin: 0;
    padding: 1.15rem 0.9rem 1.05rem;
    border-radius: 1.1rem;
    text-align: center;
    background:
      radial-gradient(10rem 6rem at 100% 0, rgb(12 138 168 / 0.38), transparent 70%),
      linear-gradient(165deg, var(--navy-soft), var(--navy) 75%);
    box-shadow: 0 18px 36px -22px rgb(11 26 51 / 0.65);
  }
  .stat__num {
    display: block;
    font-size: clamp(2.1rem, 4.5vw, 2.8rem);
    font-weight: 900;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    background: var(--gold-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .stat__label {
    display: block;
    margin-top: 0.45rem;
    font-size: 0.9rem;
    line-height: 1.35;
    color: var(--on-dark);
  }
  @media (max-width: 30rem) {
    .stats {
      gap: 0.5rem;
    }
    .stat {
      padding: 0.95rem 0.5rem 0.9rem;
    }
    .stat__label {
      font-size: 0.8rem;
    }
  }
  @media (min-width: 52rem) {
    .h-meet {
      display: flex;
      align-items: center;
      min-height: 26rem;
    }
    /* התמונה בצד שמאל (נוגה, 2026-11-08), צרה (בערך שליש), ונעלמת לכיוון הטקסט */
    .h-meet__media {
      position: absolute;
      inset: 0 auto 0 0;
      width: 34%;
      height: auto;
    }
    /* הטשטוש רק בקצה שליד הטקסט, רחוק מהפנים (נוגה, 2026-11-13) */
    .h-meet__media::after {
      background: linear-gradient(to left, var(--white) 0%, rgb(255 255 255 / 0.45) 9%, rgb(255 255 255 / 0) 24%);
    }
    .h-meet__inner {
      padding-block: 3.25rem;
    }
    .h-meet__text {
      max-width: min(40rem, 58vw);
      /* הטקסט בצד ימין, כי התמונה בשמאל */
      margin-right: 0;
      margin-left: auto;
    }
  }

  .more {
    margin: 1.75rem 0 0;
    font-weight: 800;
  }
  .more a {
    color: var(--teal-dark);
  }
  .more--dark a {
