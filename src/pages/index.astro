---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import YouTubeEmbed from '../components/YouTubeEmbed.astro';
import { contact } from '../data/contact';
---

<BaseLayout title="בית">
  <!-- אזור פתיחה: המסר המרכזי וכפתור פעולה -->
  <section class="hero section">
    <div class="container hero__inner">
      <div class="hero__text">
        <!-- TODO: ניסוח המסר המרכזי של האתר (❓ בסעיף 2 ב-REQUIREMENTS.md). נוגה תספק. -->
        <h1>[כאן יופיע המסר המרכזי של האתר]</h1>
        <p class="placeholder">תוכן חסר: משפט פתיחה / הצעת ערך. עדיין לא נקבע.</p>
        <!-- הכפתור פותח את דף קביעת הפגישות ביומן גוגל (contact.booking) -->
        <p><a class="btn" href={contact.booking} target="_blank" rel="noopener">קביעת שיחת היכרות<span class="sr-only"> (נפתח בלשונית חדשה)</span></a></p>
      </div>
      <!-- TODO: תמונה ראשית (למשל תמונה של נוגה) – נוגה תבחר מהחומרים -->
      <div class="placeholder-img hero__img" role="img" aria-label="מקום שמור לתמונה ראשית">
        תמונה חסרה:<br />תמונה ראשית
      </div>
    </div>
  </section>

  <!-- תמצית השירותים, עם קישור לעמוד המלא -->
  <section class="section section--mist">
    <div class="container">
      <h2>במה אני עוזרת</h2>
      <!-- TODO: להחליף בתמצית של השירותים בפועל, אחרי שנוגה תספק את הרשימה (עמוד שירותים) -->
      <ul class="cards">
        <li class="card">
          <h3>[שירות ראשון]</h3>
          <p class="placeholder">תוכן חסר: תיאור קצר.</p>
        </li>
        <li class="card">
          <h3>[שירות שני]</h3>
          <p class="placeholder">תוכן חסר: תיאור קצר.</p>
        </li>
        <li class="card">
          <h3>[שירות שלישי]</h3>
          <p class="placeholder">תוכן חסר: תיאור קצר.</p>
        </li>
      </ul>
      <p class="more"><a href="/services/">לכל השירותים</a></p>
    </div>
  </section>

  <!-- הגישה: הקשבה, עיבוד ובניית פתרון בזמן אמת (לפי סעיף 1 ב-REQUIREMENTS.md) -->
  <section class="section">
    <div class="container">
      <h2>הגישה</h2>
      <!-- TODO: ניסוח הגישה בקולה של נוגה. לפי המפרט: הקשבה, עיבוד ובניית פתרון בזמן אמת מתוך מה שהלקוח משתף. -->
      <p class="placeholder">תוכן חסר: תיאור הגישה בניסוח של נוגה.</p>
      <p class="more"><a href="/about/">עוד עליי</a></p>
    </div>
  </section>

  <!-- סרטון תדמית מכנס העסקים שנוגה הפיקה, עם המלצות. הכותרת לקוחה מהדף ב-Canva -->
  <section class="section section--mist">
    <div class="container">
      <h2>קצת מכנס העסקים שפתח את השנה</h2>
      <div class="conference">
        <YouTubeEmbed id="RJd6_sdT62U" title="נוגה דיין אור - כנס עסקים במקסימום" />
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .hero__inner {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  .hero__img {
    aspect-ratio: 4 / 3;
  }
  .conference {
    max-width: 48rem;
    margin-inline: auto;
  }
  .more {
    margin-top: 1.5rem;
    margin-bottom: 0;
    font-weight: 700;
  }
  @media (min-width: 48rem) {
    .hero__inner {
      grid-template-columns: 1.2fr 1fr;
    }
    .hero__img {
      aspect-ratio: 4 / 5;
    }
  }
</style>
