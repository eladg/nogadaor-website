<script>
  // ספירה עולה של המספרים ב"נעים להכיר". מי שביקש פחות תנועה רואה את המספרים הסופיים.
  // נוגה (2026-11-13): הספירה התחילה הרבה לפני שהגיעו לאזור. עכשיו היא מתחילה רק כשכל שורת המספרים
  // כבר בתוך המסך (ולא בתחתית שלו), ואחרי שהטקסט סביבה הופיע.
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const row = document.querySelector<HTMLElement>('.stats');
  const nums = [...document.querySelectorAll<HTMLElement>('[data-count]')];
  if (row && !calm && 'IntersectionObserver' in window) {
    nums.forEach((el) => (el.textContent = '0'));
    const run = () =>
      nums.forEach((el) => {
        const target = Number(el.dataset.count);
        const start = performance.now();
        const step = (t: number) => {
          const p = Math.min(1, (t - start) / 1600);
          const eased = 1 - Math.pow(1 - p, 3);
          el.textContent = String(Math.round(target * eased));
          if (p < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      });
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        setTimeout(run, 350);
      },
      { threshold: 1, rootMargin: '0px 0px -18% 0px' },
    );
    io.observe(row);
  }
</script>
