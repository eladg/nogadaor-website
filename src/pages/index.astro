---
// עמוד הבית (2026-11-07). הכול טיוטה לאישור נוגה. הביקורת והציונים: drafts/critique-2026-11-07.md.
// המסר הראשי (נוגה): "העולם דוהר קדימה, העסק שלך חייב לגדול", אבל רק בצד החיובי והתועלתי.
// הסדר: פתיח עם הבטחה ← 4 מספרים ← דווקא עכשיו (הטקסט של נוגה) ← איך יודעים שהעסק מוכן לשלב הבא (6 מצבים)
//   ← השירותים (ריבועים מתהפכים) ← הגישה + נעים להכיר ← שאלון ← סרטון הכנס ← קריאה לפעולה
//   ← "כל מה שתמצאו באתר" (רשימה לחיפוש, רק ממה שיש באתר).
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import YouTubeEmbed from '../components/YouTubeEmbed.astro';
import QuizFeature from '../components/QuizFeature.astro';
import ServiceCards from '../components/ServiceCards.astro';
import Icon from '../components/Icon.astro';
import Star from '../components/Star.astro';
import { contact } from '../data/contact';
import { services, situations } from '../data/services';
import { trainings } from '../data/trainings';
import { quizYear } from '../data/quiz';
import heroPhoto from '../assets/about/gallery/17-looking-ahead.jpg';
import introPhoto from '../assets/about/gallery/05-podium-smile.jpg';
// תמונות אווירה (AI) ששלחה נוגה, 2026-11-07. הדמות המצוירת: רק במקומות מתאימים ובאזורים בהירים (רקע לבן).
import darkLines from '../assets/atmosphere/dark-lines.webp';
import treasure from '../assets/character/treasure.webp';
import pointing from '../assets/character/pointing-down.webp';

const linesBg = await getImage({ src: darkLines, width: 1600, format: 'webp' });

// המספרים שנוגה אישרה (SKILL.md סעיף 6א). 4 בשורה. הספירה עולה כשמגיעים לאזור.
const stats = [
  { num: 20, label: 'שנה בהנהלה של בנק גדול' },
  { num: 450, label: 'עסקים בליווי' },
  { num: 10, label: 'שנות ניסיון בייעוץ עסקי' },
  { num: 9.4, label: 'ציון ב-4 שנות ייעוץ מטעם משרד הכלכלה' },
];

// נוגה (2026-11-07): האתר צריך לשדר שהיא מקדמת עסקים בפרויקטים, במשימות, בתהליכי עבודה וביעדים
const advances = ['פרויקטים', 'משימות', 'תהליכי עבודה', 'יעדים', 'צוותים', 'מהלכי צמיחה'];

// "כל מה שתמצאו באתר": רק עמודים שקיימים (נוגה: "מכל מה שיש באתר ולא דברים שאין")
const guides = (await getCollection('guides'))
  .filter((g) => !g.data.comingSoon)
  .sort((a, b) => (a.data.type === b.data.type ? a.data.order - b.data.order : a.data.type === 'guide' ? -1 : 1));
const index = [
  { title: 'שירותים', links: services.map((s) => ({ href: s.href, label: s.title })) },
  { title: 'הדרכות', links: trainings.map((t) => ({ href: `/trainings/${t.slug}/`, label: t.title })) },
  { title: 'מדריכים ומאמרים', links: guides.map((g) => ({ href: `/guides/${g.id}/`, label: g.data.title })) },
  {
    title: 'עוד באתר',
    links: [
      { href: '/guides/business-focus-quiz/', label: `שאלון מיקוד פיתוח עסקי ${quizYear}` },
      { href: '/about/', label: 'אודות נוגה דיין אור' },
      { href: '/testimonials/', label: 'המלצות לקוחות' },
      { href: '/guides/', label: 'הדרכות לצפייה בחינם' },
      { href: '/contact/', label: 'צור קשר' },
      { href: '/contact/', label: 'הקהילה: תודעה עסקית מנצחת' },
    ],
  },
];
---

<BaseLayout
  title="ייעוץ עסקי וארגוני"
  description="נוגה דיין אור: ייעוץ עסקי וארגוני לעסקים מבוססים, להגדלת הכנסות ושיפור רווחיות מתוך מה שכבר קיים בעסק. ייעוץ עסקי, ייעוץ ארגוני, אוטומציות ו-AI, ליווי פיננסי והדרכות."
>
  <!-- 1. פתיח: ההבטחה. התמונה: נוגה על הבמה, מביטה קדימה (מתאים למסר) -->
  <section class="h-hero">
    <div class="h-hero__media">
      <Image
        src={heroPhoto}
        alt="נוגה דיין אור על הבמה, מביטה אל הקהל בחיוך"
        widths={[640, 1024, 1600]}
        sizes="(min-width: 52rem) 60vw, 100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="container h-hero__inner">
      <div class="h-hero__text">
        <p class="h-hero__kicker">נוגה דיין אור · ייעוץ עסקי וארגוני</p>
        <!-- המסר הראשי: טיוטה שלי לאישור נוגה -->
        <h1 class="h-hero__title">
          העולם העסקי זז מהר.{' '}<span class="hl">זה הזמן של העסק שלך לגדול</span>
        </h1>
        <p class="h-hero__lead">להגדיל הכנסות ולשפר רווחיות מתוך מה שכבר קיים בעסק, ולהוביל אותו קדימה בביטחון.</p>
        <!-- מילה מתחלפת: מה מקדמים. קוראי מסך מקבלים את כל הרשימה, ומי שביקש פחות תנועה רואה מילה אחת קבועה. -->
        <p class="h-hero__advance">
          <span class="sr-only">מקדמים יחד: {advances.join(', ')}</span>
          <span aria-hidden="true">מקדמים יחד{' '}<span class="rot" data-words={advances.join('|')}><span class="rot__word">{advances[0]}</span></span></span>
        </p>
        <div class="h-hero__actions">
          <a class="btn" href={contact.booking} target="_blank" rel="noopener">קביעת שיחת היכרות<span class="sr-only"> (נפתח בלשונית חדשה)</span></a>
          <a class="btn btn--ghost" href="/services/">לשירותים</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. מספרים -->
  <section class="h-stats" aria-label="במספרים">
    <div class="container">
      <ul class="stats">
        {
          stats.map((s, i) => (
            <li class="stat reveal" style={`transition-delay: ${i * 0.08}s`}>
              <span class="stat__num" data-count={s.num}>{s.num}</span>
              <span class="stat__label">{s.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 2א. דווקא עכשיו: מתוך הטקסט שנוגה כתבה (2026-11-07, drafts/strategy-and-products-2026-11-07.md).
       לבקשתה, רק מה שמשדר קידמה ולא קורבנות: "המלחמה שלא נגמרת" לא נכנסה. המשפט האחרון בפסקה השנייה הוא תוספת שלי. -->
  <section class="section section--deep h-now" style={`--bg: url(${linesBg.src})`}>
    <div class="container h-now__inner">
      <h2 class="sec-title reveal">דווקא עכשיו, <span class="hl">הזמן להתקדם</span></h2>
      <p class="sec-lead">עסק צריך להשקיע בפיתוח עסקי באופן שוטף: להיות עם היד על הדופק, להתאים את עצמו למגמות המתפתחות ולבחון איך לייצר יותר ערך והכנסות.</p>
      <p class="h-now__kicker">הגבינה זזה לכולם:</p>
      <ul class="h-now__list">
        <li class="reveal"><Icon name="robot" size={26} /><span>הבינה המלאכותית משנה את הדרך שבה עובדים, לומדים וקונים</span></li>
        <li class="reveal" style="transition-delay: 0.08s"><Icon name="chart" size={26} /><span>החשיפה האורגנית נשחקת, והאלגוריתמים משתנים כל הזמן</span></li>
        <li class="reveal" style="transition-delay: 0.16s"><Icon name="layers" size={26} /><span>הצפת ידע ותוכן, ולקוחות שחסינים יותר למסרים שיווקיים</span></li>
      </ul>
      <p class="h-now__end">מה שעבד בעבר כבר לא תמיד מספיק. וזו בדיוק ההזדמנות לבנות את המהלך הבא.</p>
      <p class="h-now__principle reveal">
        <Star size={24} />
        <span>צמיחה היא חלק מהניהול השוטף.</span>
      </p>
    </div>
  </section>

  <!-- 3. איך יודעים שהעסק מוכן לשלב הבא (בהשראת תמונה ששלחה נוגה; המצבים מתוך מסמך העבודה שלה) -->
  <section class="section section--mist">
    <div class="container">
      <h2 class="sec-title center reveal">איך יודעים שהעסק מוכן <span class="hl--mark">לשלב הבא?</span></h2>
      <!-- מתוך מסר 2 של נוגה ("גם עסק מצליח צריך להמשיך להתפתח") -->
      <p class="sec-lead center">גם עסק מצליח צריך להמשיך להתפתח. אלה הרגעים שבהם כדאי לעצור ולבדוק מה הצעד הבא:</p>
      <ul class="moments">
        {
          situations.map((m, i) => (
            <li class="moment reveal" style={`transition-delay: ${(i % 3) * 0.1}s`}>
              <span class="moment__icon">
                <Icon name={m.icon} size={40} />
              </span>
              <p>{m.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 4. השירותים -->
  <section class="section">
    <div class="container">
      <h2 class="sec-title reveal">מה מקדמים <span class="hl--mark">יחד</span></h2>
      <p class="sec-lead">ייעוץ עסקי וארגוני משולב: הכנסות, אנשים, תהליכים ומספרים, בדרך שמתאימה לעסק שלך.</p>
      <ServiceCards />
      <p class="more"><a href="/services/">לכל השירותים ←</a></p>
    </div>
  </section>

  <!-- 5. הגישה: מסר 1 של נוגה, מקוצר. באזור בהיר, עם הדמות ותיבת האוצר (הכסף שמסתתר בעסק). -->
  <section class="section h-approach-sec">
    <div class="container h-approach">
      <div class="h-approach__text reveal">
        <h2 class="sec-title">בכל עסק הכסף נמצא <span class="hl--mark">במקום אחר</span></h2>
        <p>אי אפשר לדעת מראש איפה נמצא הכסף בעסק, עד שמכירים ובודקים אותו לעומק. לא בטוח שצריך עוד לידים, עוד שיווק, עוד עובדים או עוד מערכות.</p>
        <!-- מתוך הטקסט שנוגה כתבה (2026-11-07) -->
        <p>פיתוח עסקי לא מתחיל בפתרון מוכן, אלא בלמידת העסק: מה עובד, מה נשחק, ואילו משאבים ונכסים קיימים יכולים לייצר את הזדמנות הצמיחה הבאה. מכאן בונים מהלכים מדויקים, פשוטים וישימים, בלי הוצאות נוספות ופרויקטים מסובכים.</p>
      </div>
      <div class="h-approach__art reveal" style="transition-delay: 0.15s">
        <Image src={treasure} alt="" widths={[360, 560]} sizes="(min-width: 52rem) 22rem, 70vw" class="toon" />
      </div>
    </div>
  </section>

  <!-- 6. נעים להכיר: תמונה של נוגה כרקע (נוגה מעדיפה תמונה כרקע ולא במסגרת). הפתיח האישי שגובש באסטרטגיה שלה. -->
  <section class="h-meet">
    <div class="h-meet__media">
      <Image src={introPhoto} alt="נוגה דיין אור ליד הדוכן על הבמה, מחייכת" widths={[640, 1024, 1400]} sizes="(min-width: 52rem) 55vw, 100vw" />
    </div>
    <div class="container h-meet__inner">
      <div class="h-meet__text reveal">
        <h2 class="h-meet__hi">נעים להכיר, <span class="hl">נוגה דיין אור</span></h2>
        <p class="h-meet__voice">חיה ונושמת פיתוח עסקים והגדלת הכנסות! אוהבת להיכנס לעסק, להכיר את האנשים, להבין איך דברים עובדים, לגלות הזדמנויות עסקיות, לחבר בין רעיונות, לעשות סדר ובעיקר לגרום לדברים טובים לקרות.</p>
        <p class="h-meet__cred">יועצת עסקית וארגונית להגדלת הכנסות ושיפור רווחיות, עם ניסיון בליווי 450 עסקים ו-20 שנה של תהליכי ניהול, פיתוח עסקי ואסטרטגיה בהנהלה של בנק גדול.</p>
        <p class="more more--dark"><a href="/about/">עוד על נוגה ←</a></p>
      </div>
    </div>
  </section>

  <!-- 7. שאלון המיקוד (עבר לכאן מעמוד המדריכים, 2026-11-07). הדמות מצביעה על השאלון. -->
  <section class="section section--mist">
    <div class="container">
      <div class="h-quiz-head">
        <div class="reveal">
          <!-- הכותרת היא הצעה שלי -->
          <h2 class="sec-title">איפה העסק שלך <span class="hl--mark">עומד היום?</span></h2>
          <p class="sec-lead">שאלון קצר שעושה סדר: פרופיל של העסק ושלושה מיקודים לשנה הקרובה.</p>
        </div>
        <Image src={pointing} alt="" widths={[220, 340]} sizes="11rem" class="toon h-quiz-head__toon" />
      </div>
      <QuizFeature />
    </div>
  </section>

  <!-- 8. סרטון תדמית מכנס העסקים שנוגה הפיקה, עם המלצות. הכותרת לקוחה מהדף ב-Canva -->
  <section class="section">
    <div class="container">
      <h2 class="sec-title center">קצת מכנס העסקים שפתח את השנה</h2>
      <div class="conference">
        <YouTubeEmbed id="RJd6_sdT62U" title="נוגה דיין אור - כנס עסקים במקסימום" />
      </div>
    </div>
  </section>

  <CtaBand />

  <!-- 9. כל מה שתמצאו באתר: רשימה שעונה על הרבה חיפושים, רק ממה שקיים באתר (נוגה, 2026-11-07) -->
  <section class="h-index" aria-labelledby="index-title">
    <div class="container">
      <h2 id="index-title" class="h-index__title">כל מה שתמצאו באתר</h2>
      <div class="h-index__cols">
        {
          index.map((col) => (
            <div>
              <h3 class="h-index__col-title">{col.title}</h3>
              <ul>
                {col.links.map((l) => (
                  <li>
                    <a href={l.href}>{l.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- 1. פתיח (באותו מבנה של פתיח האודות: תמונה בצד שמאל, טקסט בימין על הצללה) ---------- */
  .h-hero {
    position: relative;
    overflow: hidden;
    background: var(--navy-deep);
    color: var(--on-dark);
  }
  .h-hero__media {
    position: relative;
    height: min(62vw, 20rem);
  }
  .h-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 25%;
  }
  .h-hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(7 17 31 / 0.15) 0%, rgb(7 17 31 / 0.1) 55%, var(--navy-deep) 100%);
  }
  .h-hero__inner {
    position: relative;
    padding-block: 0.5rem 2.5rem;
  }
  .h-hero__kicker {
    margin: 0 0 0.75rem;
    font-weight: 800;
    color: var(--gold-light);
  }
  .h-hero__title {
    margin: 0 0 1rem;
    color: var(--white);
    font-size: clamp(2rem, 5.4vw, 3.4rem);
    font-weight: 900;
    line-height: 1.15;
  }
  .h-hero__title .hl {
    display: block;
  }
  .h-hero__lead {
    max-width: 34rem;
    font-size: clamp(1.1rem, 2.2vw, 1.3rem);
    font-weight: 500;
    line-height: 1.6;
    margin-bottom: 1.75rem;
  }
  .h-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  @media (min-width: 52rem) {
    .h-hero {
      display: flex;
      align-items: center;
      min-height: clamp(28rem, 70vh, 38rem);
    }
    .h-hero__media {
      position: absolute;
      top: 0;
      bottom: 0;
      left: 0;
      width: 60%;
      height: auto;
    }
    .h-hero__media::after {
      background:
        linear-gradient(to left, var(--navy-deep) 0%, rgb(7 17 31 / 0.7) 16%, rgb(7 17 31 / 0) 42%),
        linear-gradient(to right, rgb(7 17 31 / 0.85) 0%, rgb(7 17 31 / 0) 30%),
        linear-gradient(0deg, rgb(7 17 31 / 0.7) 0%, rgb(7 17 31 / 0) 28%),
        rgb(7 17 31 / 0.12);
    }
    .h-hero__inner {
      padding-block: 3.5rem;
    }
    .h-hero__text {
      max-width: min(38rem, 55vw);
      text-shadow: 0 2px 18px rgb(7 17 31 / 0.6);
    }
  }

  /* ---------- 2. מספרים ---------- */
  .h-stats {
    background: var(--white);
    border-bottom: 1px solid var(--line);
    padding-block: 2.25rem;
  }
  .stats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    text-align: center;
  }
  @media (max-width: 48rem) {
    .stats {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem 1rem;
    }
  }
  .stat {
    margin: 0;
  }
  .stat__num {
    display: block;
    font-size: clamp(2.4rem, 6vw, 3.4rem);
    font-weight: 900;
    line-height: 1;
    color: var(--teal-dark);
  }
  .stat:nth-child(even) .stat__num {
    color: var(--gold-dark);
  }
  .stat__label {
    display: block;
    margin-top: 0.4rem;
    font-weight: 600;
    color: #33445c;
    line-height: 1.4;
  }

  /* ---------- 3. מצבים: 3 בשורה, 2 בטאבלט, 1 בנייד ---------- */
  .moments {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  @media (max-width: 62rem) {
    .moments {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 36rem) {
    .moments {
      grid-template-columns: 1fr;
    }
  }
  .moment {
    margin: 0;
    padding: 1.75rem 1.5rem;
    text-align: center;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 1.25rem;
  }
  .moment__icon {
    display: inline-grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    margin-bottom: 0.75rem;
    border-radius: 1.25rem;
    color: var(--gold-light);
    background:
      radial-gradient(circle at 30% 20%, rgb(25 154 181 / 0.55), transparent 70%),
      var(--navy);
    box-shadow: 0 14px 28px -16px rgb(11 26 51 / 0.6);
  }
  .moment p {
    margin: 0;
    font-size: 1.12rem;
    font-weight: 700;
    line-height: 1.5;
    color: var(--navy);
  }

  .more {
