---
// עמוד הבית. הסדר שנוגה קבעה (2026-11-07):
//   פתיח ("מקדמים יחד" עם כל הנושאים) ← 6 קוביות השירותים, בלי כותרת ← 6 המלצות בקרוסלה (4 נראות)
//   ← "דווקא עכשיו חייבים להתקדם": 6 מצבים, בלי הסברים ← "בכל עסק הכסף נמצא במקום אחר" + 3 שלבי התהליך ומה יוצא מכל אחד
//   ← 6 עקרונות הליווי (כמו באודות) ← שאלון ← נעים להכיר (עם MBA והמספרים) ← סרטון הכנס ← קריאה לפעולה ← "כל מה שתמצאו באתר".
// בלי גוף ראשון. הביקורת והציונים: drafts/critique-2026-11-07.md.
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import YouTubeEmbed from '../components/YouTubeEmbed.astro';
import QuizFeature from '../components/QuizFeature.astro';
import ServiceCards from '../components/ServiceCards.astro';
import ReviewsCarousel from '../components/ReviewsCarousel.astro';
import Timeline from '../components/Timeline.astro';
import Icon from '../components/Icon.astro';
import { contact } from '../data/contact';
import { services, situations, steps } from '../data/services';
import { featuredReviews } from '../data/reviews';
import { ways, icons } from '../data/principles';
import { trainings } from '../data/trainings';
import { quizYear } from '../data/quiz';
import { atmoStyle } from '../utils/atmo';
import heroPhoto from '../assets/about/gallery/17-looking-ahead.jpg';
import introPhoto from '../assets/about/gallery/05-podium-smile.jpg';
// תמונות אווירה (AI) ששלחה נוגה. הדמות המצוירת: רק במקומות מתאימים ובאזורים בהירים (רקע לבן).
import darkLines from '../assets/atmosphere/dark-lines.webp';
import darkStairs from '../assets/atmosphere/dark-stairs.webp';
import lightTeam from '../assets/atmosphere/light-team.webp';
import treasure from '../assets/character/treasure.webp';
import pointing from '../assets/character/pointing-down.webp';

const linesStyle = await atmoStyle(darkLines, 0.55);
const stairsStyle = await atmoStyle(darkStairs, 0.4);
const teamStyle = await atmoStyle(lightTeam, 0.28);

// נוגה: "מקדמים יחד" ואחריו כל הנושאים שמקדמים
const advances = ['פרויקטים', 'משימות', 'תהליכי עבודה', 'יעדים', 'צוותים', 'מהלכי צמיחה'];

// המספרים שנוגה אישרה (SKILL.md סעיף 6א). עולים בספירה כשמגיעים אליהם.
const stats = [
  { num: 20, label: 'שנה בהנהלה של בנק גדול' },
  { num: 450, label: 'עסקים בליווי' },
  { num: 10, label: 'שנות ניסיון בייעוץ עסקי' },
  { num: 9.4, label: 'ציון ב-4 שנות ייעוץ מטעם משרד הכלכלה' },
];

// "כל מה שתמצאו באתר": רק עמודים שקיימים (נוגה: "מכל מה שיש באתר ולא דברים שאין")
const guides = (await getCollection('guides'))
  .filter((g) => !g.data.comingSoon)
  .sort((a, b) => (a.data.type === b.data.type ? a.data.order - b.data.order : a.data.type === 'guide' ? -1 : 1));
const index = [
  { title: 'שירותים', links: services.map((s) => ({ href: s.href, label: s.title })) },
  { title: 'הדרכות', links: trainings.map((t) => ({ href: `/trainings/${t.slug}/`, label: t.title })) },
  { title: 'מדריכים ומאמרים', links: guides.map((g) => ({ href: `/guides/${g.id}/`, label: g.data.title })) },
  {
    title: 'עוד באתר',
    links: [
      { href: '/guides/business-focus-quiz/', label: `שאלון מיקוד פיתוח עסקי ${quizYear}` },
      { href: '/about/', label: 'אודות נוגה דיין אור' },
      { href: '/testimonials/', label: 'המלצות לקוחות' },
      { href: '/guides/', label: 'הרצאות לצפייה בחינם' },
      { href: '/contact/', label: 'צור קשר' },
      { href: '/contact/', label: 'הקהילה: תודעה עסקית מנצחת' },
    ],
  },
];
---

<BaseLayout
  title="ייעוץ עסקי וארגוני"
  description="נוגה דיין אור: ייעוץ עסקי וארגוני להגדלת הכנסות ושיפור רווחיות באמצעות אסטרטגיה, שיווק ושיפור תהליכי עבודה עם בינה מלאכותית. ייעוץ עסקי, ייעוץ ארגוני, אוטומציות ו-AI, ליווי פיננסי והדרכות."
>
  <!-- 1. פתיח. הנוסח של נוגה (2026-11-07). התמונה: נוגה על הבמה, מביטה קדימה. -->
  <section class="h-hero">
    <div class="h-hero__media">
      <Image
        src={heroPhoto}
        alt="נוגה דיין אור על הבמה, מביטה אל הקהל בחיוך"
        widths={[640, 1024, 1600]}
        sizes="(min-width: 52rem) 60vw, 100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="container h-hero__inner">
      <div class="h-hero__text">
        <p class="h-hero__kicker">נוגה דיין אור · ייעוץ עסקי וארגוני</p>
        <h1 class="h-hero__title">העולם משתנה בקצב מסחרר{' '}<span class="hl">וזה הזמן של העסק שלך לגדול</span></h1>
        <p class="h-hero__lead">להגדיל הכנסות ולשפר רווחיות באמצעות אסטרטגיה, שיווק ושיפור תהליכי עבודה עם בינה מלאכותית.</p>
        <div class="h-advance">
          <p class="h-advance__label">מקדמים יחד:</p>
          <ul class="h-advance__list">
            {advances.map((a) => <li>{a}</li>)}
          </ul>
        </div>
        <div class="h-hero__actions">
          <a class="btn" href={contact.booking} target="_blank" rel="noopener">קביעת שיחת היכרות<span class="sr-only"> (נפתח בלשונית חדשה)</span></a>
          <a class="btn btn--ghost" href="/services/">לשירותים</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. שש קוביות השירותים, בלי כותרת (נוגה). כותרת נסתרת רק לקוראי מסך. -->
  <section class="section h-services" aria-labelledby="services-title">
    <div class="container">
      <h2 id="services-title" class="sr-only">השירותים</h2>
      <ServiceCards />
    </div>
  </section>

  <!-- 3. המלצות: 6 ההמלצות הכי מקצועיות ועסקיות (src/data/reviews.ts, featuredReviews), בשורה אחת, 4 נראות במחשב -->
  <section class="section section--mist atmo h-reviews" style={teamStyle}>
    <div class="container">
      <div class="h-reviews__head">
        <h2 class="sec-title reveal">מה אומרים <span class="hl--mark">הלקוחות</span></h2>
        <a class="h-more" href="/testimonials/">לכל ההמלצות ←</a>
      </div>
      <ReviewsCarousel reviews={featuredReviews} itemWidth="clamp(16rem, calc((100% - 3.75rem) / 4), 23rem)" />
    </div>
  </section>

  <!-- 4. דווקא עכשיו חייבים להתקדם: 6 מצבים שבהם לוקחים ייעוץ עסקי, בלי הסברים נוספים (נוגה) -->
  <section class="section section--deep atmo h-now" style={linesStyle}>
    <div class="container">
      <h2 class="sec-title reveal">דווקא עכשיו, <span class="hl">חייבים להתקדם</span></h2>
      <ul class="moments">
        {
          situations.map((m, i) => (
            <li class="moment reveal" style={`transition-delay: ${(i % 3) * 0.1}s`}>
              <span class="moment__icon">
                <Icon name={m.icon} size={30} />
              </span>
              <p>{m.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 5. בכל עסק הכסף נמצא במקום אחר + שלושת שלבי התהליך ומה יוצא מכל אחד (src/data/services.ts, steps) -->
  <section class="section h-approach-sec">
    <div class="container">
      <div class="h-approach">
        <div class="reveal">
          <h2 class="sec-title">בכל עסק הכסף נמצא <span class="hl--mark">במקום אחר</span></h2>
          <p class="sec-lead">אי אפשר לדעת מראש איפה נמצא הכסף בעסק, עד שמכירים ובודקים אותו לעומק. לא בטוח שצריך עוד לידים, עוד שיווק, עוד עובדים או עוד מערכות.</p>
        </div>
        <Image src={treasure} alt="" widths={[300, 480]} sizes="(min-width: 52rem) 15rem, 40vw" class="toon h-approach__toon" />
      </div>
      <Timeline items={steps} />
      <p class="more"><a href="/services/">לפרטים על השירותים ←</a></p>
    </div>
  </section>

  <!-- 6. עקרונות הליווי: שש הקוביות מהאודות (נוגה: "צריכים להופיע גם במסך הבית"). src/data/principles.ts -->
  <section class="section section--deep atmo h-ways" style={stairsStyle}>
    <div class="container">
      <h2 class="sec-title reveal">עקרונות <span class="hl">הליווי</span></h2>
      <ul class="ways">
        {
          ways.map((w, i) => (
            <li class="way reveal" style={`transition-delay: ${(i % 3) * 0.1}s`}>
              <span class="way__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" set:html={icons[w.icon]} />
              </span>
              <h3>{w.title}</h3>
              <p>{w.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 7. שאלון המיקוד. הדמות מצביעה על השאלון. -->
  <section class="section section--mist">
    <div class="container">
      <div class="h-quiz-head">
        <div class="reveal">
          <!-- הכותרת היא הצעה שלי -->
          <h2 class="sec-title">איפה העסק שלך <span class="hl--mark">עומד היום?</span></h2>
          <p class="sec-lead">שאלון קצר שעושה סדר: פרופיל של העסק ושלושה מיקודים לשנה הקרובה.</p>
        </div>
        <Image src={pointing} alt="" widths={[220, 340]} sizes="11rem" class="toon h-quiz-head__toon" />
      </div>
      <QuizFeature />
    </div>
  </section>

  <!-- 8. נעים להכיר: תמונה של נוגה כרקע (נוגה מעדיפה תמונה כרקע ולא במסגרת). הפתיח האישי מהאסטרטגיה שלה, עם MBA והמספרים. -->
  <section class="h-meet">
    <div class="h-meet__media">
      <Image src={introPhoto} alt="נוגה דיין אור ליד הדוכן על הבמה, מחייכת" widths={[640, 1024, 1400]} sizes="(min-width: 52rem) 55vw, 100vw" />
    </div>
    <div class="container h-meet__inner">
      <div class="h-meet__text reveal">
        <h2 class="h-meet__hi">נעים להכיר, <span class="hl">נוגה דיין אור</span></h2>
        <p class="h-meet__voice">חיה ונושמת פיתוח עסקים והגדלת הכנסות! אוהבת להיכנס לעסק, להכיר את האנשים, להבין איך דברים עובדים, לגלות הזדמנויות עסקיות, לחבר בין רעיונות, לעשות סדר ובעיקר לגרום לדברים טובים לקרות.</p>
        <p class="h-meet__cred">יועצת עסקית וארגונית להגדלת הכנסות ושיפור רווחיות, בעלת תואר שני במנהל עסקים (MBA), עם ניסיון בליווי 450 עסקים ו-20 שנה של תהליכי ניהול, פיתוח עסקי ואסטרטגיה בהנהלה של בנק גדול.</p>
        <ul class="stats">
          {
            stats.map((s) => (
              <li class="stat">
                <span class="stat__num" data-count={s.num}>{s.num}</span>
                <span class="stat__label">{s.label}</span>
              </li>
            ))
          }
        </ul>
        <p class="more more--dark"><a href="/about/">עוד על נוגה ←</a></p>
      </div>
    </div>
  </section>

  <!-- 9. סרטון תדמית מכנס העסקים שנוגה הפיקה, עם המלצות. הכותרת לקוחה מהדף ב-Canva -->
  <section class="section">
    <div class="container">
      <h2 class="sec-title center">קצת מכנס העסקים שפתח את השנה</h2>
      <div class="conference">
        <YouTubeEmbed id="RJd6_sdT62U" title="נוגה דיין אור - כנס עסקים במקסימום" />
      </div>
    </div>
  </section>

  <CtaBand />

  <!-- 10. כל מה שתמצאו באתר: רשימה שעונה על הרבה חיפושים, רק ממה שקיים באתר (נוגה, 2026-11-07) -->
  <section class="h-index" aria-labelledby="index-title">
    <div class="container">
      <h2 id="index-title" class="h-index__title">כל מה שתמצאו באתר</h2>
      <div class="h-index__cols">
        {
          index.map((col) => (
            <div>
              <h3 class="h-index__col-title">{col.title}</h3>
              <ul>
                {col.links.map((l) => (
                  <li>
                    <a href={l.href}>{l.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- 1. פתיח: תמונה בצד שמאל, טקסט בימין על הצללה ---------- */
  .h-hero {
    position: relative;
    overflow: hidden;
    background: var(--navy-deep);
    color: var(--on-dark);
  }
  .h-hero__media {
    position: relative;
    height: min(62vw, 20rem);
  }
  .h-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 25%;
  }
  .h-hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(7 17 31 / 0.15) 0%, rgb(7 17 31 / 0.1) 55%, var(--navy-deep) 100%);
  }
  .h-hero__inner {
    position: relative;
    padding-block: 0.5rem 2.5rem;
  }
  .h-hero__kicker {
    margin: 0 0 0.75rem;
    font-weight: 800;
    color: var(--gold-light);
  }
  .h-hero__title {
    margin: 0 0 1rem;
    color: var(--white);
    font-size: clamp(2rem, 5.2vw, 3.3rem);
    font-weight: 900;
    line-height: 1.15;
  }
  .h-hero__title .hl {
    display: block;
  }
  .h-hero__lead {
    max-width: 36rem;
    font-size: clamp(1.1rem, 2.2vw, 1.3rem);
    font-weight: 500;
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }
  /* מקדמים יחד: כל הנושאים כתגיות */
  .h-advance {
    margin-bottom: 1.75rem;
  }
  .h-advance__label {
    margin: 0 0 0.5rem;
    font-weight: 800;
    color: var(--white);
  }
  .h-advance__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .h-advance__list li {
    margin: 0;
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
    border: 1px solid rgb(252 220 109 / 0.45);
    background: rgb(252 220 109 / 0.08);
    color: var(--gold-light);
    font-weight: 700;
    font-size: 0.95rem;
    text-shadow: none;
  }
  .h-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  @media (min-width: 52rem) {
    .h-hero {
      display: flex;
      align-items: center;
      min-height: clamp(30rem, 74vh, 40rem);
    }
    .h-hero__media {
      position: absolute;
      top: 0;
      bottom: 0;
      left: 0;
      width: 60%;
      height: auto;
    }
    .h-hero__media::after {
      background:
        linear-gradient(to left, var(--navy-deep) 0%, rgb(7 17 31 / 0.7) 16%, rgb(7 17 31 / 0) 42%),
        linear-gradient(to right, rgb(7 17 31 / 0.85) 0%, rgb(7 17 31 / 0) 30%),
        linear-gradient(0deg, rgb(7 17 31 / 0.7) 0%, rgb(7 17 31 / 0) 28%),
        rgb(7 17 31 / 0.12);
    }
    .h-hero__inner {
      padding-block: 3.5rem;
    }
    .h-hero__text {
      max-width: min(38rem, 55vw);
      text-shadow: 0 2px 18px rgb(7 17 31 / 0.6);
    }
  }

  /* ---------- 2. שירותים ---------- */
  .h-services {
    padding-block: clamp(2.5rem, 6vw, 4rem);
  }

  /* ---------- 3. המלצות ---------- */
  .h-reviews__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-bottom: 0.5rem;
  }
  .h-more {
    font-weight: 800;
    color: var(--teal-dark);
  }

  /* ---------- 4. דווקא עכשיו: 6 מצבים על רקע כהה ---------- */
  .moments {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  @media (max-width: 62rem) {
    .moments {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 36rem) {
    .moments {
      grid-template-columns: 1fr;
    }
  }
  .moment {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0;
    padding: 1.25rem 1.35rem;
    border-radius: 1.25rem;
    background: linear-gradient(160deg, rgb(255 255 255 / 0.09), rgb(255 255 255 / 0.03));
    border: 1px solid rgb(255 255 255 / 0.14);
    transition:
      opacity 0.7s ease,
      transform 0.7s cubic-bezier(0.22, 0.61, 0.36, 1),
      border-color 0.3s ease;
  }
  .moment:hover {
    border-color: rgb(252 220 109 / 0.55);
  }
  .moment__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 3.2rem;
    height: 3.2rem;
    border-radius: 0.9rem;
    background: var(--gold-gradient);
    color: var(--navy);
  }
  .moment p {
    margin: 0;
    font-size: 1.08rem;
    font-weight: 700;
    line-height: 1.45;
    color: var(--white);
  }

  /* ---------- 5. בכל עסק הכסף נמצא במקום אחר + תהליך ---------- */
  .h-approach-sec {
    background: linear-gradient(180deg, var(--white), var(--mist));
  }
  .h-approach {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .h-approach .sec-lead {
    margin-bottom: 0.5rem;
  }
  .h-approach :global(.h-approach__toon) {
    flex: none;
    width: clamp(8rem, 18vw, 15rem);
  }
  @media (max-width: 40rem) {
    .h-approach {
      flex-direction: column;
      align-items: flex-start;
    }
    .h-approach :global(.h-approach__toon) {
      width: 9rem;
      align-self: flex-end;
    }
  }

  /* ---------- 6. עקרונות הליווי (כמו באודות) ---------- */
  .ways {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(3, 1fr);
  }
  @media (max-width: 62rem) {
    .ways {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 36rem) {
    .ways {
      grid-template-columns: 1fr;
    }
  }
  .way {
    margin: 0;
    padding: 1.6rem 1.5rem 1.5rem;
    border-radius: 1.25rem;
    background: linear-gradient(160deg, rgb(255 255 255 / 0.07), rgb(255 255 255 / 0.02));
    border: 1px solid rgb(255 255 255 / 0.1);
    transition:
      opacity 0.7s ease,
