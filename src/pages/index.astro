---
// עמוד הבית. הסדר שנוגה קבעה (2026-11-07, סבב 3):
//   פתיח ← סרט נע בטורקיז (כ-20 נושאים שמקדמים) ← שירותים בשורה אחת ← המלצות (רק על ליווי, צר, 6 בבת אחת, בלי כותרת)
//   ← עקרונות הליווי (עלו שני שלבים) ← תהליך הליווי (3 שלבים, "מה מקבלים" עם כוכבים) ← "מתי נכון לבוא לייעוץ עסקי" (ריבועים)
//   ← שאלון ← נעים להכיר ← סרטון הכנס ← קריאה לפעולה ← "כל מה שתמצאו באתר".
//   "בכל עסק הכסף נמצא במקום אחר" הוסר מהבית (נוגה). כל הכותרות ממורכזות.
// בלי גוף ראשון. הביקורת והציונים: drafts/critique-2026-11-07.md.
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import YouTubeEmbed from '../components/YouTubeEmbed.astro';
import MomentsReel from '../components/MomentsReel.astro';
import ServiceCards from '../components/ServiceCards.astro';
import QuoteMarquee from '../components/QuoteMarquee.astro';
import Ribbon from '../components/Ribbon.astro';
import Timeline from '../components/Timeline.astro';
import Icon from '../components/Icon.astro';
import { contact } from '../data/contact';
import { services, situations, steps } from '../data/services';
import { homeReviews } from '../data/reviews';
import { ways, icons } from '../data/principles';
import ContentCover from '../components/ContentCover.astro';
import Star from '../components/Star.astro';
import { quizYear, quizAreas } from '../data/quiz';
import { atmoStyle } from '../utils/atmo';
// תמונת הפתיח: התמונה החלופית שנוגה הכינה (2026-11-08, בלי השקעים), עם מסך המקרן מוכהה לכחול כהה.
// המקור: "חומרים גרפיים לאתר/תמונות לפתיח הבית 2026-11-07/noga-replacement-2026-11-08.webp"
import heroPhoto from '../assets/hero/stage-noga.jpg';
// "נעים להכיר": אחת משתי התמונות שנוגה שלחה (2026-11-07). השנייה (על הספסל) כבר בעמוד צור קשר.
import introPhoto from '../assets/hero/headshot.webp';
// תמונות אווירה (AI) ששלחה נוגה. הדמות המצוירת: רק במקומות מתאימים ובאזורים בהירים (רקע לבן).
import darkLines from '../assets/atmosphere/dark-lines.webp';
import darkStairs from '../assets/atmosphere/dark-stairs.webp';
// הדמות חתוכה מתחת לידיים (נוגה, 2026-11-08: "לחתוך את החלק של הרגליים")
// הדמות בלי רקע (שקופה), כדי שתעמוד על הרקע הכהה של השאלון
import pointing from '../assets/character/pointing-down-bust-clear.webp';
// כריכת סרטון הכנס (נוגה, 2026-11-08): נוגה על הבמה מגבה, מול כל הקהל. חתוכה בלי הכיסאות הריקים והתקרה.
import conferenceCover from '../assets/hero/conference-cover.jpg';
// כל התמונות מהכנסים, כמו באודות, וגם שלוש התמונות שבאודות יושבות ליד הסיפור (23, 08, 12)
const momentRows = [
  ['07', '14', '05', '23', '22', '18', '09', '21', '06', '17'],
  ['19', '13', '08', '10', '15', '20', '12', '03', '11', '16'],
];
const linesStyle = await atmoStyle(darkLines, 0.55);
const stairsStyle = await atmoStyle(darkStairs, 0.4);

// הסרט הנע: מה מקדמים יחד (נוגה, 2026-11-07: כ-20 מילים, בלי לחזור על אותן מילים, בלי הכיתוב "מקדמים יחד")
const advances = [
  'יעדים', 'מטרות', 'אסטרטגיה', 'שיווק', 'התייעלות', 'בינה מלאכותית', 'חדשנות', 'פרויקטים',
  'משימות', 'תהליכי עבודה', 'צוותים', 'מכירות', 'רווחיות', 'תמחור', 'תזרים', 'מנהיגות',
  'קבלת החלטות', 'שירות לקוחות', 'הצעות ערך', 'אוטומציות', 'שגרות ניהול', 'מהלכי צמיחה',
];

// המספרים שנוגה אישרה (SKILL.md סעיף 6א). עולים בספירה כשמגיעים אליהם.
const stats = [
  { num: 20, label: 'שנה בהנהלה של בנק גדול' },
  { num: 450, label: 'עסקים בליווי' },
  { num: 10, label: 'שנות ניסיון בייעוץ עסקי' },
];

// שורת מדריכים חינמיים בסוף העמוד (נוגה, 2026-11-08: במקום "כל מה שתמצאו באתר", שנראה כמו פוטר מיותר)
const guides = (await getCollection('guides'))
  .filter((g) => !g.data.comingSoon && g.data.type === 'guide')
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);---

<BaseLayout
  title="ייעוץ עסקי וארגוני"
  description="נוגה דיין אור: ייעוץ עסקי וארגוני להגדלת הכנסות ושיפור רווחיות באמצעות אסטרטגיה, שיווק ושיפור תהליכי עבודה עם בינה מלאכותית. ייעוץ עסקי, ייעוץ ארגוני, ייעול תהליכים עם AI, ליווי פיננסי והדרכות."
>
  <!-- 1. פתיח (נוגה, 2026-11-07): התמונה מימין, כך שהפנים פונות אל הטקסט; רואים גם את הדוכן.
       הכותרת ממורכזת, והפתיח לא תופס את כל המסך הראשון. "מקדמים יחד" עבר לסרט הנע שמתחת. -->
  <section class="h-hero">
    <div class="h-hero__media">
      <Image
        src={heroPhoto}
        alt="נוגה דיין אור מרצה על הבמה בכנס עסקים במקסימום"
        widths={[640, 1024, 1600, 2000]}
        sizes="(min-width: 52rem) 58vw, 100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="container h-hero__inner">
      <div class="h-hero__text">
        <p class="h-hero__kicker">נוגה דיין אור · ייעוץ עסקי וארגוני</p>
        <h1 class="h-hero__title">העולם משתנה בקצב מהיר{' '}<span class="hl">וזה הזמן של העסק שלך לגדול</span></h1>
        <p class="h-hero__lead">להגדיל הכנסות ולשפר רווחיות באמצעות אסטרטגיה, שיווק ושיפור תהליכי עבודה עם בינה מלאכותית.</p>
        <div class="h-hero__actions">
          <a class="btn" href={contact.booking} target="_blank" rel="noopener">לשיחת היכרות<span class="sr-only"> (נפתח בלשונית חדשה)</span></a>
          <a class="btn btn--ghost" href="/services/">לשירותים</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 1א. סרט נע בטורקיז: מה מקדמים יחד (השראה מהפס הנע של מאשה, בלי להעתיק; אופקי, עם הכוכב של נוגה) -->
  <Ribbon items={advances} tone="teal" />

  <!-- 1ב. פסקת פתיחה שמסבירה את הכותרת (נוגה, 2026-11-08, סבב 2). המסר של נוגה: חייבים לגדול, כל עסק מיוחד,
       ומתוך הקיים מוצאים את הדרך שלו להצלחה עסקית. הניסוח שלי מהמילים שלה, ממתין לאישור. בלי גוף ראשון.
       המשפט הראשון כולו בצבע אחד, כדי שלא תהיה שבירה באמצע שורה (נוגה). -->
  <section class="h-intro" aria-label="על הליווי">
    <div class="container">
      <p class="h-intro__lead reveal">העסק שלך חייב לגדול ולחשוב קדימה כל הזמן, במיוחד בתקופה שבה הטכנולוגיה משנה את העולם בקצב מסחרר.</p>
      <p class="h-intro__text reveal">כל עסק הוא שונה ומיוחד, עם מטרות, תהליכי עבודה, חוזקות ומשאבים משלו. לכן הליווי מתחיל בלמידה של המצב הקיים ושל מה שרוצים להשיג, ומתוך מה שכבר יש בעסק מוצאים את הדרך שלו להצלחה עסקית, להגדלת ההכנסות, לשיפור הרווחיות ולייעול העבודה בכלים חדשניים ומעודכנים.</p>
    </div>
  </section>

  <!-- 2. שש קוביות השירותים, בלי כותרת (נוגה). כותרת נסתרת רק לקוראי מסך. -->
  <section class="section h-services" aria-labelledby="services-title">
    <div class="container">
      <h2 id="services-title" class="sr-only">השירותים</h2>
      <ServiceCards variant="row" />
    </div>
  </section>

  <!-- 3. המלצות: רק על ליווי. שורה אחת של כרטיסים צרים שזזה לאט, "קרא עוד" והשם באותו גובה בכל הכרטיסים.
       הכותרת "לקוחות משתפים" והקישור לכל ההמלצות למעלה, כדי שהקישור לא ייתקע מעל הכותרת הבאה (נוגה, 2026-11-08). -->
  <section class="section section--mist h-reviews" aria-labelledby="reviews-title">
    <div class="container">
      <div class="h-head reveal">
        <h2 id="reviews-title" class="h-title">לקוחות <span class="hl--mark">משתפים</span></h2>
        <p class="h-sub"><a href="/testimonials/">לכל ההמלצות ←</a></p>
      </div>
    </div>
    <QuoteMarquee reviews={homeReviews} />
  </section>

  <!-- 3א. נעים להכיר: מיד אחרי "לקוחות משתפים" (נוגה, 2026-11-08). אזור בהיר, התמונה קטנה יותר כרקע בצד (נוגה מעדיפה תמונה כרקע ולא במסגרת,
       ו"לא באה לדגמן"). בלי 9.4 במספרים, בלי סוגריים ל-MBA, ובלי משפט המספרים שחזר על עצמו. -->
  <section class="h-meet">
    <div class="h-meet__media">
      <Image src={introPhoto} alt="נוגה דיין אור מחייכת" widths={[600]} sizes="(min-width: 52rem) 34vw, 100vw" />
    </div>
    <div class="container h-meet__inner">
      <div class="h-meet__text reveal">
        <h2 class="h-meet__hi">נעים להכיר, <span class="hl--mark">נוגה דיין אור</span></h2>
        <p class="h-meet__voice">חיה ונושמת פיתוח עסקים והגדלת הכנסות! אוהבת להיכנס לעסק, להכיר את האנשים, להבין איך דברים עובדים, לגלות הזדמנויות עסקיות, לחבר בין רעיונות, לעשות סדר ובעיקר לגרום לדברים טובים לקרות.</p>
        <p class="h-meet__cred">יועצת עסקית וארגונית להגדלת הכנסות ושיפור רווחיות, בעלת תואר שני במנהל עסקים.</p>
        <!-- מתוך המילים של נוגה (2026-11-08), בלי גוף ראשון ובלי שפה "קואצ'רית". הניסוח שלי, ממתין לאישור. -->
        <p class="h-meet__belief">כל עסק וכל בעל עסק הם מיוחדים, ולכן ייעוץ טוב לא מחלק מתכונים להצלחה. הוא מלטש את היהלום של כל עסק, כדי שיבלוט, יתחבר ללקוחות עם הצעות מדויקות ויפרוץ תקרות של הכנסות וצמיחה.</p>
        <ul class="stats">
          {
            stats.map((s) => (
              <li class="stat">
                <span class="stat__num" data-count={s.num}>{s.num}</span>
                <span class="stat__label">{s.label}</span>
              </li>
            ))
          }
        </ul>
        <p class="more"><a href="/about/">עוד על נוגה ←</a></p>
      </div>
    </div>
  </section>

  <!-- 4. שש הקוביות של עקרונות הליווי (src/data/principles.ts, משותף לאודות).
       הכותרת של נוגה (2026-11-08) מחליפה את "איך עובדים / עקרונות הליווי". שורת המשנה על "נוסחאות מוכנות" הוסרה, כי היא חוזרת על הכותרת. -->
  <section class="section section--deep atmo h-ways" style={stairsStyle}>
    <div class="container">
      <div class="h-head reveal">
        <h2 class="h-title h-title--split">הצלחה עסקית בדרך שלך{' '}<span class="hl">עם נוסחה מיוחדת משלך</span></h2>
      </div>
      <ul class="ways">
        {
          ways.map((w, i) => (
            <li class="way reveal" style={`transition-delay: ${(i % 3) * 0.1}s`}>
              <span class="way__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" set:html={icons[w.icon]} />
              </span>
              <h3>{w.title}</h3>
              <p>{w.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 5. תהליך הליווי: שלושה שלבים, ו"מה מקבלים" באותו גובה בכל שלב, עם הכוכב כתבליט (src/data/services.ts, steps) -->
  <section class="section h-process">
    <div class="container">
      <div class="h-head reveal">
        <h2 class="h-title">תהליך ליווי <span class="hl--mark">עסקי וארגוני</span></h2>
      </div>
      <Timeline items={steps} />
      <!-- משפט הסיום של נוגה (2026-11-08) -->
      <p class="h-goal reveal">תובנות, החלטות ופעולות פשוטות וישימות שמקדמות את העסק בכל פגישה.</p>
    </div>
  </section>

  <!-- 6. מתי נכון לבוא לייעוץ עסקי: 6 מצבים בריבועים בולטים (נוגה, 2026-11-07) -->
  <section class="section section--deep atmo h-when" style={linesStyle}>
    <div class="container">
      <div class="h-head reveal">
        <!-- הכותרת של נוגה (2026-11-08): הסיבות להתקדם דווקא עם נוגה, לא סיבות כלליות לייעוץ. הכרטיסים משלימים את המשפט ("כש...") -->
        <h2 class="h-title">מתקדמים <span class="hl">עם נוגה</span></h2>
      </div>
      <ul class="moments">
        {
          situations.map((m, i) => (
            <li class="moment reveal" style={`transition-delay: ${(i % 3) * 0.1}s`}>
              <span class="moment__icon" aria-hidden="true">
                <Icon name={m.icon} size={28} />
              </span>
              <p>{m.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 6א. סרטון הכנס וכל התמונות מהכנסים, מיד אחרי "מתקדמים עם נוגה" (נוגה, 2026-11-08).
       הכריכה: תמונה של נוגה מגבה מול כל הקהל, במקום התמונה של יוטיוב. הסרטון מופיע גם בעמוד ההדרכות. -->
  <section class="section h-stage">
    <div class="container">
      <div class="h-head reveal">
        <h2 class="h-title h-title--split">קצת מכנס העסקים{' '}<span class="hl--mark">שפתח את השנה</span></h2>
      </div>
      <div class="conference reveal">
        <YouTubeEmbed id="RJd6_sdT62U" title="נוגה דיין אור - כנס עסקים במקסימום">
          <span class="stage-cover">
            <Image src={conferenceCover} alt="" widths={[640, 960, 1300]} sizes="(min-width: 44rem) 40rem, 100vw" />
            <span class="stage-cover__play" aria-hidden="true"></span>
            <span class="stage-cover__label">עסקים במקסימום</span>
          </span>
        </YouTubeEmbed>
      </div>
    </div>
    <div class="h-moments">
      <MomentsReel rows={momentRows} />
    </div>
  </section>

  <!-- 7. השאלון: הדבר הכי מרשים באתר, כי הוא מביא לידים (נוגה, 2026-11-08). אזור כהה בכחול של האתר עם זוהר טורקיז וזהב,
       כרטיס עם מסגרת זוהרת, הדמות (בלי רקע) ממורכזת מעל הכותרת, וכפתור זהב גדול. בלי מספר שאלות (עשוי להשתנות).
       מספר המסלולים נלקח מהנתונים. הכותרת והמשפט הם הצעה שלי, ממתינים לאישור. -->
  <section class="h-quiz" aria-labelledby="quiz-title">
    <div class="container">
      <div class="h-quiz__card">
        <Image src={pointing} alt="" widths={[260, 420]} sizes="13rem" class="h-quiz__toon" />
        <p class="h-quiz__tag reveal"><Star size={16} /> שאלון חינמי</p>
        <h2 id="quiz-title" class="h-quiz__title h-title--split reveal">כמה העסק שלך מוכן{' '}<span class="hl">לקפיצה הבאה?</span></h2>
        <p class="h-quiz__text reveal">שאלון קצר ב-{quizAreas.length} מסלולים שבודק את העסק, ומראה איפה הוא חזק, איפה כדאי להתמקד ומה הצעדים הבאים לשנת {quizYear}.</p>
        <a class="h-quiz__btn reveal" href="/guides/business-focus-quiz/">לבדיקת העסק שלך <span aria-hidden="true">←</span></a>
      </div>
    </div>
  </section>

  <CtaBand />

  <!-- 10. מדריכים חינמיים: שורה אחת והפניה למרכז הידע, ובסוף משפט סיום, ואז הפוטר (נוגה, 2026-11-08).
       במקום "כל מה שתמצאו באתר". -->
  <section class="section h-guides" aria-labelledby="guides-title">
    <div class="container">
      <div class="h-head reveal">
        <h2 id="guides-title" class="h-title">מדריכים <span class="hl--mark">חינמיים</span></h2>
        <p class="h-sub"><a href="/guides/">לכל המדריכים וההרצאות במרכז הידע ←</a></p>
      </div>
      <ul class="guides-row">
        {
          guides.map((g, i) => (
            <li class="guide-card reveal" style={`transition-delay: ${i * 0.08}s`}>
              <a href={`/guides/${g.id}/`}>
                <ContentCover title={g.data.coverTitle ?? g.data.title} motif={g.data.coverMotif} star={g.data.coverStar} kind="guide" />
                <span class="guide-card__title">{g.data.title}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- משפט הסיום: הסיסמה שחותמת כל פוסט של נוגה, באותו גופן של האתר ומודגשת (לא בכתב יד) -->
  <section class="h-sign" aria-label="סיום">
    <p class="h-sign__motto reveal">קמים ונהיים ענקיים מהחיים <Star size={26} /></p>
  </section>
</BaseLayout>

<style>
  /* ---------- 1. פתיח: התמונה בצד ימין (נוגה פונה אל הטקסט), הטקסט ממורכז משמאל ---------- */
  .h-hero {
    position: relative;
    overflow: hidden;
