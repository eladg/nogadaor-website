                  <path fill="url(#g1a)" stroke="url(#r1a)" stroke-width="2.5" d="M84 90h220a44 44 0 0 1 44 44v104a44 44 0 0 1-44 44H178l-58 48v-48H84a44 44 0 0 1-44-44V134a44 44 0 0 1 44-44Z"></path>
