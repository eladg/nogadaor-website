---
// עמוד עבודה זמני: סבב 2 של כריכות (2026-11-06).
// נוגה אהבה הכי הרבה את גרסה א' מהסבב הקודם ("אופק עתידני"), "אבל לא עד הסוף", וביקשה עוד אפשרויות:
// בלי לוגו, בלי מספור ובלי תמונה שלה. בכריכה רק ויזואל ושם מעניין. מתחת לכריכה זמן קריאה.
// השראה (לא להעתיק!): עמוד המגזין של masha-bar.co.il. מה שלקחנו כרעיון: כריכה בלי מיתוג, שורת סוג וזמן קריאה,
// פריסה מדורגת שמושכת לגלול, הופעה בהדרגה, ועיצוב שונה לכל סוג תוכן באותה שפה.
// הסבב הקודם (עם הלוגו והתמונות) נמצא בהיסטוריית Git (commit cc79745).
// TODO: למחוק את העמוד הזה לפני שהאתר עולה לאוויר. הוא לא מקושר מהתפריט.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import Star from '../components/Star.astro';

// שלושת התכנים שמשמשים לדוגמה. "כותרת כריכה" היא גרסה קצרה של השם, למשיכת העין. שתי הראשונות הן הצעה שלי.
const items = [
  { type: 'מדריך', time: "7 דק' קריאה", full: 'איך לגרום ל-AI להמליץ על העסק שלך?' },
  { type: 'מאמר', time: "4 דק' קריאה", full: 'השיווק האורגני דורש היום יותר מנהיגות עסקית' },
  { type: 'הרצאה', time: "54 דק' צפייה", full: 'עסק מקצועי הוא עסק מעוצב' },
];

// אפשרות 3: קווי אור שנוצרים בקוד (בלי אקראיות, כדי שכל בנייה תיראה אותו דבר)
function converge(fx: number, fy: number, n: number) {
  return Array.from({ length: n }, (_, i) => {
    const y0 = 20 + (i * 360) / (n - 1);
    const c1x = 120 + ((i * 37) % 60);
    const c2y = fy + (y0 - fy) * 0.25;
    return `M-10 ${y0.toFixed(1)} C${c1x} ${y0.toFixed(1)} ${fx - 90} ${c2y.toFixed(1)} ${fx} ${fy}`;
  });
}
function rising(n: number) {
  return Array.from({ length: n }, (_, i) => {
    const x0 = -10 + i * 22;
    const lift = 40 + i * 14;
    return `M${x0} 410 C${x0 + 60} ${360 - lift} ${x0 + 150} ${300 - lift * 1.4} ${330 + i * 4} ${70 - i * 3}`;
  });
}
const linesAi = converge(300, 170, 16);
const linesArt = rising(12);
const ringsLec = [40, 70, 100, 130, 160, 190];
---

