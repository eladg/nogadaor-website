---
// עמוד עבודה זמני (2026-11-06): שלושה סגנונות לכריכות של מדריכים, מאמרים והרצאות, שלוש דוגמאות בכל סגנון.
// נוגה תבחר סגנון, ואחריו נבנה ממנו רכיב כריכה אחד ל-10 התכנים.
// TODO: למחוק את העמוד הזה לפני שהאתר עולה לאוויר. הוא לא מקושר מהתפריט.
// בכל הסגנונות אותם שלושה תכנים, כדי שיהיה קל להשוות. הכריכות בפורמט 16:9, כמו תמונה ביוטיוב.
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import lookingAhead from '../assets/about/gallery/17-looking-ahead.jpg';
import podium from '../assets/about/gallery/05-podium-smile.jpg';
import bench from '../assets/about/gallery/03-bench-portrait.jpg';
import stageSlide from '../assets/about/gallery/13-stage-slide.jpg';
import leadershipSlide from '../assets/about/gallery/18-leadership-slide.jpg';

const play = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z"/></svg>';
---

<BaseLayout title="כריכות: 3 סגנונות לבחירה" description="עמוד עבודה: השוואה בין שלושה סגנונות כריכה.">
  <PageHeader title="כריכות למדריכים: 3 סגנונות לבחירה">
    <p>
      בכל סגנון אותם שלושה תכנים: מדריך, מאמר והרצאה ביוטיוב, כדי שיהיה קל להשוות. בוחרים סגנון אחד, ואחר כך
      נייצר ממנו כריכה לכל אחד מעשרת התכנים.
    </p>
  </PageHeader>

  <!-- ============ גרסה א: אופק עתידני ============ -->
  <section class="section">
    <div class="wide">
      <div class="v-head">
        <span class="v-tag">גרסה א'</span>
        <h2>אופק עתידני</h2>
        <p>
          כחול כהה עם הילות של טורקיז וזהב, רשת שנמתחת לאופק וסמל זוהר שמתאים לנושא של כל תוכן. נראה הכי טכנולוגי
          וחדשני, וממשיך את האזורים הכהים שאת אוהבת באתר.
        </p>
      </div>
      <div class="v-grid">
        <!-- א1: מדריך -->
        <figure class="cw">
          <div class="cv a">
            <span class="a__floor"></span>
            <span class="a__corner a__corner--tr"></span><span class="a__corner a__corner--tl"></span>
            <span class="a__corner a__corner--br"></span><span class="a__corner a__corner--bl"></span>
            <div class="a__text">
              <span class="a__kicker">מדריך · 02</span>
              <p class="a__title">איך לגרום <span class="nw">ל-<em>AI</em></span> להמליץ על העסק שלך?</p>
              <p class="a__sub">נראות ברשת שעוזרת ללקוחות, וגם לכלי AI, להבין אתכם מהר</p>
              <img class="a__logo" src="/images/logo-white-trim.webp" alt="" width="900" height="312" />
            </div>
            <svg class="a__visual" viewBox="0 0 200 200" aria-hidden="true">
              <g fill="none" stroke="currentColor">
                <ellipse cx="100" cy="100" rx="92" ry="32" transform="rotate(-24 100 100)" opacity=".55" />
                <ellipse cx="100" cy="100" rx="92" ry="32" transform="rotate(36 100 100)" opacity=".35" />
                <circle cx="100" cy="100" r="64" stroke-dasharray="2 6" opacity=".8" />
              </g>
              <g fill="currentColor">
                <circle cx="22" cy="132" r="4" /><circle cx="176" cy="66" r="3" /><circle cx="150" cy="168" r="4.5" />
                <circle cx="48" cy="34" r="3" /><circle cx="164" cy="132" r="2.5" />
              </g>
              <circle cx="58" cy="52" r="5" fill="#fcdc6d" />
              <path
                d="M66 72h68a12 12 0 0 1 12 12v30a12 12 0 0 1-12 12H96l-16 14v-14H66a12 12 0 0 1-12-12V84a12 12 0 0 1 12-12Z"
                fill="rgb(11 26 51 / .7)"
                stroke="currentColor"
                stroke-width="2"></path>
              <text x="100" y="108" text-anchor="middle" font-size="26" font-weight="800" fill="#fff" font-family="Heebo Variable, sans-serif">AI</text>
            </svg>
          </div>
          <figcaption>מדריך</figcaption>
        </figure>

        <!-- א2: מאמר -->
        <figure class="cw">
          <div class="cv a a--article">
            <span class="a__floor"></span>
            <span class="a__corner a__corner--tr"></span><span class="a__corner a__corner--tl"></span>
            <span class="a__corner a__corner--br"></span><span class="a__corner a__corner--bl"></span>
            <div class="a__text">
              <span class="a__kicker">מאמר · BizFinder</span>
              <p class="a__title">השיווק האורגני דורש היום יותר <em>מנהיגות עסקית</em></p>
              <p class="a__sub">הדרך לבלוט מעל הרעש אינה לרדוף אחרי האלגוריתם</p>
              <img class="a__logo" src="/images/logo-white-trim.webp" alt="" width="900" height="312" />
            </div>
            <svg class="a__visual" viewBox="0 0 200 200" aria-hidden="true">
              <g stroke="currentColor" opacity=".25" stroke-width="10">
                <line x1="30" y1="180" x2="30" y2="150" /><line x1="62" y1="180" x2="62" y2="132" />
                <line x1="94" y1="180" x2="94" y2="140" /><line x1="126" y1="180" x2="126" y2="104" />
              </g>
              <polyline points="20,150 58,122 92,132 128,90 168,48" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round" stroke-linecap="round" />
              <g fill="currentColor"><circle cx="58" cy="122" r="4" /><circle cx="92" cy="132" r="4" /><circle cx="128" cy="90" r="4" /></g>
              <g fill="none" stroke="#fcdc6d">
                <circle cx="168" cy="48" r="14" opacity=".7" /><circle cx="168" cy="48" r="26" opacity=".4" /><circle cx="168" cy="48" r="40" opacity=".2" />
              </g>
              <circle cx="168" cy="48" r="7" fill="#fcdc6d" />
            </svg>
          </div>
          <figcaption>מאמר</figcaption>
        </figure>

        <!-- א3: הרצאה ביוטיוב -->
        <figure class="cw">
          <div class="cv a a--video">
            <span class="a__floor"></span>
            <span class="a__corner a__corner--tr"></span><span class="a__corner a__corner--tl"></span>
            <span class="a__corner a__corner--br"></span><span class="a__corner a__corner--bl"></span>
            <div class="a__text">
              <span class="a__kicker">הרצאה מלאה · צפייה חינם</span>
              <p class="a__title">עסק מקצועי הוא <em>עסק מעוצב</em></p>
              <p class="a__sub">הדרכה חינמית מתוך הערוץ שלי ביוטיוב</p>
              <img class="a__logo" src="/images/logo-white-trim.webp" alt="" width="900" height="312" />
            </div>
            <div class="a__lens">
              <Image src={bench} alt="" widths={[300, 500]} sizes="20vw" class="a__photo" />
              <span class="play play--gold" set:html={play} />
            </div>
          </div>
          <figcaption>הרצאה ביוטיוב</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- ============ גרסה ב: דוח מנהלים ============ -->
  <section class="section section--mist">
    <div class="wide">
      <div class="v-head">
        <span class="v-tag">גרסה ב'</span>
        <h2>דוח מנהלים</h2>
        <p>
          לבן ונקי, כותרת גדולה וחזקה, קווי זהב דקים ופאנל כחול עם מספר התוכן. נראה כמו פרסום רשמי של חברת ייעוץ:
          הכי עסקי ורציני, פחות "וואו".
        </p>
      </div>
      <div class="v-grid">
        <!-- ב1: מדריך -->
        <figure class="cw">
          <div class="cv b">
            <div class="b__text">
              <div class="b__top"><img src="/images/logo-color-trim.webp" alt="" width="900" height="313" /><span>מדריכים לעסקים</span></div>
              <span class="b__chip">מדריך מעשי</span>
              <p class="b__title">איך לגרום <span class="nw">ל-<em>AI</em></span> להמליץ על העסק שלך?</p>
              <span class="b__bar"></span>
              <p class="b__meta">כולל פרומפטים להעתקה · נוגה דיין אור</p>
            </div>
            <div class="b__panel">
              <span class="b__num">02</span>
              <span class="b__icon"><Icon name="robot" size={64} /></span>
            </div>
          </div>
          <figcaption>מדריך</figcaption>
        </figure>

        <!-- ב2: מאמר -->
        <figure class="cw">
          <div class="cv b b--article">
            <div class="b__text">
              <div class="b__top"><img src="/images/logo-color-trim.webp" alt="" width="900" height="313" /><span>מאמרים</span></div>
              <span class="b__chip">מאמר דעה</span>
              <p class="b__title">השיווק האורגני דורש היום יותר <em>מנהיגות עסקית</em></p>
              <span class="b__bar"></span>
              <p class="b__meta">פורסם במגזין BizFinder · נוגה דיין אור</p>
            </div>
            <div class="b__panel">
              <span class="b__num">01</span>
              <span class="b__icon"><Icon name="crown" size={64} /></span>
            </div>
          </div>
          <figcaption>מאמר</figcaption>
        </figure>

        <!-- ב3: הרצאה -->
        <figure class="cw">
          <div class="cv b b--video">
            <div class="b__text">
              <div class="b__top"><img src="/images/logo-color-trim.webp" alt="" width="900" height="313" /><span>הרצאות</span></div>
              <span class="b__chip">הרצאה מלאה</span>
              <p class="b__title">עסק מקצועי הוא <em>עסק מעוצב</em></p>
              <span class="b__bar"></span>
              <p class="b__meta">צפייה חינם ביוטיוב · נוגה דיין אור</p>
            </div>
            <div class="b__panel b__panel--photo">
              <Image src={leadershipSlide} alt="" widths={[400, 700]} sizes="20vw" class="b__photo" />
              <span class="play play--navy" set:html={play} />
            </div>
          </div>
          <figcaption>הרצאה ביוטיוב</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- ============ גרסה ג: במה אישית ============ -->
  <section class="section">
    <div class="wide">
      <div class="v-head">
        <span class="v-tag">גרסה ג'</span>
        <h2>במה אישית</h2>
        <p>
          הכחול שלך במלוא העוצמה, תמונה שלך בקשת עם מסגרת זהב, ובועות אייקונים שמספרות על הנושא. הכי חם ואישי, ומתכתב
          עם הקשת והבועות בעמוד צור קשר. מתאים במיוחד לסרטונים, וצריך תמונה שונה לכל תוכן.
        </p>
      </div>
      <div class="v-grid">
        <!-- ג1: מדריך -->
        <figure class="cw">
          <div class="cv c">
            <div class="c__text">
              <span class="c__pill">מדריך</span>
              <p class="c__title">איך לגרום <span class="nw">ל-<em>AI</em></span> להמליץ על העסק שלך?</p>
              <p class="c__sub">נראות ברשת שעוזרת ללקוחות, וגם לכלי AI, להבין אתכם מהר</p>
              <img class="c__logo" src="/images/logo-white-trim.webp" alt="" width="900" height="312" />
            </div>
            <div class="c__stage">
              <span class="c__ring"></span>
              <div class="c__arch"><Image src={lookingAhead} alt="" widths={[300, 500]} sizes="20vw" class="c__photo" style="object-position: 52% 30%" /></div>
              <span class="c__bubble c__bubble--1"><Icon name="robot" size={28} /></span>
              <span class="c__bubble c__bubble--2"><Icon name="chat" size={28} /></span>
              <span class="c__bubble c__bubble--3"><Icon name="search" size={28} /></span>
            </div>
          </div>
          <figcaption>מדריך</figcaption>
        </figure>

        <!-- ג2: מאמר -->
        <figure class="cw">
          <div class="cv c c--article">
            <div class="c__text">
              <span class="c__pill">מאמר</span>
              <p class="c__title">השיווק האורגני דורש היום יותר <em>מנהיגות עסקית</em></p>
              <p class="c__sub">הדרך לבלוט מעל הרעש אינה לרדוף אחרי האלגוריתם</p>
              <img class="c__logo" src="/images/logo-white-trim.webp" alt="" width="900" height="312" />
            </div>
            <div class="c__stage">
              <span class="c__ring"></span>
              <div class="c__arch"><Image src={podium} alt="" widths={[300, 500]} sizes="20vw" class="c__photo" style="object-position: 45% 15%" /></div>
              <span class="c__bubble c__bubble--1"><Icon name="crown" size={28} /></span>
              <span class="c__bubble c__bubble--2"><Icon name="megaphone" size={28} /></span>
              <span class="c__bubble c__bubble--3"><Icon name="chart" size={28} /></span>
            </div>
          </div>
          <figcaption>מאמר</figcaption>
        </figure>

        <!-- ג3: הרצאה -->
        <figure class="cw">
          <div class="cv c c--video">
            <div class="c__text">
              <span class="c__pill">הרצאה · צפייה חינם</span>
              <p class="c__title">עסק מקצועי הוא <em>עסק מעוצב</em></p>
              <p class="c__sub">הדרכה חינמית מתוך הערוץ שלי ביוטיוב</p>
              <img class="c__logo" src="/images/logo-white-trim.webp" alt="" width="900" height="312" />
            </div>
            <div class="c__stage">
              <span class="c__ring"></span>
              <div class="c__arch"><Image src={stageSlide} alt="" widths={[300, 500]} sizes="20vw" class="c__photo" style="object-position: 22% 40%" /></div>
              <span class="c__bubble c__bubble--1"><Icon name="layers" size={28} /></span>
              <span class="c__bubble c__bubble--2"><Icon name="star" size={28} /></span>
              <span class="play play--gold c__play" set:html={play} />
            </div>
          </div>
          <figcaption>הרצאה ביוטיוב</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="section section--mist">
    <div class="container notes">
      <h2>ושתי השאלות שלך</h2>
      <div class="notes__grid">
        <div class="note">
          <h3>מדריך ומאמר: עיצוב שונה?</h3>
          <p>
            ההמלצה שלי: אותו סגנון לשניהם, כדי שהכול ייראה כמו משפחה אחת, עם הבדל קטן שמראה מה סוג התוכן. בדוגמאות
            למעלה יש לכל סוג תווית משלו (מדריך / מאמר / הרצאה), ובכל גרסה יש גם הבדל קטן בצבע או בסמל.
          </p>
        </div>
        <div class="note">
          <h3>כריכה מעל סרטוני יוטיוב?</h3>
          <p>
            כן. באתר, הכריכה שלנו יכולה להופיע במקום התמונה של יוטיוב, והסרטון נטען רק כשלוחצים עליה (ככה זה כבר
            בנוי). אפשר גם לשמור את הכריכה כתמונה בגודל של יוטיוב ולהעלות אותה כתמונה ממוזערת בערוץ עצמו, ואז גם שם
            הכול ייראה אחיד.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .wide {
    width: min(100% - 2rem, 92rem);
    margin-inline: auto;
  }
  .v-head {
    max-width: 48rem;
    margin-bottom: 1.75rem;
  }
  .v-head p {
    margin: 0;
  }
  .v-head h2 {
    margin-bottom: 0.4em;
  }
  .v-tag {
    display: inline-block;
    margin-bottom: 0.5rem;
    padding: 0.15rem 0.8rem;
    border-radius: 999px;
    background: var(--gold-gradient);
    color: var(--navy);
    font-size: 0.9rem;
    font-weight: 800;
  }
  .v-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 25rem), 1fr));
    gap: 1.5rem;
  }
  figure {
    margin: 0;
  }
  figcaption {
    margin-top: 0.5rem;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--teal-dark);
  }
  .notes__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 1.25rem;
  }
  .note {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.25rem 1.5rem;
  }
  .note p {
    margin: 0;
  }

  /* ---------- משותף לכל הכריכות ---------- */
  .cw {
    container-type: inline-size;
  }
  .cv {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    isolation: isolate;
    border-radius: 2.4cqi;
    box-shadow: 0 1.5cqi 4cqi -2cqi rgb(7 17 31 / 0.45);
  }
  .cv p {
    margin: 0;
  }
  .cv em {
    font-style: normal;
  }
  .nw {
    white-space: nowrap;
  }
  .play {
    display: grid;
    place-items: center;
    width: 9cqi;
    aspect-ratio: 1;
    border-radius: 50%;
  }
  .play :global(svg) {
    width: 48%;
    fill: currentColor;
    translate: 6% 0;
  }
  .play--gold {
    background: var(--gold-gradient);
    color: var(--navy);
    box-shadow: 0 0 0 1cqi rgb(252 220 109 / 0.25);
  }
  .play--navy {
    background: var(--navy);
    color: var(--gold-light);
    box-shadow: 0 0 0 1cqi rgb(255 255 255 / 0.35);
  }

  /* ---------- גרסה א: אופק עתידני ---------- */
  .a {
    color: var(--on-dark);
    background:
      radial-gradient(50% 70% at 20% 42%, rgb(25 154 181 / 0.5), transparent 70%),
      radial-gradient(30% 40% at 6% 96%, rgb(209 154 74 / 0.4), transparent 70%),
      linear-gradient(150deg, #07111f 0%, #0b1a33 55%, #0f2d50 100%);
  }
  .a--article {
    background:
      radial-gradient(50% 70% at 20% 42%, rgb(209 154 74 / 0.38), transparent 70%),
      radial-gradient(30% 40% at 6% 96%, rgb(25 154 181 / 0.45), transparent 70%),
      linear-gradient(150deg, #07111f 0%, #0b1a33 55%, #0f2d50 100%);
  }
  .a__floor {
    position: absolute;
    z-index: -1;
    inset-inline: -30%;
    bottom: -4%;
    height: 52%;
    background-image:
      linear-gradient(rgb(127 211 230 / 0.3) 1px, transparent 1px),
      linear-gradient(90deg, rgb(127 211 230 / 0.3) 1px, transparent 1px);
    background-size: 5cqi 5cqi;
    transform: perspective(28cqi) rotateX(64deg);
    transform-origin: 50% 100%;
    mask-image: linear-gradient(to top, #000 5%, transparent 80%);
  }
  .a__corner {
    position: absolute;
    width: 3.5cqi;
    height: 3.5cqi;
    border: 0 solid rgb(127 211 230 / 0.65);
  }
  .a__corner--tr {
    top: 3cqi;
    right: 3cqi;
    border-top-width: 2px;
    border-right-width: 2px;
  }
  .a__corner--tl {
    top: 3cqi;
    left: 3cqi;
    border-top-width: 2px;
    border-left-width: 2px;
  }
  .a__corner--br {
    bottom: 3cqi;
    right: 3cqi;
    border-bottom-width: 2px;
    border-right-width: 2px;
  }
  .a__corner--bl {
    bottom: 3cqi;
    left: 3cqi;
    border-bottom-width: 2px;
    border-left-width: 2px;
  }
  .a__text {
    position: absolute;
    inset-block: 0;
    right: 0;
    width: 58%;
    padding: 6cqi 7cqi 6cqi 1cqi;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 1.8cqi;
  }
  .a__kicker {
    display: inline-flex;
    align-items: center;
    gap: 1.2cqi;
    font-size: 2cqi;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: #8fdcec;
  }
  .a__kicker::before {
    content: '';
    width: 1.1cqi;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #8fdcec;
    box-shadow: 0 0 1.4cqi #8fdcec;
