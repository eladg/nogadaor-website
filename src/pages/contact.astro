---
// עמוד צור קשר (2026-11-05): בהשראת meitalchesner.co.il/contact (פתיח עם תמונה, טופס פנייה,
// הזמנה לקבוצת הוואטסאפ), בעיצוב ובצבעים של האתר.
// הטפסים מעוצבים בלבד ועדיין לא מחוברים לשום שירות. TODO: לחבר שירות טפסים ושירות דיוור.
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { contact, socials } from '../data/contact';
import nogaPodium from '../assets/about/gallery/05-podium-smile.jpg';

const waIcon =
  '<path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.4.8 3.2.7.5-.1 1.5-.6 1.8-1.2.2-.6.2-1.1.1-1.2l-.5-.3Z"/>';
---

<BaseLayout title="צור קשר" description="דברו איתי בוואטסאפ, בטלפון או באימייל, או השאירו פרטים ואחזור אליכם.">
  <!-- 1. פתיח: טקסט ולצדו תמונה -->
  <section class="c-hero">
    <div class="container c-hero__grid">
      <div class="c-hero__text">
        <h1>צור <span class="hl--mark">קשר</span></h1>
        <!-- הנוסח לקוח מהדף שנוגה בנתה ב-Canva -->
        <p class="c-hero__lead">
          מרגישים שיש בעסק פוטנציאל שלא מתממש עד הסוף? ביחד הרבה יותר קל לדייק, להחליט ולהניע מהלכים.
        </p>
        <p class="c-hero__hint">מתלבטים? משהו לא ברור? דברו איתי באהבה!</p>
        <div class="c-hero__actions">
          <a class="btn c-btn" href={contact.whatsapp} target="_blank" rel="noopener">
            <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" set:html={waIcon} />
            לשיחת וואטסאפ<span class="sr-only"> (נפתח בלשונית חדשה)</span>
          </a>
          <a class="c-link" href={contact.phoneHref} dir="ltr">{contact.phoneDisplay}</a>
          <a class="c-link" href={`mailto:${contact.email}`} dir="ltr">{contact.email}</a>
        </div>
      </div>
      <div class="c-hero__photo">
        <Image src={nogaPodium} alt="נוגה דיין אור מחייכת ליד הדוכן על הבמה" widths={[500, 800, 1100]} sizes="(min-width: 52rem) 30vw, 80vw" loading="eager" />
      </div>
    </div>
  </section>

  <!-- 2. טופס פנייה, ולצדו פרטי קשר ורשתות -->
  <section class="section">
    <div class="container c-main">
      <!-- TODO: לחבר את הטופס לשירות טפסים (Formspree / Netlify Forms וכד'). כרגע הוא לא שולח דבר. -->
      <form class="c-form js-demo-form" method="post" novalidate aria-labelledby="form-title">
        <h2 id="form-title" class="c-title">השאירו <span class="hl--mark">פרטים</span></h2>
        <p class="c-form__note">ואחזור אליכם בהקדם</p>
        <div class="c-form__row">
          <label>
            <span>שם מלא</span>
            <input type="text" name="name" autocomplete="name" required />
          </label>
          <label>
            <span>טלפון</span>
            <input type="tel" name="phone" autocomplete="tel" dir="ltr" required />
          </label>
        </div>
        <label>
          <span>אימייל</span>
          <input type="email" name="email" autocomplete="email" dir="ltr" />
        </label>
        <label>
          <span>במה אפשר לעזור?</span>
          <textarea name="message" rows="4"></textarea>
        </label>
        <button class="btn" type="submit">שליחה</button>
        <p class="c-form__status" role="status" aria-live="polite"></p>
      </form>

      <aside class="c-details" aria-labelledby="details-title">
        <h2 id="details-title" class="c-details__title">או ישירות</h2>
        <ul class="c-details__list">
          <li>
            <span class="c-details__label">וואטסאפ</span>
            <a href={contact.whatsapp} target="_blank" rel="noopener" dir="ltr">{contact.phoneDisplay}<span class="sr-only"> (נפתח בלשונית חדשה)</span></a>
          </li>
          <li>
            <span class="c-details__label">טלפון</span>
            <a href={contact.phoneHref} dir="ltr">{contact.phoneDisplay}</a>
          </li>
          <li>
            <span class="c-details__label">אימייל</span>
            <a href={`mailto:${contact.email}`} dir="ltr">{contact.email}</a>
          </li>
        </ul>
        <h3 class="c-details__sub">אפשר למצוא אותי גם כאן</h3>
        <ul class="c-socials">
          {
            socials.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener">
                  {s.name}
                  <span class="sr-only"> (נפתח בלשונית חדשה)</span>
                </a>
              </li>
            ))
          }
        </ul>
      </aside>
    </div>
  </section>

  <!-- 3. להישאר בקשר: קבוצת הוואטסאפ והרשמה לתכנים במייל -->
  <section class="c-stay">
    <div class="container c-stay__grid">
      <article class="c-card">
        <span class="c-card__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" set:html={waIcon} />
        </span>
        <h2 class="c-card__title">לקבוצת הוואטסאפ <span class="hl">"תודעה עסקית מנצחת"</span></h2>
        <!-- הנוסח מעמוד האודות (של נוגה) -->
        <p>קהילה של מאות בעלי עסקים, שמביאה עוצמה, אנרגיה ומוטיבציה לעשייה עסקית ולניהול נכון של התודעה.</p>
        <a class="btn" href={contact.whatsappGroup} target="_blank" rel="noopener">
          להצטרפות לקבוצה<span class="sr-only"> (נפתח בלשונית חדשה)</span>
        </a>
      </article>

      <!-- TODO: לחבר לשירות דיוור (רשימת תפוצה). כרגע הטופס לא שולח דבר. -->
      <article class="c-card">
        <span class="c-card__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
        </span>
        <h2 id="news-title" class="c-card__title">הרשמה <span class="hl">לתכנים במייל</span></h2>
        <form class="c-news js-demo-form" method="post" novalidate aria-labelledby="news-title">
          <label>
            <span class="sr-only">שם</span>
            <input type="text" name="name" autocomplete="name" placeholder="שם" />
          </label>
          <label>
            <span class="sr-only">אימייל</span>
            <input type="email" name="email" autocomplete="email" placeholder="אימייל" dir="ltr" required />
          </label>
          <!-- TODO: נוסח ההסכמה לקבלת דיוור לבדוק עם איש מקצוע -->
          <label class="c-news__consent">
            <input type="checkbox" name="consent" required />
            <span>אני מאשר/ת לקבל תכנים ועדכונים במייל</span>
          </label>
          <button class="btn" type="submit">להרשמה</button>
          <p class="c-form__status" role="status" aria-live="polite"></p>
        </form>
      </article>
    </div>
  </section>
</BaseLayout>

<!-- הטפסים עוד לא מחוברים: במקום לשלוח, מוצגת הודעה. TODO: להסיר כשמחברים שירות טפסים -->
<script is:inline>
  document.querySelectorAll('.js-demo-form').forEach(function (form) {
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var status = form.querySelector('.c-form__status');
      if (status) status.textContent = 'הטופס עוד לא מחובר. בינתיים אפשר לכתוב לי בוואטסאפ.';
    });
  });
</script>

<style>
  /* ---------- 1. פתיח ---------- */
  .c-hero {
    padding-block: clamp(2.25rem, 6vw, 4rem);
    background:
      radial-gradient(34rem 20rem at 90% 10%, rgb(29 157 160 / 0.14), transparent 70%),
      radial-gradient(30rem 20rem at 5% 90%, rgb(252 220 109 / 0.22), transparent 70%),
      var(--mist);
    border-bottom: 1px solid var(--line);
  }
  .c-hero__grid {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  @media (min-width: 52rem) {
    .c-hero__grid {
      grid-template-columns: 1.4fr 1fr;
      gap: 4rem;
    }
  }
  .c-hero h1 {
    font-size: clamp(2.4rem, 7vw, 3.8rem);
    font-weight: 900;
    margin-bottom: 0.6rem;
  }
  .c-hero__lead {
    font-size: clamp(1.15rem, 2.4vw, 1.4rem);
    line-height: 1.65;
    max-width: 34rem;
  }
  .c-hero__hint {
    font-weight: 800;
    color: var(--teal-dark);
  }
  .c-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: 1.5rem;
  }
  .c-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }
  .c-link {
    font-weight: 700;
  }
  .c-hero__photo {
    position: relative;
    width: min(100%, 20rem);
    margin-inline: auto;
  }
  /* מסגרת זהב מוזזת מאחורי התמונה */
  .c-hero__photo::before {
    content: '';
    position: absolute;
    inset: 1rem -1rem -1rem 1rem;
    border: 2px solid var(--gold-dark);
    border-radius: 1.5rem;
  }
  .c-hero__photo :global(img) {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 1.5rem;
    box-shadow: 0 30px 60px -32px rgb(11 26 51 / 0.55);
  }

  /* ---------- 2. טופס ופרטים ---------- */
  .c-main {
    display: grid;
    gap: 2rem;
    align-items: start;
  }
  @media (min-width: 52rem) {
    .c-main {
      grid-template-columns: 1.5fr 1fr;
      gap: 3rem;
    }
  }
  .c-title {
    font-size: clamp(1.7rem, 4vw, 2.3rem);
    font-weight: 900;
    margin-bottom: 0.2rem;
  }
  .c-form {
    display: grid;
    gap: 1rem;
    padding: clamp(1.5rem, 4vw, 2.25rem);
    border-radius: 1.5rem;
    background: var(--white);
    border: 1px solid var(--line);
    box-shadow: 0 30px 60px -40px rgb(11 26 51 / 0.45);
  }
  .c-form__note {
    margin: 0 0 0.5rem;
    color: var(--teal-dark);
    font-weight: 600;
  }
  .c-form__row {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 36rem) {
    .c-form__row {
      grid-template-columns: 1fr 1fr;
    }
  }
  .c-form label {
    display: grid;
    gap: 0.35rem;
    font-weight: 700;
    font-size: 1rem;
  }
  input,
  textarea {
    width: 100%;
    font: inherit;
    font-weight: 400;
    font-size: 1.05rem;
    color: var(--navy);
    padding: 0.75rem 1rem;
    border: 1.5px solid var(--line);
    border-radius: 0.8rem;
    background: var(--mist);
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  input[dir='ltr'] {
    text-align: right;
  }
  input:focus,
  textarea:focus {
    outline: none;
    border-color: var(--teal);
    background: var(--white);
    box-shadow: 0 0 0 3px rgb(29 157 160 / 0.2);
  }
  textarea {
    resize: vertical;
    min-height: 7rem;
  }
  .c-form .btn,
  .c-news .btn {
    justify-self: start;
    padding-inline: 2.4em;
  }
  .c-form__status:empty {
    display: none;
  }
  .c-form__status {
    margin: 0;
    font-weight: 700;
    color: var(--teal-dark);
  }

  .c-details {
    padding: clamp(1.5rem, 4vw, 2rem);
    border-radius: 1.5rem;
    color: var(--on-dark);
    background:
      radial-gradient(18rem 12rem at 100% 0, rgb(29 157 160 / 0.3), transparent 70%),
      var(--navy);
  }
  .c-details__title {
    color: var(--white);
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }
  .c-details__list {
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
  }
  .c-details__list li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.7rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.12);
  }
  .c-details__label {
    font-weight: 700;
    color: var(--on-dark-soft);
  }
  .c-details a {
    color: var(--white);
    font-weight: 700;
  }
  .c-details__sub {
    color: var(--gold-light);
    font-size: 1.05rem;
    margin-bottom: 0.75rem;
  }
  .c-socials {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .c-socials a {
    display: inline-block;
    padding: 0.4rem 0.95rem;
    border: 1px solid rgb(252 220 109 / 0.5);
    border-radius: 999px;
    text-decoration: none;
    font-size: 0.95rem;
  }
  .c-socials a:hover {
    background: rgb(252 220 109 / 0.12);
  }

  /* ---------- 3. להישאר בקשר ---------- */
  .c-stay {
    padding-block: clamp(2.5rem, 6vw, 4rem);
    color: var(--on-dark);
    background:
      radial-gradient(40rem 22rem at 100% 0, rgb(29 157 160 / 0.22), transparent 70%),
      radial-gradient(34rem 22rem at 0 100%, rgb(209 154 74 / 0.14), transparent 72%),
      var(--navy-deep);
  }
  .c-stay__grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
  }
  .c-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
    padding: clamp(1.5rem, 4vw, 2.25rem);
    border-radius: 1.5rem;
    background: linear-gradient(160deg, rgb(255 255 255 / 0.08), rgb(255 255 255 / 0.02));
    border: 1px solid rgb(255 255 255 / 0.12);
  }
  .c-card__icon {
    display: grid;
    place-items: center;
    width: 3.2rem;
    height: 3.2rem;
    margin-bottom: 0.75rem;
    border-radius: 0.9rem;
    background: var(--gold-gradient);
    color: var(--navy);
  }
  .c-card__title {
    color: var(--white);
    font-size: clamp(1.35rem, 3vw, 1.7rem);
    font-weight: 900;
    margin-bottom: 0.5rem;
  }
  .c-card p {
    color: var(--on-dark);
  }
  .c-news {
    display: grid;
    gap: 0.75rem;
    width: 100%;
  }
  .c-news input[type='text'],
  .c-news input[type='email'] {
    background: rgb(255 255 255 / 0.95);
    border-color: transparent;
  }
  .c-news__consent {
    display: flex !important;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.95rem;
    color: var(--on-dark);
  }
  .c-news__consent input {
    width: 1.15rem;
    height: 1.15rem;
    margin-top: 0.25rem;
    accent-color: var(--gold-dark);
    flex: none;
  }
  .c-stay .c-form__status {
    color: var(--gold-light);
  }
</style>
