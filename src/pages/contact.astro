---
// עמוד צור קשר, גרסה 2 (2026-11-05). לפי ההנחיות של נוגה: כל הדרכים להתחבר אליה במקום אחד,
// כולל הקהילה (אין עמוד קהילה נפרד). אווירה שמחה וקלילה, מלא אייקונים, מקצועי ומזמין.
// הסיסמה ומשפט ההשראה בפתיח: נוגה אישרה (2026-11-05). התמונה בפתיח: נוגה שלחה אותה לעמוד הזה.
// הסדר (נוגה, 2026-11-05): פתיח ← קרוסלת "כל הדרכים להתחבר" ← הקהילה ← מהאינסטגרם ← טופס פנייה והרשמה לתכנים.
// הטפסים מעוצבים בלבד ועדיין לא מחוברים לשום שירות. TODO: לחבר שירות טפסים ושירות דיוור.
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ReadMore from '../components/ReadMore.astro';
import { contact, socials } from '../data/contact';
import { communityIntro, communityPerks, communityPost } from '../data/community';
import { instagramPosts } from '../data/instagram';
import nogaBench from '../assets/contact/noga-bench.jpg';
import heroPhoto from '../assets/about/gallery/14-audience.jpg';

const instagram = socials.find((s) => s.icon === 'instagram')!;

// הקרוסלה "כל הדרכים להתחבר" (נוגה, 2026-11-05): הוואטסאפ שלה, הקהילה והרשתות.
// הטלפון והאימייל מופיעים ליד טופס הפנייה.
const ways = [
  { name: 'וואטסאפ', icon: 'whatsapp', handle: 'לשיחה איתי', href: contact.whatsapp, ltr: false },
  { name: 'הקהילה', icon: 'users', handle: 'תודעה עסקית מנצחת', href: contact.whatsappGroup, ltr: false },
  ...socials.map((s) => ({ ...s, ltr: !/[א-ת]/.test(s.handle) })),
] as const;

const [featuredPost, ...morePosts] = instagramPosts;
// תמונות אווירה (2026-11-07, קו רציף בכל האתר): קווי אור באזור הקהילה, ושולחן עבודה מאחורי הטפסים
import { atmoStyle } from '../utils/atmo';
import linesAtmo from '../assets/atmosphere/dark-lines.webp';
import deskAtmo from '../assets/atmosphere/light-desk.webp';
const linesStyle = await atmoStyle(linesAtmo, 0.4);
const deskStyle = await atmoStyle(deskAtmo, 0.35);
---

<BaseLayout title="צור קשר" description="כל הדרכים להתחבר לנוגה דיין אור: וואטסאפ, טלפון, אימייל, רשתות חברתיות, קהילת העסקים תודעה עסקית מנצחת והרשמה לתכנים במייל.">
  <!-- 1. פתיח: פס רחב ונמוך עם תמונת אווירה מהכנס והסיסמה (נוגה, 2026-11-05: שהתמונה לא תעכב
       את הגעה לדברים החשובים, ואפשר תמונת אווירה במקום תמונה שלה). משפט ההשראה עבר לטופס, כדי לפזר את הסיסמאות. -->
  <section class="c-hero">
    <Image class="c-hero__bg" src={heroPhoto} alt="" widths={[800, 1400, 2000]} sizes="100vw" loading="eager" />
    <div class="container c-hero__text">
      <p class="c-eyebrow c-eyebrow--dark"><Icon name="heart" size={16} /> צור קשר</p>
      <h1>להעז לגלות את הגרסה <span class="hl">האמיצה</span> של העסק שלך</h1>
    </div>
  </section>

  <!-- 2. כל הדרכים להתחבר: קרוסלת לוגואים, כל לוגו הוא קישור -->
  <section class="section c-ways reveal" aria-labelledby="ways-title">
    <div class="container">
      <h2 id="ways-title" class="c-title c-center">כל הדרכים <span class="hl--mark">להתחבר</span></h2>
      <!-- המשפט הזה הוא הצעה שלי, לאישור נוגה -->
      <p class="c-sub c-center">עוקבים, שואלים, מתייעצים או סתם אומרים שלום. אני כאן.</p>
    </div>
    <!-- קרוסלה לרוחב העמוד שזזה לאט (נעצרת במעבר עכבר או במיקוד מקלדת).
         הרשימה מופיעה פעמיים כדי שהתנועה תהיה רציפה; העותק השני מוסתר מקוראי מסך ומהמקלדת. -->
    <div class="c-marquee">
      <div class="c-marquee__track">
        {
          [0, 1].map((copy) => (
            <ul class="c-marquee__list" aria-hidden={copy === 1 ? 'true' : undefined}>
              {ways.map((w) => (
                <li>
                  <a class="c-way" href={w.href} target="_blank" rel="noopener" tabindex={copy === 1 ? -1 : undefined}>
                    <span class="c-way__icon">
                      <Icon name={w.icon} size={34} />
                    </span>
                    <span class="c-way__name">{w.name}</span>
                    <span class="c-way__handle" dir={w.ltr ? 'ltr' : undefined}>
                      {w.handle}
                    </span>
                    <span class="sr-only"> (נפתח בלשונית חדשה)</span>
                  </a>
                </li>
              ))}
            </ul>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 3. הקהילה: קבוצת הוואטסאפ "תודעה עסקית מנצחת" (הטקסטים של נוגה, src/data/community.ts) -->
  <section class="c-community reveal atmo" aria-labelledby="community-title" style={linesStyle}>
    <div class="container c-community__grid">
      <div class="c-community__info">
        <p class="c-eyebrow c-eyebrow--dark"><Icon name="users" size={16} /> הקהילה שלי</p>
        <h2 id="community-title" class="c-community__title">קבוצת הוואטסאפ <span class="hl">"תודעה עסקית מנצחת"</span></h2>
        {communityIntro.map((p) => <p>{p}</p>)}
        <ul class="c-perks">
          {
            communityPerks.map((perk) => (
              <li>
                <Icon name="check" size={18} />
                {perk.text}
              </li>
            ))
          }
        </ul>
        <a class="btn c-btn" href={contact.whatsappGroup} target="_blank" rel="noopener">
          <Icon name="whatsapp" size={20} />
          להצטרפות לקבוצה<span class="sr-only"> (נפתח בלשונית חדשה)</span>
        </a>
      </div>

      <!-- פוסט מתוך הקהילה, בעיצוב של הודעה -->
      <article class="c-post" aria-labelledby="post-title">
        <header class="c-post__head">
          <Image class="c-post__avatar" src={nogaBench} alt="" widths={[96]} sizes="48px" />
          <div>
            <h3 id="post-title" class="c-post__who">נוגה דיין אור</h3>
            <p class="c-post__where">מתוך הקהילה</p>
          </div>
        </header>
        <ReadMore class="c-post__body" preview={communityPost.preview} more={communityPost.more} />
        <p class="c-post__signoff">{communityPost.signoff}</p>
        <p class="c-post__sign">שלכם, נוגה</p>
      </article>
    </div>
  </section>

  <!-- 4. מהאינסטגרם: פוסטים שנוגה בחרה (src/data/instagram.ts), עם קישור לכל פוסט -->
  <section class="section c-insta reveal" aria-labelledby="insta-title">
    <div class="container">
      <div class="c-insta__head">
        <h2 id="insta-title" class="c-title">מה קורה <span class="hl--mark">באינסטגרם</span></h2>
        <a class="c-follow" href={instagram.href} target="_blank" rel="noopener">
          <Icon name="instagram" size={20} />
          לעקוב אחריי <span dir="ltr">{instagram.handle}</span><span class="sr-only"> (נפתח בלשונית חדשה)</span>
        </a>
      </div>

      <article class="c-ig c-ig--featured">
        <a class="c-ig__media" href={featuredPost.href} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
          <Image src={featuredPost.image} alt="" widths={[400, 640]} sizes="(min-width: 52rem) 24rem, 90vw" />
        </a>
        <div class="c-ig__content">
          <ReadMore class="c-ig__text" preview={featuredPost.preview} more={featuredPost.more} />
          <a class="c-ig__link" href={featuredPost.href} target="_blank" rel="noopener">
            לפוסט באינסטגרם <Icon name="arrow" size={18} /><span class="sr-only"> (נפתח בלשונית חדשה)</span>
          </a>
        </div>
      </article>

      <ul class="c-ig__grid">
        {
          morePosts.map((post) => (
            <li class="c-ig">
              <a class="c-ig__media" href={post.href} target="_blank" rel="noopener">
                <Image src={post.image} alt={post.alt} widths={[320, 480]} sizes="(min-width: 64rem) 16rem, (min-width: 36rem) 45vw, 90vw" />
                {post.kind === 'reel' && <span class="c-ig__badge">סרטון</span>}
                <span class="sr-only"> (לפוסט באינסטגרם, נפתח בלשונית חדשה)</span>
              </a>
              <div class="c-ig__content">
                <ReadMore class="c-ig__text" preview={post.preview} more={post.more} />
                <a class="c-ig__link" href={post.href} target="_blank" rel="noopener">
                  {post.kind === 'reel' ? 'לצפייה באינסטגרם' : 'לפוסט באינסטגרם'} <Icon name="arrow" size={18} />
                  <span class="sr-only"> (נפתח בלשונית חדשה)</span>
                </a>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
  <!-- 5. טופס פנייה, ולצדו הרשמה לתכנים במייל -->
  <section class="section section--mist c-forms reveal atmo" style={deskStyle}>
    <div class="container c-forms__grid">
      <!-- TODO: לחבר את הטופס לשירות טפסים (Formspree / Netlify Forms וכד'). כרגע הוא לא שולח דבר. -->
      <form class="c-form js-demo-form" method="post" novalidate aria-labelledby="form-title">
        <h2 id="form-title" class="c-title">השאירו <span class="hl--mark">פרטים</span></h2>
        <!-- משפט ההשראה (נוגה אישרה) עבר לכאן מהפתיח, כדי לפזר את הסיסמאות בעמוד -->
        <p class="c-form__note">בואו נבדוק יחד איך עושים סדר ומוצאים כסף גם בעסק שלך</p>
        <p class="c-form__direct">
          <a class="c-quick" href={contact.phoneHref}>
            <span class="c-quick__icon"><Icon name="phone" size={18} /></span>
            <span dir="ltr">{contact.phoneDisplay}</span>
          </a>
          <a class="c-quick" href={`mailto:${contact.email}`}>
            <span class="c-quick__icon"><Icon name="mail" size={18} /></span>
            <span dir="ltr">{contact.email}</span>
          </a>
        </p>
        <div class="c-form__row">
          <label>
            <span>שם מלא</span>
            <input type="text" name="name" autocomplete="name" required />
          </label>
          <label>
            <span>טלפון</span>
            <input type="tel" name="phone" autocomplete="tel" dir="ltr" required />
          </label>
        </div>
        <label>
          <span>אימייל</span>
          <input type="email" name="email" autocomplete="email" dir="ltr" />
        </label>
        <label>
          <span>במה אפשר לעזור?</span>
          <textarea name="message" rows="2"></textarea>
        </label>
        <button class="btn" type="submit">שליחה</button>
        <p class="c-form__status" role="status" aria-live="polite"></p>
      </form>

      <!-- TODO: לחבר לשירות דיוור (רשימת תפוצה). כרגע הטופס לא שולח דבר. -->
      <div class="c-news">
        <span class="c-news__icon" aria-hidden="true"><Icon name="mail" size={28} /></span>
        <h2 id="news-title" class="c-news__title">הרשמה <span class="hl">לתכנים במייל</span></h2>
        <!-- הצעה שלי, לאישור נוגה -->
        <p class="c-news__text">תכנים ועדכונים ישירות לתיבת המייל.</p>
        <form class="c-news__form js-demo-form" method="post" novalidate aria-labelledby="news-title">
          <label>
            <span class="sr-only">שם</span>
            <input type="text" name="name" autocomplete="name" placeholder="שם" />
          </label>
          <label>
            <span class="sr-only">אימייל</span>
            <input type="email" name="email" autocomplete="email" placeholder="אימייל" dir="ltr" required />
          </label>
          <!-- TODO: נוסח ההסכמה לקבלת דיוור לבדוק עם איש מקצוע -->
          <label class="c-news__consent">
            <input type="checkbox" name="consent" required />
            <span>אני מאשר/ת לקבל תכנים ועדכונים במייל</span>
          </label>
          <button class="btn" type="submit">להרשמה</button>
          <p class="c-form__status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </section>

</BaseLayout>

<!-- הטפסים עוד לא מחוברים: במקום לשלוח, מוצגת הודעה. TODO: להסיר כשמחברים שירות טפסים -->
<script is:inline>
  document.querySelectorAll('.js-demo-form').forEach(function (form) {
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var status = form.querySelector('.c-form__status');
      if (status) status.textContent = 'הטופס עוד לא מחובר. בינתיים אפשר לכתוב לי בוואטסאפ.';
    });
  });
</script>

<style>
  /* ---------- כללי לעמוד ---------- */
  .c-center {
    text-align: center;
  }
  .c-title {
    font-size: clamp(1.8rem, 4.5vw, 2.5rem);
    font-weight: 900;
    margin-bottom: 0.3rem;
  }
  .c-sub {
    font-size: 1.1rem;
    margin: 0 auto 0.75rem;
    color: var(--navy);
    opacity: 0.85;
  }
  .c-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0 0 0.9rem;
    padding: 0.3rem 0.9rem;
    border-radius: 999px;
    background: rgb(25 154 181 / 0.12);
    color: var(--teal-dark);
    font-weight: 800;
    font-size: 0.95rem;
  }
  .c-eyebrow :global(svg) {
    color: var(--gold-dark);
  }
  .c-eyebrow--dark {
    background: rgb(252 220 109 / 0.14);
    color: var(--gold-light);
  }
  .c-eyebrow--dark :global(svg) {
    color: var(--gold-light);
  }
  .c-quick {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    color: var(--navy);
    text-decoration: none;
  }
  .c-quick:hover span:last-child {
    text-decoration: underline;
  }
  .c-quick__icon {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 50%;
    background: var(--mist);
    color: var(--teal-dark);
  }
  .c-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  /* ---------- 1. פתיח: פס רחב ונמוך עם תמונת אווירה ---------- */
  .c-hero {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    min-height: clamp(13rem, 30vw, 18rem);
    padding-block: 2rem;
    background: var(--navy);
  }
  .c-hero :global(.c-hero__bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 45%;
  }
  /* שכבה כהה בכחול של האתר, כדי שהטקסט תמיד יהיה קריא */
  .c-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(30rem 16rem at 100% 100%, rgb(25 154 181 / 0.45), transparent 70%),
      linear-gradient(270deg, rgb(7 17 31 / 0.92) 0%, rgb(11 26 51 / 0.78) 45%, rgb(11 26 51 / 0.45) 100%);
  }
  .c-hero__text {
    position: relative;
    z-index: 1;
  }
  .c-hero h1 {
    max-width: 40rem;
    margin: 0;
    font-size: clamp(2rem, 5.2vw, 3.3rem);
    font-weight: 900;
    line-height: 1.2;
    color: var(--white);
    text-wrap: balance;
  }

  /* ---------- 2. כל הדרכים להתחבר ---------- */
  /* פחות רווחים מהרגיל בעמוד הזה (נוגה: שלא יצטרכו לגלול הרבה) */
  .c-ways,
  .c-insta,
  .c-forms {
    padding-block: clamp(1.75rem, 4.5vw, 3rem);
  }
  .c-ways {
    overflow: hidden;
    padding-bottom: clamp(1rem, 3vw, 2rem);
  }
  /* הקרוסלה: שורה אחת לרוחב כל העמוד, עם דהייה בקצוות */
  .c-marquee {
    overflow: hidden;
    padding-block: 0.75rem 1.25rem;
    -webkit-mask-image: linear-gradient(to left, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(to left, transparent, #000 6%, #000 94%, transparent);
  }
  .c-marquee__track {
    display: flex;
    width: max-content;
    animation: c-marquee 38s linear infinite;
  }
  .c-marquee:hover .c-marquee__track,
  .c-marquee:focus-within .c-marquee__track {
    animation-play-state: paused;
  }
  /* בכיוון ימין-לשמאל העותק השני נמצא משמאל, ולכן זזים ימינה בחצי מהרוחב */
  @keyframes c-marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(50%);
    }
  }
  .c-marquee__list {
    list-style: none;
    margin: 0;
    padding: 0 0.6rem;
    display: flex;
    gap: 1.2rem;
    padding-inline-end: 1.2rem;
  }
  .c-way {
    --tint: rgb(25 154 181 / 0.1);
    --ink: var(--teal);
    width: 11.5rem;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    padding: 1.5rem 0.75rem 1.25rem;
    border-radius: 1.25rem;
    background: var(--white);
    border: 1px solid var(--line);
    text-align: center;
    text-decoration: none;
    color: var(--navy);
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      border-color 0.25s ease;
  }
  li:nth-child(3n + 2) .c-way {
    --tint: rgb(252 220 109 / 0.3);
    --ink: var(--gold-dark);
  }
  li:nth-child(3n + 3) .c-way {
    --tint: rgb(11 26 51 / 0.07);
    --ink: var(--navy);
  }
  .c-way:hover,
  .c-way:focus-visible {
    transform: translateY(-4px);
    border-color: var(--ink);
    box-shadow: 0 18px 34px -22px rgb(11 26 51 / 0.5);
  }
  .c-way__icon {
    display: grid;
    place-items: center;
    width: 4.6rem;
    height: 4.6rem;
    margin-bottom: 0.4rem;
    border-radius: 50%;
    background: var(--tint);
    color: var(--ink);
    transition:
      background 0.25s ease,
      color 0.25s ease;
  }
  .c-way:hover .c-way__icon,
  .c-way:focus-visible .c-way__icon {
    background: var(--ink);
    color: var(--white);
  }
  .c-way__name {
    font-weight: 800;
    font-size: 1.05rem;
  }
  .c-way__handle {
    font-size: 0.85rem;
    opacity: 0.75;
    overflow-wrap: anywhere;
  }

  /* ---------- 3. טופס והרשמה ---------- */
  .c-forms__grid {
    display: grid;
    gap: 1.5rem;
    align-items: start;
  }
  @media (min-width: 52rem) {
    .c-forms__grid {
      grid-template-columns: 1.6fr 1fr;
    }
  }
  .c-form {
    display: grid;
    gap: 1rem;
    padding: clamp(1.5rem, 4vw, 2.25rem);
    border-radius: 1.5rem;
    background: var(--white);
    border: 1px solid var(--line);
    box-shadow: 0 30px 60px -40px rgb(11 26 51 / 0.45);
  }
  .c-form__note {
    margin: 0 0 0.25rem;
    color: var(--teal-dark);
    font-weight: 700;
  }
  .c-form__row {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 36rem) {
    .c-form__row {
      grid-template-columns: 1fr 1fr;
    }
  }
  .c-form label {
    display: grid;
    gap: 0.35rem;
    font-weight: 700;
    font-size: 1rem;
  }
  input,
  textarea {
    width: 100%;
    font: inherit;
    font-weight: 400;
    font-size: 1.05rem;
    color: var(--navy);
