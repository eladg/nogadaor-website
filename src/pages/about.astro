---
// עמוד אודות (גרסה 5, 2026-11-05). נוגה אמרה שהעמוד גמור, חוץ מהמומחים.
// השראה כללית מ-meitalchesner.co.il/about ומ-masha-bar.co.il, בלי להעתיק את העיצוב של אף אחת מהן.
// הצבעים של נוגה: כחול, טורקיז וזהב. הדגשות: .hl--mark (קו זהב מעוגל, לא מרקר).
// הסדר שנוגה קבעה: פתיח קצר, הסיפור, הקהילה + מחוץ לעבודה, עקרונות הליווי שלי (כהה), שותפים מקצועיים,
// התפיסה שלי, דווקא עכשיו + הסיסמה, תמונות. בלי אזור הקריאה לפעולה הכללי בתחתית.
// כל הטקסטים: הנוסח של נוגה (2026-11-05), עם עריכה קלה שהיא ביקשה.
// התמונות: נוגה שלחה אותן. כולן שמורות במקור ב"חומרים גרפיים לאתר/תמונות מכנסים",
// והגרסאות באתר (חתוכות, עם תיקון תאורה עדין) ב-src/assets/about/gallery.
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import nogaStage from '../assets/noga-stage.jpg';
import { experts } from '../data/experts';
import { contact } from '../data/contact';

// כל התמונות מהתיקייה, לפי המספר שבתחילת שם הקובץ
const files = import.meta.glob<ImageMetadata>('../assets/about/gallery/*.jpg', { eager: true, import: 'default' });
const pic = (num: string) => {
  const key = Object.keys(files).find((k) => k.split('/').pop()!.startsWith(`${num}-`));
  if (!key) throw new Error(`חסרה תמונה ${num} ב-src/assets/about/gallery`);
  return files[key];
};

// תיאורי התמונות (לקוראי מסך)
const alts: Record<string, string> = {
  '03': 'נוגה יושבת על ספסל בגינה ומחייכת',
  '05': 'נוגה ליד הדוכן על הבמה, מחייכת למצלמה',
  '06': 'משתתפים נרשמים בעמדת הקבלה של הכנס',
  '07': 'נוגה עם משתתפות בכנס',
  '09': 'נוגה עם משתתפים בכנס',
  '10': 'נוגה עם משתתפים בכנס',
  '11': 'נוגה עם שני משתתפים בכנס',
  '12': 'נוגה עם משתתפות בכנס',
  '13': 'נוגה מרצה על הבמה',
  '14': 'קהל המשתתפים באולם הכנס',
  '16': 'נוגה עם משתתפים על הבמה בכנס "עסקים במקסימום"',
  '17': 'נוגה על הבמה מביטה אל הקהל בחיוך',
  '18': 'נוגה מרצה בכנס "מנהיגות במקסימום"',
  '19': 'נוגה בין המשתתפים בזמן שאלה מהקהל',
  '20': 'נוגה בשיחה על הבמה עם מרצה נוספת',
  '21': 'רול-אפ של הכנס "מנהיגות במקסימום" עם התמונה של נוגה',
  '22': 'מחברות ועטים שהוכנו למשתתפי הכנס',
  '23': 'נוגה מדברת אל הקהל',
};
// שתי שורות שזזות לכיוונים הפוכים. הסדר מעורבב בכוונה, כדי שלא יהיו כמה תמונות במה ברצף.
// תמונות 15 ו-08 מופיעות לצד הסיפור, ולכן לא חוזרות כאן.
const rows = [
  ['07', '14', '05', '22', '18', '09', '21', '06', '17'],
  ['12', '19', '13', '10', '20', '03', '23', '11', '16'],
].map((row) => row.map((n) => ({ src: pic(n), alt: alts[n] })));

// שש הקוביות: הנוסח של נוגה (2026-11-05). נוגה ביקשה לא לקרוא לזה "שיטה".
// icon הוא שם הציור הקטן מהרשימה icons שלמטה
const ways = [
  {
    icon: 'eye',
    title: 'לראות את התמונה המלאה',
    text: 'לחבר בין נתונים, אנשים, לקוחות ותהליכים כדי להבין את שורש האתגר ולזהות הזדמנויות לצמיחה.',
  },
  {
    icon: 'compass',
    title: 'להתאים את הדרך לעסק',
    text: 'לבנות מהלכים מתוך הבנת הזהות העסקית, המטרות, היכולות והאנשים שצריכים להוציא אותם לפועל.',
  },
  {
    icon: 'growth',
    title: 'להפיק יותר מהקיים',
    text: 'לזהות פוטנציאל בלקוחות, בידע ובמשאבים הקיימים ולמצוא דרכים יצירתיות להפוך אותו להכנסות ולרווח.',
  },
  {
    icon: 'list',
    title: 'לפשט את הדרך ליישום',
    text: 'לתרגם חשיבה אסטרטגית לפתרונות ברורים ומעשיים שאפשר לשלב בשגרת העבודה ולהתמיד בהם.',
  },
  {
    icon: 'together',
    title: 'לעבוד יחד עד לביצוע',
    text: 'להיכנס לעומק החומרים, לקבל החלטות ולקדם יחד משימות ותוצרים כדי להפוך רעיונות למהלכים בשטח.',
  },
  {
    icon: 'flag',
    title: 'לחזק את יכולת ההובלה',
    text: 'לפתח ביטחון בקבלת החלטות, לקיחת אחריות ורתימת אנשים כדי להמשיך להוביל את העסק גם לאחר הליווי.',
  },
];

// ציורים קטנים (קווים) לקוביות
const icons: Record<string, string> = {
  eye: '<path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/>',
  compass: '<circle cx="12" cy="12" r="9"/><path d="m15.5 8.5-2 5-5 2 2-5Z"/>',
  growth: '<path d="m3 17 6-6 4 4 8-8"/><path d="M15 7h6v6"/>',
  list: '<path d="M10 6h10M10 12h10M10 18h10"/><path d="m3 6 1.5 1.5L7 5M3 12l1.5 1.5L7 11M3 18l1.5 1.5L7 17"/>',
  together: '<circle cx="9" cy="8" r="3"/><circle cx="17" cy="9" r="2.5"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><path d="M15.5 14.6c2.6.4 4.5 2.6 4.5 5.4"/>',
  flag: '<path d="M5 21V4"/><path d="M5 4h12l-2.5 4L17 12H5"/>',
};
---

<BaseLayout
  title="אודות"
  description="נעים להכיר, נוגה דיין אור: יועצת עסקית וארגונית להגדלת הכנסות ושיפור רווחיות באמצעות אסטרטגיה, שיווק ותהליכי עבודה."
>
  <!-- 1. פתיח: תמונה של נוגה כרקע, עם הצללה כהה מאחורי הטקסט כדי שיהיה קריא תמיד -->
  <section class="a-hero">
    <div class="a-hero__media">
      <Image
        src={nogaStage}
        alt="נוגה דיין אור מרצה מול קהל"
        widths={[640, 1024, 1600, 2000]}
        sizes="(min-width: 52rem) 60vw, 100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="container a-hero__inner">
      <div class="a-hero__text">
        <h1>
          <span class="a-hero__hi">נעים להכיר,</span>
          <span class="a-hero__name hl">נוגה דיין אור</span>
        </h1>
        <!-- משפט אחד ברצף, באותו עיצוב (לבקשת נוגה) -->
        <p class="a-hero__title">יועצת עסקית וארגונית להגדלת הכנסות ושיפור רווחיות באמצעות אסטרטגיה, שיווק ותהליכי עבודה</p>
        <!-- TODO: לחבר את הכפתור לאמצעי הקשר / היומן שנוגה תבחר -->
        <a class="btn a-btn" href="/contact/">
          קביעת שיחת היכרות
          <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path d="M19 12H5m6-6-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- 2. הסיפור: מתחיל מיד אחרי הפתיח (לבקשת נוגה). הטקסט ברצף אחד, ולצדו צמד תמונות -->
  <section class="section a-story">
    <div class="container a-story__grid">
      <div class="a-story__text reveal">
        <p class="a-kicker">הסיפור שלי</p>
        <!-- המשפט של נוגה (2026-11-05) -->
        <h2 class="a-story__title">מאוהבת בלעשות עסקים</h2>
        <!-- שימו לב: ב-Astro ירידת שורה לפני תגית או אחריה נמחקת, ולכן הרווחים כאן כתובים במפורש עם {' '} -->
        <p>
          מכירים את זה שבכל שבועיים סמנכ״ל בבנק קם בבוקר ואומר <span class="a-wish" lang="en" dir="ltr">“I WISH”</span>{' '}
          — ועכשיו צריך לגרום לעשרות סניפים ולמאות יועצי השקעות לזוז? מישהו צריך לקחת את הרעיון, לחבר
          את האנשים והמספרים ולבנות דוחות עבודה, נהלים, בקרות ודיווחים.{' '}
          <span class="hl--mark">התפקיד שלי היה לגרום לדברים לקרות.</span>
        </p>
        <p>
          <span class="hl--mark">20 שנה בתפקידים בהנהלת הבנק הבינלאומי</span> לימדו אותי המון על פיתוח עסקי,
          ניהול עובדים והובלת תהליכים. עשיתי שם המון דברים מעניינים, אבל הכי הרבה אהבתי לייעץ
          לדירקטוריון בפרויקטים אסטרטגיים פנים־ארגוניים. וכמובן שלכל תפקיד הבאתי גם אותי: חדה,
          סקרנית, שואלת שאלות, ראש גדול ויצירתי ואהבה לפתור אתגרים עסקיים עם פתרונות חכמים ואפס תקציבים.
        </p>
        <p>
          יש לי <span class="hl--mark">תואר שני במנהל עסקים</span> מלפני שני עשורים, וגם ניסיון אמיתי של{' '}
          <span class="hl--mark">ליווי 450 עסקים</span>, ואת כל אלה אני מביאה לעסק שלכם.
        </p>
        <p>
          <!-- המשפט השני מודגש לבקשת נוגה, כחלק מהפסקה -->
          קשה לי להחליט אם קוראים לזה ייעוץ עסקי, ארגוני, שיווקי או אסטרטגי, כי זה הרבה מכל דבר.{' '}
          <strong class="a-strong">כל עסק הוא שונה ומיוחד, ואני באה ולומדת את המצב הקיים ומה רוצים להשיג, ועוזרת לכם לגרום לזה לקרות: להגדיל הכנסות, לשפר רווחיות ולייעל את העבודה בכלים חדשניים ומעודכנים.</strong>
        </p>
      </div>

      <!-- צמד תמונות רחבות שחופפות מעט -->
      <div class="a-story__photos reveal">
        <Image class="pic pic--main" src={pic('15')} alt="נוגה על הבמה מול קהל המשתתפים" widths={[600, 900, 1300]} sizes="(min-width: 52rem) 40vw, 100vw" />
        <Image class="pic pic--small" src={pic('08')} alt="נוגה מחובקת עם משתתפת בכנס" widths={[400, 700]} sizes="(min-width: 52rem) 22vw, 60vw" />
      </div>
    </div>
  </section>

  <!-- 3. הקהילה שלי ומחוץ לעבודה: שני כרטיסים -->
  <section class="section section--mist a-cards-sec">
    <div class="container a-cards">
      <article class="a-card reveal">
        <h2 class="a-card__title">הקהילה <span class="hl--mark">שלי</span></h2>
        <p>
          כבר 4 שנים אני מנהלת את <strong>"תודעה עסקית מנצחת"</strong>, קהילה של מאות בעלי עסקים. הקהילה
          מביאה להם עוצמה, אנרגיה ומוטיבציה לעשייה עסקית ולניהול נכון של התודעה.
        </p>
        <!-- TODO: קישור לעמוד הקהילה, כשייבנה -->
        <a class="btn a-group" href={contact.whatsappGroup} target="_blank" rel="noopener">
          להצטרפות לקבוצת הוואטסאפ
          <span class="sr-only"> (נפתח בלשונית חדשה)</span>
        </a>
      </article>
      <article class="a-card reveal" style="transition-delay: 120ms">
        <h2 class="a-card__title">מחוץ <span class="hl--mark">לעבודה</span></h2>
        <p>
          אמא לשלושה וגרה בראשון לציון. אוהבת טבע, נחלים, טיולים בג'יפים והרפתקאות, לרקוד, לצחוק,
          והרבה חברים.
        </p>
      </article>
    </div>
  </section>

  <!-- 4. עקרונות הליווי שלי: שש קוביות על רקע כחול. בגוף יחיד: זה האתר של נוגה -->
  <section class="a-ways">
    <div class="container">
      <!-- TODO: הכותרת היא הצעה. נוגה ביקשה כותרת בגוף יחיד שמתאימה לתוכן הקוביות -->
      <h2 class="a-ways__title reveal">עקרונות <span class="hl">הליווי שלי</span></h2>
      <ul class="ways">
        {
          ways.map((w, i) => (
            <li class="way reveal" style={`transition-delay: ${(i % 3) * 110}ms`}>
              <span class="way__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" set:html={icons[w.icon]} />
              </span>
              <h3>{w.title}</h3>
              <p>{w.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 5. שותפים מקצועיים: מומחים שנוגה עובדת איתם (אינם חלק מהארגון). הרשימה ב-src/data/experts.ts -->
  <section class="section">
    <div class="container">
      <!-- TODO: הכותרת היא הצעה. נוגה ביקשה כותרת מקצועית יותר מ"מומחים שאני עובדת איתם" -->
      <h2 class="a-title reveal">שותפים <span class="hl--mark">מקצועיים</span></h2>
      <ul class="experts">
        {
          experts.map((e, i) => (
            <li class={`expert reveal${e.placeholder ? ' expert--todo' : ''}`} style={`transition-delay: ${(i % 3) * 100}ms`}>
              <span class="expert__mono" aria-hidden="true">{e.placeholder ? '?' : e.name.charAt(0)}</span>
              <div>
                <h3>{e.placeholder ? `תוכן חסר: ${e.name}` : e.name}</h3>
                <p>{e.field}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 6. התפיסה שלי (לשעבר "מה מניע אותי"; הנוסח של נוגה) -->
  <section class="section section--mist a-drive">
    <div class="container a-drive__grid">
      <!-- TODO: הכותרת היא הצעה. נוגה ביקשה כותרת מקצועית יותר -->
      <h2 class="a-title reveal">התפיסה <span class="hl--mark">שלי</span></h2>
      <!-- ממורכז ובפסקה אחת, בלי מעברי שורות (בקשה של נוגה) -->
      <div class="a-drive__text reveal">
        <p><strong class="a-drive__lead">אני מאמינה שכל עסק וכל בעל עסק הוא מיוחד. אין מתכון אחד לבניית עסק ואין שיטה להצלחה. כולם יכולים הכול, כשהם רק רוצים.</strong>{' '}כבעלי עסקים, אנחנו חייבים <span class="hl--mark">להסמיך את עצמנו</span> ולא לחכות לאישורים, ולעשות בדרך שלנו, לא כמו אחרים. זה מה שהופך אותנו למנהיגים, וזה מה שממגנט אלינו את הלקוחות המדויקים. הליווי שלי דואג למנף את הכישורים הקיימים ולחבר עוד יותר לתשוקה, לאנרגיה ולשליחות. מתוך החיבור הזה בונים יסודות אסטרטגיים חזקים, ייחודיים ומבודלים, ובוחרים את הקהלים הנכונים. במקביל מחזקים את מה שיחזיק את העסק גם אחרי הליווי: חוסן ואמונה עצמית, קבלת החלטות בקלות, מנהיגות ולקיחת אחריות, ועשייה גם כשמפחדים. כי כשאנחנו מחוברים והחלטיים, אנחנו יכולים לכבוש כל יעד ולהגשים את הבלתי אפשרי, וזה צריך להיות בדרך שלך. זו המשמעות של הסלוגן שלי:</p>
        <p class="a-slogan">הצלחה עסקית בדרך שלך</p>
      </div>
    </div>
  </section>

  <!-- 7. דווקא עכשיו, ובסופו הסיסמה שחותמת כל פוסט של נוגה -->
  <section class="a-now">
    <div class="container a-now__inner reveal">
      <h2 class="a-now__title">דווקא <span class="hl">עכשיו</span></h2>
      <p>
        הטכנולוגיה משנה את העולם בקצב מסחרר, ורוב האנשים לא מספיקים לאמץ את השינויים. זה בדיוק
        הרגע להעז, לסמוך על עצמנו ולחשוב בגדול.
      </p>
      <p class="a-now__big">
        העולם כבר מרחיב את גבולות האפשר. הגיע הזמן להרחיב גם את מה שאתם מרשים לעצמכם.
      </p>
      <p class="a-now__motto hl">קמים ונהיים ענקיים מהחיים</p>
      <p class="a-now__sign">שלכם, נוגה</p>
    </div>
  </section>

  <!-- 8. רגעים מהכנסים: שתי שורות תמונות שזזות לכיוונים הפוכים, בסוף העמוד (לבקשת נוגה).
       נעצרות במעבר עכבר. אצל מי שביקש פחות תנועה הן עומדות, ואפשר לגלול אותן לצדדים.
       בעמוד הזה אין את אזור הקריאה לפעולה הכללי: נוגה אמרה שהרצף הזה מספיק. -->
  <section class="a-moments" aria-labelledby="moments-title">
    <div class="container">
      <!-- TODO: הכותרת "רגעים מהכנסים" היא הצעה. נוגה יכולה לשנות -->
