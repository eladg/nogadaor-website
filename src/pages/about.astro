---
// עמוד אודות (גרסה 3, 2026-11-05).
// השראה כללית מ-meitalchesner.co.il/about ומ-masha-bar.co.il, בלי להעתיק את העיצוב של אף אחת מהן.
// הצבעים של נוגה: כחול, טורקיז וזהב.
// סדר האזורים (לבקשת נוגה): פתיח עם תמונת רקע, הדרך שלנו (6 קוביות), הסיפור ברצף אחד עם צמד תמונות,
// גלריית רגעים מהכנסים, מומחים שאני עובדת איתם.
// "מלב אל לב" הוסר בינתיים: נוגה אמרה שהסיפור שלה כבר כתוב מספיק מלב אל לב.
// התמונות: נוגה שלחה אותן (2026-11-05). היא ביקשה לפזר אותן כך שלא יופיעו כמה תמונות במה ברצף,
// ובלי מסגרות לאורך. כל התמונות שנשלחו שמורות ב"חומרים גרפיים לאתר/תמונות מכנסים".
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import nogaStage from '../assets/noga-stage.jpg';
import facingAudience from '../assets/about/facing-audience.jpg';
import hug from '../assets/about/hug.jpg';
import groupFive from '../assets/about/group-five.jpg';
import audience from '../assets/about/audience.jpg';
import lookingAhead from '../assets/about/looking-ahead.jpg';
import notebooks from '../assets/about/notebooks-badges.jpg';
import stageParticipants from '../assets/about/stage-participants.jpg';
import groupFour from '../assets/about/group-four-c.jpg';
import amongAudience from '../assets/about/among-audience.jpg';
import { experts } from '../data/experts';

// גלריית רגעים: מעורבב בכוונה (אנשים, קהל, במה, חומרים), לא כמה תמונות במה ברצף.
// size: big = ריבוע גדול, wide = רחבה, רגילה = בלי size. pos = איזה חלק בתמונה להראות כשהיא נחתכת.
const moments = [
  { src: groupFive, alt: 'נוגה עם משתתפות בכנס', size: 'big' },
  { src: audience, alt: 'קהל המשתתפים באולם הכנס', size: 'wide' },
  { src: lookingAhead, alt: 'נוגה על הבמה מביטה אל הקהל בחיוך' },
  // החיתוך מימין מסתיר תג שם של משתתפת
  { src: notebooks, alt: 'מחברות "הצלחה עסקית בדרך שלך" שחולקו בכנס', pos: '100% 50%' },
  { src: stageParticipants, alt: 'נוגה עם משתתפים על הבמה בכנס "עסקים במקסימום"', size: 'wide' },
  { src: groupFour, alt: 'נוגה עם משתתפות בכנס' },
  { src: amongAudience, alt: 'נוגה בין המשתתפים בזמן שאלות מהקהל' },
];

// שש הקוביות: הנוסח של נוגה (2026-11-05). נוגה ביקשה לא לקרוא לזה "שיטה".
// icon הוא שם הציור הקטן מהרשימה icons שלמטה
const ways = [
  {
    icon: 'eye',
    title: 'לראות את התמונה המלאה',
    text: 'לחבר בין נתונים, אנשים, לקוחות ותהליכים כדי להבין את שורש האתגר ולזהות הזדמנויות לצמיחה.',
  },
  {
    icon: 'compass',
    title: 'להתאים את הדרך לעסק',
    text: 'לבנות מהלכים מתוך הבנת הזהות העסקית, המטרות, היכולות והאנשים שצריכים להוציא אותם לפועל.',
  },
  {
    icon: 'growth',
    title: 'להפיק יותר מהקיים',
    text: 'לזהות פוטנציאל בלקוחות, בידע ובמשאבים הקיימים ולמצוא דרכים יצירתיות להפוך אותו להכנסות ולרווח.',
  },
  {
    icon: 'list',
    title: 'לפשט את הדרך ליישום',
    text: 'לתרגם חשיבה אסטרטגית לפתרונות ברורים ומעשיים שאפשר לשלב בשגרת העבודה ולהתמיד בהם.',
  },
  {
    icon: 'together',
    title: 'לעבוד יחד עד לביצוע',
    text: 'להיכנס לעומק החומרים, לקבל החלטות ולקדם יחד משימות ותוצרים כדי להפוך רעיונות למהלכים בשטח.',
  },
  {
    icon: 'flag',
    title: 'לחזק את יכולת ההובלה',
    text: 'לפתח ביטחון בקבלת החלטות, לקיחת אחריות ורתימת אנשים כדי להמשיך להוביל את העסק גם לאחר הליווי.',
  },
];

// ציורים קטנים (קווים) לקוביות
const icons: Record<string, string> = {
  eye: '<path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/>',
  compass: '<circle cx="12" cy="12" r="9"/><path d="m15.5 8.5-2 5-5 2 2-5Z"/>',
  growth: '<path d="m3 17 6-6 4 4 8-8"/><path d="M15 7h6v6"/>',
  list: '<path d="M10 6h10M10 12h10M10 18h10"/><path d="m3 6 1.5 1.5L7 5M3 12l1.5 1.5L7 11M3 18l1.5 1.5L7 17"/>',
  together: '<circle cx="9" cy="8" r="3"/><circle cx="17" cy="9" r="2.5"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><path d="M15.5 14.6c2.6.4 4.5 2.6 4.5 5.4"/>',
  flag: '<path d="M5 21V4"/><path d="M5 4h12l-2.5 4L17 12H5"/>',
};
---

<BaseLayout
  title="אודות"
  description="נעים להכיר, נוגה דיין אור: יועצת עסקית וארגונית להגדלת הכנסות ושיפור רווחיות באמצעות אסטרטגיה, שיווק ותהליכי עבודה."
>
  <!-- 1. פתיח: תמונה של נוגה כרקע, עם הצללה כהה מאחורי הטקסט כדי שיהיה קריא תמיד -->
  <section class="a-hero">
    <div class="a-hero__media">
      <Image
        src={nogaStage}
        alt="נוגה דיין אור מרצה מול קהל"
        widths={[640, 1024, 1600, 2000]}
        sizes="(min-width: 52rem) 60vw, 100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="container a-hero__inner">
      <div class="a-hero__text">
        <h1>
          <span class="a-hero__hi">נעים להכיר,</span>
          <span class="a-hero__name hl">נוגה דיין אור</span>
        </h1>
        <p class="a-hero__title">
          <span class="a-hero__role">יועצת עסקית וארגונית להגדלת הכנסות ושיפור רווחיות</span>{' '}
          <span class="a-hero__how">באמצעות אסטרטגיה, שיווק ותהליכי עבודה</span>
        </p>
        <!-- TODO: לחבר את הכפתור לאמצעי הקשר / היומן שנוגה תבחר -->
        <a class="btn a-btn" href="/contact/">
          קביעת שיחת היכרות
          <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path d="M19 12H5m6-6-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- 2. הדרך שלנו: שש קוביות, מיד אחרי הפתיח (לבקשת נוגה) -->
  <section class="a-ways">
    <div class="container">
      <h2 class="a-ways__title reveal">הדרך <span class="hl">שלנו</span></h2>
      <ul class="ways">
        {
          ways.map((w, i) => (
            <li class="way reveal" style={`transition-delay: ${(i % 3) * 110}ms`}>
              <span class="way__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" set:html={icons[w.icon]} />
              </span>
              <h3>{w.title}</h3>
              <p>{w.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 3. הסיפור: הטקסט של נוגה ברצף אחד, בלי פיצול לאזורים. ולצדו מקום לתמונה -->
  <section class="section a-story">
    <div class="container a-story__grid">
      <div class="a-story__text reveal">
        <h2 class="a-kicker">הסיפור שלי</h2>
        <p>
          מכירים את זה שבכל שבועיים סמנכ״ל בבנק קם בבוקר ואומר <span class="a-wish" lang="en" dir="ltr">“I WISH”</span>
          — ועכשיו צריך לגרום לעשרות סניפים ולמאות יועצי השקעות לזוז? מישהו צריך לקחת את הרעיון, לחבר
          את האנשים והמספרים ולבנות דוחות עבודה, נהלים, בקרות ודיווחים.
          <span class="hl--mark">התפקיד שלי היה לגרום לדברים לקרות.</span>
        </p>
        <p>
          <span class="hl--mark">20 שנה בתפקידים בהנהלת הבנק הבינלאומי</span> לימדו אותי המון על פיתוח עסקי,
          ניהול עובדים והובלת תהליכים. עשיתי שם המון דברים מעניינים, אבל הכי הרבה אהבתי לייעץ
          לדירקטוריון בפרויקטים אסטרטגיים פנים־ארגוניים. וכמובן שלכל תפקיד הבאתי גם אותי: חדה,
          סקרנית, שואלת שאלות, ראש גדול ויצירתי ואהבה לפתור אתגרים עסקיים עם פתרונות חכמים ואפס תקציבים.
        </p>
        <p>
          יש לי <span class="hl--mark">תואר שני במנהל עסקים</span> מלפני שני עשורים, וגם ניסיון אמיתי של
          <span class="hl--mark">ליווי 450 עסקים</span>, ואת כל אלה אני מביאה לעסק שלכם.
        </p>
        <p>
          קשה לי להחליט אם קוראים לזה ייעוץ עסקי, ארגוני, שיווקי או אסטרטגי, כי זה הרבה מכל דבר.
          כל עסק הוא שונה ומיוחד, ואני באה ולומדת את המצב הקיים ומה רוצים להשיג, ועוזרת לכם לגרום
          לזה לקרות: להגדיל הכנסות, לשפר רווחיות ולייעל את העבודה בכלים חדשניים ומעודכנים.
        </p>
      </div>

      <!-- צמד תמונות רחבות שחופפות מעט, במקום מסגרת לאורך -->
      <div class="a-story__photos reveal">
        <Image class="pic pic--main" src={facingAudience} alt="נוגה על הבמה מול קהל המשתתפים" widths={[600, 900, 1300]} sizes="(min-width: 52rem) 40vw, 100vw" />
        <Image class="pic pic--small" src={hug} alt="נוגה מחובקת עם משתתפת בכנס" widths={[400, 700]} sizes="(min-width: 52rem) 22vw, 60vw" />
      </div>
    </div>
  </section>

  <!-- 4. רגעים מהכנסים: גלריה מעורבבת -->
  <section class="section a-moments">
    <div class="container">
      <!-- TODO: הכותרת "רגעים מהכנסים" היא הצעה. נוגה יכולה לשנות -->
      <h2 class="a-title reveal">רגעים <span class="hl--mark">מהכנסים</span></h2>
      <ul class="moments">
        {
          moments.map((m, i) => (
            <li class={`moment reveal${m.size ? ` moment--${m.size}` : ''}`} style={`transition-delay: ${(i % 4) * 80}ms`}>
              <Image
                src={m.src}
                alt={m.alt}
                widths={m.size === 'big' ? [600, 1000, 1400] : [400, 700, 1000]}
                sizes={m.size ? '(min-width: 52rem) 50vw, 100vw' : '(min-width: 52rem) 25vw, 50vw'}
                style={m.pos ? `object-position: ${m.pos}` : undefined}
              />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 4. מומחים שאני עובדת איתם: הם אינם חלק מהארגון. הרשימה ב-src/data/experts.ts -->
  <section class="section section--mist">
    <div class="container">
      <h2 class="a-title reveal">מומחים <span class="hl--mark">שאני עובדת איתם</span></h2>
      <ul class="experts">
        {
          experts.map((e, i) => (
            <li class={`expert reveal${e.placeholder ? ' expert--todo' : ''}`} style={`transition-delay: ${(i % 3) * 100}ms`}>
              <span class="expert__mono" aria-hidden="true">{e.placeholder ? '?' : e.name.charAt(0)}</span>
              <div>
                <h3>{e.placeholder ? `תוכן חסר: ${e.name}` : e.name}</h3>
                <p>{e.field}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  /* ---------- 1. פתיח עם תמונת רקע ---------- */
  .a-hero {
    position: relative;
    overflow: hidden;
    background: var(--navy-deep);
    color: var(--on-dark);
  }
  /* בנייד: התמונה למעלה, והטקסט מתחתיה על כחול מלא */
  .a-hero__media {
    position: relative;
    height: min(78vw, 26rem);
  }
  .a-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 28%;
  }
  .a-hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(7 17 31 / 0.15) 0%, rgb(7 17 31 / 0.1) 55%, var(--navy-deep) 100%);
  }
  .a-hero__inner {
    position: relative;
    padding-block: 0.5rem 3rem;
  }
  .a-hero h1 {
    margin: 0 0 1rem;
    color: var(--white);
    line-height: 1.05;
  }
  .a-hero__hi {
    display: block;
    font-size: clamp(1.5rem, 3.6vw, 2.3rem);
    font-weight: 600;
    margin-bottom: 0.25em;
  }
  .a-hero__name {
    display: inline-block;
    font-size: min(12vw, 4.8rem);
    font-weight: 900;
    white-space: nowrap;
    padding-bottom: 0.08em;
  }
  /* התואר וההמשך "באמצעות..." זורמים ברצף, בלי שבירת שורה ביניהם (בקשה של נוגה) */
  .a-hero__title {
    font-size: clamp(1.1rem, 2.2vw, 1.35rem);
    font-weight: 600;
    line-height: 1.55;
    margin-bottom: 1.75rem;
  }
  .a-hero__how {
    font-weight: 400;
    color: var(--on-dark-soft);
  }
  .a-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .a-btn svg {
    transition: transform 0.3s ease;
  }
  .a-btn:hover svg {
    transform: translateX(-0.25rem);
  }

  /* במסך רחב: התמונה ממלאת את כל הפתיח, והטקסט בצד ימין על הצללה כהה */
  @media (min-width: 52rem) {
    .a-hero {
      display: flex;
      align-items: center;
      min-height: clamp(32rem, 80vh, 44rem);
    }
    /* התמונה תופסת את הצד השמאלי בלבד, כך שהטקסט בימין לא עולה עליה אף פעם */
    .a-hero__media {
      position: absolute;
      top: 0;
      bottom: 0;
      left: 0;
      width: 60%;
      height: auto;
    }
    .a-hero__media img {
      object-position: 50% 28%;
    }
    .a-hero__media::after {
      background:
        linear-gradient(to left, var(--navy-deep) 0%, rgb(7 17 31 / 0.7) 16%, rgb(7 17 31 / 0) 42%),
        linear-gradient(to right, rgb(7 17 31 / 0.85) 0%, rgb(7 17 31 / 0) 30%),
        linear-gradient(0deg, rgb(7 17 31 / 0.7) 0%, rgb(7 17 31 / 0) 28%),
        rgb(7 17 31 / 0.12);
    }
    .a-hero__inner {
      padding-block: 4rem;
    }
    /* במחשב התואר נכנס בשורה אחת */
    .a-hero__role {
      white-space: nowrap;
    }
    .a-hero__text {
      max-width: min(38rem, 55vw);
      text-shadow: 0 2px 18px rgb(7 17 31 / 0.6);
    }
  }

  /* ---------- כותרות ---------- */
  .a-title {
    font-size: clamp(1.9rem, 5vw, 2.8rem);
    font-weight: 900;
  }
  .a-kicker {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--teal-dark);
    margin-bottom: 1.25rem;
  }
  .a-kicker::before {
    content: '';
    display: inline-block;
    width: 2rem;
    height: 3px;
    margin-inline-end: 0.6rem;
    vertical-align: middle;
    border-radius: 2px;
    background: var(--gold-gradient);
  }

  /* ---------- 2. הסיפור ---------- */
  /* הטקסט ברצף אחד, ולצדו תמונה שנשארת במקום בזמן הגלילה (במחשב) */
  .a-story__grid {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }
  @media (min-width: 52rem) {
    .a-story__grid {
      grid-template-columns: 1.45fr 1fr;
      gap: 4rem;
    }
    .a-story__photos {
      position: sticky;
      top: 6.5rem;
    }
  }
  .a-story__text {
    font-size: 1.2rem;
    line-height: 1.85;
  }
  .a-story__text p:last-child {
    margin-bottom: 0;
  }
  .a-wish {
    display: inline-block;
    padding: 0 0.45em;
    border-radius: 0.4em;
    background: var(--navy);
    color: var(--gold-light);
    font-weight: 800;
    letter-spacing: 0.03em;
  }

  /* צמד תמונות: גדולה, ומעליה קטנה שחופפת בפינה עם מסגרת לבנה */
  .a-story__photos {
    position: relative;
    padding-bottom: 18%;
  }
  .pic {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: 1.5rem;
  }
  .pic--main {
    aspect-ratio: 3 / 2;
    box-shadow: 0 30px 60px -32px rgb(11 26 51 / 0.55);
  }
  .pic--small {
    position: absolute;
    bottom: 0;
    left: -4%;
    width: 58%;
    aspect-ratio: 4 / 3;
    border: 6px solid var(--white);
    border-radius: 1.25rem;
    box-shadow: 0 24px 48px -24px rgb(11 26 51 / 0.6);
    rotate: -2deg;
  }

  /* ---------- רגעים מהכנסים: גלריה על רקע כחול ---------- */
  .a-moments {
    background:
      radial-gradient(36rem 22rem at 100% 0, rgb(29 157 160 / 0.2), transparent 70%),
      var(--navy);
  }
  .a-moments .a-title {
    color: var(--white);
  }
  .a-moments .hl--mark {
    color: var(--gold-light);
    background: none;
  }
  .moments {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(2, 1fr);
    grid-auto-rows: clamp(9rem, 38vw, 13rem);
    grid-auto-flow: dense;
  }
  @media (min-width: 52rem) {
    .moments {
      gap: 1rem;
      grid-template-columns: repeat(4, 1fr);
      grid-auto-rows: clamp(10rem, 16vw, 14rem);
    }
  }
  .moment {
    overflow: hidden;
    border-radius: 1.1rem;
    background: var(--navy-soft);
  }
  .moment--wide {
    grid-column: span 2;
  }
  .moment--big {
    grid-column: span 2;
    grid-row: span 2;
  }
  .moment :global(img) {
