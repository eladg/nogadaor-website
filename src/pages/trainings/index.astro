---
// עמוד מרכז ההדרכות. הנתונים ב-src/data/trainings.ts
// נוגה (2026-11-07): העמוד מחולק לנושאים, והנושאים מופיעים למעלה. לכל הדרכה: כריכה מתאימה, כותרת ומשפט הסבר אחד.
// בלי משך, בלי פירוט הסדנה ובלי מספור בכרטיסים (הפירוט נמצא בעמוד של כל הדרכה).
// "הרצאות לארגונים" ו"הרצאות העצמה, מנהיגות ומוטיבציה" יהיו בקרוב.
import BaseLayout from '../../layouts/BaseLayout.astro';
import LightHero from '../../components/LightHero.astro';
import ContentCover from '../../components/ContentCover.astro';
import ConferenceVideo from '../../components/ConferenceVideo.astro';
import QuoteMarquee from '../../components/QuoteMarquee.astro';
import { lectureReviews } from '../../data/reviews';
import darkLines from '../../assets/atmosphere/dark-lines.webp';
import { trainings, trainingCategories } from '../../data/trainings';
import { contact } from '../../data/contact';
import Icon from '../../components/Icon.astro';
import { atmoStyle } from '../../utils/atmo';
import chairs from '../../assets/atmosphere/light-chairs.webp';
import road from '../../assets/atmosphere/dark-road.webp';

const waText = encodeURIComponent('היי נוגה, אשמח לפרטים על ההדרכות');
const roadStyle = await atmoStyle(road, 0.45);
const linesStyle = await atmoStyle(darkLines, 0.5);

// כל ההדרכות ברשת אחת, בלי הפרדה בתצוגה בין הנושאים (נוגה, 2026-11-08). הסדר: לפי סדר הנושאים, ובתוך כל נושא לפי הרשימה.
const groups = trainingCategories
  .filter((c) => !('soon' in c && c.soon))
  .map((c) => ({ ...c, items: trainings.filter((t) => t.category === c.id) }))
  .filter((g) => g.items.length > 0);
const allTrainings = groups.flatMap((g) => g.items);
const soon = trainingCategories.filter((c) => 'soon' in c && c.soon);
// "להזמנת ההדרכה": וואטסאפ עם שם ההדרכה בהודעה
const orderHref = (title: string) => `${contact.whatsapp}?text=${encodeURIComponent(`היי נוגה, אשמח לפרטים על הזמנת ההדרכה "${title}"`)}`;
---

<BaseLayout
  title="קטלוג הדרכות"
  description="הדרכות והרצאות של נוגה דיין אור: בינה מלאכותית לעסקים, שיווק לעצמאים, קהילה בוואטסאפ, כתיבה שיווקית, מנהיגות עסקית, נטוורקינג וקבלת החלטות. כל הדרכה ניתנת כהרצאה או כסדנה יישומית."
>
  <LightHero image={chairs} title="קטלוג הדרכות" kicker="הרצאות וסדנאות">
    <!-- הנוסח של נוגה ("העברת הדרכות שיווק, אסטרטגיה, מנהיגות ועוד", 2026-11-07), בלי גוף ראשון -->
    <p><strong>הדרכה טובה לא רק מעבירה ידע. היא גורמת לך ולעסק שלך לגדול,</strong> בעזרת תובנות, החלטות וכלים שאפשר ליישם מיד.</p>
    <p>ההדרכות מותאמות לקהל, לארגון, למטרות המפגש ולאתגרים של המשתתפים, ומשלבות אסטרטגיה, שיווק, דוגמאות מהשטח וחשיבה מעשית. כל הדרכה ניתנת כהרצאה, ואפשר להפוך אותה לסדנה יישומית.</p>
  </LightHero>

  <!-- הנושאים למעלה (נוגה אוהבת אותם, וגם את ה"בקרוב"). בלי מספרים. כפתורי סינון: "כל ההדרכות" מסומן כברירת מחדל,
       ולחיצה על נושא מציגה רק את ההדרכות שלו, באותה רשת. בלי JavaScript מוצגות כל ההדרכות. -->
  <nav class="topics-nav" aria-label="נושאי ההדרכות">
    <div class="container">
      <ul>
        <li>
          <button type="button" class="topics-nav__btn" data-topic="all" aria-pressed="true">כל ההדרכות</button>
        </li>
        {
          groups.map((g) => (
            <li>
              <button type="button" class="topics-nav__btn" data-topic={g.id} aria-pressed="false">
                {g.title}
              </button>
            </li>
          ))
        }
        {
          soon.map((c) => (
            <li>
              <span class="topics-nav__soon">
                {c.title} <span class="badge">בקרוב</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>

  <!-- כל ההדרכות ברשת אחת. בכל שורה התמונה, הכותרת, ההסבר והקישור להזמנה באותו גובה (subgrid, נוגה 2026-11-08). -->
  <section class="section topic" id="trainings">
    <div class="container">
      <h2 class="sr-only">כל ההדרכות</h2>
      <ul class="tgrid">
        {allTrainings.map((t, i) => (
          <li class="tcard reveal" data-topic={t.category} style={`transition-delay: ${(i % 3) * 0.08}s`}>
            <a class="tcard__cover" href={`/trainings/${t.slug}/`} tabindex="-1" aria-hidden="true">
              <ContentCover title={t.coverTitle} motif={t.coverMotif} fit />
            </a>
            <h3 class="tcard__title">
              <a href={`/trainings/${t.slug}/`}>{t.title}</a>
            </h3>
            <p class="tcard__short">{t.short}</p>
            <a class="tcard__order" href={orderHref(t.title)} target="_blank" rel="noopener">
              <Icon name="whatsapp" size={16} />
              להזמנת ההדרכה<span class="sr-only"> "{t.title}" בוואטסאפ (נפתח בלשונית חדשה)</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- על הבמה: סרטון כנס העסקים שנוגה הפיקה. מופיע בשני מקומות באתר: כאן ובעמוד הבית (2026-11-07).
       אותה כריכה כמו בעמוד הבית (נוגה, 2026-11-08), מהרכיב המשותף ConferenceVideo. -->
  <section class="section section--deep atmo stage" style={linesStyle}>
    <div class="container stage__grid">
      <div class="reveal">
        <h2 class="sec-title">נוגה <span class="hl">על הבמה</span></h2>
        <p class="sec-lead">קצת מכנס העסקים שנוגה הפיקה, עם משתתפים שמספרים על החוויה.</p>
      </div>
      <ConferenceVideo class="stage__video reveal" />
    </div>
  </section>

  <!-- מה אמרו משתתפים: המלצות על הרצאות (src/data/reviews.ts, lectureReviews).
       באותו עיצוב כמו ההמלצות בעמוד הבית, בשתי שורות שזזות לכיוונים הפוכים (נוגה, 2026-11-08) -->
  <section class="section section--mist">
    <div class="container">
      <h2 class="sec-title reveal t-rev-title">מה אמרו <span class="hl--mark">משתתפים</span></h2>
    </div>
    <QuoteMarquee reviews={lectureReviews} rows={2} />
  </section>

  <!-- אזור "בקרוב" בתחתית הוסר (נוגה, 2026-11-08). ה"בקרוב" נשאר רק בנושאים למעלה. -->

  <section class="section section--dark trainings-cta atmo atmo--full" style={roadStyle}>
    <div class="container">
      <h2>להזמנת הרצאה או סדנה</h2>
      <p>אפשר להזמין כל הדרכה לקבוצה, לארגון או לכנס.</p>
      <p class="trainings-cta__actions">
        <a class="btn" href={`${contact.whatsapp}?text=${waText}`}>לפרטים בוואטסאפ</a>
        <a href={contact.phoneHref}>{contact.phoneDisplay}</a>
        <a href={`mailto:${contact.email}`}>{contact.email}</a>
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  // סינון לפי נושא: מציג רק את ההדרכות של הנושא שנבחר, באותה רשת
  const buttons = document.querySelectorAll<HTMLButtonElement>('.topics-nav__btn');
  const cards = document.querySelectorAll<HTMLElement>('.tcard');
  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const topic = btn.dataset.topic;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      cards.forEach((c) => {
        c.hidden = topic !== 'all' && c.dataset.topic !== topic;
      });
      document.getElementById('trainings')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    })
  );
</script>

<style>
  /* ---------- הנושאים למעלה: פס דביק מתחת לכותרת האתר ---------- */
  .topics-nav {
    position: sticky;
    top: var(--header-h, 3.8rem);
    z-index: 20;
    background: rgb(255 255 255 / 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .topics-nav ul {
    list-style: none;
    margin: 0;
    padding: 0.75rem 0;
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .topics-nav ul::-webkit-scrollbar {
    display: none;
  }
  .topics-nav li {
    flex: none;
    margin: 0;
  }
  .topics-nav__btn,
  .topics-nav__soon {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    font-weight: 800;
    font-size: 0.95rem;
    white-space: nowrap;
    text-decoration: none;
  }
  .topics-nav__btn {
    border: 1px solid var(--navy);
    background: var(--white);
    color: var(--navy);
    font-family: inherit;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .topics-nav__btn:hover {
    border-color: var(--teal-dark);
    color: var(--teal-dark);
  }
  .topics-nav__btn[aria-pressed='true'] {
    background: var(--navy);
    border-color: var(--navy);
    color: var(--white);
  }
  .topics-nav__soon {
    border: 1px dashed #b9c6d3;
    color: #5b6b80;
  }
  .badge {
    display: inline-block;
    padding: 0.1rem 0.6rem;
    border-radius: 999px;
    background: var(--gold-gradient);
    color: var(--navy);
    font-size: 0.75rem;
    font-weight: 900;
  }

  /* מעבר לאזור: שהכותרת לא תוסתר מתחת לפסים הדביקים */
  .topic {
    scroll-margin-top: 7.5rem;
  }

  /* ---------- כרטיסים: 3 בשורה במחשב, 2 בטאבלט, 1 בנייד. שורה אחרונה לא מלאה ממורכזת ----------
     רשת של 6 טורים (כל כרטיס 2), ו-subgrid: התמונה, הכותרת, ההסבר והקישור להזמנה באותו גובה בכל שורה. */
  .tgrid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    /* במחשב 4 בשורה (8 טורים, כל כרטיס על 2), כדי ש-7 הדרכות יתחלקו לשורות מאוזנות 4+3 (נוגה: תמיד שורות מאוזנות) */
    grid-template-columns: repeat(8, 1fr);
    /* יותר מרווח בין ההדרכות (נוגה, 2026-11-08) */
    gap: 0 2.25rem;
  }
  .tcard {
    position: relative;
    grid-column: span 2;
    grid-row: span 4;
    display: grid;
    grid-template-rows: subgrid;
    row-gap: 0;
    margin: 0 0 3.25rem;
  }
  .tcard[hidden] {
    display: none;
  }
  /* שורה אחרונה לא מלאה: ממורכזת (בכל רוחב לפי מספר הטורים שלו) */
  @media (min-width: 62.01rem) {
    .tcard:nth-child(4n + 1 of :not([hidden])):nth-last-child(3 of :not([hidden])) {
      grid-column: 2 / span 2;
    }
    .tcard:nth-child(4n + 1 of :not([hidden])):nth-last-child(2 of :not([hidden])) {
      grid-column: 3 / span 2;
    }
    .tcard:nth-child(4n + 1 of :not([hidden])):nth-last-child(1 of :not([hidden])) {
      grid-column: 4 / span 2;
    }
  }
  @media (max-width: 62rem) {
    .tgrid {
      grid-template-columns: repeat(4, 1fr);
      column-gap: 2rem;
    }
  }
  @media (max-width: 62rem) and (min-width: 36.01rem) {
    .tcard:nth-child(2n + 1 of :not([hidden])):nth-last-child(1 of :not([hidden])) {
      grid-column: 2 / span 2;
    }
  }
  @media (max-width: 36rem) {
    .tgrid {
      grid-template-columns: 1fr;
    }
    .tcard {
      grid-column: 1;
    }
  }
  .tcard__cover {
    display: block;
    transition: transform 0.3s ease;
  }
  .tcard:hover .tcard__cover {
    transform: translateY(-4px);
  }
  .tcard__title {
    align-self: start;
    margin: 0.85rem 0 0.4rem;
    font-size: 1.1rem;
    font-weight: 900;
    line-height: 1.35;
  }
  .tcard__title a {
    color: var(--navy);
    text-decoration: none;
  }
  /* כל הכרטיס לחיץ, דרך הקישור שבכותרת */
  .tcard__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .tcard__title a:hover {
    color: var(--teal-dark);
  }
  .tcard__short {
    align-self: start;
    margin: 0;
    font-size: 0.97rem;
    line-height: 1.65;
    color: #33445c;
  }

  /* "להזמנת ההדרכה": קישור עדין מתחת לכל הדרכה, מעל הקישור של כל הכרטיס */
  .tcard__order {
    position: relative;
    z-index: 1;
    justify-self: start;
    align-self: end;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.8rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--teal-dark);
    text-decoration: none;
  }
  .tcard__order:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* ---------- על הבמה ---------- */
  .stage__grid {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }
  @media (min-width: 56rem) {
    .stage__grid {
      grid-template-columns: 1fr 1.6fr;
      gap: 3rem;
    }
  }

  .trainings-cta {
    text-align: center;
    padding-block: clamp(3.5rem, 9vw, 5.5rem);
  }
  .trainings-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    justify-content: center;
    align-items: center;
    margin: 1.5rem 0 0;
  }
  .trainings-cta a:not(.btn) {
    color: var(--gold-light);
  }
  @media (prefers-reduced-motion: reduce) {
    .tcard__cover {
      transition: none;
    }
  }
</style>
