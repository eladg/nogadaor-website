---
// עמוד מרכז ההדרכות: כרטיס לכל הדרכה מהקטלוג, וקישור לעמוד שלה.
// הנתונים ב-src/data/trainings.ts
// עיצוב (2026-11-07, "קו רציף בכל האתר"): פתיח בהיר עם תמונת אווירה (כיתה ריקה), כרטיסים ממוספרים
// (4 בשורה, שורות מאוזנות), ואזור הזמנה כהה עם תמונת הדרך המוארת, כמו בתחתית שאר העמודים.
import BaseLayout from '../../layouts/BaseLayout.astro';
import LightHero from '../../components/LightHero.astro';
import { trainings } from '../../data/trainings';
import { contact } from '../../data/contact';
import { atmoStyle } from '../../utils/atmo';
import chairs from '../../assets/atmosphere/light-chairs.webp';
import road from '../../assets/atmosphere/dark-road.webp';

const waText = encodeURIComponent('היי נוגה, אשמח לפרטים על ההדרכות');
const roadStyle = await atmoStyle(road, 0.45);
---

<BaseLayout
  title="הדרכות"
  description="קטלוג ההדרכות של נוגה דיין אור: שיווק, תוכן, קהילה בוואטסאפ, AI, מנהיגות, נטוורקינג וקבלת החלטות. כל הדרכה ניתנת כהרצאה או כסדנה יישומית."
>
  <LightHero image={chairs} title="קטלוג הדרכות" kicker="הרצאות וסדנאות">
    <!-- הפתיח נלקח מעמוד השער של הקטלוג -->
    <p>יועצת עסקית, ניסיון של שני עשורים בתהליכי ניהול ופיתוח עסקי, מכורה לפיתוח והגשמת חלומות עסקים.</p>
    <ul class="pillars" aria-label="הגישה">
      <li>חשיבה הוליסטית אסטרטגית</li>
      <li>התייעלות פרקטית להגדלת הכנסות</li>
      <li>מחויבות אישית לתוצאות משותפות</li>
    </ul>
  </LightHero>

  <section class="section">
    <div class="container">
      <h2 class="sec-title reveal">ההדרכות</h2>
      <p class="sec-lead">כל הדרכה ניתנת כהרצאה, ואפשר להפוך אותה לסדנה יישומית.</p>
      <ul class="tcards">
        {
          trainings.map((t, i) => (
            <li class="tcard reveal" style={`transition-delay: ${(i % 4) * 0.08}s`}>
              <span class="tcard__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="tcard__title">
                <a href={`/trainings/${t.slug}/`}>{t.title}</a>
              </h3>
              <p class="tcard__lead">{t.lead[0]}</p>
              <p class="tcard__format">{t.format}</p>
              <span class="tcard__more" aria-hidden="true">לפרטים ←</span>
            </li>
          ))
        }
      </ul>
      <!-- TODO: לפי העץ באתר אמורות להיות כ-12 הרצאות. בקטלוג 8. נוגה תשלים. -->
    </div>
  </section>

  <section class="section section--dark trainings-cta atmo atmo--full" style={roadStyle}>
    <div class="container">
      <h2>להזמנת הרצאה או סדנה</h2>
      <p>אפשר להזמין כל הדרכה לקבוצה, לארגון או לכנס.</p>
      <p class="trainings-cta__actions">
        <a class="btn" href={`${contact.whatsapp}?text=${waText}`}>לפרטים בוואטסאפ</a>
        <a href={contact.phoneHref}>{contact.phoneDisplay}</a>
        <a href={`mailto:${contact.email}`}>{contact.email}</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .pillars {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .pillars li {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.35em 1em;
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--teal-dark);
  }

  /* כרטיסים ממוספרים: 4 בשורה במחשב, 2 בטאבלט, 1 בנייד (8 הדרכות = שורות מאוזנות) */
  .tcards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }
  @media (max-width: 68rem) {
    .tcards {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 36rem) {
    .tcards {
      grid-template-columns: 1fr;
    }
  }
  .tcard {
    position: relative;
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 1.5rem 1.35rem 1.25rem;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 1.25rem;
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      border-color 0.25s ease;
  }
  .tcard:hover {
    transform: translateY(-4px);
    border-color: var(--teal);
    box-shadow: 0 18px 40px -26px rgb(11 26 51 / 0.45);
  }
  .tcard__num {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    margin-bottom: 0.85rem;
    border-radius: 50%;
    background: var(--gold-gradient);
    color: var(--navy);
    font-weight: 900;
  }
  .tcard__title {
    margin: 0 0 0.5rem;
    font-size: 1.12rem;
    font-weight: 900;
    line-height: 1.35;
  }
  .tcard__title a {
    color: var(--navy);
    text-decoration: none;
  }
  /* כל הכרטיס לחיץ, דרך הקישור שבכותרת */
  .tcard__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .tcard__lead {
    margin: 0 0 0.75rem;
    font-size: 0.97rem;
    line-height: 1.55;
    color: #33445c;
  }
  .tcard__format {
    margin: auto 0 0.5rem;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--teal-dark);
  }
  .tcard__more {
    font-weight: 800;
    color: var(--gold-dark);
  }

  .trainings-cta {
    text-align: center;
    padding-block: clamp(3.5rem, 9vw, 5.5rem);
  }
  .trainings-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    justify-content: center;
    align-items: center;
    margin: 1.5rem 0 0;
  }
  .trainings-cta a:not(.btn) {
    color: var(--gold-light);
  }
  @media (prefers-reduced-motion: reduce) {
    .tcard {
      transition: none;
    }
  }
</style>
