---
// עמוד מרכז ההדרכות. הנתונים ב-src/data/trainings.ts
// נוגה (2026-11-07): העמוד מחולק לנושאים, והנושאים מופיעים למעלה. לכל הדרכה: כריכה מתאימה, כותרת ומשפט הסבר אחד.
// בלי משך, בלי פירוט הסדנה ובלי מספור בכרטיסים (הפירוט נמצא בעמוד של כל הדרכה).
// "הרצאות לארגונים" ו"הרצאות העצמה, מנהיגות ומוטיבציה" יהיו בקרוב.
import BaseLayout from '../../layouts/BaseLayout.astro';
import LightHero from '../../components/LightHero.astro';
import ContentCover from '../../components/ContentCover.astro';
import { trainings, trainingCategories } from '../../data/trainings';
import { contact } from '../../data/contact';
import { atmoStyle } from '../../utils/atmo';
import chairs from '../../assets/atmosphere/light-chairs.webp';
import road from '../../assets/atmosphere/dark-road.webp';

const waText = encodeURIComponent('היי נוגה, אשמח לפרטים על ההדרכות');
const roadStyle = await atmoStyle(road, 0.45);

const groups = trainingCategories
  .filter((c) => !('soon' in c && c.soon))
  .map((c) => ({ ...c, items: trainings.filter((t) => t.category === c.id) }))
  .filter((g) => g.items.length > 0);
const soon = trainingCategories.filter((c) => 'soon' in c && c.soon);
---

<BaseLayout
  title="הדרכות"
  description="הדרכות והרצאות של נוגה דיין אור: בינה מלאכותית לעסקים, שיווק לעצמאים, קהילה בוואטסאפ, כתיבה שיווקית, מנהיגות עסקית, נטוורקינג וקבלת החלטות. כל הדרכה ניתנת כהרצאה או כסדנה יישומית."
>
  <LightHero image={chairs} title="קטלוג הדרכות" kicker="הרצאות וסדנאות">
    <!-- הפתיח נלקח מעמוד השער של הקטלוג -->
    <p>יועצת עסקית, ניסיון של שני עשורים בתהליכי ניהול ופיתוח עסקי, מכורה לפיתוח והגשמת חלומות עסקים.</p>
    <p>כל הדרכה ניתנת כהרצאה, ואפשר להפוך אותה לסדנה יישומית.</p>
  </LightHero>

  <!-- הנושאים למעלה: קישורים לאזורים בעמוד. נושאים שעוד אין בהם הדרכות מסומנים "בקרוב". -->
  <nav class="topics-nav" aria-label="נושאי ההדרכות">
    <div class="container">
      <ul>
        {
          groups.map((g) => (
            <li>
              <a href={`#${g.id}`}>
                {g.title} <span class="topics-nav__count">{g.items.length}</span>
              </a>
            </li>
          ))
        }
        {
          soon.map((c) => (
            <li>
              <span class="topics-nav__soon">
                {c.title} <span class="badge">בקרוב</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>

  {
    groups.map((g, gi) => (
      <section class:list={['section', 'topic', { 'section--mist': gi % 2 === 1 }]} id={g.id}>
        <div class="container">
          <h2 class="sec-title reveal">{g.title}</h2>
          <ul class="tgrid">
            {g.items.map((t, i) => (
              <li class="tcard reveal" style={`transition-delay: ${(i % 4) * 0.08}s`}>
                <a class="tcard__cover" href={`/trainings/${t.slug}/`} tabindex="-1" aria-hidden="true">
                  <ContentCover title={t.coverTitle} motif={t.coverMotif} />
                </a>
                <h3 class="tcard__title">
                  <a href={`/trainings/${t.slug}/`}>{t.title}</a>
                </h3>
                <p class="tcard__short">{t.short}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))
  }

  <!-- בקרוב -->
  <section class="section soon-sec">
    <div class="container">
      <h2 class="sec-title reveal">בקרוב</h2>
      <ul class="soon-list">
        {
          soon.map((c) => (
            <li class="reveal">
              <span class="badge">בקרוב</span>
              <h3>{c.title}</h3>
            </li>
          ))
        }
      </ul>
      <!-- TODO: לפי העץ באתר אמורות להיות כ-12 הרצאות. כרגע 8. נוגה תשלים, כולל ההרצאות לארגונים וההרצאות בנושא העצמה. -->
    </div>
  </section>

  <section class="section section--dark trainings-cta atmo atmo--full" style={roadStyle}>
    <div class="container">
      <h2>להזמנת הרצאה או סדנה</h2>
      <p>אפשר להזמין כל הדרכה לקבוצה, לארגון או לכנס.</p>
      <p class="trainings-cta__actions">
        <a class="btn" href={`${contact.whatsapp}?text=${waText}`}>לפרטים בוואטסאפ</a>
        <a href={contact.phoneHref}>{contact.phoneDisplay}</a>
        <a href={`mailto:${contact.email}`}>{contact.email}</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- הנושאים למעלה: פס דביק מתחת לכותרת האתר ---------- */
  .topics-nav {
    position: sticky;
    top: var(--header-h, 3.8rem);
    z-index: 20;
    background: rgb(255 255 255 / 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .topics-nav ul {
    list-style: none;
    margin: 0;
    padding: 0.75rem 0;
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .topics-nav ul::-webkit-scrollbar {
    display: none;
  }
  .topics-nav li {
    flex: none;
    margin: 0;
  }
  .topics-nav a,
  .topics-nav__soon {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    font-weight: 800;
    font-size: 0.95rem;
    white-space: nowrap;
    text-decoration: none;
  }
  .topics-nav a {
    background: var(--navy);
    color: var(--white);
  }
  .topics-nav a:hover {
    background: var(--teal-dark);
  }
  .topics-nav__count {
    display: inline-grid;
    place-items: center;
    min-width: 1.4rem;
    height: 1.4rem;
    border-radius: 999px;
    background: var(--gold-gradient);
    color: var(--navy);
    font-size: 0.8rem;
  }
  .topics-nav__soon {
    border: 1px dashed #b9c6d3;
    color: #5b6b80;
  }
  .badge {
    display: inline-block;
    padding: 0.1rem 0.6rem;
    border-radius: 999px;
    background: var(--gold-gradient);
    color: var(--navy);
    font-size: 0.75rem;
    font-weight: 900;
  }

  /* מעבר לאזור: שהכותרת לא תוסתר מתחת לפסים הדביקים */
  .topic {
    scroll-margin-top: 7.5rem;
  }

  /* ---------- כרטיסים: 3 בשורה במחשב (6 = 3+3), 2 בטאבלט, 1 בנייד. שורה לא מלאה ממורכזת ---------- */
  .tgrid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.75rem 1.5rem;
  }
  .tcard {
    position: relative;
    flex: 0 1 calc((100% - 2 * 1.5rem) / 3);
    margin: 0;
  }
  @media (max-width: 62rem) {
    .tcard {
      flex-basis: calc((100% - 1.5rem) / 2);
    }
  }
  @media (max-width: 36rem) {
    .tcard {
      flex-basis: 100%;
    }
  }
  .tcard__cover {
    display: block;
    transition: transform 0.3s ease;
  }
  .tcard:hover .tcard__cover {
    transform: translateY(-4px);
  }
  .tcard__title {
    margin: 0.85rem 0 0.35rem;
    font-size: 1.1rem;
    font-weight: 900;
    line-height: 1.35;
  }
  .tcard__title a {
    color: var(--navy);
    text-decoration: none;
  }
  /* כל הכרטיס לחיץ, דרך הקישור שבכותרת */
  .tcard__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .tcard__title a:hover {
    color: var(--teal-dark);
  }
  .tcard__short {
    margin: 0;
    font-size: 0.97rem;
    line-height: 1.55;
    color: #33445c;
  }

  /* ---------- בקרוב ---------- */
  .soon-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }
  @media (max-width: 40rem) {
    .soon-list {
      grid-template-columns: 1fr;
    }
  }
  .soon-list li {
    margin: 0;
    padding: 1.5rem;
    border-radius: 1.25rem;
    border: 2px dashed #c9d5e0;
    background: var(--mist);
  }
  .soon-list h3 {
    margin: 0.6rem 0 0;
    font-size: 1.2rem;
    font-weight: 900;
    color: #4a5b73;
  }

  .trainings-cta {
    text-align: center;
    padding-block: clamp(3.5rem, 9vw, 5.5rem);
  }
  .trainings-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    justify-content: center;
    align-items: center;
    margin: 1.5rem 0 0;
  }
  .trainings-cta a:not(.btn) {
    color: var(--gold-light);
  }
  @media (prefers-reduced-motion: reduce) {
    .tcard__cover {
      transition: none;
    }
  }
</style>
