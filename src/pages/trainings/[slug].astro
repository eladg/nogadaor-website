---
// עמוד הדרכה בודדת. הנתונים ב-src/data/trainings.ts
import BaseLayout from '../../layouts/BaseLayout.astro';
import LightHero from '../../components/LightHero.astro';
import FreeLectures from '../../components/FreeLectures.astro';
import { atmoStyle } from '../../utils/atmo';
import { lectureReviews } from '../../data/reviews';
import chairs from '../../assets/atmosphere/light-chairs.webp';
import audience from '../../assets/atmosphere/light-audience.webp';
import road from '../../assets/atmosphere/dark-road.webp';
import { trainings, type Training } from '../../data/trainings';
import { contact } from '../../data/contact';

export function getStaticPaths() {
  return trainings.map((training) => ({ params: { slug: training.slug }, props: { training } }));
}

const { training } = Astro.props as { training: Training };
const waText = encodeURIComponent(`היי נוגה, אשמח לפרטים על ההדרכה "${training.title}"`);
const others = trainings.filter((t) => t.slug !== training.slug);
// תמונות אווירה (2026-11-07): כיתה ריקה וקהל, לסירוגין בין ההדרכות
const heroImage = trainings.indexOf(training) % 2 === 0 ? audience : chairs;
const roadStyle = await atmoStyle(road, 0.45);
// המלצות משתתפים על ההדרכה הזו (אם יש)
const myReviews = lectureReviews.filter((r) => r.training === training.slug);

// נתונים מובנים: ההדרכה כשירות (הרצאה או סדנה), ושביל ניווט (src/utils/schema.ts)
import { serviceSchema } from '../../utils/schema';
import { coverImage } from '../../utils/coverImages';
const pageDescription = training.short;
const path = `/trainings/${training.slug}/`;
// הכריכה מקטלוג ההדרכות כקובץ תמונה: תמונת השיתוף של העמוד
const cover = coverImage({ group: 'training', slug: training.slug, pageTitle: training.title, coverTitle: training.coverTitle, motif: training.coverMotif });
const schema = [serviceSchema(Astro.site, { name: training.title, description: pageDescription, path, image: cover.src })];
const crumbs = [
  { name: 'בית', path: '/' },
  { name: 'קטלוג הדרכות', path: '/trainings/' },
  { name: training.title, path },
];
---

<BaseLayout title={training.title} description={pageDescription} schema={schema} crumbs={crumbs} image={cover}>
  <!-- עמוד ההדרכה כולו ממורכז (נוגה, 2026-11-08) -->
  <LightHero image={heroImage} title={training.title} center crumbs={{ href: '/trainings/', label: 'קטלוג הדרכות', current: 'הדרכה' }}>
    <p>{training.short}</p>
  </LightHero>

  <section class="section">
    <div class="container t-body">
      <!-- על ההדרכה. הטקסט ב-trainings.ts, טיוטה לאישור נוגה -->
      {
        training.about && (
          <>
            <h2>על ההדרכה</h2>
            <div class="about">
              {training.about.map((p) => (
                <p>{p}</p>
              ))}
            </div>
          </>
        )
      }
      {
        training.keyLines && (
          <>
            <h2>משפטי מפתח מההדרכה</h2>
            <ul class="keylines">
              {training.keyLines.map((line) => (
                <li>{line}</li>
              ))}
            </ul>
          </>
        )
      }
    </div>
  </section>

  <!-- מה לומדים: קוביות לרוחב העמוד על רקע כהה (נוגה, 2026-11-08) -->
  <section class="section section--deep t-topics">
    <div class="container">
      <h2 class="t-topics__title">מה לומדים בהדרכה</h2>
      <ul class="topics">
        {
          training.topics.map((topic, i) => (
            <li class="topic reveal" style={`transition-delay: ${i * 0.08}s`}>
              <span class="topic__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="topic__title">{topic.title}</h3>
              <p class="topic__text">{topic.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container t-body">
      {
        training.takeaways && (
          <>
            <h2>יוצאים מההדרכה עם</h2>
            <ul class="takeaways">
              {training.takeaways.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          </>
        )
      }

      <h2>למי מתאימה</h2>
      {
        training.audience ? (
          <p>{training.audience}</p>
        ) : (
          <p class="placeholder">תוכן חסר: למי ההדרכה מתאימה.</p>
        )
      }

      <h2>משך ופורמט</h2>
      <p class="format">{training.format}</p>
    </div>
  </section>

  {
    myReviews.length > 0 && (
      <section class="section section--mist">
        <div class="container">
          <h2 class="t-rev-title">מה אמרו משתתפים</h2>
          <ul class="t-reviews">
            {myReviews.map((r) => (
              <li class="t-review">
                <p class="t-review__stars" role="img" aria-label={`דירוג ${r.stars} מתוך 5`}>
                  {'★'.repeat(r.stars)}
                </p>
                <blockquote>{r.text}</blockquote>
                <p class="t-review__by">
                  <strong>{r.name}</strong> · מקור: {r.source}
                </p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="section section--dark t-cta atmo atmo--full" style={roadStyle}>
    <div class="container">
      <h2>להזמין את ההדרכה כהרצאה או כסדנה</h2>
      <p class="t-cta__actions">
        <a class="btn" href={`${contact.whatsapp}?text=${waText}`}>לפרטים בוואטסאפ</a>
        <a href={contact.phoneHref}>{contact.phoneDisplay}</a>
        <a href={`mailto:${contact.email}`}>{contact.email}</a>
      </p>
    </div>
  </section>

  <section class="section section--mist">
    <div class="container">
      <h2 class="center">הדרכות נוספות</h2>
      <ul class="others">
        {
          others.map((t) => (
            <li>
              <a href={`/trainings/${t.slug}/`}>{t.title}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- הזמנה להרצאות החינמיות במרכז הידע (נוגה, 2026-11-08) -->
  <FreeLectures />
</BaseLayout>

<style>
  .t-hero {
    border-bottom: 1px solid var(--line);
    padding-block: clamp(2rem, 6vw, 4rem);
  }
  .t-hero__inner,
  .t-body {
    max-width: 46rem;
  }
  /* כל הטקסט בעמוד ממורכז (נוגה, 2026-11-08) */
  .t-body {
    text-align: center;
  }
  .t-hero__kicker {
    font-size: 0.95rem;
    margin-bottom: 0.5rem;
  }
  .t-hero h1 {
    color: var(--teal-dark);
  }
  .t-hero__lead {
    font-weight: 700;
  }
  .t-hero__lead:last-child {
    margin-bottom: 0;
  }
  .t-body h2 {
    color: var(--teal-dark);
    margin-top: 2rem;
  }
  .t-body h2:first-child {
    margin-top: 0;
  }
  /* מה לומדים: קוביות בשורה אחת לרוחב העמוד, על רקע כהה. שורה לא מלאה ממורכזת */
  .t-topics {
    text-align: center;
  }
  .t-topics__title {
    margin: 0 0 clamp(1.5rem, 4vw, 2.25rem);
    font-size: clamp(1.6rem, 3.6vw, 2.2rem);
  }
  .topics {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.1rem;
  }
  .topic {
    flex: 1 1 13rem;
    max-width: 21rem;
    margin: 0;
    padding: 1.6rem 1.3rem 1.5rem;
    border-radius: 1.25rem;
    background: linear-gradient(160deg, rgb(255 255 255 / 0.09), rgb(255 255 255 / 0.03));
    border: 1px solid rgb(143 220 236 / 0.28);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.08);
  }
  .topic__num {
    display: block;
    margin-bottom: 0.55rem;
    font-size: 1.6rem;
    font-weight: 900;
    line-height: 1;
    background: var(--gold-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .topic__title {
    margin: 0 0 0.45rem;
    font-size: 1.15rem;
    font-weight: 800;
    line-height: 1.35;
    color: var(--white);
  }
  .topic__text {
    margin: 0;
    font-size: 0.98rem;
    line-height: 1.6;
    color: var(--on-dark-soft);
  }
  .format {
    font-weight: 700;
  }
  .about p {
    font-size: 1.08rem;
    line-height: 1.8;
  }
  .about p:last-child {
    margin-bottom: 0;
  }
  /* יוצאים מההדרכה עם: שורות ממורכזות, וי עדין בזהב (בלי ריבוע), כמו בתהליך הליווי */
  .takeaways {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.6rem;
  }
  .takeaways li {
    margin: 0;
    line-height: 1.55;
  }
  .takeaways li::before {
    content: '✓';
    margin-inline-end: 0.45rem;
    font-weight: 900;
    color: var(--gold-dark);
  }
  /* משפטי מפתח מההדרכה: טקסט צף עם פס זהב, בלי קופסאות */
  .keylines {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
  }
  /* ממורכז: קו זהב קצר מעל כל משפט במקום פס בצד */
  .keylines li::before {
    content: '';
    display: block;
    width: 2.5rem;
    height: 3px;
    margin: 0 auto 0.6rem;
    border-radius: 3px;
    background: var(--gold-gradient);
  }
  .keylines li {
    font-size: clamp(1.08rem, 2vw, 1.2rem);
    font-weight: 800;
    line-height: 1.5;
    color: var(--navy);
  }
  .t-cta {
    text-align: center;
    padding-block: clamp(3.5rem, 9vw, 5.5rem);
  }
  .t-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    justify-content: center;
    align-items: center;
    margin: 1.5rem 0 0;
  }
  .t-cta a:not(.btn) {
    color: var(--gold-light);
  }
  /* המלצות משתתפים על ההדרכה */
  .t-rev-title {
    text-align: center;
    color: var(--teal-dark);
    margin-bottom: 1rem;
  }
  .t-reviews {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 1rem;
  }
  .t-review {
    margin: 0;
    text-align: center;
    padding: 1.35rem;
    border-radius: 1.25rem;
    background: var(--white);
    border: 1px solid var(--line);
    border-top: 4px solid var(--gold-dark);
  }
  .t-review__stars {
    margin: 0 0 0.5rem;
    color: var(--gold-dark);
    letter-spacing: 0.1em;
  }
  .t-review blockquote {
    margin: 0 0 0.75rem;
    line-height: 1.65;
    white-space: pre-line;
    color: #33445c;
  }
  .t-review__by {
    margin: 0;
    font-size: 0.92rem;
    color: #4a5b73;
  }

  /* הדרכות נוספות: תגיות לחיצות */
  .others {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .others li {
    margin: 0;
  }
  .others a {
    display: inline-block;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background: var(--white);
    border: 1px solid var(--line);
    color: var(--navy);
    font-weight: 700;
    text-decoration: none;
  }
  .others a:hover {
    border-color: var(--teal);
    color: var(--teal-dark);
  }
</style>
