---
// עמוד הדרכה בודדת. הנתונים ב-src/data/trainings.ts
import BaseLayout from '../../layouts/BaseLayout.astro';
import LightHero from '../../components/LightHero.astro';
import { atmoStyle } from '../../utils/atmo';
import { lectureReviews } from '../../data/reviews';
import chairs from '../../assets/atmosphere/light-chairs.webp';
import audience from '../../assets/atmosphere/light-audience.webp';
import road from '../../assets/atmosphere/dark-road.webp';
import { trainings, type Training } from '../../data/trainings';
import { contact } from '../../data/contact';

export function getStaticPaths() {
  return trainings.map((training) => ({ params: { slug: training.slug }, props: { training } }));
}

const { training } = Astro.props as { training: Training };
const waText = encodeURIComponent(`היי נוגה, אשמח לפרטים על ההדרכה "${training.title}"`);
const others = trainings.filter((t) => t.slug !== training.slug);
// תמונות אווירה (2026-11-07): כיתה ריקה וקהל, לסירוגין בין ההדרכות
const heroImage = trainings.indexOf(training) % 2 === 0 ? audience : chairs;
const roadStyle = await atmoStyle(road, 0.45);
// המלצות משתתפים על ההדרכה הזו (אם יש)
const myReviews = lectureReviews.filter((r) => r.training === training.slug);
---

<BaseLayout title={training.title} description={training.lead.join(' ')}>
  <LightHero image={heroImage} title={training.title} crumbs={{ href: '/trainings/', label: 'קטלוג הדרכות', current: 'הדרכה' }}>
    {training.lead.map((p) => <p>{p}</p>)}
  </LightHero>

  <section class="section">
    <div class="container t-body">
      {
        training.keyLines && (
          <>
            <h2>משפטי מפתח מההדרכה</h2>
            <ul class="keylines">
              {training.keyLines.map((line) => (
                <li>{line}</li>
              ))}
            </ul>
          </>
        )
      }
      <h2>מה נלמד בהדרכה</h2>
      <ul class="topics">
        {
          training.topics.map((topic) => (
            <li>
              <strong>{topic.title}</strong>
              {topic.text && <span>{topic.text}</span>}
            </li>
          ))
        }
      </ul>

      <h2>משך ופורמט</h2>
      <p class="format">{training.format}</p>

      <h2>למי מתאימה</h2>
      <!-- TODO: נוגה תספק למי ההדרכה מתאימה (בעלי עסקים, ארגונים, קבוצות וכד'). אין להמציא. -->
      <p class="placeholder">תוכן חסר: למי ההדרכה מתאימה.</p>
    </div>
  </section>

  {
    myReviews.length > 0 && (
      <section class="section section--mist">
        <div class="container">
          <h2 class="t-rev-title">מה אמרו משתתפים</h2>
          <ul class="t-reviews">
            {myReviews.map((r) => (
              <li class="t-review">
                <p class="t-review__stars" role="img" aria-label={`דירוג ${r.stars} מתוך 5`}>
                  {'★'.repeat(r.stars)}
                </p>
                <blockquote>{r.text}</blockquote>
                <p class="t-review__by">
                  <strong>{r.name}</strong> · מקור: {r.source}
                </p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="section section--dark t-cta atmo atmo--full" style={roadStyle}>
    <div class="container">
      <h2>להזמין את ההדרכה כהרצאה או כסדנה</h2>
      <p class="t-cta__actions">
        <a class="btn" href={`${contact.whatsapp}?text=${waText}`}>לפרטים בוואטסאפ</a>
        <a href={contact.phoneHref}>{contact.phoneDisplay}</a>
        <a href={`mailto:${contact.email}`}>{contact.email}</a>
      </p>
    </div>
  </section>

  <section class="section section--mist">
    <div class="container">
      <h2>הדרכות נוספות</h2>
      <ul class="others">
        {
          others.map((t) => (
            <li>
              <a href={`/trainings/${t.slug}/`}>{t.title}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .t-hero {
    border-bottom: 1px solid var(--line);
    padding-block: clamp(2rem, 6vw, 4rem);
  }
  .t-hero__inner,
  .t-body {
    max-width: 46rem;
  }
  .t-hero__kicker {
    font-size: 0.95rem;
    margin-bottom: 0.5rem;
  }
  .t-hero h1 {
    color: var(--teal-dark);
  }
  .t-hero__lead {
    font-weight: 700;
  }
  .t-hero__lead:last-child {
    margin-bottom: 0;
  }
  .t-body h2 {
    color: var(--teal-dark);
    margin-top: 2rem;
  }
  .t-body h2:first-child {
    margin-top: 0;
  }
  .topics {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.75rem;
    counter-reset: topic;
  }
  .topics li {
    position: relative;
    display: grid;
    gap: 0.15rem;
    padding: 1rem 1.2rem 1rem 1.2rem;
    padding-inline-start: 3.6rem;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 1rem;
    counter-increment: topic;
  }
  /* מספר בעיגול זהב, כמו בצירים ובכרטיסים באתר */
  .topics li::before {
    content: counter(topic, decimal-leading-zero);
    position: absolute;
    inset-inline-start: 1rem;
    top: 0.95rem;
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 50%;
    background: var(--gold-gradient);
    color: var(--navy);
    font-size: 0.8rem;
    font-weight: 900;
  }
  .format {
    font-weight: 700;
  }
  /* משפטי מפתח מההדרכה: טקסט צף עם פס זהב, בלי קופסאות */
  .keylines {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
  }
  .keylines li {
    padding-inline-start: 1rem;
    border-inline-start: 3px solid var(--gold-dark);
    font-size: clamp(1.08rem, 2vw, 1.2rem);
    font-weight: 800;
    line-height: 1.5;
    color: var(--navy);
  }
  .t-cta {
    text-align: center;
    padding-block: clamp(3.5rem, 9vw, 5.5rem);
  }
  .t-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    justify-content: center;
    align-items: center;
    margin: 1.5rem 0 0;
  }
  .t-cta a:not(.btn) {
    color: var(--gold-light);
  }
  /* המלצות משתתפים על ההדרכה */
  .t-rev-title {
    color: var(--teal-dark);
    margin-bottom: 1rem;
  }
  .t-reviews {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 1rem;
  }
  .t-review {
    margin: 0;
    padding: 1.35rem;
    border-radius: 1.25rem;
    background: var(--white);
    border: 1px solid var(--line);
    border-top: 4px solid var(--gold-dark);
  }
  .t-review__stars {
    margin: 0 0 0.5rem;
    color: var(--gold-dark);
    letter-spacing: 0.1em;
  }
  .t-review blockquote {
    margin: 0 0 0.75rem;
    line-height: 1.65;
    white-space: pre-line;
    color: #33445c;
  }
  .t-review__by {
    margin: 0;
    font-size: 0.92rem;
    color: #4a5b73;
  }

  /* הדרכות נוספות: תגיות לחיצות */
  .others {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .others li {
    margin: 0;
  }
  .others a {
    display: inline-block;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background: var(--white);
    border: 1px solid var(--line);
    color: var(--navy);
    font-weight: 700;
    text-decoration: none;
  }
  .others a:hover {
    border-color: var(--teal);
    color: var(--teal-dark);
  }
</style>
