---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBand from '../components/CtaBand.astro';
import YouTubeEmbed from '../components/YouTubeEmbed.astro';
---

<BaseLayout
  title="מדריכים והדרכות חינמיות"
  description="מדריכים להורדה והדרכות חינמיות לבעלי עסקים, מאת נוגה דיין אור."
>
  <PageHeader title="מדריכים והדרכות חינמיות">
    <!-- TODO: משפט פתיחה קצר לעמוד – נוגה תספק -->
    <p class="placeholder">תוכן חסר: משפט פתיחה קצר.</p>
  </PageHeader>

  <!-- מדריכי PDF להורדה, בתמורה לכתובת אימייל -->
  <section class="section">
    <div class="container">
      <h2>מדריכים להורדה</h2>
      <!-- TODO: מדריכי ה-PDF. נוגה תספק לכל מדריך: שם, משפט תיאור, וקובץ PDF.
           ההחלטה: ההורדה תהיה בתמורה לכתובת אימייל. נדרש שירות לאיסוף אימיילים (ראו סעיף 6 בסקיל).
           עד אז אין כפתור הורדה, כדי לא לפרסם את הקבצים בלי איסוף. -->
      <p class="placeholder">
        תוכן חסר: מדריכי ה-PDF. כל מדריך יורד בתמורה לכתובת אימייל, והטופס ייבנה אחרי שנבחר שירות לאיסוף אימיילים.
      </p>
    </div>
  </section>

  <!-- הדרכות חינמיות ביוטיוב -->
  <section class="section section--mist">
    <div class="container">
      <h2>הדרכות חינמיות</h2>
      <!-- TODO: נוגה תבחר אילו עוד הדרכות מהערוץ להציג. כרגע הדרכה אחת, שכותרתה ביוטיוב כוללת "הדרכה חינמית". -->
      <div class="training">
        <YouTubeEmbed
          id="QANXfOW_s-Q"
          title="נוגה דיין אור הדרכה חינמית - עסק מקצועי הוא עסק מעוצב"
        />
        <p class="training__caption">הדרכה חינמית: עסק מקצועי הוא עסק מעוצב</p>
      </div>
    </div>
  </section>

  <!-- מאמרים -->
  <section class="section">
    <div class="container">
      <h2>מאמרים</h2>
      <!-- TODO: המאמר שנוגה כתבה – נוגה תשלח את הטקסט. אין להמציא תוכן. -->
      <p class="placeholder">תוכן חסר: המאמר שנוגה כתבה. יתווסף כשיתקבל.</p>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .training {
    max-width: 48rem;
  }
  .training__caption {
    margin: 0.5rem 0 0;
    font-weight: 700;
  }
</style>
