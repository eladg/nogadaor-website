---
// תבנית בסיס לכל העמודים: כיוון עברית RTL, כותרת, ניווט ופוטר.
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SiteIndex from '../components/SiteIndex.astro';
import { graph, breadcrumbSchema, type Schema } from '../utils/schema';
// טעינה מוקדמת של הגופן (בדיקת SEO, 2026-11-08): בלי זה הטקסט מוצג קודם בגופן אחר, ואז מתחלף ל-Heebo,
// הכותרת בפתיח של הבית יורדת שורה וכל העמוד "קופץ" (CLS 0.257 במחשב). אלה אותם קבצים שה-CSS טוען.
import heeboHebrew from '@fontsource-variable/heebo/files/heebo-hebrew-wght-normal.woff2?url';
import heeboLatin from '@fontsource-variable/heebo/files/heebo-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description?: string;
  /** עמוד שלא צריך להופיע בגוגל (למשל עמוד מדיניות שעוד בהכנה) */
  noindex?: boolean;
  /** נתונים מובנים לעמוד (src/utils/schema.ts) */
  schema?: Schema[];
  /** שביל ניווט לנתונים המובנים, מהבית ועד העמוד. נכתב רק כשיש site. */
  crumbs?: { name: string; path: string }[];
}
  /** תמונת שיתוף לעמוד (וואטסאפ, פייסבוק, לינקדאין), למשל הכריכה כתמונה – src/utils/coverImages.ts */
  image?: { src: string; alt: string; width: number; height: number };
  /** article למדריכים ולמאמרים, website לכל השאר */
  ogType?: 'website' | 'article';

const { title, description = 'נוגה דיין אור – הצלחה עסקית בדרך שלך', noindex = false, schema = [], crumbs = [], image, ogType = 'website' } = Astro.props;
const fullTitle = title === 'בית' ? 'נוגה דיין אור' : `${title} | נוגה דיין אור`;
// כתובת קנונית: רק כשמוגדר site ב-astro.config.mjs (כשיהיה דומיין). אז היא מופיעה לבד בכל העמודים.
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
// תמונת שיתוף: הרשתות דורשות כתובת מלאה, ולכן גם היא נכתבת רק כשיש site.
// TODO: תמונת שיתוף כללית לעמודים בלי כריכה (בית, אודות, שירותים וכו') – בדיקת SEO, פריט 5
const ogImage = image && Astro.site ? new URL(image.src, Astro.site).href : undefined;
const ld = [...schema, breadcrumbSchema(Astro.site, crumbs)].filter(Boolean) as Schema[];
---

<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="preload" href={heeboHebrew} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={heeboLatin} as="font" type="font/woff2" crossorigin />
    <!-- תוספות לראש העמוד מעמוד מסוים (למשל טעינה מוקדמת של גופן שמשמש רק בו) -->
    <slot name="head" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="נוגה דיין אור" />
    <meta property="og:locale" content="he_IL" />
    <meta property="og:type" content={ogType} />
    {canonical && <meta property="og:url" content={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {
      ogImage && image && (
        <>
          <meta property="og:image" content={ogImage} />
          <meta property="og:image:width" content={String(image.width)} />
          <meta property="og:image:height" content={String(image.height)} />
          <meta property="og:image:alt" content={image.alt} />
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:image:alt" content={image.alt} />
        </>
      )
    }
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {ld.length > 0 && <script type="application/ld+json" set:html={graph(ld)} />}
    <!-- מסמן שיש JavaScript, כדי שאפקט ההופעה בגלילה (.reveal) יפעל רק כשאפשר -->
    <script is:inline>
      if ('IntersectionObserver' in window) document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">דילוג לתוכן הראשי</a>
    <Header currentPath={Astro.url.pathname} />
    <main id="main">
      <slot />
    </main>
    <!-- "כל מה שתמצאו באתר": בכל העמודים חוץ מעמוד הבית (נוגה, 2026-11-08) -->
    {Astro.url.pathname !== '/' && <SiteIndex />}
    <Footer />
    <!-- הופעה עדינה של אזורים בגלילה: כל אלמנט עם class="reveal" מופיע כשמגיעים אליו -->
    <script is:inline>
      (function () {
        if (!('IntersectionObserver' in window)) return;
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px' }
        );
        document.querySelectorAll('.reveal').forEach(function (el) {
          io.observe(el);
        });
      })();
    </script>
  </body>
</html>
