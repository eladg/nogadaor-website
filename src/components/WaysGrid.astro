---
// שש הקוביות של עקרונות הליווי (src/data/principles.ts), על רקע כחול. משותף לעמוד הבית ולאודות.
// במחשב ובטאבלט: אייקון, כותרת והסבר בכל קוביה (3 / 2 בשורה).
// בטלפון (נוגה, 2026-11-12): שתי קוביות בשורה, רק אייקון וכותרת. נגיעה בקוביה הופכת אותה ומציגה את ההסבר,
// בלי לפתוח עמוד חדש. נגיעה נוספת מחזירה. גובה הקוביה נקבע לפי הצד הארוך, ולכן שני הצדדים תמיד נכנסים.
// ההסבר תמיד קיים בעמוד (גם לקוראי מסך ולגוגל), ההיפוך הוא רק תצוגה.
import { ways, icons } from '../data/principles';
---

<ul class="wg">
  {
    ways.map((w, i) => (
      <li class="wg__item reveal" style={`transition-delay: ${(i % 3) * 0.1}s`}>
        <div class="wg__inner">
          <div class="wg__face wg__front">
            <span class="wg__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" set:html={icons[w.icon]} />
            </span>
            <h3 class="wg__title">{w.title}</h3>
            <span class="wg__hint" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 0 1 15.5-6.2L21 8" /><path d="M21 3v5h-5" /><path d="M21 12a9 9 0 0 1-15.5 6.2L3 16" /><path d="M3 21v-5h5" /></svg>
            </span>
          </div>
          <div class="wg__face wg__back">
            <p class="wg__text">{w.text}</p>
          </div>
        </div>
        <button type="button" class="wg__flip" aria-pressed="false">
          <span class="sr-only">היפוך הקוביה: {w.title}</span>
        </button>
      </li>
    ))
  }
</ul>

<script>
  document.querySelectorAll<HTMLButtonElement>('.wg__flip').forEach((btn) => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.wg__item');
      const on = !item?.classList.contains('is-flipped');
      item?.classList.toggle('is-flipped', on);
      btn.setAttribute('aria-pressed', String(on));
    });
  });
</script>

<style>
  .wg {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(3, 1fr);
  }
  @media (max-width: 62rem) {
    .wg {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .wg__item {
    position: relative;
    margin: 0;
  }
  .wg__inner {
    height: 100%;
    padding: 1.6rem 1.5rem 1.5rem;
    border-radius: 1.25rem;
    background: linear-gradient(160deg, rgb(255 255 255 / 0.07), rgb(255 255 255 / 0.02));
    border: 1px solid rgb(255 255 255 / 0.1);
    transition: border-color 0.3s ease;
  }
  .wg__item:hover .wg__inner {
    border-color: rgb(252 220 109 / 0.55);
  }
  .wg__icon {
    display: grid;
    place-items: center;
    width: 3.2rem;
    height: 3.2rem;
    margin-bottom: 1rem;
    border-radius: 0.9rem;
    background: var(--gold-gradient);
    color: var(--navy);
  }
  .wg__title {
    margin: 0 0 0.45rem;
    color: var(--white);
    font-size: 1.2rem;
  }
  .wg__text {
    margin: 0;
    color: var(--on-dark-soft);
    line-height: 1.65;
  }
  /* הרמז להיפוך והכפתור: רק בטלפון */
  .wg__hint,
  .wg__flip {
    display: none;
  }

  /* ---------- טלפון: שתי קוביות בשורה שמתהפכות בנגיעה ---------- */
  @media (max-width: 40rem) {
    .wg {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.75rem;
      margin-top: 1.25rem;
    }
    .wg__item {
      perspective: 900px;
    }
    /* שני הצדדים באותה משבצת, כך שהגובה נקבע לפי הצד הארוך */
    .wg__inner {
      display: grid;
      padding: 0;
      border: 0;
      background: none;
      transform-style: preserve-3d;
      transition: transform 0.6s cubic-bezier(0.22, 0.61, 0.36, 1);
    }
    .wg__item.is-flipped .wg__inner {
      transform: rotateY(180deg);
    }
    .wg__face {
      grid-area: 1 / 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 1.1rem 0.85rem;
      border-radius: 1.1rem;
      text-align: center;
      backface-visibility: hidden;
      -webkit-backface-visibility: hidden;
    }
    .wg__front {
      position: relative;
      background: linear-gradient(160deg, rgb(255 255 255 / 0.09), rgb(255 255 255 / 0.03));
      border: 1px solid rgb(255 255 255 / 0.14);
    }
    .wg__back {
      transform: rotateY(180deg);
      background: linear-gradient(160deg, var(--teal), var(--teal-dark));
      border: 1px solid rgb(255 255 255 / 0.14);
    }
    .wg__icon {
      width: 2.75rem;
      height: 2.75rem;
      margin-bottom: 0.7rem;
      border-radius: 0.8rem;
    }
    .wg__title {
      margin: 0;
      font-size: 1.02rem;
      line-height: 1.35;
    }
    .wg__text {
      font-size: 0.86rem;
      line-height: 1.5;
      color: var(--white);
    }
    .wg__hint {
      display: block;
      position: absolute;
      bottom: 0.55rem;
      left: 0.6rem;
      color: var(--gold-light);
      opacity: 0.75;
    }
    /* כל הקוביה היא כפתור שקוף להיפוך */
    .wg__flip {
      display: block;
      position: absolute;
      inset: 0;
      z-index: 1;
      width: 100%;
      padding: 0;
      border: 0;
      border-radius: 1.1rem;
      background: transparent;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
    }
    .wg__flip:focus-visible {
      outline: 3px solid var(--gold-light);
      outline-offset: 2px;
    }
  }
  @media (max-width: 40rem) and (prefers-reduced-motion: reduce) {
    .wg__inner {
      transition: none;
    }
  }
</style>
