---
// קרוסלה של המלצות כתובות: שורה אחת שזזה לצדדים, עם החלפה אוטומטית.
// התנועה והכפתורים מגיעים מהרכיב Carousel. כאן רק עיצוב כרטיס ההמלצה.
// כלל של נוגה: בכל המלצה מוצגים שם ומקור, באותו עיצוב לכל המקורות, בלי תאריכים.
import Carousel from './Carousel.astro';
import type { Review } from '../data/reviews';

interface Props {
  reviews: Review[];
  label?: string;
}
const { reviews, label = 'המלצות לקוחות' } = Astro.props;
// האות הראשונה של השם, לעיגול שליד השם
const initial = (name: string) => name.trim().charAt(0);
---

<Carousel label={label} auto itemWidth="min(86%, 23rem)">
  {
    reviews.map((r) => (
      <li class="review">
        <figure>
          <span class="review__mark" aria-hidden="true">”</span>
          <p class="review__stars" role="img" aria-label={`דירוג ${r.stars} מתוך 5`}>
            {'★'.repeat(r.stars)}
          </p>
          <blockquote class="review__text">{r.text}</blockquote>
          <button type="button" class="review__more" hidden aria-expanded="false">
            קרא עוד
          </button>
          <span class="review__spacer" aria-hidden="true" />
          <figcaption class="review__by">
            <span class="review__avatar" aria-hidden="true">
              {initial(r.name)}
            </span>
            <span>
              <span class="review__name">{r.name}</span>
              <span class="review__source">מקור: {r.source}</span>
            </span>
          </figcaption>
        </figure>
      </li>
    ))
  }
</Carousel>

<script>
  // "קרא עוד" רק להמלצות ארוכות
  document.querySelectorAll<HTMLElement>('.review').forEach((card) => {
    const text = card.querySelector<HTMLElement>('.review__text')!;
    const more = card.querySelector<HTMLButtonElement>('.review__more')!;
    if (text.scrollHeight > text.clientHeight + 2) {
      more.hidden = false;
      more.addEventListener('click', () => {
        const open = card.classList.toggle('is-open');
        more.textContent = open ? 'הצג פחות' : 'קרא עוד';
        more.setAttribute('aria-expanded', String(open));
      });
    }
  });
</script>

<style>
  .review figure {
    position: relative;
    margin: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 1rem;
    padding: 1.5rem 1.5rem 1.25rem;
    box-shadow: 0 6px 20px rgb(11 26 51 / 0.06);
  }
  /* מירכאה גדולה ועדינה בפינה */
  .review__mark {
    position: absolute;
    top: 0.25rem;
    inset-inline-end: 1rem;
    font-size: 4.5rem;
    line-height: 1;
    font-family: Georgia, serif;
    color: var(--gold-light);
    opacity: 0.7;
  }
  .review__stars {
    margin: 0 0 0.75rem;
    color: var(--gold-dark);
    letter-spacing: 0.12em;
    font-size: 1.1rem;
  }
  .review__text {
    margin: 0;
    white-space: pre-line;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 7;
    line-clamp: 7;
    overflow: hidden;
  }
  .review.is-open .review__text {
    display: block;
    -webkit-line-clamp: unset;
    line-clamp: unset;
  }
  .review__more {
    align-self: flex-start;
    margin-top: 0.5rem;
    padding: 0;
    background: none;
    border: 0;
    color: var(--teal-dark);
    font: inherit;
    font-weight: 700;
    text-decoration: underline;
    cursor: pointer;
  }
  /* דוחף את שם הממליץ לתחתית הכרטיס, עם רווח מינימלי מהטקסט */
  .review__spacer {
    flex: 1 0 1.1rem;
  }
  .review__by {
    padding-top: 1rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border-top: 1px solid var(--line);
  }
  .review__avatar {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    background: var(--mist);
    border: 2px solid var(--teal);
    color: var(--teal-dark);
    font-weight: 700;
  }
  .review__name {
    display: block;
    font-weight: 700;
    color: var(--navy);
    line-height: 1.3;
  }
  .review__source {
    display: block;
    font-size: 0.9rem;
    color: var(--teal-dark);
  }
</style>
