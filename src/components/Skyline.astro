---
// קו רקיע לילי של מגדלים (נוגה, 2026-11-08: "פי 100 יותר מרשים", רקע כהה, בניינים אמיתיים ולא לגו).
// כל תחום הוא מגדל בסגנון אחר (צריח, מדרגות, חזית רחבה, גג מעוגל, מגדל צר עם אנטנה, כתר משולש, בניין עם מגדל מים).
// שם התחום מעל המגדל, והפירוט מתחת לקו הקרקע בבולטים עם כוכבים. החלונות נבחרים בקוד (אותו דפוס בכל טעינה).
// במעבר עכבר המגדל "נדלק". ברקע קו רקיע רחוק ושקוף וזוהר אופק. בטלפון גוללים לצדדים.
import Star from './Star.astro';
import { areas } from '../data/services';

// מחולל אקראי קבוע, כדי שהחלונות ייראו אותו דבר בכל בנייה
let seed = 7;
const rand = () => ((seed = (seed * 9301 + 49297) % 233280) / 233280);

type Win = { x: number; y: number; w: number; h: number; on: boolean };
const grid = (x0: number, y0: number, x1: number, y1: number, cols: number, rowH: number, ww: number, wh: number, lit = 0.32) => {
  const out: Win[] = [];
  const cw = (x1 - x0) / cols;
  for (let y = y0 + 6; y + wh < y1 - 4; y += rowH) {
    for (let c = 0; c < cols; c++) out.push({ x: x0 + c * cw + (cw - ww) / 2, y, w: ww, h: wh, on: rand() < lit });
  }
  return out;
};

const W = 120;
// שבעה מגדלים. H: גובה בתוך ה-viewBox. shape: קווי המתאר. wins: החלונות.
const towers = [
  // שיווק: מגדל זכוכית עם גג מעוגל
  { H: 330, shape: `M28 330 L28 78 Q60 8 92 78 L92 330 Z`, wins: grid(32, 80, 88, 330, 5, 15, 6, 8) },
  // מכירות: גורד שחקים במדרגות (ארט דקו) עם אנטנה
  { H: 400, shape: `M12 400 L12 210 L24 210 L24 130 L38 130 L38 62 L82 62 L82 130 L96 130 L96 210 L108 210 L108 400 Z`, antenna: [60, 62, 60, 10], wins: [...grid(42, 64, 78, 130, 3, 15, 6, 8), ...grid(28, 132, 92, 210, 5, 15, 6, 8), ...grid(16, 212, 104, 400, 7, 15, 6, 8)] },
  // כספים: בניין משרדים רחב עם פסי זכוכית אופקיים
  { H: 270, shape: `M6 270 L6 74 L114 74 L114 270 Z M34 74 L34 54 L66 54 L66 74 Z`, bands: true, wins: grid(10, 76, 110, 270, 9, 14, 8, 6, 0.38) },
  // תהליכי ניהול: מגדל עם כתר משולש
  { H: 360, shape: `M20 360 L20 96 L60 30 L100 96 L100 360 Z`, wins: grid(24, 98, 96, 360, 6, 15, 6, 8) },
  // טכנולוגיה ו-AI: המגדל הגבוה והצר, עם צלעות אנכיות ואנטנה
  { H: 430, shape: `M38 430 L38 46 L82 46 L82 430 Z`, antenna: [60, 46, 60, 0], fins: true, wins: grid(41, 50, 79, 430, 3, 14, 7, 9, 0.4) },
  // שירות ולקוחות: בניין בינוני עם מגדל מים על הגג
  { H: 290, shape: `M14 290 L14 112 L106 112 L106 290 Z`, tank: true, wins: grid(18, 114, 102, 290, 7, 15, 6, 8) },
  // פיתוח עסקי: מגדל צריח שמתחדד למעלה
  { H: 380, shape: `M30 380 L30 92 L44 92 L60 26 L76 92 L90 92 L90 380 Z`, antenna: [60, 26, 60, 4], wins: grid(34, 96, 86, 380, 5, 15, 6, 8) },
];
const MAXH = 430;

// קו רקיע רחוק ברקע (שקוף)
const back: { x: number; w: number; h: number }[] = [];
for (let x = 0; x < 1400; ) {
  const w = 30 + rand() * 60;
  back.push({ x, w, h: 90 + rand() * 210 });
  x += w + 4;
}
// כוכבים קטנים בשמיים
const stars = Array.from({ length: 60 }, () => ({ x: rand() * 1400, y: rand() * 220, r: rand() < 0.15 ? 1.4 : 0.8, o: 0.3 + rand() * 0.6 }));
---

<div class="skyline">
  <svg class="skyline__bg" viewBox="0 0 1400 520" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
    <defs>
      <radialGradient id="sk-glow" cx="50%" cy="100%" r="70%">
        <stop offset="0" stop-color="#fcdc6d" stop-opacity="0.28" />
        <stop offset="0.35" stop-color="#199ab5" stop-opacity="0.18" />
        <stop offset="1" stop-color="#0b1a33" stop-opacity="0" />
      </radialGradient>
    </defs>
    <rect width="1400" height="520" fill="url(#sk-glow)" />
    {stars.map((s) => <circle cx={s.x} cy={s.y} r={s.r} fill="#fff" opacity={s.o} />)}
    {back.map((b) => <rect x={b.x} y={520 - b.h} width={b.w} height={b.h} fill="#13284a" opacity="0.55" />)}
  </svg>

  <ul class="skyline__row" aria-label="התחומים שהליווי מסתכל עליהם">
    {
      areas.map((a, i) => {
        const t = towers[i % towers.length];
        return (
          <li class="tower" style={`--th: calc(var(--zone) * ${(t.H / MAXH).toFixed(3)})`}>
            <h3 class="tower__title">{a.title}</h3>
            <svg class="tower__svg" viewBox={`0 0 ${W} ${t.H}`} aria-hidden="true">
              <defs>
                <linearGradient id={`tw-${i}`} x1="0" y1="0" x2="1" y2="0">
                  <stop offset="0" stop-color="#2a5288" />
                  <stop offset="0.45" stop-color="#173563" />
                  <stop offset="1" stop-color="#0a1830" />
                </linearGradient>
                <linearGradient id={`tw-sheen-${i}`} x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-color="#7fd3e6" stop-opacity="0.22" />
                  <stop offset="0.5" stop-color="#7fd3e6" stop-opacity="0" />
                </linearGradient>
              </defs>
              {t.antenna && <line class="tower__antenna" x1={t.antenna[0]} y1={t.antenna[1]} x2={t.antenna[2]} y2={t.antenna[3]} />}
              {t.antenna && <circle class="tower__beacon" cx={t.antenna[2]} cy={t.antenna[3] + 2} r="2.2" />}
              {t.tank && (
                <g class="tower__tank">
                  <rect x="70" y="84" width="22" height="16" rx="3" />
                  <line x1="74" y1="100" x2="72" y2="112" />
                  <line x1="88" y1="100" x2="90" y2="112" />
                </g>
              )}
              <path d={t.shape} fill={`url(#tw-${i})`} class="tower__body" />
              <path d={t.shape} fill={`url(#tw-sheen-${i})`} />
              {t.fins && [44, 52, 60, 68, 76].map((x) => <line class="tower__fin" x1={x} y1="46" x2={x} y2={t.H} />)}
              {t.wins.map((w) => (
                <rect class={w.on ? 'win win--on' : 'win'} x={w.x.toFixed(1)} y={w.y.toFixed(1)} width={t.bands ? w.w + 3 : w.w} height={w.h} rx="0.6" />
              ))}
              <path d={t.shape} fill="none" class="tower__edge" />
            </svg>
            <ul class="tower__points">
              {a.points.map((p) => (
                <li>
                  <Star size={11} />
                  <span>{p}</span>
                </li>
              ))}
            </ul>
          </li>
        );
      })
    }
  </ul>
</div>

<style>
  .skyline {
    --zone: clamp(15rem, 30vw, 24rem);
    position: relative;
    margin-top: 2rem;
  }
  .skyline__bg {
    position: absolute;
    inset: 0 0 auto 0;
    width: 100%;
    height: calc(var(--zone) + 4rem);
  }
  .skyline__row {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: center;
  }
  .tower {
    flex: 1 1 0;
    max-width: 11rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  /* אזור המגדל בגובה קבוע, כך שקו הקרקע ישר לאורך כל השורה */
  .tower__title {
    order: 0;
    margin: 0;
    min-height: calc(var(--zone) + 4rem);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    /* הכותרת נגמרת בדיוק מעל ראש המגדל */
    padding-bottom: calc(var(--th) + 0.7rem);
    font-size: 1rem;
    font-weight: 800;
    line-height: 1.3;
    color: var(--white);
    transition: color 0.3s ease;
  }
  .tower__svg {
    display: block;
    height: var(--th);
    width: auto;
    max-width: 100%;
    overflow: visible;
  }
  /* הכותרת יושבת מעל המגדל: האזור כולו בגובה קבוע, והמגדל נצמד לתחתיתו */
  .tower {
    position: relative;
  }
  .tower__title {
    position: relative;
    z-index: 1;
  }
  .tower__svg {
    position: absolute;
    top: calc(var(--zone) + 4rem);
    transform: translateY(-100%);
  }
  .tower__body {
    transition: filter 0.4s ease;
  }
  .tower__edge {
    stroke: rgb(127 211 230 / 0.35);
    stroke-width: 0.8;
  }
  .tower__antenna,
  .tower__fin,
  .tower__tank line {
    stroke: rgb(127 211 230 / 0.45);
    stroke-width: 1;
  }
  .tower__fin {
    stroke: rgb(127 211 230 / 0.18);
  }
  .tower__tank rect {
    fill: #13284a;
    stroke: rgb(127 211 230 / 0.35);
    stroke-width: 0.8;
  }
  .tower__beacon {
    fill: #ff6b6b;
    animation: beacon 2.4s ease-in-out infinite;
  }
  @keyframes beacon {
    0%,
    100% {
      opacity: 0.25;
    }
    50% {
      opacity: 1;
    }
  }
  .win {
    fill: rgb(255 255 255 / 0.07);
    transition: fill 0.5s ease;
  }
  .win--on {
    fill: rgb(252 220 109 / 0.85);
  }
  /* במעבר עכבר: המגדל נדלק */
  .tower:hover .win {
    fill: rgb(252 220 109 / 0.55);
  }
  .tower:hover .win--on {
    fill: #fff3c4;
  }
  .tower:hover .tower__body {
    filter: brightness(1.25);
  }
  .tower:hover .tower__title {
    color: var(--gold-light);
  }
  /* קו הקרקע וזוהר עדין מתחתיו */
  .skyline__row::after {
    content: '';
    position: absolute;
    top: calc(var(--zone) + 4rem);
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(to left, transparent, rgb(252 220 109 / 0.7), transparent);
    box-shadow: 0 0 18px 2px rgb(252 220 109 / 0.35);
  }
  .tower__points {
    list-style: none;
    margin: 1.1rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
    justify-items: start;
  }
  .tower__points li {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
    font-size: 0.88rem;
    color: var(--on-dark-soft);
  }
  /* טאבלט וטלפון: אותו קו רקיע, גוללים לצדדים */
  @media (max-width: 60rem) {
    .skyline__row {
      justify-content: flex-start;
      overflow-x: auto;
      padding-bottom: 0.75rem;
      scroll-snap-type: x proximity;
    }
    .tower {
      flex: 0 0 9.5rem;
      scroll-snap-align: start;
    }
    .skyline__row::after {
      display: none;
    }
    .tower__points {
      border-top: 1px solid rgb(252 220 109 / 0.6);
      padding-top: 0.9rem;
      margin-top: 0;
    }
    .tower__title {
      margin-bottom: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tower__beacon {
      animation: none;
    }
    .win,
    .tower__body,
    .tower__title {
      transition: none;
    }
  }
</style>
