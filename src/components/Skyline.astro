---
// קו רקיע מאויר (נוגה, 2026-11-08, גרסה 3): בהשראת תמונת קיר ששלחה נוגה, בלי להעתיק. רק העיר, בלי שמש, עננים ומים.
// עיר אחת צפופה ושלמה, ולא מגדלים בודדים: שכבת בניינים רחוקה בכחול פלדה, שכבה אמצעית, ובחזית שבעה מגדלים
// בולטים, אחד לכל תחום, עם חלונות מוארים בזהב וכתום. מאחור שמש זהב גדולה ועננים שטוחים, ולמטה מים עם השתקפויות.
// שם התחום מעל המגדל שלו, והבולטים עם כוכבים מתחת לקו המים, באותו טור. במעבר עכבר המגדל נדלק.
// בטלפון: האיור מעל, והתחומים ברשימה מתחת.
import Star from './Star.astro';
import { areas } from '../data/services';

let seed = 11;
const rand = () => ((seed = (seed * 9301 + 49297) % 233280) / 233280);

const VW = 1400, VH = 450, G = 430; // G: קו הקרקע. בלי שמש, עננים ומים (נוגה, 2026-11-08)
const n = areas.length;
const colW = VW / n;
// הראשון בימין (עברית)
const cx = (i: number) => VW - colW * (i + 0.5);

type R = { x: number; y: number; w: number; h: number };
// שכבה רחוקה ושכבה אמצעית
const layer = (minH: number, maxH: number, minW: number, maxW: number) => {
  const out: R[] = [];
  for (let x = 20; x < VW - 20; ) {
    const w = minW + rand() * (maxW - minW);
    const h = minH + rand() * (maxH - minH);
    out.push({ x, y: G - h, w, h });
    x += w + 2 + rand() * 6;
  }
  return out;
};
const far = layer(70, 200, 38, 80);
const mid = layer(100, 250, 40, 75);

// חלונות: טורים של חלונות צרים, חלקם מוארים
const windows = (x0: number, y0: number, x1: number, cols: number, lit = 0.45) => {
  const out: (R & { c: string })[] = [];
  const cw = (x1 - x0) / cols;
  for (let y = y0 + 10; y < G - 12; y += 15) {
    for (let c = 0; c < cols; c++) {
      const on = rand() < lit;
      out.push({ x: x0 + c * cw + cw / 2 - 2.5, y, w: 5, h: 8, c: on ? (rand() < 0.7 ? '#fcdc6d' : '#f2a65a') : '' });
    }
  }
  return out;
};

// שבעה מגדלים בחזית, בצורות שונות. top: ראש המגדל (לשם התחום)
const shapes = [
  (x: number) => { const w = 78, h = 300, l = x - w / 2; return { top: G - h - 20, d: `M${l} ${G} V${G - h} Q${x} ${G - h - 40} ${l + w} ${G - h} V${G} Z`, win: windows(l + 6, G - h, l + w - 6, 6) }; },
  (x: number) => { const l = x - 48; return { top: G - 352, d: `M${l} ${G} V${G - 190} H${l + 12} V${G - 270} H${l + 26} V${G - 330} H${l + 70} V${G - 270} H${l + 84} V${G - 190} H${l + 96} V${G} Z M${x - 1.5} ${G - 330} h3 v-22 h-3 z`, win: windows(l + 16, G - 268, l + 80, 6) }; },
  (x: number) => { const w = 104, h = 210, l = x - w / 2; return { top: G - h - 22, d: `M${l} ${G} V${G - h} H${l + w} V${G} Z M${l + 24} ${G - h} v-22 h34 v22 z`, win: windows(l + 6, G - h, l + w - 6, 9, 0.5) }; },
  (x: number) => { const w = 84, h = 270, l = x - w / 2; return { top: G - h - 62, d: `M${l} ${G} V${G - h} L${x} ${G - h - 62} L${l + w} ${G - h} V${G} Z`, win: windows(l + 6, G - h, l + w - 6, 6) }; },
  (x: number) => { const w = 54, h = 360, l = x - w / 2; return { top: G - h - 50, d: `M${l} ${G} V${G - h} H${l + w} V${G} Z M${x - 1.5} ${G - h} h3 v-50 h-3 z`, win: windows(l + 5, G - h, l + w - 5, 4, 0.55) }; },
  (x: number) => { const w = 96, h = 230, l = x - w / 2; return { top: G - h - 44, d: `M${l} ${G} V${G - h} H${l + w} V${G} Z M${x - 26} ${G - h} a26 30 0 0 1 52 0 z M${x - 1.5} ${G - h - 30} h3 v-14 h-3 z`, win: windows(l + 6, G - h, l + w - 6, 7) }; },
  (x: number) => { const l = x - 40; return { top: G - 378, d: `M${l} ${G} V${G - 260} H${l + 14} V${G - 300} L${x} ${G - 360} L${l + 66} ${G - 300} V${G - 260} H${l + 80} V${G} Z M${x - 1.5} ${G - 360} h3 v-18 h-3 z`, win: windows(l + 6, G - 258, l + 74, 6) }; },
];
const front = areas.map((a, i) => {
  const x = cx(i);
  const s = shapes[i % shapes.length](x);
  return { ...a, x, ...s, labelLeft: (x / VW) * 100, labelTop: ((s.top - 10) / VH) * 100 };
});
// בניינים נמוכים בחזית בין המגדלים, כדי שהעיר תהיה צפופה
const fillers: R[] = [];
for (let i = 0; i < n - 1; i++) {
  const x = VW - colW * (i + 1);
  const w = 44 + rand() * 30, h = 90 + rand() * 90;
  fillers.push({ x: x - w / 2, y: G - h, w, h });
}

---

<div class="sky">
  <div class="sky__art">
    <svg viewBox={`0 0 ${VW} ${VH}`} aria-hidden="true" class="sky__svg">
      <g fill="#6f8db1">{far.map((r) => <rect x={r.x} y={r.y} width={r.w} height={r.h} />)}</g>
      <g fill="#3b5d88">{mid.map((r) => <rect x={r.x} y={r.y} width={r.w} height={r.h} />)}</g>
      <g fill="#1a3459">{fillers.map((r) => <rect x={r.x} y={r.y} width={r.w} height={r.h} />)}</g>
      {
        front.map((f) => (
          <g class="sky__tower">
            <path d={f.d} fill="#13284a" />
            {f.win.map((w) => <rect class={w.c ? 'sky__win sky__win--on' : 'sky__win'} x={w.x.toFixed(1)} y={w.y.toFixed(1)} width={w.w} height={w.h} fill={w.c || undefined} />)}
          </g>
        ))
      }
      <rect x="0" y={G} width={VW} height="4" fill="#13284a" />
    </svg>
    {
      front.map((f) => (
        <h3 class="sky__label" style={`left: ${f.labelLeft.toFixed(2)}%; top: ${f.labelTop.toFixed(2)}%`}>
          {f.title}
        </h3>
      ))
    }
  </div>

  <ul class="sky__points" aria-label="התחומים שהליווי מסתכל עליהם">
    {
      areas.map((a) => (
        <li>
          <strong class="sky__name">{a.title}</strong>
          <ul>
            {a.points.map((p) => (
              <li>
                <Star size={11} />
                <span>{p}</span>
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>
</div>

<style>
  /* קטן ומאופק: רק המחשה (נוגה, 2026-11-08: "תופס חצי עמוד על שטות") */
  .sky {
    max-width: 50rem;
    margin-inline: auto;
  }
  .sky__art {
    position: relative;
    margin-top: 1.5rem;
  }
  .sky__svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .sky__label {
    position: absolute;
    transform: translate(-50%, -100%);
    margin: 0;
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.85);
    box-shadow: 0 6px 16px -10px rgb(11 26 51 / 0.5);
    font-size: clamp(0.72rem, 1.1vw, 0.85rem);
    font-weight: 800;
    color: var(--navy);
    white-space: nowrap;
  }
  .sky__win {
    fill: rgb(255 255 255 / 0.1);
    transition: fill 0.4s ease;
  }
  .sky__tower:hover .sky__win {
    fill: #fcdc6d;
  }
  /* הבולטים: טור אחד מתחת לכל מגדל */
  .sky__points {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(7, 1fr);
  }
  .sky__points > li {
    margin: 0;
    padding-inline: 0.4rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .sky__name {
    display: none;
  }
  .sky__points ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.3rem;
  }
  .sky__points ul li {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0;
    font-size: 0.8rem;
    color: #33445c;
  }
  /* טלפון וטאבלט: האיור מעל, והתחומים ברשימה בשני טורים, עם שם התחום */
  @media (max-width: 52rem) {
    .sky__label {
      display: none;
    }
    .sky__points {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem 1rem;
      margin-top: 1.25rem;
    }
    .sky__points > li {
      align-items: flex-start;
    }
    .sky__name {
      display: block;
      margin-bottom: 0.4rem;
      color: var(--navy);
    }
  }
</style>
