---
// כריכת מדריך: הדמיה של ספר ומעליו טאבלט, באותו סגנון של המדריכים של נוגה ב-Canva
// (רקע בהיר עם רשת נקודות וקווים, קווי זהב, כותרת בכחול, הלוגו למעלה).
// כל המדריכים מקבלים את אותו סגנון. variant משנה רק את סידור הרשת ואת האייקון,
// כדי שכל כריכה תהיה מעט שונה. הכריכה מצוירת בקוד, ולכן אין קובץ תמונה לכל מדריך.
// size="lg": ספר וטאבלט (בראש עמוד המדריך). size="sm": ספר בלבד (בכרטיסים).
interface Props {
  title: string;
  subtitle?: string;
  variant?: number;
  size?: 'lg' | 'sm';
  label?: string; // "מדריך" / "מאמר"
}
const { title, subtitle, variant = 0, size = 'lg', label = 'מדריך' } = Astro.props;

// רשת נקודות דטרמיניסטית לפי variant (בלי אקראיות, כדי שכל בנייה תיראה אותו דבר)
function rand(seed: number) {
  let s = seed * 9301 + 49297;
  return () => {
    s = (s * 9301 + 49297) % 233280;
    return s / 233280;
  };
}
const r = rand(variant + 3);
const nodes = Array.from({ length: 16 }, () => ({ x: Math.round(r() * 300), y: Math.round(r() * 420), s: 3 + Math.round(r() * 9) }));
const links: [number, number][] = [];
nodes.forEach((n, i) => {
  const near = nodes
    .map((m, j) => ({ j, d: (m.x - n.x) ** 2 + (m.y - n.y) ** 2 }))
    .filter((o) => o.j !== i)
    .sort((a, b) => a.d - b.d)
    .slice(0, 2);
  near.forEach((o) => i < o.j && links.push([i, o.j]));
});
const net = `${links.map(([a, b]) => `<line x1="${nodes[a].x}" y1="${nodes[a].y}" x2="${nodes[b].x}" y2="${nodes[b].y}"/>`).join('')}${nodes
  .map((n) => `<circle cx="${n.x}" cy="${n.y}" r="${n.s}"/>`)
  .join('')}`;
---

<div class:list={['gc', `gc--${size}`]} aria-hidden="true">
  <div class="gc__book">
    <svg class="gc__net" viewBox="0 0 300 420" preserveAspectRatio="xMidYMid slice" set:html={net} />
    <div class="gc__face">
      <img class="gc__logo" src="/images/logo-color-transparent.webp" alt="" width="120" height="60" loading="lazy" />
      <span class="gc__label">{label}</span>
      <span class="gc__rule"></span>
      <span class="gc__title">{title}</span>
      {subtitle && size === 'lg' && <span class="gc__sub">{subtitle}</span>}
      <span class="gc__rule"></span>
      <span class="gc__author">נוגה דיין אור</span>
    </div>
    <span class="gc__band"></span>
  </div>
  {
    size === 'lg' && (
      <div class="gc__tablet">
        <div class="gc__screen">
          <svg class="gc__net" viewBox="0 0 300 420" preserveAspectRatio="xMidYMid slice" set:html={net} />
          <div class="gc__face gc__face--mini">
            <img class="gc__logo" src="/images/logo-color-transparent.webp" alt="" width="120" height="60" loading="lazy" />
            <span class="gc__rule"></span>
            <span class="gc__title">{title}</span>
            <span class="gc__rule"></span>
          </div>
        </div>
      </div>
    )
  }
</div>

<style>
  .gc {
    position: relative;
    container-type: inline-size;
    width: 100%;
    aspect-ratio: 1 / 1.08;
  }
  .gc--sm {
    aspect-ratio: 0.72;
  }

  /* הספר */
  .gc__book {
    position: absolute;
    inset-block: 0 4%;
    inset-inline-end: 2%;
    width: 72%;
    overflow: hidden;
    border-radius: 14px 4px 4px 14px; /* בספר עברי השדרה מימין */
    background: linear-gradient(160deg, #ffffff 0%, #eef6f9 55%, #dcecf2 100%);
    box-shadow:
      inset -10px 0 14px -8px rgb(11 26 51 / 0.28),
      28px 34px 50px -26px rgb(7 17 31 / 0.65);
    transform: perspective(1400px) rotateY(-14deg) rotateX(2deg);
    transform-origin: right center;
  }
  .gc--sm .gc__book {
    inset: 0;
    width: 100%;
    transform: none;
    border-radius: 12px 6px 6px 12px;
    box-shadow:
      inset -8px 0 12px -8px rgb(11 26 51 / 0.25),
      0 18px 30px -20px rgb(7 17 31 / 0.55);
  }
  .gc__net {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: #fff;
    stroke: #fff;
    stroke-width: 1.6;
    opacity: 0.95;
    filter: drop-shadow(0 0 2px rgb(25 154 181 / 0.25));
  }
  .gc__face {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3.2cqi;
    padding: 9cqi 7cqi 12cqi;
    text-align: center;
  }
  .gc__logo {
    position: absolute;
    top: 5cqi;
    width: 26cqi;
    height: auto;
  }
  .gc--sm .gc__logo {
    width: 34cqi;
  }
  .gc__label {
    font-size: 4cqi;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--teal-dark);
  }
  .gc--sm .gc__label {
    font-size: 6.5cqi;
  }
  .gc__rule {
    width: 78%;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--gold-dark), var(--gold-light), var(--gold-dark), transparent);
  }
  .gc__title {
    font-size: 7.4cqi;
    font-weight: 900;
    line-height: 1.15;
    color: var(--teal);
    text-wrap: balance;
  }
  .gc--sm .gc__title {
    font-size: 11cqi;
  }
  .gc__sub {
    font-size: 3.6cqi;
    font-weight: 700;
    line-height: 1.35;
    color: var(--navy);
    text-wrap: balance;
  }
  .gc__author {
    position: absolute;
    bottom: 5.5cqi;
    font-size: 3.4cqi;
    font-weight: 800;
    color: var(--white);
    z-index: 1;
  }
  .gc--sm .gc__author {
    font-size: 5.5cqi;
    bottom: 3.5cqi;
  }
  .gc__band {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 11cqi;
    background: linear-gradient(90deg, var(--teal), #7cc6d6 55%, var(--teal));
  }
  .gc--sm .gc__band {
    height: 16cqi;
  }

  /* הטאבלט */
  .gc__tablet {
    position: absolute;
    inset-inline-start: 2%;
    bottom: 0;
    width: 44%;
    aspect-ratio: 0.74;
    padding: 2.2cqi;
    border-radius: 4.5cqi;
    background: linear-gradient(145deg, #2a3446, #0b111c);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.08) inset,
      24px 30px 44px -22px rgb(7 17 31 / 0.75);
    transform: perspective(1200px) rotateY(10deg) rotateZ(-2deg);
  }
  .gc__screen {
    position: relative;
    height: 100%;
    overflow: hidden;
    border-radius: 2.6cqi;
    background: linear-gradient(160deg, #ffffff 0%, #eef6f9 60%, #d6e9f0 100%);
  }
  .gc__face--mini {
    gap: 2.2cqi;
    padding: 6cqi 3.5cqi;
  }
  .gc__face--mini .gc__logo {
    top: 3cqi;
    width: 14cqi;
  }
  .gc__face--mini .gc__title {
    font-size: 4.2cqi;
  }
</style>
