---
// מעבר לחלק חדש בתוך מדריך (נוגה, 2026-11-10): כותרת שקטה בין שני קווי זהב, ומכאן מספור הסעיפים מתחיל מחדש.
// שימוש בקובץ mdx:  <Part title="החלק המעשי" />
// התבנית ([slug].astro) מזהה את הרכיב בגוף המדריך ומחלקת גם את תוכן העניינים לשני חלקים.
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<div class="part-g" id="part-2">
  <p class="part-g__title">{title}</p>
</div>

<style>
  .part-g {
    /* מספור הסעיפים מתחיל מחדש אחרי הרכיב: מונה נפרד (g-h2b), שהכותרות שאחרי הרכיב משתמשות בו (הכלל ב-[slug].astro).
       איפוס של g-h2 עצמו לא עובד בדפדפן, כי המונה נוצר ברכיב האב */
    counter-reset: g-h2b;
    scroll-margin-top: 6rem;
    display: flex;
    align-items: center;
    gap: 1.1rem;
    margin: 3.5rem 0 0.5rem;
  }
  .part-g::before,
  .part-g::after {
    content: '';
    flex: 1;
    height: 2px;
    border-radius: 2px;
    background: var(--gold-gradient);
  }
  .part-g__title {
    margin: 0;
    font-size: clamp(1.25rem, 3vw, 1.55rem);
    font-weight: 900;
    line-height: 1.3;
    text-align: center;
    color: var(--teal-dark);
  }
</style>
