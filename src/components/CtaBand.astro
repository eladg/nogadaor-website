---
// אזור קריאה לפעולה כהה, שמופיע בתחתית העמודים.
import { contact } from '../data/contact';
interface Props {
  buttonLabel?: string;
}
const { buttonLabel = 'קביעת שיחת היכרות' } = Astro.props;
---

<section class="section section--dark cta-band">
  <div class="container">
    <!-- הנוסח מתוך הטיוטות של נוגה ("הנעה לפעולה לדוגמה לפני טופס", drafts/services-background-drafts.md). טיוטה לאישור (2026-11-07). -->
    <h2>מרגישים שיש בעסק פוטנציאל <span class="hl">שלא מתממש עד הסוף?</span></h2>
    <p class="cta-band__lead">ביחד הרבה יותר קל לדייק, להחליט ולהניע מהלכים.</p>
    <!-- הכפתור פותח את דף קביעת הפגישות ביומן גוגל (contact.booking) -->
    <p><a class="btn" href={contact.booking} target="_blank" rel="noopener">{buttonLabel}<span class="sr-only"> (נפתח בלשונית חדשה)</span></a></p>
    <p class="cta-band__note"><a href={contact.whatsapp} target="_blank" rel="noopener">{contact.bookingNote}</a></p>
  </div>
</section>

<style>
  .cta-band {
    text-align: center;
  }
  .cta-band__note {
    margin: -0.25rem 0 0;
    font-size: 0.95rem;
  }
  .cta-band__note a {
    color: var(--on-dark-soft);
  }
  .cta-band {
    background:
      radial-gradient(40rem 22rem at 50% 0, rgb(25 154 181 / 0.22), transparent 70%),
      radial-gradient(30rem 18rem at 50% 100%, rgb(209 154 74 / 0.14), transparent 72%),
      var(--navy);
  }
  .cta-band h2 {
    font-size: clamp(1.7rem, 4.4vw, 2.5rem);
    font-weight: 900;
    max-width: 44rem;
    margin-inline: auto;
  }
  .cta-band__lead {
    max-width: 36rem;
    margin: 0 auto 1.5rem;
    font-size: 1.15rem;
    color: var(--on-dark);
  }
</style>
