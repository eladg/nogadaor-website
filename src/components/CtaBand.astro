---
// אזור קריאה לפעולה כהה, שמופיע בתחתית העמודים.
import { getImage } from 'astro:assets';
import { contact } from '../data/contact';
// תמונת אווירה (AI, נוגה 2026-11-07): דרך מוארת אל הזריחה, "העולם דוהר קדימה"
import road from '../assets/atmosphere/dark-road.webp';
const roadBg = await getImage({ src: road, width: 1800, format: 'webp' });
interface Props {
  buttonLabel?: string;
}
const { buttonLabel = 'קביעת שיחת היכרות' } = Astro.props;
---

<section class="section section--dark cta-band" style={`--bg: url(${roadBg.src})`}>
  <div class="container cta-band__inner">
    <!-- הכיוון של נוגה (2026-11-07): "העסק שלך חייב לגדול" + "הצלחה עסקית בדרך שלך" (הסלוגן מהלוגו), עם דחיפות והנעה,
         כשהעולם דוהר קדימה. הניסוח שלי, טיוטה לאישור. -->
    <h2>העסק שלך <span class="hl">חייב לגדול</span></h2>
    <p class="cta-band__lead">העולם דוהר קדימה, וזה הזמן להתקדם איתו. ביחד נדאג שתהיה לך <strong>הצלחה עסקית בדרך שלך.</strong></p>
    <!-- הכפתור פותח את דף קביעת הפגישות ביומן גוגל (contact.booking) -->
    <p><a class="btn" href={contact.booking} target="_blank" rel="noopener">{buttonLabel}<span class="sr-only"> (נפתח בלשונית חדשה)</span></a></p>
    <p class="cta-band__note"><a href={contact.whatsapp} target="_blank" rel="noopener">{contact.bookingNote}</a></p>
  </div>
</section>

<style>
  .cta-band {
    text-align: center;
  }
  .cta-band__note {
    margin: -0.25rem 0 0;
    font-size: 0.95rem;
  }
  .cta-band__note a {
    color: var(--on-dark-soft);
  }
  .cta-band {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3.5rem, 9vw, 6rem);
    background:
      linear-gradient(180deg, rgb(11 26 51 / 0.85) 0%, rgb(11 26 51 / 0.55) 45%, rgb(11 26 51 / 0.8) 100%),
      var(--bg) center 62% / cover no-repeat,
      var(--navy);
  }
  .cta-band__inner {
    position: relative;
    text-shadow: 0 2px 16px rgb(7 17 31 / 0.7);
  }
  .cta-band__inner :global(.hl) {
    text-shadow: none;
  }
  .cta-band h2 {
    font-size: clamp(1.7rem, 4.4vw, 2.5rem);
    font-weight: 900;
    max-width: 44rem;
    margin-inline: auto;
  }
  .cta-band__lead {
    max-width: 36rem;
    margin: 0 auto 1.5rem;
    font-size: 1.15rem;
    color: var(--on-dark);
  }
</style>
