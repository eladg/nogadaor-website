---
// כותרת האתר: לוגו וניווט. בנייד הניווט נפתח בלחיצה על כפתור התפריט.
interface Props {
  currentPath: string;
}
import { services } from '../data/services';
const { currentPath } = Astro.props;

// תת-תפריט השירותים: שמות קצרים (נוגה, 2026-11-07: 2-3 מילים, "כמו כולם")
const serviceLinks = services.map((s) => ({ href: s.href, label: s.menu }));

const links = [
  { href: '/', label: 'בית' },
  { href: '/about/', label: 'אודות' },
  { href: '/services/', label: 'שירותים' },
  { href: '/testimonials/', label: 'המלצות' },
  { href: '/trainings/', label: 'קטלוג הדרכות' },
  { href: '/guides/', label: 'מרכז הידע' }, // לשעבר "מדריכים והרצאות" (נוגה, 2026-11-07)
  { href: '/contact/', label: 'צור קשר' },
];

const isCurrent = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__logo" href="/" aria-label="נוגה דיין אור – לעמוד הבית">
      <img src="/images/logo.png" alt="נוגה דיין אור – הצלחה עסקית בדרך שלך" width="1200" height="441" />
    </a>

    <button
      class="site-header__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="main-nav"
    >
      <span class="sr-only">תפריט</span>
      <span aria-hidden="true" class="site-header__burger"></span>
    </button>

    <nav id="main-nav" class="site-nav" aria-label="ניווט ראשי">
      <ul>
        {
          links.map((link) => (
            <li class:list={[{ 'has-sub': link.href === '/services/' }]}>
              <a
                href={link.href}
                class:list={[{ 'is-current': isCurrent(link.href) }]}
                aria-current={currentPath === link.href ? 'page' : undefined}
              >
                {link.label}
              </a>
              {link.href === '/services/' && (
                <ul class="site-nav__sub" aria-label="השירותים">
                  {serviceLinks.map((sl) => (
                    <li>
                      <a href={sl.href} aria-current={currentPath === sl.href ? 'page' : undefined}>
                        {sl.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.site-header__toggle');
  const nav = document.getElementById('main-nav');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    nav?.classList.toggle('is-open', !open);
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--white);
    border-bottom: 1px solid var(--line);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.5rem;
  }
  .site-header__logo img {
    display: block;
    width: 9.5rem;
    height: auto;
  }

  .site-header__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    background: none;
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    cursor: pointer;
  }
  .site-header__burger,
  .site-header__burger::before,
  .site-header__burger::after {
    display: block;
    width: 1.4rem;
    height: 2px;
    background: var(--navy);
    position: relative;
    content: '';
  }
  .site-header__burger::before {
    position: absolute;
    top: -6px;
  }
  .site-header__burger::after {
    position: absolute;
    top: 6px;
  }

  /* נייד: התפריט מוסתר עד שלוחצים על הכפתור */
  .site-nav {
    display: none;
    position: absolute;
    inset-inline: 0;
    top: 100%;
    background: var(--white);
    border-bottom: 1px solid var(--line);
  }
  .site-nav.is-open {
    display: block;
  }
  .site-nav ul {
    list-style: none;
    margin: 0;
    padding: 0.5rem 1rem 1rem;
  }
  .site-nav a {
    display: block;
    padding: 0.7rem 0.25rem;
    color: var(--navy);
    text-decoration: none;
    font-weight: 500;
  }
  .site-nav a:hover {
    color: var(--teal-dark);
  }
  .site-nav a.is-current {
    color: var(--teal-dark);
    font-weight: 700;
  }

  /* תת-תפריט השירותים. בנייד: מתחת ל"שירותים", מוזח פנימה */
  .site-nav ul.site-nav__sub {
    padding: 0 1rem 0.25rem 0;
    border-inline-start: 2px solid var(--line);
    margin-inline-start: 0.25rem;
  }
  .site-nav__sub a {
    padding: 0.45rem 0.25rem;
    font-size: 0.95rem;
    color: #33445c;
  }

  /* מסך רחב: ניווט אופקי, בלי כפתור */
  @media (min-width: 48rem) {
    .site-header__toggle {
      display: none;
    }
    .site-header__logo img {
      width: 11rem;
    }
    .site-nav {
      display: block;
      position: static;
      border: 0;
    }
    .site-nav ul {
      display: flex;
      gap: 1.5rem;
      padding: 0;
    }
    .site-nav a {
      padding: 0.5rem 0;
      border-bottom: 2px solid transparent;
    }
    .site-nav a.is-current {
      border-bottom-color: var(--gold-dark);
    }
    /* תת-תפריט: נפתח במעבר עכבר או בפוקוס מהמקלדת */
    .has-sub {
      position: relative;
    }
    .site-nav ul.site-nav__sub {
      display: none;
      position: absolute;
      top: 100%;
      inset-inline-start: -1rem;
      min-width: 13rem;
      margin: 0;
      padding: 0.5rem;
      background: var(--white);
      border: 1px solid var(--line);
      border-radius: 0.9rem;
      box-shadow: 0 18px 40px -20px rgb(11 26 51 / 0.45);
    }
    .has-sub:hover .site-nav__sub,
    .has-sub:focus-within .site-nav__sub {
      display: block;
    }
    .site-nav__sub a {
      display: block;
      padding: 0.55rem 0.75rem;
      border-radius: 0.6rem;
      border-bottom: 0;
      white-space: nowrap;
    }
    .site-nav__sub a:hover {
      background: var(--mist);
    }
  }
</style>
