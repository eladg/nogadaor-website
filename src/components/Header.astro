---
// כותרת האתר: לוגו וניווט. בנייד הניווט נפתח בלחיצה על כפתור התפריט.
interface Props {
  currentPath: string;
}
const { currentPath } = Astro.props;

const links = [
  { href: '/', label: 'בית' },
  { href: '/about/', label: 'אודות' },
  { href: '/services/', label: 'שירותים' },
  { href: '/testimonials/', label: 'המלצות' },
  { href: '/guides/', label: 'מדריכים והדרכות' },
  { href: '/contact/', label: 'צור קשר' },
];

const isCurrent = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__logo" href="/" aria-label="נוגה דיין אור – לעמוד הבית">
      <img src="/images/logo.png" alt="נוגה דיין אור – הצלחה עסקית בדרך שלך" width="1200" height="441" />
    </a>

    <button
      class="site-header__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="main-nav"
    >
      <span class="sr-only">תפריט</span>
      <span aria-hidden="true" class="site-header__burger"></span>
    </button>

    <nav id="main-nav" class="site-nav" aria-label="ניווט ראשי">
      <ul>
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[{ 'is-current': isCurrent(link.href) }]}
                aria-current={isCurrent(link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.site-header__toggle');
  const nav = document.getElementById('main-nav');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    nav?.classList.toggle('is-open', !open);
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--white);
    border-bottom: 1px solid var(--line);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.5rem;
  }
  .site-header__logo img {
    display: block;
    width: 9.5rem;
    height: auto;
  }

  .site-header__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    background: none;
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    cursor: pointer;
  }
  .site-header__burger,
  .site-header__burger::before,
  .site-header__burger::after {
    display: block;
    width: 1.4rem;
    height: 2px;
    background: var(--navy);
    position: relative;
    content: '';
  }
  .site-header__burger::before {
    position: absolute;
    top: -6px;
  }
  .site-header__burger::after {
    position: absolute;
    top: 6px;
  }

  /* נייד: התפריט מוסתר עד שלוחצים על הכפתור */
  .site-nav {
    display: none;
    position: absolute;
    inset-inline: 0;
    top: 100%;
    background: var(--white);
    border-bottom: 1px solid var(--line);
  }
  .site-nav.is-open {
    display: block;
  }
  .site-nav ul {
    list-style: none;
    margin: 0;
    padding: 0.5rem 1rem 1rem;
  }
  .site-nav a {
    display: block;
    padding: 0.7rem 0.25rem;
    color: var(--navy);
    text-decoration: none;
    font-weight: 500;
  }
  .site-nav a:hover {
    color: var(--teal-dark);
  }
  .site-nav a.is-current {
    color: var(--teal-dark);
    font-weight: 700;
  }

  /* מסך רחב: ניווט אופקי, בלי כפתור */
  @media (min-width: 48rem) {
    .site-header__toggle {
      display: none;
    }
    .site-header__logo img {
      width: 11rem;
    }
    .site-nav {
      display: block;
      position: static;
      border: 0;
    }
    .site-nav ul {
      display: flex;
      gap: 1.5rem;
      padding: 0;
    }
    .site-nav a {
      padding: 0.5rem 0;
      border-bottom: 2px solid transparent;
    }
    .site-nav a.is-current {
      border-bottom-color: var(--gold-dark);
    }
  }
</style>
