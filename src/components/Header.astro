---
// כותרת האתר: לוגו מימין, תפריט באמצע, כפתור פגישה משמאל (נוגה, 2026-11-08, בהשראת מאשה בלי להעתיק).
// ההאדר כהה בכל האתר, עם הלוגו הלבן. בעמוד הבית הוא שקוף ומתמזג עם הפתיח, ומקבל רקע כשגוללים.
// בנייד ובטאבלט הניווט נפתח בלחיצה על כפתור התפריט.
interface Props {
  currentPath: string;
}
import { services } from '../data/services';
const { currentPath } = Astro.props;
const overlay = currentPath === '/';

// תת-תפריט השירותים: שמות קצרים (נוגה, 2026-11-07: 2-3 מילים, "כמו כולם")
// פגישת הייעוץ ראשונה ובולטת (בזהב) בתת-התפריט בלבד (נוגה, 2026-11-13). הסדר בשאר האתר לא משתנה.
const featuredService = '/services/consulting-session/';
const serviceLinks = [
  ...services.filter((s) => s.href === featuredService),
  ...services.filter((s) => s.href !== featuredService),
].map((s) => ({ href: s.href, label: s.menu, featured: s.href === featuredService }));

const links = [
  { href: '/', label: 'בית' },
  // הסדר שנוגה קבעה (2026-11-08): שירותים לפני אודות, ואז מרכז הידע, קטלוג, המלצות, צור קשר
  { href: '/services/', label: 'שירותים' },
  { href: '/about/', label: 'אודות' },
  { href: '/guides/', label: 'מרכז הידע' }, // לשעבר "מדריכים והרצאות" (נוגה, 2026-11-07)
  { href: '/trainings/', label: 'קטלוג הדרכות' },
  { href: '/testimonials/', label: 'המלצות' },
  { href: '/contact/', label: 'צור קשר' },
];

// כפתור הפגישה: מוביל לעמוד הפגישות בתשלום, ושם יהיה גם קישור לשיחת ההיכרות (נוגה, 2026-11-08).
// נוגה, 2026-11-08: היעד הוא עמוד פגישת הייעוץ (מכיל את כל נושאי הייעוץ), והנוסח "לפגישת ייעוץ".
// עדכון (נוגה, 2026-11-13, אחרי השיחה עם המעצבת): הכפתור הקבוע הוא "לשיחת היכרות" (וואטסאפ), במקום "לפגישת ייעוץ".
// פגישת הייעוץ נשארת ראשונה ובולטת בתת-תפריט השירותים.
import { contact } from '../data/contact';
const cta = { href: contact.whatsapp, label: 'לשיחת היכרות' };

const isCurrent = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class:list={['site-header', { 'site-header--overlay': overlay }]}>
  <div class="container site-header__inner">
    <a class="site-header__logo" href="/" aria-label="נוגה דיין אור – לעמוד הבית">
      <!-- הלוגו הצבעוני (נוגה, 2026-11-08), והשורה "הצלחה עסקית בדרך שלך" בלבן כדי שתיקרא על הרקע הכהה -->
      <img src="/images/logo-color-on-dark.webp" alt="נוגה דיין אור – הצלחה עסקית בדרך שלך" width="900" height="313" />
    </a>

    <nav id="main-nav" class="site-nav" aria-label="ניווט ראשי">
      <ul>
        {
          links.map((link) => (
            <li class:list={[{ 'has-sub': link.href === '/services/' }]}>
              <a
                href={link.href}
                class:list={[{ 'is-current': isCurrent(link.href) }]}
                aria-current={currentPath === link.href ? 'page' : undefined}
              >
                {link.label}
              </a>
              {link.href === '/services/' && (
                <ul class="site-nav__sub" aria-label="השירותים">
                  {serviceLinks.map((sl) => (
                    <li>
                      <a href={sl.href} class:list={[{ 'is-featured': sl.featured }]} aria-current={currentPath === sl.href ? 'page' : undefined}>
                        {sl.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__end">
      <a class="btn site-header__cta" href={cta.href} target="_blank" rel="noopener">{cta.label}<span class="sr-only"> (נפתח בלשונית חדשה)</span></a>
      <button
        class="site-header__toggle"
        type="button"
        aria-expanded="false"
        aria-controls="main-nav"
      >
        <span class="sr-only">תפריט</span>
        <span aria-hidden="true" class="site-header__burger"></span>
      </button>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = document.querySelector<HTMLButtonElement>('.site-header__toggle');
  const nav = document.getElementById('main-nav');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    nav?.classList.toggle('is-open', !open);
    header?.classList.toggle('is-open', !open);
  });
  // בעמוד הבית: ההאדר שקוף מעל הפתיח, ומקבל רקע כהה אחרי שגוללים קצת
  if (header?.classList.contains('site-header--overlay')) {
    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 24);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--navy);
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }
  /* בעמוד הבית: שקוף, והפתיח עולה אל מתחתיו */
  .site-header--overlay {
    margin-bottom: calc(-1 * var(--header-h));
    background: transparent;
    border-bottom-color: transparent;
  }
  .site-header--overlay.is-scrolled,
  .site-header--overlay.is-open {
    background: var(--navy);
    border-bottom-color: rgb(255 255 255 / 0.08);
    box-shadow: 0 10px 30px -18px rgb(0 0 0 / 0.7);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: var(--header-h);
  }
  .site-header__logo img {
    display: block;
    width: 8.25rem;
    height: auto;
  }
  .site-header__end {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .site-header__cta {
    padding: 0.55em 1.15em;
    font-size: 0.92rem;
    white-space: nowrap;
  }

  .site-header__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    background: none;
    border: 1px solid rgb(255 255 255 / 0.25);
    border-radius: 0.5rem;
    cursor: pointer;
  }
  .site-header__burger,
  .site-header__burger::before,
  .site-header__burger::after {
    display: block;
    width: 1.4rem;
    height: 2px;
    background: var(--white);
    position: relative;
    content: '';
  }
  .site-header__burger::before {
    position: absolute;
    top: -6px;
  }
  .site-header__burger::after {
    position: absolute;
    top: 6px;
  }

  /* נייד וטאבלט: התפריט מוסתר עד שלוחצים על הכפתור */
  .site-nav {
    display: none;
    position: absolute;
    inset-inline: 0;
    top: 100%;
    background: var(--navy-deep);
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
  }
  .site-nav.is-open {
    display: block;
  }
  .site-nav ul {
    list-style: none;
    margin: 0;
    padding: 0.5rem 1rem 1rem;
  }
  .site-nav a {
    display: block;
    padding: 0.7rem 0.25rem;
    color: var(--on-dark);
    text-decoration: none;
    font-weight: 500;
  }
  .site-nav a:hover {
    color: var(--gold-light);
  }
  .site-nav a.is-current {
    color: var(--white);
    font-weight: 700;
  }

  /* תת-תפריט השירותים. בנייד: מתחת ל"שירותים", מוזח פנימה */
  .site-nav ul.site-nav__sub {
    padding: 0 1rem 0.25rem 0;
    border-inline-start: 2px solid rgb(255 255 255 / 0.15);
    margin-inline-start: 0.25rem;
  }
  .site-nav__sub a {
    padding: 0.45rem 0.25rem;
    font-size: 0.95rem;
    color: var(--on-dark-soft);
  }
  /* פגישת הייעוץ: בזהב, מודגשת */
  .site-nav .site-nav__sub a.is-featured {
    color: var(--gold-light);
    font-weight: 800;
  }

  /* מסך צר מאוד: הכפתור מתקצר כדי שהכול ייכנס בשורה אחת */
  @media (max-width: 23rem) {
    .site-header__logo img {
      width: 7rem;
    }
    .site-header__cta {
      padding: 0.5em 0.9em;
      font-size: 0.85rem;
    }
  }

  @media (min-width: 48rem) {
    .site-header__logo img {
      width: 10rem;
    }
  }

  /* מסך רחב: לוגו מימין, ניווט באמצע, כפתור משמאל */
  @media (min-width: 64rem) {
    /* שלוש עמודות, כך שהתפריט יושב בדיוק באמצע */
    .site-header__inner {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
    }
    .site-header__end {
      justify-self: end;
    }
    .site-header__toggle {
      display: none;
    }
    .site-nav {
      display: block;
      position: static;
      border: 0;
      background: none;
    }
    .site-nav ul {
      display: flex;
      gap: 1.6rem;
      padding: 0;
    }
    .site-nav a {
      padding: 0.5rem 0;
      border-bottom: 2px solid transparent;
    }
    .site-nav a.is-current {
      border-bottom-color: var(--gold-light);
    }
    .site-header__cta {
      font-size: 0.95rem;
    }
    /* תת-תפריט: נפתח במעבר עכבר או בפוקוס מהמקלדת */
    .has-sub {
      position: relative;
    }
    .site-nav ul.site-nav__sub {
      display: none;
      position: absolute;
      top: 100%;
      inset-inline-start: -1rem;
      min-width: 13rem;
      margin: 0;
      padding: 0.5rem;
      background: var(--navy-deep);
      border: 1px solid rgb(255 255 255 / 0.12);
      border-radius: 0.9rem;
      box-shadow: 0 18px 40px -20px rgb(0 0 0 / 0.8);
    }
    .has-sub:hover .site-nav__sub,
    .has-sub:focus-within .site-nav__sub {
      display: block;
    }
    .site-nav__sub a {
      display: block;
      padding: 0.55rem 0.75rem;
      border-radius: 0.6rem;
      border-bottom: 0;
      white-space: nowrap;
      color: var(--on-dark);
    }
    .site-nav__sub a:hover {
      background: rgb(255 255 255 / 0.07);
    }
    .site-nav .site-nav__sub a.is-featured {
      margin-bottom: 0.25rem;
      background: rgb(252 220 109 / 0.12);
      box-shadow: inset 0 0 0 1px rgb(252 220 109 / 0.35);
    }
    .site-nav .site-nav__sub a.is-featured:hover {
      background: rgb(252 220 109 / 0.2);
    }
  }
</style>
