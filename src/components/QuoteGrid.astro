---
// המלצות בעמוד הבית (נוגה, 2026-11-07): צר, כמה המלצות בו זמנית (3 בשורה, 6 בסך הכול), כולן באותו גובה,
// רק ההתחלה של כל המלצה, ו"קרא עוד". טקסט צף בלי קופסאות ובלי עיגולים, עם קו דק בין ההמלצות.
// הטקסט של ההמלצה לא משתנה: הוא רק נחתך בתצוגה, ו"קרא עוד" פותח אותו.
import type { Review } from '../data/reviews';

interface Props {
  reviews: Review[];
}
const { reviews } = Astro.props;
---

<ul class="qg">
  {
    reviews.map((r, i) => (
      <li class="qg__item reveal" style={`transition-delay: ${(i % 3) * 0.08}s`}>
        <span class="qg__mark" aria-hidden="true">”</span>
        <blockquote class="qg__text">{r.text}</blockquote>
        <button type="button" class="qg__more" hidden aria-expanded="false">קרא עוד</button>
        <p class="qg__by">
          <strong>{r.name}</strong> · מקור: {r.source}
        </p>
      </li>
    ))
  }
</ul>

<script>
  // "קרא עוד" מופיע רק בהמלצה שנחתכה בפועל
  document.querySelectorAll<HTMLElement>('.qg__item').forEach((item) => {
    const text = item.querySelector<HTMLElement>('.qg__text');
    const btn = item.querySelector<HTMLButtonElement>('.qg__more');
    if (!text || !btn) return;
    if (text.scrollHeight > text.clientHeight + 2) {
      btn.hidden = false;
      btn.addEventListener('click', () => {
        const open = item.classList.toggle('is-open');
        btn.setAttribute('aria-expanded', String(open));
        btn.textContent = open ? 'סגירה' : 'קרא עוד';
      });
    }
  });
</script>

<style>
  .qg {
    list-style: none;
    max-width: 62rem;
    margin: 0 auto;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.25rem 0;
  }
  @media (max-width: 52rem) {
    .qg {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 36rem) {
    .qg {
      grid-template-columns: 1fr;
    }
  }
  .qg__item {
    position: relative;
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0.25rem 1.5rem;
    border-inline-start: 1px solid var(--line);
  }
  .qg__item:nth-child(3n + 1) {
    border-inline-start: 0;
  }
  @media (max-width: 52rem) {
    .qg__item:nth-child(3n + 1) {
      border-inline-start: 1px solid var(--line);
    }
    .qg__item:nth-child(2n + 1) {
      border-inline-start: 0;
    }
  }
  @media (max-width: 36rem) {
    .qg__item {
      border-inline-start: 0 !important;
      padding-inline: 0;
    }
  }
  .qg__mark {
    display: block;
    height: 1.6rem;
    font-size: 3rem;
    font-weight: 900;
    line-height: 1;
    background: var(--gold-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  /* רק ההתחלה: 4 שורות בגובה קבוע, כך שכל ההמלצות באותו גובה */
  .qg__text {
    margin: 0;
    font-size: 1.02rem;
    font-weight: 600;
    line-height: 1.65;
    color: var(--navy);
    white-space: pre-line;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: calc(1.65em * 4);
  }
  .qg__item.is-open .qg__text {
    display: block;
    -webkit-line-clamp: unset;
  }
  .qg__more {
    align-self: flex-start;
    margin-top: 0.35rem;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: 0.92rem;
    font-weight: 800;
    color: var(--teal-dark);
    cursor: pointer;
  }
  .qg__more[hidden] {
    display: none;
  }
  .qg__by {
    margin: 0.6rem 0 0;
    font-size: 0.92rem;
    color: #4a5b73;
  }
  .qg__by strong {
    color: var(--teal-dark);
  }
</style>
