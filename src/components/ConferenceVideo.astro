---
// סרטון כנס העסקים (RJd6_sdT62U) עם הכריכה מהכנס: נוגה מגבה מול כל הקהל, במקום התמונה של יוטיוב.
// משותף לעמוד הבית ולקטלוג ההדרכות ("נוגה על הבמה"), כדי שהכריכה תהיה זהה בשניהם (נוגה, 2026-11-08).
import { Image } from 'astro:assets';
import YouTubeEmbed from './YouTubeEmbed.astro';
import conferenceCover from '../assets/hero/conference-cover.jpg';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={['conference', className]}>
  <YouTubeEmbed id="RJd6_sdT62U" title="נוגה דיין אור - כנס עסקים במקסימום">
    <span class="stage-cover">
      <Image src={conferenceCover} alt="" widths={[640, 960, 1300]} sizes="(min-width: 44rem) 40rem, 100vw" />
      <span class="stage-cover__play" aria-hidden="true"></span>
      <span class="stage-cover__label">עסקים במקסימום</span>
    </span>
  </YouTubeEmbed>
</div>

<style>
  .conference {
    /* קטן יותר (נוגה, 2026-11-08: "זה עצום") */
    width: 100%;
    max-width: 40rem;
    margin-inline: auto;
    border-radius: 1.25rem;
    overflow: hidden;
    box-shadow: 0 30px 60px -35px rgb(11 26 51 / 0.55);
  }
  .conference:hover .stage-cover__play {
    transform: translate(-50%, -50%) scale(1.08);
  }
  .stage-cover {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
  }
  .stage-cover :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 45%;
  }
  .stage-cover::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgb(11 26 51 / 0.7) 0%, rgb(11 26 51 / 0) 45%);
  }
  .stage-cover__play {
    position: absolute;
    z-index: 1;
    top: 50%;
    left: 50%;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    background: var(--gold-gradient);
    box-shadow: 0 12px 30px -8px rgb(0 0 0 / 0.6);
    transform: translate(-50%, -50%);
    transition: transform 0.25s ease;
  }
  .stage-cover__play::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 54%;
    border-style: solid;
    border-width: 0.75rem 0 0.75rem 1.2rem;
    border-color: transparent transparent transparent var(--navy);
    transform: translate(-50%, -50%);
  }
  .stage-cover__label {
    position: absolute;
    z-index: 1;
    bottom: 1rem;
    right: 1.25rem;
    color: var(--white);
    font-size: clamp(1rem, 2vw, 1.3rem);
    font-weight: 800;
  }
</style>
