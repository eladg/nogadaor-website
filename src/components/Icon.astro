const { name, size = 24, class: className } = Astro.props;
const icon = icons[name];
const strokeProps =
  icon.type === 'stroke'
    ? { fill: 'none', stroke: 'currentColor', 'stroke-width': 2, 'stroke-linecap': 'round', 'stroke-linejoin': 'round' }
    : { fill: 'currentColor' };
---

<svg class={className} aria-hidden="true" focusable="false" viewBox="0 0 24 24" width={size} height={size} {...strokeProps} set:html={icon.svg} />
