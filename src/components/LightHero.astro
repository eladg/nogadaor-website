---
// פתיח בהיר עם תמונת אווירה (AI) בצד שמאל, שנעלמת לבן לכיוון הטקסט בימין.
// התמונות הבהירות שנוגה שלחה (2026-11-07) נוצרו עם צד ימין ריק, בדיוק בשביל טקסט בעברית.
// שימוש: <LightHero image={chairs} title="..." kicker="..." crumbs={{ href: '/trainings/', label: 'קטלוג הדרכות' }}>שורת פתיחה</LightHero>
import { Image } from 'astro:assets';

interface Props {
  image: ImageMetadata;
  title: string;
  kicker?: string;
  crumbs?: { href: string; label: string; current?: string };
  center?: boolean; // טקסט ממורכז, והתמונה רקע עדין לכל הרוחב (עמודי ההדרכות, נוגה 2026-11-08)
}
const { image, title, kicker, crumbs, center = false } = Astro.props;
---

<section class:list={['lh', center && 'lh--center']}>
  <div class="lh__media" aria-hidden="true">
    <Image src={image} alt="" widths={[640, 1024, 1600]} sizes="(min-width: 52rem) 62vw, 100vw" loading="eager" />
  </div>
  <div class="container lh__inner">
    <div class="lh__text">
      {
        crumbs && (
          <p class="lh__crumbs">
            <a href={crumbs.href}>{crumbs.label}</a>
            {crumbs.current && (
              <>
                {' '}
                <span aria-hidden="true">/</span> {crumbs.current}
              </>
            )}
          </p>
        )
      }
      {/* בלי תווית מעל הכותרת (נוגה, 2026-11-09) */}
      <h1 class="lh__title">{title}</h1>
      <div class="lh__lead"><slot /></div>
    </div>
  </div>
</section>

<style>
  .lh {
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, var(--white), var(--mist));
    border-bottom: 1px solid var(--line);
  }
  /* בנייד: התמונה למעלה, ונעלמת לבן כלפי מטה */
  .lh__media {
    position: relative;
    height: min(58vw, 16rem);
  }
  .lh__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* בנייד החיתוך נמוך יותר, שם נמצאים האנשים והכיסאות בתמונות */
    object-position: 15% 78%;
  }
  .lh__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(255 255 255 / 0) 45%, var(--white) 100%);
  }
  .lh__inner {
    position: relative;
    padding-block: 0.25rem 2.5rem;
  }
  .lh__crumbs {
    margin: 0 0 0.6rem;
    font-size: 0.95rem;
    color: #4a5b73;
  }
  .lh__crumbs a {
    color: var(--teal-dark);
    font-weight: 700;
  }
  .lh__kicker {
    margin: 0 0 0.4rem;
    font-weight: 800;
    color: var(--gold-dark);
  }
  .lh__title {
    margin: 0 0 0.85rem;
    font-size: clamp(2rem, 5.4vw, 3.2rem);
    font-weight: 900;
    line-height: 1.15;
    color: var(--navy);
  }
  .lh__lead {
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    line-height: 1.65;
    color: #33445c;
  }
  .lh__lead :global(p:last-child) {
    margin-bottom: 0;
  }

  /* מחשב: התמונה בצד שמאל, הטקסט בימין על לבן */
  @media (min-width: 52rem) {
    .lh {
      display: flex;
      align-items: center;
      min-height: clamp(22rem, 52vh, 28rem);
    }
    .lh__media {
      position: absolute;
      inset: 0 auto 0 0;
      width: 62%;
      height: auto;
    }
    .lh__media :global(img) {
      object-position: left center;
    }
    .lh__media::after {
      background: linear-gradient(to left, var(--white) 0%, rgb(255 255 255 / 0.85) 18%, rgb(255 255 255 / 0) 55%);
    }
    .lh__inner {
      padding-block: 3rem;
    }
    .lh__text {
      max-width: min(36rem, 50vw);
    }
  }

  /* ממורכז: הטקסט באמצע, והתמונה ברקע מאחורי שכבה לבנה כך שהטקסט תמיד קריא */
  .lh--center {
    text-align: center;
  }
  .lh--center .lh__text {
    margin-inline: auto;
  }
  @media (min-width: 52rem) {
    .lh--center .lh__media {
      inset: 0;
      width: 100%;
    }
    .lh--center .lh__media :global(img) {
      object-position: center;
    }
    .lh--center .lh__media::after {
      background: radial-gradient(ellipse 58% 80% at 50% 50%, rgb(255 255 255 / 0.95) 35%, rgb(255 255 255 / 0.78) 70%, rgb(255 255 255 / 0.55) 100%);
    }
    .lh--center .lh__text {
      max-width: 46rem;
    }
  }
</style>
