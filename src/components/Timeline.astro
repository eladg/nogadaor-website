---
// ציר תהליך ממוספר (בהשראת ציר הליווי ב-yanivless.co.il, לבקשת נוגה, 2026-11-07).
// במחשב: שלבים בשורה אחת עם קו זהב שמחבר ביניהם. בנייד: אחד מתחת לשני, עם קו אנכי.
// tone="dark" לשימוש על רקע כחול כהה.
interface Props {
  // gets: "מה מקבלים" כבולטים עם וי עדין, בלי כותרת (נוגה, 2026-11-08).
  items: { title: string; text: string; gets?: string[] }[];
  tone?: 'light' | 'dark';
}
const { items, tone = 'light' } = Astro.props;
---

<ol class:list={['tl', `tl--${tone}`]} style={`--n: ${items.length}`}>
  {
    items.map((item, i) => (
      <li class="tl__step reveal" style={`transition-delay: ${i * 0.12}s`}>
        <span class="tl__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        <h3 class="tl__title">{item.title}</h3>
        <p class="tl__text">{item.text}</p>
        {item.gets && (
          <ul class="tl__gets">
            {item.gets.map((g) => (
              <li>
                <span class="tl__check" aria-hidden="true">
                  <svg viewBox="0 0 20 20" width="18" height="18"><path d="M3.5 10.5 8 15 16.5 4.5" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </span>
                <span>{g}</span>
              </li>
            ))}
          </ul>
        )}
      </li>
    ))
  }
</ol>

<style>
  .tl {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
    position: relative;
  }
  .tl__step {
    position: relative;
    margin: 0;
    padding-inline-start: 4rem;
  }
  /* נייד: קו אנכי שמחבר בין המספרים */
  .tl__step:not(:last-child)::after {
    content: '';
    position: absolute;
    inset-inline-start: 1.4rem;
    top: 3rem;
    bottom: -1.5rem;
    width: 2px;
    background: linear-gradient(var(--gold-dark), rgb(209 154 74 / 0.15));
  }
  .tl__num {
    position: absolute;
    inset-inline-start: 0;
    top: 0;
    display: grid;
    place-items: center;
    width: 2.8rem;
    height: 2.8rem;
    border-radius: 50%;
    background: var(--gold-gradient);
    color: var(--navy);
    font-weight: 900;
    font-size: 1rem;
  }
  .tl__title {
    margin: 0.35rem 0 0.35rem;
    font-size: 1.2rem;
    font-weight: 900;
  }
  .tl__text {
    margin: 0;
    line-height: 1.6;
    color: #33445c;
  }
  /* כל שלב בעמודה, ו"מה מקבלים" בתחתית: כך הקופסאות מתחילות באותו גובה בכל השלבים */
  .tl__step {
    display: flex;
    flex-direction: column;
  }
  /* מה מקבלים: בולטים עם וי עדין (נוגה, 2026-11-08: בלי הכותרת "מה מקבלים", וי במקום כוכב) */
  .tl__gets {
    list-style: none;
    margin: auto 0 0;
    padding: 0.9rem 0 0;
    display: grid;
    gap: 0.5rem;
    border-top: 1px solid var(--line);
  }
  .tl__text {
    margin-bottom: 0.9rem !important;
  }
  .tl__gets li {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    margin: 0;
    line-height: 1.45;
    font-size: 0.97rem;
    color: #33445c;
  }
  /* וי לבד, בלי ריבוע (נוגה, 2026-11-08) */
  .tl__check {
    flex: none;
    display: inline-flex;
    margin-top: 0.05rem;
    color: var(--teal);
  }
  .tl--dark .tl__gets {
    border-top-color: rgb(255 255 255 / 0.14);
  }
  .tl--dark .tl__gets li {
    color: var(--on-dark);
  }
  .tl--dark .tl__check {
    color: var(--gold-light);
  }
  .tl--dark .tl__title {
    color: var(--white);
  }
  .tl--dark .tl__text {
    color: var(--on-dark-soft);
  }

  /* מחשב: כל השלבים בשורה אחת, קו אופקי מתחת למספרים */
  @media (min-width: 56rem) {
    .tl {
      grid-template-columns: repeat(var(--n), 1fr);
      /* פחות צפוף בין השלבים (נוגה, 2026-11-08) */
      gap: 3.5rem;
    }
    .tl__step {
      padding-inline-start: 0;
      padding-top: 4.2rem;
    }
    .tl__step:not(:last-child)::after {
      inset-inline-start: 3.4rem;
      inset-inline-end: -1.5rem;
      top: 1.4rem;
      bottom: auto;
      width: auto;
      height: 2px;
      background: linear-gradient(to left, var(--gold-dark), rgb(209 154 74 / 0.2));
    }
  }
</style>
