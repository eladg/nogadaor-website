---
// ציר תהליך ממוספר (בהשראת ציר הליווי ב-yanivless.co.il, לבקשת נוגה, 2026-11-07).
// במחשב: שלבים בשורה אחת עם קו זהב שמחבר ביניהם. בנייד: אחד מתחת לשני, עם קו אנכי.
// tone="dark" לשימוש על רקע כחול כהה.
import Star from './Star.astro';
interface Props {
  // gets: "מה מקבלים" ברשימה. התבליט הוא הכוכב של נוגה (2026-11-07). הקופסה באותו גובה בכל השלבים.
  items: { title: string; text: string; gets?: string[] }[];
  tone?: 'light' | 'dark';
}
const { items, tone = 'light' } = Astro.props;
---

<ol class:list={['tl', `tl--${tone}`]} style={`--n: ${items.length}`}>
  {
    items.map((item, i) => (
      <li class="tl__step reveal" style={`transition-delay: ${i * 0.12}s`}>
        <span class="tl__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        <h3 class="tl__title">{item.title}</h3>
        <p class="tl__text">{item.text}</p>
        {item.gets && (
          <div class="tl__gets">
            <p class="tl__gets-title">מה מקבלים?</p>
            <ul>
              {item.gets.map((g) => (
                <li>
                  <Star size={14} class="tl__star" />
                  <span>{g}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </li>
    ))
  }
</ol>

<style>
  .tl {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
    position: relative;
  }
  .tl__step {
    position: relative;
    margin: 0;
    padding-inline-start: 4rem;
  }
  /* נייד: קו אנכי שמחבר בין המספרים */
  .tl__step:not(:last-child)::after {
    content: '';
    position: absolute;
    inset-inline-start: 1.4rem;
    top: 3rem;
    bottom: -1.5rem;
    width: 2px;
    background: linear-gradient(var(--gold-dark), rgb(209 154 74 / 0.15));
  }
  .tl__num {
    position: absolute;
    inset-inline-start: 0;
    top: 0;
    display: grid;
    place-items: center;
    width: 2.8rem;
    height: 2.8rem;
    border-radius: 50%;
    background: var(--gold-gradient);
    color: var(--navy);
    font-weight: 900;
    font-size: 1rem;
  }
  .tl__title {
    margin: 0.35rem 0 0.35rem;
    font-size: 1.2rem;
    font-weight: 900;
  }
  .tl__text {
    margin: 0;
    line-height: 1.6;
    color: #33445c;
  }
  /* כל שלב בעמודה, ו"מה מקבלים" בתחתית: כך הקופסאות מתחילות באותו גובה בכל השלבים */
  .tl__step {
    display: flex;
    flex-direction: column;
  }
  .tl__gets {
    margin-top: auto;
    padding: 0.9rem 1rem;
    border-radius: 0.9rem;
    background: var(--white);
    border: 1px solid var(--line);
    border-top: 3px solid var(--gold-dark);
  }
  .tl__text {
    margin-bottom: 0.9rem !important;
  }
  .tl__gets-title {
    margin: 0 0 0.5rem;
    font-weight: 900;
    color: var(--navy);
  }
  .tl__gets ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }
  .tl__gets li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin: 0;
    line-height: 1.45;
    font-size: 0.97rem;
    color: #33445c;
  }
  .tl__gets :global(.tl__star) {
    flex: none;
    margin-top: 0.2rem;
  }
  .tl--dark .tl__gets {
    background: rgb(255 255 255 / 0.06);
    border-color: rgb(255 255 255 / 0.14);
    border-top-color: var(--gold-light);
  }
  .tl--dark .tl__gets-title {
    color: var(--gold-light);
  }
  .tl--dark .tl__gets li {
    color: var(--on-dark);
  }
  @media (min-width: 56rem) {
    .tl__gets {
      min-height: 11.5rem;
    }
  }
  .tl--dark .tl__title {
    color: var(--white);
  }
  .tl--dark .tl__text {
    color: var(--on-dark-soft);
  }

  /* מחשב: כל השלבים בשורה אחת, קו אופקי מתחת למספרים */
  @media (min-width: 56rem) {
    .tl {
      grid-template-columns: repeat(var(--n), 1fr);
      gap: 1.5rem;
    }
    .tl__step {
      padding-inline-start: 0;
      padding-top: 4.2rem;
    }
    .tl__step:not(:last-child)::after {
      inset-inline-start: 3.4rem;
      inset-inline-end: -1.5rem;
      top: 1.4rem;
      bottom: auto;
      width: auto;
      height: 2px;
      background: linear-gradient(to left, var(--gold-dark), rgb(209 154 74 / 0.2));
    }
  }
</style>
