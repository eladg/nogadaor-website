---
// שירותים בשורה אחת (עמוד הבית). נוגה (2026-11-07): התמונות לא תמכו בטקסט, ולכן אייקונים.
// תמיד באותו גובה: האייקונים, הכותרות וההסברים (CSS subgrid, כל כרטיס מקבל את אותן 4 שורות).
// כרטיסים כהים על רקע בהיר, כדי שלא יהיו ריבועים לבנים על לבן.
// במחשב: 6 בשורה. בטאבלט ובנייד: אותה שורה, וגוללים לצדדים.
import Icon from './Icon.astro';
import { services } from '../data/services';
---

<ul class="strip">
  {
    services.map((s, i) => (
      <li class="strip__card reveal" style={`transition-delay: ${i * 0.06}s`}>
        <span class="strip__icon" aria-hidden="true">
          <Icon name={s.icon} size={24} />
        </span>
        <h3 class="strip__title">
          <a href={s.href}>{s.title}</a>
        </h3>
        <p class="strip__lead">{s.lead}</p>
        <span class="strip__more" aria-hidden="true">לפרטים ←</span>
      </li>
    ))
  }
</ul>

<style>
  .strip {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-template-rows: repeat(4, auto);
    gap: 0 0.85rem;
  }
  /* טאבלט ונייד: שורה אחת שגוללים לצדדים */
  @media (max-width: 62rem) {
    .strip {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: minmax(12rem, 40%);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: 0.75rem;
    }
    .strip__card {
      scroll-snap-align: start;
    }
  }
  @media (max-width: 36rem) {
    .strip {
      grid-auto-columns: 70%;
    }
  }
  .strip__card {
    position: relative;
    display: grid;
    grid-row: span 4;
    grid-template-rows: subgrid;
    row-gap: 0.55rem;
    align-items: start;
    margin: 0;
    padding: 1.25rem 1.1rem 1.1rem;
    border-radius: 1.25rem;
    color: var(--on-dark);
    background:
      radial-gradient(14rem 9rem at 100% 0, rgb(25 154 181 / 0.35), transparent 70%),
      linear-gradient(170deg, var(--navy-soft), var(--navy) 70%);
    border: 1px solid rgb(255 255 255 / 0.08);
    transition:
      opacity 0.7s ease,
      transform 0.35s ease,
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }
  .strip__card:hover,
  .strip__card:focus-within {
    transform: translateY(-4px);
    border-color: rgb(252 220 109 / 0.6);
    box-shadow: 0 20px 40px -25px rgb(11 26 51 / 0.7);
  }
  .strip__icon {
    display: grid;
    place-items: center;
    width: 2.8rem;
    height: 2.8rem;
    border-radius: 0.8rem;
    background: var(--gold-gradient);
    color: var(--navy);
  }
  .strip__title {
    margin: 0;
    font-size: 1.12rem;
    font-weight: 900;
    line-height: 1.3;
  }
  .strip__title a {
    color: var(--white);
    text-decoration: none;
  }
  /* כל הכרטיס לחיץ, דרך הקישור שבכותרת */
  .strip__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .strip__lead {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.45;
    color: var(--on-dark-soft);
  }
  .strip__more {
    align-self: end;
    margin-top: 0.25rem;
    font-size: 0.88rem;
    font-weight: 800;
    color: var(--gold-light);
  }
  @media (prefers-reduced-motion: reduce) {
    .strip__card {
      transition: none;
    }
  }
</style>
