---
// שירותים בשורה אחת (עמוד הבית, נוגה 2026-11-07): כרטיסים עם תמונה, לא רק אייקון, ולא ריבועים לבנים על לבן.
// במחשב: 6 בשורה. בטאבלט ובנייד: אותה שורה, וגוללים לצדדים (scroll-snap).
// תמונות: תמונות האווירה ששלחה נוגה, ותמונה אמיתית מהכנס להדרכות.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { services } from '../data/services';
import whiteboard from '../assets/atmosphere/light-whiteboard.webp';
import team from '../assets/atmosphere/light-team.webp';
import lines from '../assets/atmosphere/dark-lines.webp';
import desk from '../assets/atmosphere/light-desk.webp';
import meeting from '../assets/atmosphere/light-meeting-table.webp';
import stage from '../assets/about/gallery/15-facing-audience.jpg';

const images: Record<string, ImageMetadata> = {
  'business-consulting': whiteboard,
  'organizational-consulting': team,
  'ai-automation': lines,
  financial: desk,
  'consulting-session': meeting,
  trainings: stage,
};
---

<ul class="strip">
  {
    services.map((s, i) => (
      <li class="strip__item reveal" style={`transition-delay: ${i * 0.06}s`}>
        <a class="strip__card" href={s.href}>
          <Image src={images[s.slug] ?? desk} alt="" widths={[320, 480]} sizes="(min-width: 62rem) 13rem, 60vw" class="strip__img" />
          <span class="strip__shade" aria-hidden="true" />
          <span class="strip__body">
            <span class="strip__icon" aria-hidden="true">
              <Icon name={s.icon} size={20} />
            </span>
            <span class="strip__title">{s.title}</span>
            <span class="strip__lead">{s.lead}</span>
            <span class="strip__more" aria-hidden="true">לפרטים ←</span>
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .strip {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 0.85rem;
  }
  /* טאבלט ונייד: שורה אחת שגוללים לצדדים */
  @media (max-width: 62rem) {
    .strip {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: minmax(12.5rem, 42%);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: 0.75rem;
      scrollbar-width: thin;
    }
    .strip__item {
      scroll-snap-align: start;
    }
  }
  @media (max-width: 36rem) {
    .strip {
      grid-auto-columns: 72%;
    }
  }
  .strip__item {
    margin: 0;
  }
  .strip__card {
    position: relative;
    display: block;
    height: 100%;
    min-height: 17rem;
    overflow: hidden;
    border-radius: 1.25rem;
    color: var(--white);
    text-decoration: none;
    isolation: isolate;
  }
  .strip__card :global(.strip__img) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left center;
    transition: transform 0.6s ease;
  }
  .strip__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgb(7 17 31 / 0.15) 0%, rgb(7 17 31 / 0.55) 40%, rgb(7 17 31 / 0.94) 78%);
  }
  .strip__body {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1rem 1rem 1.1rem;
  }
  .strip__icon {
    display: grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    margin-bottom: 0.2rem;
    border-radius: 0.7rem;
    background: var(--gold-gradient);
    color: var(--navy);
  }
  .strip__title {
    font-size: 1.12rem;
    font-weight: 900;
    line-height: 1.25;
  }
  .strip__lead {
    font-size: 0.88rem;
    line-height: 1.4;
    color: var(--on-dark);
  }
  .strip__more {
    margin-top: 0.2rem;
    font-size: 0.88rem;
    font-weight: 800;
    color: var(--gold-light);
    opacity: 0;
    transform: translateY(0.35rem);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }
  .strip__card:hover :global(.strip__img),
  .strip__card:focus-visible :global(.strip__img) {
    transform: scale(1.07);
  }
  .strip__card:hover .strip__more,
  .strip__card:focus-visible .strip__more {
    opacity: 1;
    transform: none;
  }
  @media (hover: none) {
    .strip__more {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .strip__card :global(.strip__img),
    .strip__more {
      transition: none;
    }
  }
</style>
