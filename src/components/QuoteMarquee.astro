---
// המלצות בעמוד הבית (נוגה, 2026-11-08): שורה אחת של כרטיסים צרים שזזה לאט, כך שרואים הרבה המלצות בבת אחת.
// (סבב 2: שורה אחת במקום שתיים, כרטיסים צרים יותר, טקסט רגיל ולא מודגש, שורת המקור קטנה.)
// בכל כרטיס: גרש זהב מבריק, ההתחלה של ההמלצה (4 שורות), "קרא עוד" ושם הממליץ, תמיד באותו גובה בכל הכרטיסים.
// "קרא עוד" פותח חלון עם ההמלצה המלאה. התנועה נעצרת כשהעכבר או המקלדת על ההמלצות, ולא פועלת למי שביקש פחות תנועה.
// הטקסט של ההמלצה לא משתנה: הוא רק נחתך בתצוגה.
// בטלפון (נוגה, 2026-11-12): בלי תנועה לצדדים. ההמלצות זו מתחת לזו, מתחילים בכמה, וכפתור "לעוד המלצות" מוסיף עוד,
// כך שרואים שיש הרבה בלי להעמיס את העמוד.
import type { Review } from '../data/reviews';

// rows={2} (עמוד ההמלצות וקטלוג ההדרכות, נוגה 2026-11-08): שתי שורות שזזות לכיוונים הפוכים, באותו עיצוב בדיוק.
interface Props {
  reviews: Review[];
  rows?: 1 | 2;
  mobileStart?: number; // כמה המלצות מוצגות בטלפון לפני הכפתור
}
const { reviews, rows: rowCount = 1, mobileStart = 3 } = Astro.props;
const rows = rowCount === 2 ? [reviews.filter((_, i) => i % 2 === 0), reviews.filter((_, i) => i % 2 === 1)] : [reviews];
---

<div class="qm" data-start={mobileStart}>
  {
    rows.map((row, ri) => (
      <div class:list={['qm__row', { 'qm__row--rev': ri === 1 }]}>
        <ul class="qm__track" style={`--dur: ${row.length * 6}s`}>
          {[...row, ...row].map((r, i) => {
            const dup = i >= row.length;
            return (
              <li class:list={['qm__card', { 'qm__card--dup': dup }]} aria-hidden={dup ? 'true' : undefined}>
                <span class="qm__mark" aria-hidden="true">”</span>
                <blockquote class="qm__text">{r.text}</blockquote>
                <button type="button" class="qm__more" tabindex={dup ? -1 : undefined}>
                  קרא עוד<span class="sr-only"> – ההמלצה של {r.name}</span>
                </button>
                <p class="qm__by">
                  <strong>{r.name}</strong>
                  <span>מקור: {r.source}</span>
                </p>
              </li>
            );
          })}
        </ul>
      </div>
    ))
  }

  <button type="button" class="qm__showmore">לעוד המלצות</button>

  <dialog class="qm__dialog" aria-labelledby="qm-dialog-name">
    <button type="button" class="qm__close" aria-label="סגירה">×</button>
    <span class="qm__mark" aria-hidden="true">”</span>
    <p class="qm__dtext"></p>
    <p class="qm__by">
      <strong id="qm-dialog-name"></strong>
      <span class="qm__dsrc"></span>
    </p>
  </dialog>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.qm').forEach((root) => {
  const dialog = root.querySelector<HTMLDialogElement>('.qm__dialog');
  // "קרא עוד" מופיע רק כשההמלצה נחתכה, אבל המקום שלו שמור תמיד, כדי שהשם יישאר באותו גובה.
  // נבדק שוב כשכרטיס נחשף בטלפון, כי כרטיס מוסתר לא נמדד.
  const measure = (card: HTMLElement) => {
    const text = card.querySelector<HTMLElement>('.qm__text');
    const btn = card.querySelector<HTMLButtonElement>('.qm__more');
    if (!text || !btn || !text.clientHeight) return;
    btn.classList.toggle('is-empty', text.scrollHeight <= text.clientHeight + 2);
  };
  // טלפון: מציגים כמה המלצות, והכפתור מוסיף ארבע בכל לחיצה
  const cards = [...root.querySelectorAll<HTMLElement>('.qm__card:not(.qm__card--dup)')];
  const more = root.querySelector<HTMLButtonElement>('.qm__showmore');
  let shown = Number(root.dataset.start) || 3;
  const sync = () => {
    cards.forEach((c, i) => c.classList.toggle('is-later', i >= shown));
    more?.classList.toggle('is-done', shown >= cards.length);
  };
  sync();
  more?.addEventListener('click', () => {
    const from = shown;
    shown += 4;
    sync();
    cards.slice(from, shown).forEach(measure);
    cards[from]?.querySelector<HTMLElement>('.qm__more:not(.is-empty)')?.focus({ preventScroll: true });
  });
  root.querySelectorAll<HTMLElement>('.qm__card').forEach((card) => {
    const text = card.querySelector<HTMLElement>('.qm__text');
    const btn = card.querySelector<HTMLButtonElement>('.qm__more');
    if (!text || !btn) return;
    measure(card);
    btn.addEventListener('click', () => {
      if (!dialog) return;
      dialog.querySelector('.qm__dtext')!.textContent = text.textContent;
      dialog.querySelector('#qm-dialog-name')!.textContent = card.querySelector('.qm__by strong')?.textContent ?? '';
      dialog.querySelector('.qm__dsrc')!.textContent = card.querySelector('.qm__by span')?.textContent ?? '';
      dialog.showModal();
    });
  });
  dialog?.querySelector('.qm__close')?.addEventListener('click', () => dialog.close());
  // לחיצה מחוץ לחלון סוגרת אותו
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
  });
</script>

<style>
  .qm {
    display: grid;
    gap: 1.25rem;
    /* הכרטיסים נעלמים בעדינות בקצוות */
    -webkit-mask-image: linear-gradient(to left, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(to left, transparent, #000 6%, #000 94%, transparent);
  }
  .qm__row {
    overflow: hidden;
  }
  .qm__track {
    display: flex;
    width: max-content;
    margin: 0;
    /* מקום לצל של הכרטיסים, כדי שלא ייחתך */
    padding: 0.9rem 0 2.25rem;
    list-style: none;
    animation: qm-scroll var(--dur, 90s) linear infinite;
  }
  .qm__row--rev .qm__track {
    animation-direction: reverse;
  }
  .qm:hover .qm__track,
  .qm:focus-within .qm__track {
    animation-play-state: paused;
  }
  /* שני עותקים זהים של השורה: הזזה בחצי מהרוחב מחזירה לנקודת ההתחלה בלי קפיצה */
  @keyframes qm-scroll {
    to {
      transform: translateX(50%);
    }
  }

  /* כרטיס: ארבע שורות קבועות, כך ש"קרא עוד" והשם באותו גובה בכל הכרטיסים */
  .qm__card {
    display: grid;
    grid-template-rows: auto auto auto 1fr;
    width: 14.5rem;
    margin: 0 0 0 1rem;
    padding: 1rem 1.1rem 0.9rem;
    background: var(--white);
    border: 1px solid rgb(214 229 234 / 0.7);
    border-radius: 1.1rem;
    /* צל רך ועמוק יותר (נוגה, 2026-11-13) */
    box-shadow:
      0 1px 2px rgb(11 26 51 / 0.06),
      0 10px 24px -10px rgb(11 26 51 / 0.18),
      0 26px 46px -28px rgb(8 103 127 / 0.35);
  }
  /* גרש זהב מבריק (נוגה, 2026-11-08: לא חום-כתום) */
  .qm__mark {
    display: block;
    height: 1.7rem;
    font-size: 3.1rem;
    font-weight: 900;
    line-height: 1;
    background: linear-gradient(160deg, #fff4bf 0%, #fcdc6d 30%, #f2c443 55%, #fff1a6 72%, #e9b73c 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 1px 0 rgb(209 154 74 / 0.35));
  }
  .qm__text {
    margin: 0;
    font-size: 0.94rem;
    font-weight: 400;
    line-height: 1.6;
    color: var(--navy);
    white-space: pre-line;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
    height: calc(1.6em * 4);
  }
  .qm__more {
    justify-self: start;
    margin-top: 0.4rem;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: 0.86rem;
    /* לא צבעוני ולא מודגש (נוגה, 2026-11-13) */
    font-weight: 400;
    color: #5b6b82;
    text-decoration: underline;
    text-decoration-color: rgb(91 107 130 / 0.4);
    text-underline-offset: 0.2em;
    cursor: pointer;
  }
  .qm__more:hover {
    color: var(--navy);
  }
  .qm__more.is-empty {
    visibility: hidden;
  }
  .qm__by {
    align-self: end;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    margin: 0.75rem 0 0;
    padding-top: 0.7rem;
    border-top: 1px solid var(--line);
    font-size: 0.76rem;
    color: #5b6b82;
  }
  .qm__by strong {
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--teal-dark);
  }

  /* החלון עם ההמלצה המלאה */
  .qm__dialog {
    width: min(34rem, calc(100vw - 2rem));
    max-height: min(80vh, 40rem);
    padding: 1.75rem 1.75rem 1.5rem;
    border: 0;
    border-radius: 1.25rem;
    background: var(--white);
    color: var(--navy);
    box-shadow: 0 30px 60px -20px rgb(11 26 51 / 0.6);
  }
  .qm__dialog::backdrop {
    background: rgb(11 26 51 / 0.55);
  }
  .qm__dtext {
    margin: 0;
    font-size: 1.02rem;
    font-weight: 400;
    line-height: 1.75;
    white-space: pre-line;
  }
  .qm__close {
    position: absolute;
    top: 0.75rem;
    inset-inline-end: 0.85rem;
    width: 2.25rem;
    height: 2.25rem;
    border: 0;
    border-radius: 0.6rem;
    background: var(--mist);
    color: var(--navy);
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
  }

  /* הכפתור "לעוד המלצות": רק בטלפון */
  .qm__showmore {
    display: none;
  }

  /* ---------- טלפון: ההמלצות זו מתחת לזו, בלי תנועה (נוגה, 2026-11-12) ---------- */
  @media (max-width: 40rem) {
    .qm {
      gap: 0.75rem;
      width: min(100% - 2rem, 30rem);
      margin-inline: auto;
      -webkit-mask-image: none;
      mask-image: none;
    }
    .qm__row {
      overflow: visible;
    }
    .qm__track {
      flex-direction: column;
      gap: 0.75rem;
      width: auto;
      padding: 0;
      animation: none;
    }
    .qm__card {
      width: auto;
      margin: 0;
      padding: 0.9rem 1.1rem 0.85rem;
    }
    .qm__card--dup,
    .qm__card.is-later {
      display: none;
    }
    /* הגרש קטן יותר, כדי שהכרטיס יהיה קומפקטי */
    .qm__card .qm__mark {
      height: 1.3rem;
      font-size: 2.5rem;
    }
    .qm__text {
      -webkit-line-clamp: 3;
      height: calc(1.6em * 3);
    }
    .qm__by {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: 0.25rem 0.75rem;
      margin-top: 0.6rem;
      padding-top: 0.55rem;
    }
    :global(.js) .qm__showmore {
      display: block;
      justify-self: center;
      margin-top: 0.5rem;
      padding: 0.65em 1.6em;
      border: 1.5px solid var(--teal);
      border-radius: 999px;
      background: var(--white);
      color: var(--teal-dark);
      font: inherit;
      font-weight: 800;
      cursor: pointer;
    }
    .qm__showmore.is-done {
      display: none;
    }
  }

  /* מי שביקש פחות תנועה: בלי תנועה, גוללים את השורות ביד */
  @media (prefers-reduced-motion: reduce) {
    .qm__track {
      animation: none;
    }
    .qm__row {
      overflow-x: auto;
    }
    @media (max-width: 40rem) {
      .qm__row {
        overflow: visible;
      }
    }
    .qm__card--dup {
      display: none;
    }
  }
</style>
