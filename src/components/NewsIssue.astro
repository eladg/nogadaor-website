---
// גיליון של המבזק החודשי (נוגה, 2026-11-17, סבב 4). משמש את /news/ (הגיליון החדש) ואת /news/<slug>/ (כתובת קבועה).
// סדר העמוד: פתיח (הדמות, הכותרת והתגיות, נוגה אהבה) ← אצל נוגה, ארבעה כרטיסים אחידים ← באנר השאלון (בולט, כמו בעמוד הבית)
// ← חדשות מעניינות מהשבוע, כרטיסים בהירים כמו באתר חדשות ← באנר רחב לקבוצת הוואטסאפ ← שיתוף.
// שפה גרפית אחת: כל הכרטיסים באותו מבנה (תמונה 16:9, כותרת, טקסט קצר, "להמשך קריאה", כפתור בתחתית).
// אזורים: בהיר, בהיר, כהה (השאלון), בהיר, בהיר. כך אין שני אזורים כהים צמודים, והאזור שלפני הפוטר בהיר.
import { Image } from 'astro:assets';
import ShareBar from './ShareBar.astro';
import Star from './Star.astro';
import Icon from './Icon.astro';
import ContentCover from './ContentCover.astro';
import YouTubeEmbed from './YouTubeEmbed.astro';
import { issues, hebDate, type Issue } from '../data/news';
import { quizAreas } from '../data/quiz';
import { communityIntro } from '../data/community';
import { contact } from '../data/contact';

interface Props {
  issue: Issue;
}
const { issue } = Astro.props;
const d = hebDate(issue.date);

const assets = import.meta.glob<{ default: ImageMetadata }>('/src/assets/**/*.{webp,jpg,jpeg,png}', { eager: true });
const img = (p: string) => assets[`/src/assets/${p}`]!.default;

const others = issues.filter((i) => i.slug !== issue.slug);
const has = (id: string) => issue.cards.some((c) => c.id === id) || issue.news.some((n) => n.id === id);
// רצף הקריאה: כל הכרטיסים ואחריהם כל הידיעות. בסוף כל "להמשך קריאה" יש קישור לפריט הבא
const seq = [...(issue.promo ? [{ id: issue.promo.id, title: `${issue.promo.label}, ${issue.promo.title}` }] : []), ...issue.cards, ...issue.news].map((x) => ({ id: x.id, title: x.title }));
const p = issue.promo;
const next = (id: string) => seq[seq.findIndex((x) => x.id === id) + 1];
---

<!-- פתיח (נוגה, סבב 6): כחול ומרשים, בלי הפנים של נוגה. זוהר עדין שזז, תגיות לקפיצה, שורת קהילה,
     וטיקר כותרות של כל הגיליון בתחתית, כמו פס מבזקים בחדשות -->
<header class="nx-hero">
  <div class="nx-hero__sky" aria-hidden="true">
    <span class="nx-orb nx-orb--1"></span>
    <span class="nx-orb nx-orb--2"></span>
    <span class="nx-orb nx-orb--3"></span>
  </div>
  <div class="container nx-hero__inner">
    <p class="nx-issue"><Star size={13} /> {issue.month}</p>
    <h1 class="nx-hero__title no-grad">המבזק <span>החודשי</span></h1>
    <p class="nx-hero__sub">מה חם החודש בעסקים, בכלכלה וב-AI, ומה קורה בקהילה. חמש דקות, קפה, ויוצאים לדרך</p>
    <nav class="nx-jump" aria-label="בגיליון הזה">
      {p && <a href={`#${p.id}`} class="nx-jump__hot"><Icon name="gift" size={16} />מבצע {p.label}</a>}
      {has('recording') && <a href="#recording"><Icon name="mic" size={16} />הקלטת ההדרכה</a>}
      {has('reservists') && <a href="#reservists"><Icon name="gift" size={16} />מתנה למילואימניקים</a>}
      {has('rishon') && <a href="#rishon"><Icon name="users" size={16} />מפגשים בראשון לציון</a>}
      {has('year-end') && <a href="#year-end"><Icon name="calendar" size={16} />סוף שנה לעצמאים</a>}
      <a href="#quiz"><Icon name="target" size={16} />שאלון האבחון</a>
      <a href="#news"><Icon name="book-open" size={16} />חדשות החודש</a>
    </nav>
    <p class="nx-community">
      <Icon name="heart" size={16} /> המבזק של "תודעה עסקית מנצחת", קהילה של מאות בעלי עסקים
      <a href="#group">להצטרפות <span aria-hidden="true">←</span></a>
    </p>
  </div>
  <div class="nx-ticker">
    <span class="nx-ticker__label"><span class="nx-ticker__dot" aria-hidden="true"></span>מבזק</span>
    <div class="nx-ticker__track">
      <ul class="nx-ticker__row" aria-label="כותרות הגיליון">
        {seq.map((x) => <li><a href={`#${x.id}`}>{x.title}</a></li>)}
      </ul>
      <ul class="nx-ticker__row nx-ticker__row--copy" aria-hidden="true">
        {seq.map((x) => <li><a href={`#${x.id}`} tabindex="-1">{x.title}</a></li>)}
      </ul>
    </div>
  </div>
</header>

<!-- מבצע מיוחד: כרטיס שחור-זהב בולט, מיד אחרי הפתיח (בתוך אזור בהיר, כי הפתיח כהה) -->
{p && (
  <section id={p.id} class="nx-promo-sec" aria-labelledby={`${p.id}-title`}>
    <div class="container">
      <div class="nx-promo reveal">
        <span class="nx-promo__label">{p.label}</span>
        <h2 id={`${p.id}-title`} class="nx-promo__title no-grad">{p.title}</h2>
        <p class="nx-promo__text">{p.text}</p>
        {p.deadline && <p class="nx-promo__deadline"><Icon name="clock" size={16} /> {p.deadline}</p>}
        <div class="nx-promo__actions">
          <a class="nx-promo__btn" href={p.cta.href}>{p.cta.label} <span aria-hidden="true">←</span></a>
          {p.cta2 && (
            <a class="nx-promo__btn2" href={p.cta2.href} target="_blank" rel="noopener">
              <Icon name="whatsapp" size={18} /> {p.cta2.label}<span class="sr-only"> (נפתח בוואטסאפ)</span>
            </a>
          )}
        </div>
      </div>
    </div>
  </section>
)}

<!-- אצל נוגה: כרטיסים אחידים -->
<section class="section nx-noga" aria-labelledby="noga-title">
  <div class="container">
    <h2 id="noga-title" class="nx-sec-title">הודעות קהילה חשובות</h2>
    <ul class="nx-cards">
      {issue.cards.map((c) => (
        <li id={c.id} class="nx-c reveal">
          <div class:list={['nx-c__media', c.contain && 'nx-c__media--contain', (c.cover || c.video) && 'nx-c__media--cover']}>
            <span class="nx-tag">{c.tag}</span>
            {c.video ? (
              <YouTubeEmbed id={c.video} title={c.title}>
                <ContentCover title={c.cover!.title} motif={c.cover!.motif} tone={c.cover!.tone} kind="lecture" ratio="16/9" />
              </YouTubeEmbed>
            ) : c.cover ? (
              <ContentCover title={c.cover.title} motif={c.cover.motif} tone={c.cover.tone} ratio="16/9" />
            ) : (
              <Image src={img(c.image!)} alt={c.imageAlt ?? ''} widths={[480, 800]} sizes="(min-width: 62rem) 30vw, (min-width: 48rem) 45vw, 92vw" />
            )}
          </div>
          <div class="nx-c__body">
            {c.meta && (
              <p class="nx-c__meta">
                {c.meta}
                {c.time && <> · <span dir="ltr">{c.time}</span></>}
              </p>
            )}
            <h3 class="nx-c__title">{c.title}</h3>
            <p class="nx-c__text">{c.text}</p>
            {(c.more || c.sessions) && (
              <details class="nx-more">
                <summary><span class="nx-more__open">להמשך קריאה</span><span class="nx-more__close">סגירה</span></summary>
                {c.more?.map((p) => <p>{p}</p>)}
                {c.sessions && (
                  <ul class="nx-ses">
                    {c.sessions.map((s) => (
                      <li>
                        <strong>{s.date} · יום {s.day} · <span dir="ltr">{s.time}</span></strong>
                        <span>{s.areas}</span>
                      </li>
                    ))}
                  </ul>
                )}
                {next(c.id) && <a class="nx-next" href={`#${next(c.id)!.id}`}>הבא בתור, {next(c.id)!.title} <span aria-hidden="true">←</span></a>}
              </details>
            )}
            {c.cta && (
              <a class="btn nx-c__btn" href={c.cta.href} target={c.cta.external ? '_blank' : undefined} rel={c.cta.external ? 'noopener' : undefined}>
                {c.cta.label}
                {c.cta.external && <span class="sr-only"> (נפתח בלשונית חדשה)</span>}
              </a>
            )}
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- השאלון: באנר כהה ובולט, בסגנון הבאנר שבעמוד הבית -->
<section id="quiz" class="nx-quiz" aria-labelledby="quiz-title">
  <div class="container">
    <div class="nx-quiz__card">
      <Image src={img('character/pointing-down-bust-clear.webp')} alt="" widths={[240, 400]} sizes="12rem" class="nx-quiz__toon" />
      <div class="nx-quiz__body">
        <h2 id="quiz-title" class="nx-quiz__title no-grad">שאלון מיקוד פיתוח עסקי{' '}<span>להגדלת הכנסות בלי הוצאות פרסום</span></h2>
        <p class="nx-quiz__text">עשרות בעלות ובעלי עסקים כבר בדקו. שאלון קצר שמסתכל על העסק מלמעלה, כמו בפגישת ייעוץ, ובסופו מקבלים מיד</p>
        <ul class="nx-quiz__gets">
          <li><Star size={16} /> תמונת מצב של העסק ב-{quizAreas.length} תחומים</li>
          <li><Star size={16} /> העצות שכדאי להתחיל מהן, לפי התשובות שלך</li>
          <li><Star size={16} /> מה כבר עובד אצלך ושווה לחזק</li>
        </ul>
        <a class="nx-quiz__btn" href="/guides/business-focus-quiz/">לבדיקת העסק שלך <span aria-hidden="true">←</span></a>
      </div>
    </div>
  </div>
</section>

<!-- חדשות מעניינות מהשבוע: כרטיסים בהירים, כותרת אחת, משפט אחד, והשאר ב"להמשך קריאה" -->
<section id="news" class="section nx-news" aria-labelledby="news-title">
  <div class="container">
    <h2 id="news-title" class="nx-sec-title">חדשות מעניינות מהחודש</h2>
    <p class="nx-sec-sub">מה שקרה החודש במשק, ב-AI ובכלים הדיגיטליים</p>
    <ul class="nx-grid">
      {issue.news.map((n, i) => (
        <li id={n.id} class="nx-n reveal" style={`transition-delay: ${(i % 3) * 0.08}s`}>
          <div class="nx-n__media">
            <ContentCover title=" " motif={n.motif} tone={n.tone} ratio="16/9" />
            <span class="nx-tag">{n.tag}</span>
            {n.badge && <span class="nx-n__badge">{n.badge}</span>}
          </div>
          <div class="nx-n__body">
            <h3 class="nx-n__title">{n.title}</h3>
            <p class="nx-n__teaser">{n.teaser}</p>
            <details class="nx-more">
              <summary><span class="nx-more__open">להמשך קריאה</span><span class="nx-more__close">סגירה</span></summary>
              <p>{n.text}</p>
              {n.bullets && <ul class="nx-n__list">{n.bullets.map((b) => <li>{b}</li>)}</ul>}
              {n.after && <p>{n.after}</p>}
              <p class="nx-n__src">
                <span>מקור</span>
                {n.sources.map((s) => (
                  <a href={s.url} target="_blank" rel="noopener">{s.label}<span class="sr-only"> (נפתח בלשונית חדשה)</span></a>
                ))}
              </p>
              {next(n.id) && <a class="nx-next" href={`#${next(n.id)!.id}`}>הבא בתור, {next(n.id)!.title} <span aria-hidden="true">←</span></a>}
            </details>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- באנר רחב לקבוצת הוואטסאפ (הטקסט של הקהילה מעמוד צור קשר, src/data/community.ts) -->
<section id="group" class="section nx-group-sec" aria-labelledby="group-title">
  <div class="container">
    <div class="nx-group">
      <Image src={img('news/community-group.webp')} alt="תודעה עסקית מנצחת, פתרונות והזדמנויות להגדלת הכנסות" widths={[320, 600]} sizes="(min-width: 48rem) 20rem, 80vw" class="nx-group__img" />
      <div class="nx-group__body">
        <h2 id="group-title" class="nx-group__title no-grad">בואו לקבוצה <span>"תודעה עסקית מנצחת"</span></h2>
        <p class="nx-group__sub">קבוצת הוואטסאפ החינמית של נוגה. המבזק הבא מגיע לשם ראשון</p>
        {communityIntro.map((p) => <p>{p}</p>)}
        <a class="btn nx-group__btn" href={contact.whatsappGroup} target="_blank" rel="noopener">
          <Icon name="whatsapp" size={20} /> להצטרפות לקבוצה<span class="sr-only"> (נפתח בלשונית חדשה)</span>
        </a>
      </div>
    </div>

    <div class="nx-share">
      <p>אהבת? שווה לשלוח למי שיש לו עסק</p>
      <ShareBar title={`המבזק החודשי של נוגה דיין אור, ${issue.month}`} print={false} />
    </div>

    {others.length > 0 && (
      <nav class="nx-archive" aria-labelledby="archive-title">
        <h2 id="archive-title" class="nx-archive__title">גיליונות נוספים</h2>
        <ul>
          {others.map((o) => (
            <li>
              <a href={`/news/${o.slug}/`}>
                <strong>{o.month}</strong>
                <span>{o.headline}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}
  </div>
</section>

<style>
  /* ---------- פתיח: כחול, זוהר שזז לאט, וטיקר ---------- */
  .nx-hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    color: var(--on-dark);
    text-align: center;
    background:
      radial-gradient(1px 1px at 12% 22%, rgb(255 255 255 / 0.7), transparent 60%),
      radial-gradient(1px 1px at 78% 14%, rgb(255 255 255 / 0.6), transparent 60%),
      radial-gradient(1.5px 1.5px at 64% 70%, rgb(252 220 109 / 0.8), transparent 60%),
      radial-gradient(1px 1px at 30% 80%, rgb(255 255 255 / 0.5), transparent 60%),
      radial-gradient(1.5px 1.5px at 90% 52%, rgb(255 255 255 / 0.6), transparent 60%),
      radial-gradient(1px 1px at 46% 36%, rgb(252 220 109 / 0.6), transparent 60%),
      linear-gradient(170deg, #0f2d50 0%, var(--navy) 55%, #071427 100%);
  }
  .nx-hero__sky {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .nx-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
    opacity: 0.55;
    animation: nx-drift 18s ease-in-out infinite alternate;
  }
  .nx-orb--1 {
    width: 26rem;
    height: 26rem;
    top: -8rem;
    right: -6rem;
    background: rgb(12 138 168 / 0.75);
  }
  .nx-orb--2 {
    width: 22rem;
    height: 22rem;
    bottom: -9rem;
    left: -5rem;
    background: rgb(209 154 74 / 0.55);
    animation-duration: 22s;
  }
  .nx-orb--3 {
    width: 14rem;
    height: 14rem;
    top: 30%;
    left: 38%;
    background: rgb(12 138 168 / 0.35);
    animation-duration: 26s;
  }
  @keyframes nx-drift {
    to {
      transform: translate(3rem, 2rem) scale(1.12);
    }
  }
  .nx-hero__inner {
    padding-block: clamp(2.5rem, 7vw, 4.5rem) clamp(2rem, 5vw, 3rem);
  }
  .nx-issue {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0 0 1.1rem;
    padding: 0.4rem 1rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.08);
    border: 1px solid rgb(252 220 109 / 0.45);
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--gold-light);
  }
  .nx-hero__title {
    margin: 0;
    font-size: clamp(3rem, 10vw, 6rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--white);
  }
  .nx-hero__title span {
    background: var(--gold-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .nx-hero__sub {
    margin: 1.1rem auto 1.75rem;
    max-width: 36rem;
    font-size: clamp(1.1rem, 2.4vw, 1.35rem);
    line-height: 1.55;
    color: var(--on-dark-soft);
  }
  .nx-jump {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    max-width: 52rem;
    margin-inline: auto;
  }
  .nx-jump a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 1.05rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.08);
    border: 1px solid rgb(255 255 255 / 0.2);
    backdrop-filter: blur(6px);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--white);
    text-decoration: none;
  }
  .nx-jump a :global(svg) {
    color: var(--gold-light);
  }
  @media (hover: hover) {
    .nx-jump a {
      transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;
    }
    .nx-jump a:hover {
      transform: translateY(-2px);
      background: rgb(255 255 255 / 0.14);
      border-color: rgb(252 220 109 / 0.6);
    }
  }
  .nx-community {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.4rem 0.6rem;
    margin: 1.6rem 0 0;
    font-weight: 500;
    color: #a9dceb;
  }
  .nx-community :global(svg) {
    color: var(--gold-light);
  }
  .nx-community a {
    color: var(--gold-light);
    font-weight: 800;
  }
  @media (max-width: 36rem) {
    .nx-jump {
      gap: 0.45rem;
    }
    .nx-jump a {
      padding: 0.42rem 0.8rem;
      font-size: 0.86rem;
    }
  }

  /* טיקר הכותרות: פס מבזקים שזז לאט, נעצר כשמצביעים עליו */
  .nx-ticker {
    display: flex;
    align-items: stretch;
    border-top: 1px solid rgb(255 255 255 / 0.12);
    background: rgb(0 0 0 / 0.25);
  }
  .nx-ticker__label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    flex: none;
    padding: 0.7rem 1.1rem;
    background: var(--gold-gradient);
    color: var(--navy);
    font-weight: 900;
  }
  .nx-ticker__dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: #c0392b;
    animation: nx-pulse 1.6s ease-in-out infinite;
  }
  @keyframes nx-pulse {
    50% {
      opacity: 0.25;
    }
  }
  .nx-ticker__track {
    display: flex;
    overflow: hidden;
    min-width: 0;
    flex: 1;
  }
  .nx-ticker__row {
    display: flex;
    flex: none;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    animation: nx-tick 110s linear infinite;
  }
  .nx-ticker:hover .nx-ticker__row,
  .nx-ticker:focus-within .nx-ticker__row {
    animation-play-state: paused;
  }
  @keyframes nx-tick {
    to {
      transform: translateX(100%);
    }
  }
  .nx-ticker__row li {
    display: flex;
    align-items: center;
    white-space: nowrap;
  }
  .nx-ticker__row li::after {
    content: '✦';
    margin-inline: 1.1rem;
    color: var(--gold-light);
    font-size: 0.8rem;
  }
  .nx-ticker__row a {
    padding-block: 0.7rem;
    color: var(--white);
    font-weight: 700;
    text-decoration: none;
  }
  .nx-ticker__row a:hover {
    color: var(--gold-light);
  }
  @media (prefers-reduced-motion: reduce) {
    .nx-orb,
    .nx-ticker__dot {
      animation: none;
    }
    .nx-ticker__row {
      animation: none;
    }
    .nx-ticker__track {
      overflow-x: auto;
    }
    .nx-ticker__row--copy {
      display: none;
    }
  }

  /* ---------- מבצע ---------- */
  .nx-jump .nx-jump__hot {
