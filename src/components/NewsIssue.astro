---
// גיליון של המבזק השבועי (נוגה, 2026-11-17, סבב 4). משמש את /news/ (הגיליון החדש) ואת /news/<slug>/ (כתובת קבועה).
// סדר העמוד: פתיח (הדמות, הכותרת והתגיות, נוגה אהבה) ← אצל נוגה, ארבעה כרטיסים אחידים ← באנר השאלון (בולט, כמו בעמוד הבית)
// ← חדשות מעניינות מהשבוע, כרטיסים בהירים כמו באתר חדשות ← באנר רחב לקבוצת הוואטסאפ ← שיתוף.
// שפה גרפית אחת: כל הכרטיסים באותו מבנה (תמונה 16:9, כותרת, טקסט קצר, "להמשך קריאה", כפתור בתחתית).
// אזורים: בהיר, בהיר, כהה (השאלון), בהיר, בהיר. כך אין שני אזורים כהים צמודים, והאזור שלפני הפוטר בהיר.
import { Image } from 'astro:assets';
import ShareBar from './ShareBar.astro';
import Star from './Star.astro';
import Icon from './Icon.astro';
import ContentCover from './ContentCover.astro';
import { issues, hebDate, type Issue } from '../data/news';
import { quizYear, quizAreas } from '../data/quiz';
import { communityIntro } from '../data/community';
import { contact } from '../data/contact';

interface Props {
  issue: Issue;
}
const { issue } = Astro.props;
const d = hebDate(issue.date);

const assets = import.meta.glob<{ default: ImageMetadata }>('/src/assets/**/*.{webp,jpg,jpeg,png}', { eager: true });
const img = (p: string) => assets[`/src/assets/${p}`]!.default;

const others = issues.filter((i) => i.slug !== issue.slug);
const has = (id: string) => issue.cards.some((c) => c.id === id);
---

<!-- פתיח -->
<header class="nx-hero">
  <div class="container nx-hero__grid">
    <div class="nx-hero__text">
      <p class="nx-issue">
        <Star size={13} /> גיליון {issue.number} <span aria-hidden="true">·</span> <time datetime={issue.date}>{d.full}</time>
      </p>
      <h1 class="nx-hero__title no-grad">המבזק <span>השבועי</span></h1>
      <p class="nx-hero__sub">מה חם השבוע בעסקים, בכלכלה וב-AI. חמש דקות, קפה, ויוצאים לדרך</p>
      <nav class="nx-jump" aria-label="בגיליון הזה">
        {has('bizlive') && <a href="#bizlive"><Icon name="calendar" size={16} />הדרכה חינמית ב-25.11</a>}
        <a href="#quiz"><Icon name="target" size={16} />שאלון האבחון</a>
        {has('rishon') && <a href="#rishon"><Icon name="users" size={16} />מפגשים בראשון לציון</a>}
        <a href="#news"><Icon name="book-open" size={16} />חדשות השבוע</a>
      </nav>
    </div>
    <div class="nx-hero__art" aria-hidden="true">
      <Image src={img('character/phone-surprised.webp')} alt="" widths={[300, 520]} sizes="(min-width: 52rem) 19rem, 42vw" class="toon nx-hero__toon" loading="eager" />
    </div>
  </div>
</header>

<!-- אצל נוגה: כרטיסים אחידים -->
<section class="section nx-noga" aria-labelledby="noga-title">
  <div class="container">
    <h2 id="noga-title" class="nx-sec-title">מה חדש אצל נוגה</h2>
    <ul class="nx-cards">
      {issue.cards.map((c) => (
        <li id={c.id} class="nx-c reveal">
          <div class:list={['nx-c__media', c.contain && 'nx-c__media--contain']}>
            <Image src={img(c.image)} alt={c.imageAlt ?? ''} widths={[480, 800]} sizes="(min-width: 48rem) 45vw, 92vw" />
          </div>
          <div class="nx-c__body">
            {c.meta && (
              <p class="nx-c__meta">
                {c.meta}
                {c.time && <> · <span dir="ltr">{c.time}</span></>}
              </p>
            )}
            <h3 class="nx-c__title">{c.title}</h3>
            <p class="nx-c__text">{c.text}</p>
            {(c.more || c.sessions) && (
              <details class="nx-more">
                <summary><span class="nx-more__open">להמשך קריאה</span><span class="nx-more__close">סגירה</span></summary>
                {c.more?.map((p) => <p>{p}</p>)}
                {c.sessions && (
                  <ul class="nx-ses">
                    {c.sessions.map((s) => (
                      <li>
                        <strong>{s.date} · יום {s.day} · <span dir="ltr">{s.time}</span></strong>
                        <span>{s.areas}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </details>
            )}
            {c.cta && (
              <a class="btn nx-c__btn" href={c.cta.href} target={c.cta.external ? '_blank' : undefined} rel={c.cta.external ? 'noopener' : undefined}>
                {c.cta.label}
                {c.cta.external && <span class="sr-only"> (נפתח בלשונית חדשה)</span>}
              </a>
            )}
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- השאלון: באנר כהה ובולט, בסגנון הבאנר שבעמוד הבית -->
<section id="quiz" class="nx-quiz" aria-labelledby="quiz-title">
  <div class="container">
    <div class="nx-quiz__card">
      <Image src={img('character/pointing-down-bust-clear.webp')} alt="" widths={[240, 400]} sizes="12rem" class="nx-quiz__toon" />
      <div class="nx-quiz__body">
        <h2 id="quiz-title" class="nx-quiz__title no-grad">מה המיקוד הנכון <span>לעסק שלך ב-{quizYear}?</span></h2>
        <p class="nx-quiz__text">עשרות בעלות ובעלי עסקים כבר בדקו. שאלון קצר שמסתכל על העסק מלמעלה, כמו בפגישת ייעוץ, ובסופו מקבלים מיד</p>
        <ul class="nx-quiz__gets">
          <li><Star size={16} /> תמונת מצב של העסק ב-{quizAreas.length} תחומים</li>
          <li><Star size={16} /> העצות שכדאי להתחיל מהן, לפי התשובות שלך</li>
          <li><Star size={16} /> מה כבר עובד אצלך ושווה לחזק</li>
        </ul>
        <a class="nx-quiz__btn" href="/guides/business-focus-quiz/">לבדיקת העסק שלך <span aria-hidden="true">←</span></a>
      </div>
    </div>
  </div>
</section>

<!-- חדשות מעניינות מהשבוע: כרטיסים בהירים, כותרת אחת, משפט אחד, והשאר ב"להמשך קריאה" -->
<section id="news" class="section nx-news" aria-labelledby="news-title">
  <div class="container">
    <h2 id="news-title" class="nx-sec-title">חדשות מעניינות מהשבוע</h2>
    <p class="nx-sec-sub">מה שקרה במשק, ב-AI ובכלים הדיגיטליים, עם המקור של כל ידיעה</p>
    <ul class="nx-grid">
      {issue.news.map((n, i) => (
        <li id={n.id} class="nx-n reveal" style={`transition-delay: ${(i % 3) * 0.08}s`}>
          <div class="nx-n__media">
            <ContentCover title=" " motif={n.motif} tone={n.tone} ratio="16/9" />
            {n.badge && <span class="nx-n__badge">{n.badge}</span>}
          </div>
          <div class="nx-n__body">
            <h3 class="nx-n__title">{n.title}</h3>
            <p class="nx-n__teaser">{n.teaser}</p>
            <details class="nx-more">
              <summary><span class="nx-more__open">להמשך קריאה</span><span class="nx-more__close">סגירה</span></summary>
              <p>{n.text}</p>
              <p class="nx-n__src">
                <span>מקור</span>
                {n.sources.map((s) => (
                  <a href={s.url} target="_blank" rel="noopener">{s.label}<span class="sr-only"> (נפתח בלשונית חדשה)</span></a>
                ))}
              </p>
            </details>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- באנר רחב לקבוצת הוואטסאפ (הטקסט של הקהילה מעמוד צור קשר, src/data/community.ts) -->
<section class="section nx-group-sec" aria-labelledby="group-title">
  <div class="container">
    <div class="nx-group">
      <Image src={img('news/community-group.webp')} alt="תודעה עסקית מנצחת, פתרונות והזדמנויות להגדלת הכנסות" widths={[320, 600]} sizes="(min-width: 48rem) 20rem, 80vw" class="nx-group__img" />
      <div class="nx-group__body">
        <h2 id="group-title" class="nx-group__title no-grad">בואו לקבוצה <span>"תודעה עסקית מנצחת"</span></h2>
        <p class="nx-group__sub">קבוצת הוואטסאפ החינמית של נוגה. המבזק הבא מגיע לשם ראשון</p>
        {communityIntro.map((p) => <p>{p}</p>)}
        <a class="btn nx-group__btn" href={contact.whatsappGroup} target="_blank" rel="noopener">
          <Icon name="whatsapp" size={20} /> להצטרפות לקבוצה<span class="sr-only"> (נפתח בלשונית חדשה)</span>
        </a>
      </div>
    </div>

    <div class="nx-share">
      <p>אהבת? שווה לשלוח למי שיש לו עסק</p>
      <ShareBar title={`המבזק השבועי של נוגה דיין אור, ${d.full}`} print={false} />
    </div>

    {others.length > 0 && (
      <nav class="nx-archive" aria-labelledby="archive-title">
        <h2 id="archive-title" class="nx-archive__title">גיליונות נוספים</h2>
        <ul>
          {others.map((o) => (
            <li>
              <a href={`/news/${o.slug}/`}>
                <strong>גיליון {o.number}</strong> · <time datetime={o.date}>{hebDate(o.date).full}</time>
                <span>{o.headline}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}
  </div>
</section>

<style>
  /* ---------- פתיח (נוגה אהבה, בלי שינוי) ---------- */
  .nx-hero {
    position: relative;
    overflow: hidden;
    padding-block: 2rem 2.5rem;
    background:
      radial-gradient(38rem 26rem at 8% 0%, rgb(12 138 168 / 0.16), transparent 65%),
      radial-gradient(34rem 24rem at 95% 30%, rgb(209 154 74 / 0.2), transparent 65%),
      linear-gradient(180deg, #fff 0%, var(--mist) 100%);
  }
  .nx-hero__grid {
    display: grid;
    align-items: center;
    gap: 1rem 2rem;
  }
  @media (min-width: 52rem) {
    .nx-hero__grid {
      grid-template-columns: 1.4fr 1fr;
    }
  }
  .nx-issue {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0 0 1rem;
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
    background: var(--white);
    border: 1px solid rgb(209 154 74 / 0.45);
    box-shadow: 0 6px 18px -12px rgb(11 26 51 / 0.4);
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--navy);
  }
  .nx-hero__title {
    margin: 0;
    font-size: clamp(2.6rem, 7.5vw, 4.8rem);
    font-weight: 900;
    line-height: 1;
    color: var(--navy);
  }
  .nx-hero__title span {
    background: linear-gradient(90deg, var(--gold-dark), var(--teal));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .nx-hero__sub {
    margin: 1rem 0 1.5rem;
    max-width: 32rem;
    font-size: clamp(1.1rem, 2.3vw, 1.3rem);
    line-height: 1.55;
    color: #33445d;
  }
  .nx-jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .nx-jump a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background: var(--white);
    border: 1px solid var(--line);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--navy);
    text-decoration: none;
    box-shadow: 0 6px 16px -12px rgb(11 26 51 / 0.45);
  }
  .nx-jump a :global(svg) {
    color: var(--teal-dark);
  }
  @media (hover: hover) {
    .nx-jump a {
      transition: transform 0.2s ease, border-color 0.2s ease;
    }
    .nx-jump a:hover {
      transform: translateY(-2px);
      border-color: var(--teal);
    }
  }
  .nx-hero__art {
    position: relative;
    justify-self: center;
    width: min(19rem, 70vw);
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    background: linear-gradient(150deg, rgb(12 138 168 / 0.25), rgb(209 154 74 / 0.4));
    box-shadow: 0 0 0 8px rgb(255 255 255 / 0.7), 0 30px 50px -30px rgb(11 26 51 / 0.5);
  }
  .nx-hero__art :global(.nx-hero__toon) {
    position: absolute;
    inset: 6% 0 auto;
    width: 100%;
    height: auto;
    mix-blend-mode: multiply;
  }
  @media (max-width: 51.99rem) {
    .nx-hero__art {
      width: min(9.5rem, 42vw);
      order: -1;
    }
    .nx-jump {
      gap: 0.45rem;
    }
    .nx-jump a {
      padding: 0.4rem 0.75rem;
      font-size: 0.86rem;
    }
  }

  /* ---------- כותרות האזורים ---------- */
  .nx-sec-title {
    margin: 0;
    text-align: center;
    font-size: clamp(1.9rem, 4.5vw, 2.7rem);
    font-weight: 900;
    line-height: 1.15;
  }
  .nx-sec-sub {
    margin: 0.6rem auto 0;
    max-width: 36rem;
    text-align: center;
    color: #4a5b73;
  }

  /* ---------- "להמשך קריאה" (משותף לכל הכרטיסים) ---------- */
  .nx-more summary {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    cursor: pointer;
    list-style: none;
    font-weight: 800;
    color: var(--teal-dark);
  }
  .nx-more summary::-webkit-details-marker {
    display: none;
  }
  .nx-more summary::after {
    content: '';
    width: 0.5em;
    height: 0.5em;
    border-inline-end: 2px solid currentColor;
    border-block-end: 2px solid currentColor;
    rotate: 45deg;
    translate: 0 -0.15em;
    transition: rotate 0.2s ease;
  }
  .nx-more[open] summary::after {
    rotate: 225deg;
    translate: 0 0.1em;
  }
  .nx-more__close,
  .nx-more[open] .nx-more__open {
    display: none;
  }
  .nx-more[open] .nx-more__close {
    display: inline;
  }
  .nx-more p {
    margin: 0.75rem 0 0;
    line-height: 1.65;
  }

  /* ---------- אצל נוגה ---------- */
  .nx-noga {
    background: var(--mist);
    padding-top: 1.5rem;
  }
  .nx-cards {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.75rem;
  }
  @media (max-width: 47.99rem) {
    .nx-cards {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .nx-c {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 22px;
    background: var(--white);
    border: 1px solid var(--line);
    box-shadow: 0 20px 40px -30px rgb(11 26 51 / 0.5);
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }
  .nx-c__media {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--mist);
  }
  .nx-c__media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }
  .nx-c__media--contain {
    background: radial-gradient(60% 80% at 50% 50%, #12305a, #071427);
  }
  .nx-c__media--contain :global(img) {
    object-fit: contain;
    object-position: 50% 50%;
  }
  .nx-c__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.35rem 1.5rem 1.5rem;
  }
  .nx-c__meta [dir="ltr"],
  .nx-ses [dir="ltr"] {
    white-space: nowrap;
  }
  .nx-c__meta {
    margin: 0 0 0.4rem;
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--teal-dark);
  }
  .nx-c__title {
    margin: 0 0 0.55rem;
    font-size: clamp(1.35rem, 2.6vw, 1.65rem);
    font-weight: 900;
    line-height: 1.25;
    color: var(--navy);
    text-wrap: balance;
  }
  .nx-c__text {
    margin: 0 0 0.75rem;
    line-height: 1.65;
  }
  .nx-c .nx-more {
    margin-bottom: 1rem;
  }
  .nx-c__btn {
    margin-top: auto;
    align-self: flex-start;
  }
  .nx-ses {
    list-style: none;
    margin: 0.9rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .nx-ses li {
    display: grid;
    gap: 0.1rem;
    padding: 0.6rem 0.85rem;
    border-inline-start: 3px solid var(--gold-dark);
    background: var(--mist);
    border-radius: 0.5rem;
    line-height: 1.45;
  }
  .nx-ses strong {
    color: var(--navy);
  }
  @media (hover: hover) {
    .nx-c,
    .nx-n {
      transition: opacity 0.6s ease, translate 0.6s ease, transform 0.25s ease, box-shadow 0.25s ease;
    }
    .nx-c:hover,
    .nx-n:hover {
      transform: translateY(-4px);
      box-shadow: 0 28px 48px -30px rgb(11 26 51 / 0.6);
    }
  }

  /* ---------- השאלון ---------- */
  .nx-quiz {
    scroll-margin-top: var(--header-h);
    padding-block: clamp(3rem, 7vw, 4.5rem);
    background:
      radial-gradient(40rem 26rem at 15% 20%, rgb(12 138 168 / 0.32), transparent 70%),
      radial-gradient(36rem 24rem at 85% 90%, rgb(252 220 109 / 0.2), transparent 70%),
      var(--navy);
    color: var(--on-dark);
  }
  .nx-quiz__card {
    display: grid;
    align-items: center;
    gap: 1.5rem 2.5rem;
    max-width: 58rem;
    margin-inline: auto;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-radius: 28px;
    background: linear-gradient(160deg, rgb(255 255 255 / 0.07), rgb(255 255 255 / 0.02));
    border: 1px solid rgb(252 220 109 / 0.45);
    box-shadow: 0 0 0 1px rgb(12 138 168 / 0.25), 0 30px 60px -30px rgb(0 0 0 / 0.6), inset 0 0 60px -30px rgb(12 138 168 / 0.6);
    text-align: center;
  }
  @media (min-width: 48rem) {
    .nx-quiz__card {
      grid-template-columns: 12rem 1fr;
      text-align: start;
    }
  }
  .nx-quiz :global(.nx-quiz__toon) {
    justify-self: center;
    width: 12rem;
    height: auto;
  }
  @media (max-width: 47.99rem) {
    .nx-quiz :global(.nx-quiz__toon) {
      width: 8rem;
    }
  }
  .nx-quiz__title {
    margin: 0 0 0.75rem;
    font-size: clamp(1.8rem, 4.5vw, 2.6rem);
    font-weight: 900;
    line-height: 1.2;
    color: var(--white);
  }
  .nx-quiz__title span {
    background: var(--gold-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .nx-quiz__text {
    margin: 0 0 1rem;
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--on-dark-soft);
  }
  .nx-quiz__gets {
    list-style: none;
    display: grid;
    gap: 0.5rem;
    width: fit-content;
    max-width: 100%;
    margin: 0 auto 1.5rem;
    padding: 0;
    text-align: start;
    font-weight: 700;
    color: var(--white);
  }
  @media (min-width: 48rem) {
    .nx-quiz__gets {
      margin-inline: 0;
    }
  }
  .nx-quiz__gets li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .nx-quiz__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.9em 2.4em;
    border-radius: 999px;
    background: var(--gold-gradient);
    color: var(--navy);
    font-size: clamp(1.1rem, 2vw, 1.25rem);
    font-weight: 900;
    text-decoration: none;
    box-shadow: 0 16px 40px -14px rgb(252 220 109 / 0.7);
  }
  @media (hover: hover) {
    .nx-quiz__btn {
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .nx-quiz__btn:hover {
      transform: translateY(-3px);
      box-shadow: 0 22px 46px -14px rgb(252 220 109 / 0.85);
    }
  }

  /* ---------- חדשות מעניינות מהשבוע ---------- */
  .nx-news {
    scroll-margin-top: var(--header-h);
  }
  .nx-grid {
    list-style: none;
