---
// ריבועי השירותים שמתהפכים (בהשראת yanivless.co.il, לבקשת נוגה, 2026-11-07).
// מלפנים: אייקון, שם השירות ושורת התועלת. מאחור: משפט קצר וקישור לעמוד השירות.
// הריבוע כולו קישור. ההיפוך קורה במעבר עכבר או בפוקוס מהמקלדת.
// במכשירי מגע, או אצל מי שביקש פחות תנועה, אין היפוך: שני הצדדים מוצגים יחד בכרטיס אחד.
// 6 שירותים: 3 בשורה במחשב, 2 בטאבלט, 1 בנייד (שורות מאוזנות).
// variant="row" (עמוד הבית, נוגה 2026-11-08): כל השירותים בשורה אחת, כרטיס כהה עם אייקון טורקיז, ומאחור טורקיז.
// בטאבלט 3 בשורה ובטלפון 2 בשורה (נוגה, 2026-11-12), ובמסך מגע רק הצד הקדמי, בלי הטקסט שמאחור.
// עדכון (נוגה, 2026-11-13, אחרי השיחה עם המעצבת): שתי שורות של 3 במקום 6 בשורה, האייקון בזהב בלי ריבוע,
// כותרת גדולה יותר, והצד האחורי בטורקיז עמוק עם טקסט גדול וממורכז.
// "הכול מחובר": קו זהב דק עם נקודה מחבר בין הכרטיסים, לרוחב ולגובה (במקום חצי עיגול של פאזל, שנראה מיושן).
import Icon from './Icon.astro';
import { services } from '../data/services';
import { launch } from '../data/launch';

interface Props {
  headingLevel?: 'h2' | 'h3';
  variant?: 'grid' | 'row';
}
const { headingLevel = 'h3', variant = 'grid' } = Astro.props;
const row = variant === 'row';
const H = headingLevel;
---

<ul class:list={['svc', { 'svc--row': row }]}>
  {
    services.map((s, i) => (
      <li class="svc__item reveal" style={`transition-delay: ${(i % 3) * 0.1}s`}>
        <a class="svc__link" href={s.href}>
          <span class="svc__inner">
            <span class="svc__face svc__front">
              <span class="svc__icon">
                <Icon name={s.icon} size={row ? 40 : 34} />
              </span>
              <H class="svc__title">{s.title}</H>
              <span class="svc__lead">{s.lead}</span>
            </span>
            <span class="svc__face svc__back" aria-hidden="true">
              <span class="svc__card">{s.card}</span>
              {launch.servicePagesLive && <span class="svc__more">לפרטים ←</span>}
            </span>
          </span>
          <span class="sr-only">: {s.card}</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .svc {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  @media (max-width: 62rem) {
    .svc {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 36rem) {
    .svc {
      grid-template-columns: 1fr;
    }
  }
  .svc__item {
    margin: 0;
  }
  .svc__link {
    display: block;
    height: 100%;
    color: inherit;
    text-decoration: none;
    perspective: 1200px;
    border-radius: 1.25rem;
  }
  .svc__inner {
    position: relative;
    display: block;
    height: 100%;
    min-height: 15rem;
    transform-style: preserve-3d;
    transition: transform 0.7s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .svc__face {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 1.75rem 1.5rem;
    border-radius: 1.25rem;
    text-align: center;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }
  .svc__front {
    background: var(--white);
    border: 1px solid var(--line);
    box-shadow: 0 10px 30px -18px rgb(11 26 51 / 0.35);
  }
  .svc__back {
    transform: rotateY(180deg);
    color: var(--on-dark);
    background:
      radial-gradient(18rem 12rem at 100% 0, rgb(12 138 168 / 0.35), transparent 70%),
      radial-gradient(16rem 10rem at 0 100%, rgb(209 154 74 / 0.22), transparent 72%),
      var(--navy);
  }
  .svc__icon {
    color: var(--teal-dark);
  }
  .svc__item:nth-child(even) .svc__icon {
    color: var(--gold-dark);
  }
  .svc__title {
    margin: 0;
    font-size: 1.35rem;
    font-weight: 900;
    color: var(--navy);
  }
  .svc__lead {
    font-weight: 600;
    color: #33445c;
    line-height: 1.45;
  }
  .svc__card {
    font-size: 1.05rem;
    line-height: 1.6;
  }
  .svc__more {
    font-weight: 800;
    color: var(--gold-light);
  }

  /* היפוך: רק במכשיר עם עכבר, ורק אם לא ביקשו פחות תנועה */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .svc__link:hover .svc__inner,
    .svc__link:focus-visible .svc__inner {
      transform: rotateY(180deg);
    }
  }

  /* מגע או פחות תנועה: בלי היפוך. שני הצדדים זה מתחת לזה, בכרטיס אחד */
  @media (hover: none), (prefers-reduced-motion: reduce) {
    /* החלק התחתון נמתח עד סוף הכרטיס, כך שכל הכרטיסים בשורה באותו אורך בדיוק (נוגה, 2026-11-09) */
    .svc__inner {
      display: flex;
      flex-direction: column;
      min-height: 0;
      transform: none !important;
      border-radius: 1.25rem;
      overflow: hidden;
      border: 1px solid var(--line);
    }
    .svc__face {
      position: static;
      transform: none;
      backface-visibility: visible;
      border-radius: 0;
    }
    .svc__front {
      border: 0;
      box-shadow: none;
      padding-bottom: 1rem;
    }
    .svc__back {
      flex: 1;
      justify-content: flex-start;
      padding-block: 1.1rem 1.25rem;
    }
  }

  /* ---------- שורה אחת (עמוד הבית) ---------- */
  .svc--row {
    --svc-gap: 1.75rem;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--svc-gap);
    max-width: 62rem;
    margin-inline: auto;
  }
  .svc--row .svc__item {
    position: relative;
  }
  .svc--row .svc__inner {
    min-height: 14.5rem;
  }
  /* החיבורים בין הכרטיסים: קו זהב דק לכרטיס הבא בשורה (שמאלה), וקו לכרטיס שמתחת */
  .svc--row .svc__item::before,
  .svc--row .svc__item::after {
    content: '';
    position: absolute;
    pointer-events: none;
  }
  .svc--row .svc__item:not(:nth-child(3n))::before {
    top: 50%;
    left: calc(-1 * var(--svc-gap));
    width: var(--svc-gap);
    height: 2px;
    background: linear-gradient(90deg, rgb(209 154 74 / 0.25), var(--gold-dark), rgb(209 154 74 / 0.25));
  }
  .svc--row .svc__item:nth-child(-n + 3)::after {
    left: 50%;
    bottom: calc(-1 * var(--svc-gap));
    width: 2px;
    height: var(--svc-gap);
    background: linear-gradient(180deg, rgb(209 154 74 / 0.25), var(--gold-dark), rgb(209 154 74 / 0.25));
  }
  /* כלל קבוע (נוגה, 2026-11-08): האייקון, שורת הכותרת ושורת ההסבר באותו גובה בכל הכרטיסים, ו"לפרטים" באותו גובה מאחור */
  .svc--row .svc__face {
    justify-content: flex-start;
    gap: 0.55rem;
    padding: 1.5rem 1rem 1.25rem;
  }
  .svc--row .svc__front {
    color: var(--on-dark);
    background:
      radial-gradient(14rem 9rem at 100% 0, rgb(12 138 168 / 0.35), transparent 70%),
      linear-gradient(170deg, var(--navy-soft), var(--navy) 70%);
    border: 1px solid rgb(255 255 255 / 0.08);
    box-shadow: 0 16px 32px -24px rgb(11 26 51 / 0.7);
  }
  /* האייקון בזהב, בלי ריבוע (נוגה, 2026-11-13: הריבוע הזהב גנב את תשומת הלב מהכותרת) */
  .svc--row .svc__icon,
  .svc--row .svc__item:nth-child(even) .svc__icon {
    display: block;
    flex: none;
    color: var(--gold-light);
  }
  .svc--row .svc__title {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(1.25em * 2);
    font-size: clamp(1.3rem, 2.1vw, 1.55rem);
    line-height: 1.25;
    color: var(--white);
  }
  .svc--row .svc__lead {
    min-height: calc(1.45em * 2);
    font-size: 1rem;
    font-weight: 500;
    color: var(--on-dark-soft);
  }
  .svc--row .svc__back {
    color: var(--white);
    background:
      radial-gradient(14rem 9rem at 0 100%, rgb(252 220 109 / 0.16), transparent 70%),
      linear-gradient(160deg, var(--teal-dark), #04475a);
  }
  /* הטקסט מאחור: גדול יותר וממורכז גם לגובה (נוגה, 2026-11-13) */
  .svc--row .svc__back {
    justify-content: center;
  }
  .svc--row .svc__card {
    font-size: clamp(1.05rem, 1.6vw, 1.15rem);
    line-height: 1.6;
    text-align: center;
  }
  .svc--row .svc__more {
    margin-top: 0.5rem;
    color: var(--white);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  /* טאבלט: 3 בשורה. טלפון: זוגות, 2 בשורה (נוגה, 2026-11-12: הגלילה לצדדים לא עובדת בטלפון) */
  @media (max-width: 64rem) {
    .svc--row {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 40rem) {
    .svc--row {
      --svc-gap: 0.9rem;
      grid-template-columns: repeat(2, 1fr);
    }
    /* שני כרטיסים בשורה: החיבורים לפי זוגות */
    .svc--row .svc__item:not(:nth-child(3n))::before,
    .svc--row .svc__item:nth-child(-n + 3)::after {
      display: none;
    }
    .svc--row .svc__item:nth-child(odd)::before {
      display: block;
      top: 50%;
      left: calc(-1 * var(--svc-gap));
      width: var(--svc-gap);
      height: 2px;
      background: linear-gradient(90deg, rgb(209 154 74 / 0.25), var(--gold-dark), rgb(209 154 74 / 0.25));
    }
    .svc--row .svc__item:nth-child(-n + 4)::after {
      display: block;
      left: 50%;
      bottom: calc(-1 * var(--svc-gap));
      width: 2px;
      height: var(--svc-gap);
      background: linear-gradient(180deg, rgb(209 154 74 / 0.25), var(--gold-dark), rgb(209 154 74 / 0.25));
    }
    .svc--row .svc__face {
      padding: 1.15rem 0.7rem 1.1rem;
      gap: 0.45rem;
    }
    .svc--row .svc__icon :global(svg) {
      width: 32px;
      height: 32px;
    }
    .svc--row .svc__title {
      font-size: 1.12rem;
    }
    .svc--row .svc__lead {
      font-size: 0.88rem;
    }
  }
  @media (hover: none), (prefers-reduced-motion: reduce) {
    .svc--row .svc__inner {
      min-height: 0;
      border-color: rgb(255 255 255 / 0.08);
    }
    /* בטלפון ובטאבלט בעמוד הבית: רק הצד הקדמי. מה שכתוב מאחור לא מוצג (נוגה, 2026-11-12) */
    .svc--row .svc__back {
      display: none;
    }
    .svc--row .svc__front {
      flex: 1;
    }
  }
</style>
